}</style><script type="module" >const configuration = {}; const fragmentElement = document.querySelector('#fragment-ad67bcc7-6923-51d4-f7a5-d98490c62fa4'); const fragmentEntryLinkNamespace = 'xxoy'; const fragmentNamespace = 'xxoy'; const layoutMode = 'view';Liferay.on('allPortletsReady', function(){
  $('body').on('click', '.global-youtube-modal-trigger', function() {
    var videoURL = '';
    var videoTitle = '';

    if($(this).attr('data-modal-url')){
      videoURL = $(this).attr('data-modal-url');
      videoTitle = $(this).attr('data-modal-title');
    }
    else {
      var videoURLElem = $(this).attr('data-modal-url-id');
      var videoTitleElem = $(this).attr('data-modal-title-id');
      videoURL = $('#' + videoURLElem).text();
      videoTitle = $('#' + videoTitleElem).text();
    }

    var youtube_video_id = videoURL.match(/.*(youtube\.com)?.*(\?v=|\/embed\/)?(.{11})/)?.pop();

		$('#globalYoutubeIframe').attr('src', 'https://www.youtube.com/embed/' + youtube_video_id + '?autoplay=1');
    $('#globalYouTubeVideoModalLabel').text(videoTitle);
  });
	
	$('body').on('hide.bs.modal', function(){
		$('#globalYoutubeIframe').attr('src', '');
	});
});
;</script></div>




			
			
		
	


