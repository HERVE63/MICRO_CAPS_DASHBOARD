t="ixt:num-dot-decimal">4.57</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td><td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction name="ntrb:SharebasedCompensationSharesAuthorizedUnderStockOptionPlansExercisePriceRangeExercisableIntrinsicValue" contextRef="cref_1873470195" unitRef="uref_1940681636" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-14762">1,719,313</ix:nonFraction></td><td style="text-align: left">&#160;</td> </tr> </tbody></table></ix:nonNumeric><ix:exclude><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.5in; text-align: justify"><span style="font-weight: bold;">&#160;</span></p></ix:exclude></ix:nonNumeric> <p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.5in; text-align: justify"><span style="font-weight: bold;"></span></p><!-- Field: Page; Sequence: 54 --><div style="margin-top: 12pt; margin-bottom: 6pt; border-bottom: Black 1.5pt solid"><p style="font: 10pt Times New Roman, Times, Serif; text-align: center; margin-top: 0pt; margin-bottom: 0pt">F-<!-- Field: Sequence; Type: Arabic; Name: PageNo -->20<!-- Field: /Sequence --></p></div><div style="break-before: page; margin-top: 6pt; margin-bottom: 12pt"><p style="margin: 0pt">&#160;</p></div><!-- Field: /Page --><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.5in; text-align: justify"><span style="font-weight: bold;">&#160;</span></p>
 <ix:nonNumeric name="us-gaap:SegmentReportingDisclosureTextBlock" contextRef="cref_86724320" escape="true" id="ixv-8206"><table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; margin-top: 0pt; margin-bottom: 0pt" width="100%"><tbody><tr style="vertical-align: top"> <td style="width: 0.25in"/><td style="width: 0.25in">10.</td><td style="text-align: justify">SEGMENT REPORTING</td></tr></tbody></table><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.25in; text-align: justify">&#160;</p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.5in; text-align: justify"> We organize and manage our business by the following <span style="-sec-ix-hidden:fc_578464901">two</span> segments which meet the definition of reportable segments under ASC 280-10, Segment Reporting: Sales of Goods and Services. These segments are based on the customer type of products or services provided and are the same as our business units. <ix:nonNumeric name="us-gaap:SegmentReportingCodmProfitLossMeasureHowUsedDescription" contextRef="cref_86724320" id="ixv-8216">Separate financial information is available and regularly reviewed by our chief operating decision maker (&#8220;CODM&#8221;), who is our <span style="-sec-ix-hidden:fc_506596240">chief executive officer</span>, in making resource allocation decisions for our segments. Our CODM evaluates segment performance to the GAAP measure of gross profit.</ix:nonNumeric> </p><p style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0 0pt 0.5in; text-align: justify">&#160;</p><ix:nonNumeric name="us-gaap:ScheduleOfSegmentReportingInformationBySegmentTextBlock" contextRef="cref_86724320" escape="true" id="ixv-8219"><table cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; font: 10pt Times New Roman, Times, Serif"> <tbody><tr style="vertical-align: bottom"> <td style="text-align: center">&#160;</td> <td style="text-align: center">&#160;</td> <td col