olspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Number<br/> Outstanding</td><td style="padding-bottom: 1.5pt">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td> <td colspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Remaining Contractual<br/> Life (Years)</td><td style="padding-bottom: 1.5pt">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td> <td colspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Exercise Price for Shares<br/> Outstanding</td><td style="padding-bottom: 1.5pt">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td> <td colspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Number<br/> Exercisable</td><td style="padding-bottom: 1.5pt">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td> <td colspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Exercise Price for Shares<br/> Exercisable</td><td style="padding-bottom: 1.5pt">&#160;</td><td style="padding-bottom: 1.5pt">&#160;</td> <td colspan="2" style="text-align: center; border-bottom: Black 1.5pt solid">Intrinsic<br/> Value</td><td style="padding-bottom: 1.5pt">&#160;</td></tr> <tr style="vertical-align: bottom; background-color: rgb(204,238,255)"> <td style="width: 1%; text-align: left">$</td><td style="width: 12%; text-align: right">4.00</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 12%; text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedNumber" contextRef="cref_171529493" unitRef="uref_802553841" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-14602">30,000</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 1%">&#160;</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 12%; text-align: right"><ix:nonNum