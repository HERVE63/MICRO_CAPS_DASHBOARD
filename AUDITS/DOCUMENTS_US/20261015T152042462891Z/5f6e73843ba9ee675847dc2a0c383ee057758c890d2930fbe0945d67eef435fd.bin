                        <td style="vertical-align:bottom;border-bottom:0.75pt solid #000000;text-align:right;width:5%"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:8pt"><span><span><span><span><ix:nonFraction id="Fxbrl_20251023184002364_xbrl_20250415142825780" name="ecd:NonPeoNeoAvgTotalCompAmt" contextRef="C_20230101to20231231_ecdIndividualAxis_flgcMatthewCohenMember" unitRef="USD" scale="0" decimals="0" format="ixt:num-dot-decimal">237,074</ix:nonFraction></span></span></span></span></span></span></td>
