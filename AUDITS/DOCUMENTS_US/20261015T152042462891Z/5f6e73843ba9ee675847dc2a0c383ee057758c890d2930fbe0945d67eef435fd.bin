                        <td style="vertical-align:bottom;border-top:0.75pt solid #000000;text-align:right;width:5%"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:8pt"><span><span><span><span><ix:nonFraction id="Fxbrl_20251023183956308_xbrl_20250415142728200" name="ecd:NonPeoNeoAvgTotalCompAmt" contextRef="C_20240101to20241231_ecdIndividualAxis_flgcMatthewCohenMember" unitRef="USD" scale="0" decimals="0" format="ixt:fixed-zero">-</ix:nonFraction></span></span></span></span></span></span></td>
