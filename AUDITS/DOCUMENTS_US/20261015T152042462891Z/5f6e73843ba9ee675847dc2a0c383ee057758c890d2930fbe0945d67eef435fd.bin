                        <td style="vertical-align:bottom;border-bottom:0.75pt solid #000000;text-align:right;width:5%"><span style="font-family:Times New Roman,Times,serif"><span style="font-size:8pt"><span><span><span><span>31,250</span></span></span></span></span></span></td>
