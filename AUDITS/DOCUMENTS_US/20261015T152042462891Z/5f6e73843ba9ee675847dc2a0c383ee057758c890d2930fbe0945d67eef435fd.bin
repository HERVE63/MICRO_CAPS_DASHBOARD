    </table>
    <p style="font-family:Times New Roman;margin-bottom:0pt;text-align:justify;margin-top:10pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">Fort Lauderdale, Florida</span></span></p>
    <p style="font-family:Times New Roman;margin-top:0pt;text-align:justify;margin-bottom:10pt"><span style="font-size:10pt"><span style="font-family:Times New Roman,Times,serif">November 4, 2025</span></span></p>
