n','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:9pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.43%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:17.09%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_qm5B7k34nkWN9MUq-lwkuw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:UnusedCommitmentsToExtendCredit" scale="3" id="Tc_c-6_6QiNakqVm3W7vOruQw_57_6">26,385</ix:nonFraction></b></p></td></tr></table><div style="font-family:'Times New Roman','Times','serif';font-size:6.0pt;margin-bottom:0pt;min-height:1.19em;position:relative;width:100%;"><div style="background-color:#000000;height:1pt;position:relative;top:0.6em;width:25.0%;border:none;margin:0 auto 0 0;"></div></div><div style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-left:18pt;margin-top:0pt;text-indent:0pt;"><span style="display:inline-block;min-width:18pt;white-space:nowrap;">(1)</span>Unfunded commitments denominated in non-USD currencies have been converted to USD using the exchange rate as of the applicable reporting date.</div></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of both December&#160;31,&#160;2025 and December 31, 2024, the Company had commitments to fund equity interests and subordinated notes in STRS JV of $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_sk587QgGTUmARxezG9fI5A" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:CommitmentsToFundEquityInterests" scale="3" id="Narr_ciEG7Y7Cf0qhePVyPi0RQg"><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_G8Q9NKr3_k-X44TEN_0oYw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:CommitmentsToFundEquityInterests" scale="3" id="Narr_UqMaUSRlwkOE3BdWF7n9QQ">23,000</ix:nonFraction></ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_sk587QgGTUmARxezG9fI5A" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:CommitmentsToSubordinatedNotes" scale="3" id="Narr_hoi6ReShy0WEROR_phqNKA"><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_G8Q9NKr3_k-X44TEN_0oYw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:CommitmentsToSubordinatedNotes" scale="3" id="Narr_8XOwp9Rz9k6Zlv2Hmo1I8g">92,000</ix:nonFraction></ix:nonFraction>, respectively, of which $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_sk587QgGTUmARxezG9fI5A" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:UnfundedCommitmentEquityInterests" scale="3" id="Narr_boCnE4D8gEm3vd5f3YadDw"><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_G8Q9NKr3_k-X44TEN_0oYw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:UnfundedCommitmentEquityInterests" scale="3" id="Narr_Y3UGvXjlSkKDGrdOOX_m-A">1,896</ix:nonFraction></ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_sk587QgGTUmARxezG9fI5A" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:UnfundedCommitmentSubordinateNotes" scale="3" id="Narr_15R7mGKvq0O9g0CA4rx_6A"><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_whfcl_StrsJvMember_G8Q9NKr3_k-X44TEN_0oYw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:UnfundedCommitmentSubordinateNotes" scale="3" id="Narr_lcFH3xjZ5UOccRA31iD2Hg">7,584</ix:nonFraction></ix:nonFraction> were unfunded, respectively. The capital commitments cannot be drawn without an affirmative vote by both the Company&#8217;s and STRS Ohio&#8217;s representatives on STRS JV&#8217;s board of managers.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Indemnification</span>: In the normal course of business, the Company enters into contracts and agreements that contain a variety of representations and warranties that provide general indemnifications. The Company&#8217;s maximum exposure under these arrangements is unknown, as this would involve future claims that may be made against the Company that have not occurred. The Company expects the risk of any future obligation under these indemnifications to be remote.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 0pt 0.25pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Legal Proceedings</span>: In the normal course of business, the Company, WhiteHorse Advisers and WhiteHorse Administrator may be subject to legal and regulatory proceedings that are generally incidental to its ongoing operations. </p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;">180</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">WHITEHORSE FINANCE,&#160;INC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes To Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">December&#160;31, 2025</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 6pt 0pt;">(in thousands, except share and per share data)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_KNiEiyWgskOm1ck-HkyWWw_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0.25pt;">While there can be no assurance of the ultimate disposition of any such proceedings, the Company does not believe any such disposition will have a material adverse effect on the Company&#8217;s consolidated financial statements.</p></ix:continuation><a id="_759a5aea_5504_4279_aa6f_27e427c710e8"></a><a id="Tc_xmctjuQZbEa-XHV6sdfzqg_1_0"></a><a id="Tc_4oG0PWuzUEa_wR2QcOOJ0Q_1_2"></a><a id="Tc_NNNCtmlmlUOfdesbI-jpGA_1_4"></a><a id="Tc_9EoBy4yGE06X3x7kvjBGjg_1_7"></a><a id="Tc_c3ptdNA3l0irzvO9TbfPpg_1_10"></a><a id="Tc_NrbrJQ05W0-1y2vgML4c3w_2_0"></a><a id="Tc_pj-HepFdO0WAqjhZobCwuw_2_4"></a><a id="Tc_jGBk4_TBhEmHaa3e4DenWQ_2_7"></a><a id="Tc_tZuQjsjs20GnSgYej-rSPg_2_10"></a><a id="Tc_X_Bmffwg30ieCDfu1qqBIA_3_0"></a><a id="Tc_OcK0TEuKTU2oY8eSe05Tfw_4_0"></a><a id="Tc_2Lwp__cKJ0GEXqBqHIArZg_4_4"></a><a id="Tc_eBwKrWL9S0qTIMHCu4Sa0w_4_7"></a><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_AEfWhBXWI06wMjRnXNyedQ" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_bl5Cr4AvykSZpmX9PU6cgA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;9&#160;- STOCKHOLDERS&#8217; EQUITY</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">On March 31, 2023, the Company launched an &#8220;at-the-market&#8221; offering (the &#8220;ATM Program&#8221;) by entering into an Equity Distribution Agreement with B. Riley Securities, Inc. pursuant to which the Company may offer and sell, from time to time, through B. Riley Securities, Inc., as the sales agent, shares of its common stock having an aggregate offering amount of up to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_3_1_2023_To_3_31_2023_dei_LegalEntityAxis_whfcl_BRileySecuritiesIncMember_srt_RangeAxis_srt_MaximumMember_us-gaap_SubsidiarySaleOfStockAxis_whfcl_AtMarketOfferingMember_iza8bvYo3kayxVVVqcqSDA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodValueNewIssues" scale="3" id="Narr_lCy94Y0Z-0KwmVJq8XR1cA">35,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><ix:nonFraction unitRef="Unit_Standard_shares_YcQ8h8ifUE-yPIVVDa8sOA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_SubsidiarySaleOfStockAxis_whfcl_AtMarketOfferingMember_W2XIlyUtAECxmnPF-HTG2Q" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_Mzz3nWodhE-94qv6Q2nQHA"><ix:nonFraction unitRef="Unit_Standard_shares_YcQ8h8ifUE-yPIVVDa8sOA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_SubsidiarySaleOfStockAxis_whfcl_AtMarketOfferingMember_YfwskeDcWkSiE84hdjfd5w" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_VZW1OzoyB0WtTrXTcyhchA">No</ix:nonFraction></ix:nonFraction> shares were issued pursuant to the ATM program during the years ended December 31, 2025 or 2024.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">On November 10, 2025, the Company&#8217;s board of directors authorized a stock repurchase program for the purpose of repurchasing up to an aggregate of $<ix:nonFraction unitRef="Unit_Standard_shares_YcQ8h8ifUE-yPIVVDa8sOA" contextRef="As_Of_11_10_2025_j8RFpINQlUKgq8x9yHZCgg" decimals="INF" format="ixt:num-dot-decimal" name="srt:StockRepurchaseProgramNumberOfSharesAuthorizedToBeRepurchased" scale="0" id="Narr_rSO7D-cvhkWZOqnjLUq0xQ">15,000</ix:nonFraction> of its common stock on the open market or in privately negotiated purchases at prices below our then-current net asset value per share in accordance with the guidelines specified in Rule 10b-18 under the Securities Exchange Act of 1934 (the "Repurchase Program"). The timing, manner, price and amount of any share repurchases will be determined by the Company, in its sole discretion, based upon an evaluation of economic and market conditions, stock price, applicable legal and regulatory requirements and other factors. The Repurchase Program does not require the Company to repurchase any specific number of shares of common stock or any shares of common stock at all and there can be no assurance that any shares of common stock will be repurchased under the Repurchase Program. The timing and amount of any common stock repurchased depend on the terms and conditions of the Repurchase Program, the market price of the common stock and trading volumes. The Repurchase Program may be suspended, extended, modified or discontinued at any time. Repurchases are subject to SEC regulations as well as certain price, market volume and timing constraints.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_AEfWhBXWI06wMjRnXNyedQ" name="whfcl:ScheduleOfShareRepurchaseProgramTableTextBlock" id="Tb_WffETLL1Kkajm_FX3majkA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">For the year ended December 31, 2025, shares purchased under the Repurchase Program, net of commissions paid, were as follows:</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;white-space:nowrap;width:45.26%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;width:1.1%;margin:0pt;padding:0pt;"><div style="he