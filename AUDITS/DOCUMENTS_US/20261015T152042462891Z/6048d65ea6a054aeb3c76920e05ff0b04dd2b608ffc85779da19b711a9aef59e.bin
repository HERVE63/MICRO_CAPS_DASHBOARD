gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_Rbc5mMUR9USQqSmUJPAWsA"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_FivePointSixTwoFivePercent2027NotesMember_M9DXYUPlREq0CyBXOdh6rQ" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_uCkp5ZYUiEiSrtxgk4C14g">5.625</ix:nonFraction></ix:nonFraction>%<span style="background:#ffffff;"> 2027 Notes&#8221;) and the&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_FourPointTwoFiveZero2028NotesMember_5SjLGCoB-E-4lOce1tc1VA" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_kf3WzHCm1UCy6LrTzQOmvw"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_FourPointTwoFiveZero2028NotesMember_LgO6hBvsdkiq9KOg84WPJQ" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_Xl0S1RzpgUa4YyvHctZu9w">4.25</ix:nonFraction></ix:nonFraction>%<span style="background:#ffffff;"> private notes due 2028 (the &#8220;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_FourPointTwoFiveZero2028NotesMember_5SjLGCoB-E-4lOce1tc1VA" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_apjY8RPy_kiO0ddqs50KHw"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_FourPointTwoFiveZero2028NotesMember_LgO6hBvsdkiq9KOg84WPJQ" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_uYLc5LNdlkiICnprsn6yJQ">4.250</ix:nonFraction></ix:nonFraction>%<span style="background:#ffffff;"> 2028 Notes&#8221;) were estimated using discounted future cash flows to the valuation date.&#160;As of December 31, 2025 and December&#160;31,&#160;2024, the fair value of the&#160;</span><span style="background:#ffffff;"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_SevenPointEightSevenFive2028NotesMember_0P-4q_nTsUa5Z4DGaPjWxA" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_cmtL5S0BJUmkd_266GqsNQ"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_SevenPointEightSevenFive2028NotesMember_Ug2VrDleSEGAzaMrp0aXuA" decimals="5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_T-RkCUmRxE6NOZ3ZMW5YNA">7.875</ix:nonFraction></ix:nonFraction>%</span><span style="background:#ffffff;">&#160;2028 Notes and 2025 CLO Notes&#160;(as defined in Note 6)&#160;approximates the principal amounts outstanding</span><span style="white-space:pre-wrap;">.  </span></p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_AEfWhBXWI06wMjRnXNyedQ" name="whfcl:ScheduleOfPrincipalAmountAndFairValueOfBorrowingsTableTextBlock" id="Tb_egAhLho6jUONmnujk6zxOg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:19.18%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Time