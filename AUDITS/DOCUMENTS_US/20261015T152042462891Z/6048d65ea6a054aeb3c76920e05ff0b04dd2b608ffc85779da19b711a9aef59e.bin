n-height:1.19em;position:relative;width:100%;"><div style="background-color:#000000;height:1px;position:relative;top:0.6em;width:25.0%;border:none;margin:0 auto 0 0;"></div></div><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:2pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:36pt;padding:0pt;">(1)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">Except as otherwise noted, all investments are non-controlled/non-affiliate investments as defined by the Investment Company Act of 1940, as amended (the &#8220;1940 Act&#8221;), provide collateral for the Company&#8217;s credit facility, and are domiciled in the United States.</span></td></tr></table><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:2pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:36pt;padding:0pt;">(2)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">The investments bear interest at a rate that may be determined by reference to SOFR, CORRA, Prime, or EurIBOR, which resets monthly, quarterly or semiannually. The one, three and six-month SOFR were </span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_VariableRateAxis_whfcl_SecuredOvernightFinancingRateSofrOneMonthTermMember_7Q_U8GzKjUeEKttbReDTog" decimals="3" format="ixt:num-dot-decimal" name="