 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.88%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_SevenPointEightSevenFive2028NotesMember_0P-4q_nTsUa5Z4DGaPjWxA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebt" scale="3" id="Tc_C2w8voDsPk-oOQId2duFEw_8_10">33,483</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.85%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.09%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.74%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> &#8212;</p></td></tr><tr style=""><td style="vertical-align:bottom;width:28.85%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Total debt</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.85%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.37%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.85%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.67%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.75%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.09%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.95%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_qm5B7k34nkWN9MUq-lwkuw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Tc_4e_jTPgYSUOfV3gGW2H2nA_9_7">355,993</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.85%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.15%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.88%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_qm5B7k34nkWN9MUq-lwkuw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebt" scale="3" id="Tc__0Elxi5ysUCjPeP0711uJQ_9_10">353,117</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.85%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.09%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.74%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_qm5B7k34nkWN9MUq-lwkuw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Tc_SOBpE5KIqkaZbUSdxF2rlw_9_13">173,507</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:0pt;margin:0pt 0pt 0pt 18pt;"><span style="margin-bottom:12pt;margin-left:0pt;visibility:hidden;">&#8203;</span></p><div style="font-family:'Times New Roman','Times','serif';font-size:6.0pt;margin-bottom:0pt;min-height:1.19em;position:relative;width:100%;"><div style="background-color:#000000;height:1pt;position:relative;top:0.6em;width:25.0%;border:none;margin:0 auto 0 0;"></div></div><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">(1)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">All foreign denominated principal borrowings have been converted to USD using the exchange rates as of the applicable reporting date.</span></td></tr></table><div style="margin-top:12pt;"></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Credit Facility</span>: On December&#160;23, 2015, WhiteHorse Credit entered into a revolving credit and security agreement with JPMorgan, as administrative agent and lender. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On January 4, 2022, the terms of the Credit Facility were amended to, among other things, continue to establish a temporary upsize to the borrowing capacity under the Credit Facility, which allowed WhiteHorse Credit to borrow up to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_4_2022_To_1_4_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_7Udv3gjQNECOetXxbxYo8Q" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditTemporaryIncreaseInAvailability" scale="3" id="Narr_nOZMqzwsiEG9ALgp4YaMGg">335,000</ix:nonFraction> for a four-month period that originally began on October 4, 2021.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;">170</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">WHITEHORSE FINANCE,&#160;INC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes To Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">December&#160;31, 2025</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 6pt 0pt;">(in thousands, except share and per share data)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_FeiIwMJ-1kO1Dppbnxb7BA_cont2" continuedAt="Tb_FeiIwMJ-1kO1Dppbnxb7BA_cont3"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On February 4, 2022, the terms of the Credit Facility were further amended to apply an annual interest rate equal to applicable <span style="-sec-ix-hidden:Hidden_lj_jfBThT0WL4Rm1uVujEQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">SOFR</span></span> plus <ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_2_4_2022_To_2_4_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_F4BKjw_QTkuEK5EaKKjDCg" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr__q5aEt8Yqk6aBiu6OEaJaw">2.50</ix:nonFraction>% to any borrowings under the Credit Facility.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On March 30, 2022, the terms of the Credit Facility were further amended to, among other things: (i) increase WhiteHorse Credit&#8217;s availability under the Credit Facility from $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_3_29_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_SmSDzxlrc0es7IKaxd0MZg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_Q8wTUb_930KNaLbnIhcl6w">310,000</ix:nonFraction> to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_3_30_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_yA7aNEVv606ZeJSK3_SXVg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_WuWxiWl8u06TTNSPIpsCMA">335,000</ix:nonFraction>; (ii) retain an accordion feature which allows for the expansion of the borrowing limit up to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_3_30_2022_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_rGuIvOCB5UyQvGtAsDb0kQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityMaximumBorrowingCapacity" scale="3" id="Narr_vwH99GKHI0iJGDVbDUJ7KA">375,000</ix:nonFraction>; and (iii) increase the minimum funding amount from $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_3_29_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_SmSDzxlrc0es7IKaxd0MZg" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityContingentIncreaseMinimumFundingAmount" scale="3" id="Narr_HHJzqbGXjE2A6lxOyMgLXg">217,000</ix:nonFraction> to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_3_30_2022_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_yA7aNEVv606ZeJSK3_SXVg" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityContingentIncreaseMinimumFundingAmount" scale="3" id="Narr_UjLuRLSGHEuFVL_asLFz3g">234,500</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">On April 12, 2023, the terms of the Credit Facility were further amended to, among other things, (i) apply an annual interest rate equal to the applicable base rate plus <ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_4_12_2023_To_4_12_2023_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_us-gaap_VariableRateAxis_us-gaap_BaseRateMember_qaeYzl5l3Ueiz7BQlo-iNQ" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_U1zHSgXiC0OAlCh8j2ctiA">2.50</ix:nonFraction>% to any USD denominated borrowings, and (ii) convert to SOFR for USD denominated borrowings effective June 6, 2023.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">On January 17, 2025, the terms of the Credit Facility were amended to, among other things, (i) reduce the applicable margins for interest rates to <ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_1_17_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_jizCtDzNNk2zuK1K6w1I9A" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DerivativeBasisSpreadOnVariableRate" scale="-2" id="Narr_iFx70Xa1kkC6OiNDN3oTSw">2.25</ix:nonFraction>%, (ii) extend the non-call period to January 17, 2027, (iii) extend the reinvestment period to January 17, 2028, and (iv) extend the scheduled termination date to January 17, 2030.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">On June 27, 2025, the terms of the Credit Facility were amended to, among other things, reduce the availability under the Credit Facility to $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_6_27_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_A8xnxSp6IEukTjuRH-kZ9w" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_a48bjeLMIECQREd-PPhFxQ">100,000</ix:nonFraction> from $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_6_26_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_Ydkk9dKUxkWT1NOvKy2kZg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_jfVXW-YkyUebx9kQFX5aQg">335,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="background:#ffffff;">The Credit Facility bears interest at&#160;</span><span style="-sec-ix-hidden:Hidden_N18urDwJ0EKx-XsGKAO5MQ;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;background:#ffffff;">SOFR</span></span><span style="background:#ffffff;"> for USD denominated borrowings, EurIBOR for EUR denominated borrowings, CORRA for CAD denominated borrowings, SONIA for GBP denominated borrowings, plus, in each case, a spread of&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_4_12_2023_To_4_12_2023_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_us-gaap_VariableRateAxis_whfcl_SterlingOvernightIndexAverageMember_1GETvCrSBUSaCENl0x_aQA" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_e14pLSbkIkKryE5eji8Gog">2.25</ix:nonFraction><span style="background:#ffffff;">% on outstanding borrowings. The Company is required to pay a non-usage fee which accrues at&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_4_12_2023_To_4_12_2023_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_1RONmMi-wU2Fig4r2BhzQg" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityUnusedCapacityCommitmentFeePercentage" scale="-2" id="Narr_0fCgN9JqbUWDN55GMvR7UQ">0.55</ix:nonFraction><span style="background:#ffffff;">% per annum on the average daily unused amount of the financing commitments to the extent the aggregate principal amount available under the Credit Facility has not been borrowed. The Company is also required to pay a minimum outstanding borrowing fee which accrues at&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bBzLqehixUi92S4YHsLvLw" decimals="4" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityBorrowingsBelowFundingAmountMinimumBorrowingFee" scale="-2" id="Narr_8mOxDX6mGUGyili_8Frh6w">2.25</ix:nonFraction><span style="background:#ffffff;">% per annum on the average daily outstanding principal borrowing amounts below the minimum funding amount. The minimum borrowing requirement is </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bBzLqehixUi92S4YHsLvLw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityMinimumBorrowingCapacity" scale="3" id="Narr_LsmBXO_59kyKgRJv-OiNsQ">50,000</ix:nonFraction><span style="background:#ffffff;">&#160;as of December 31,&#160;2025. In connection with the Credit Facility, WhiteHorse Credit pledged securities with a fair value of approximately </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_4pKdnnnl60qULZlJiuAmng" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:SecuritiesLoanedFairValueOfCollateral" scale="3" id="Narr_d4um81RlgkCqe4YDcGPfHA">139,509</ix:nonFraction><span style="background:#ffffff;">&#160;as of December 31,&#160;2025. The Credit Facility has a maturity date of January 17, 2030.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Under the Credit Facility, the Company has made certain customary representations and warranties and is required to comply with various covenants, including leverage restrictions, reporting requirements and other customary requirements for similar credit facilities.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of <span style="background:#ffffff;">December 31,&#160;2025</span>, the Company had&#160;<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_4pKdnnnl60qULZlJiuAmng" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:DebtInstrumentCarryingAmount" scale="3" id="Narr_Ifb1sS_ZaU-bejtQmTA3IQ">no</ix:nonFraction>&#160;outstanding borrowings and $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_4pKdnnnl60qULZlJiuAmng" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_zpGjcdpb6UWoebIQJFLfPQ">100,000</ix:nonFraction>&#160;undrawn under the Credit Facility. Weighted average outstanding borrowings were&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bBzLqehixUi92S4YHsLvLw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:WeightedAverageBorrowingsOutstandingDuringPeriod" scale="3" id="Narr_DJPwY5j600OBabhGflvLjQ">77,300</ix:nonFraction> at a weighted average interest rate of&#160;<ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bBzLqehixUi92S4YHsLvLw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtWeightedAverageInterestRateOverTime" scale="-2" id="Narr_WqVT6KSHgke_0_d2njT78A">6.54</ix:nonFraction>%&#160;for the year ended December 31,&#160;2025. As of <span style="background:#ffffff;">December 31,&#160;2025</span>, the interest rate in effect on outstanding borrowings was&#160;<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bBzLqehixUi92S4YHsLvLw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:InterestExpenseLongTermDebt" scale="3" id="Narr_kVo8_0c8OUany2JInHFBGQ">zero</ix:nonFraction>. The Company&#8217;s ability to draw down undrawn funds under the Credit Facility is determined by collateral and portfolio quality requirements stipulated in the credit and security agreement. As of <span style="background:#ffffff;">December 31,&#160;2025</span>, due to borrowing base limitations, approximately $<ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_LvVy0y9BkkSTPue3ewQ-bA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_spJjo09aHEqHjfWQbVI9iA">43,777</ix:nonFraction> was available to be drawn by the Company based on these requirements.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="background:#ffffff;">As of December&#160;31,&#160;2024, the Company had </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bRNohbWkk0O6Gtz8piFVXA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentCarryingAmount" scale="3" id="Narr_PmPqPzcrO0SUnH06g9L3Ow">161,493</ix:nonFraction><span style="background:#ffffff;">&#160;in outstanding borrowings and </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bRNohbWkk0O6Gtz8piFVXA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_jZmrDAioh06xy_z9Qm2Q3w">173,507</ix:nonFraction><span style="background:#ffffff;">&#160;undrawn under the Credit Facility. For the year ended December&#160;31,&#160;2024, weighted average outstanding borrowings were </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_utQT2siXfEK4b_qyf2nXcw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:WeightedAverageBorrowingsOutstandingDuringPeriod" scale="3" id="Narr_l8pyRMMyJkuEQNZoJZ6E4Q">183,014</ix:nonFraction><span style="background:#ffffff;">&#160;at a weighted average interest rate of&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_utQT2siXfEK4b_qyf2nXcw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtWeightedAverageInterestRateOverTime" scale="-2" id="Narr_hUDrmxPv1Ua-3e1oA08bMg">7.67</ix:nonFraction><span style="background:#ffffff;">%. As of December&#160;31,&#160;2024, the interest rate in effect on outstanding borrowings was&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_OB6QXf9I0kejVMhTvRVYrQ" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bRNohbWkk0O6Gtz8piFVXA" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateEffectivePercentage" scale="-2" id="Narr_PDSX94rvh0WU5YLYBxNlQw">6.88</ix:nonFraction><span style="background:#ffffff;">%. The Company&#8217;s ability to draw down undrawn funds under the Credit Facility is determined by collateral and portfolio quality requirements stipulated in the credit and security agreement. As of December&#160;31,&#160;2024, </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_FFkwHGwPOkyNVvvR70yQzA" contextRef="As_Of_12_31_2024_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bRNohbWkk0O6Gtz8piFVXA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_sWhju3q1f0yADHB4shNe4Q">173,507</ix:nonFraction><span style="background:#ffffff;">&#160;was available to be drawn by the Company based on these requirements.</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:3pt 0pt 0pt 0pt;">171</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">WHITEHORSE FINANCE,&#160;INC.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">Notes To Consolidated Financial Statements</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt;">December&#160;31, 2025</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;text-align:center;margin:0pt 0pt 6pt 0pt;">(in thousands, except share and per share data)</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc__GHJnvWKr0mqlLnWZP74KA_1_3"></a><a id="Tc_BrH3yH7GjUS6aGeuAf3iNA_2_0"></a><a id="Tc_1b3BdtPrpEWfqKumMznmcg_2_3"></a><a id="Tc__r4luRPa6UOr_GfyyYE35g_2_6"></a><a id="Tc_j9RiBcoAG061WNLW9c1X0Q_2_10"></a><a id="Tc_Xketyjtc9kWYgLKcGMBiTA_3_0"></a><a id="Tc_bQPSkCGrsEugEWVDzrfNIQ_3_3"></a><a id="Tc_vZ3YmK3_0kuewfG7IkIa0Q_3_6"></a><a id="Tc_KQVcJtSIPE-7CkU-XxmM-A_3_10"></a><a id="Tc_sVnC0TKFgEuh2AfAOU0mbw_4_0"></a><a id="Tc_1DUF3Y0EQkSphN1LKD37lw_5_0"></a><a id="Tc_uEaiUhkadEiVSLTwHxWaAA_5_3"></a><a id="Tc_rl97DLzeqUOI8Z3hTMJV7g_5_6"></a><a id="Tc_zHrUodNq8UCVqwxy-IiujQ_5_10"></a><a id="Tc_G9NxIBoEzkmW8mVK7f06mA_6_0"></a><a id="Tc_82NwZommy02FUNETuROxcA_6