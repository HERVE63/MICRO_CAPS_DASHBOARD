  <tr style="font-size: 10pt; vertical-align: top; background-color: #CCEEFF">
    <td style="font-size: 10pt"><a href="#vz_005"><span style="font-size: 10pt">Proposal 1 &#8211; Election of Directors</span></a></td>
    <td style="text-align: right; font-size: 10pt"><a href="#vz_005">9</a></td></tr>
