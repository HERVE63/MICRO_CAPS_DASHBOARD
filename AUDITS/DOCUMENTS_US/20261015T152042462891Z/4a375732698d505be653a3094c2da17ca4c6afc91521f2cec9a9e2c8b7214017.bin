              <div style="color: rgb(0, 0, 0);">$</div>
            </td>
            <td class="cftnumcell" colspan="1" style="vertical-align: bottom; text-align: right; width: 9%; border-bottom: #000000 double 4px; background-color: #CCEEFF;" valign="bottom"> <div style="color: rgb(0, 0, 0);"><ix:nonFraction contextRef="c2" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLiability" scale="3" unitRef="usd" id="ixv-13292">67,506</ix:nonFraction></div> </td>
            <td class="cftfncell" colspan="1" style="vertical-align: bottom; width: 1%; padding-bottom: 4px; background-color: #CCEEFF; white-space: nowrap;" valign="bottom">&#160;</td>
