                    <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 12pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 0pt; text-align: center; margin-right: 0pt; "><FONT style="font-size: 10pt; font-family: Times New Roman, Times, serif; ">ii</FONT></P>
                    <!-- [if IE]></TD></TR></TABLE><![endif]-->
                </DIV>
            </DIV>
            <DIV style="border: 0pt; padding-top: 0pt; top: 42.48pt; left: 42.48pt; padding-left: 0pt; width: 637.2pt; padding-bottom: 0pt; position: absolute; padding-right: 0pt; height: 817.74pt; ">
                <P style="margin-left: 0pt; text-transform: uppercase; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 8pt; text-align: center; margin-right: 0pt; "><FONT style="font-weight: bold; "><B>TABLE OF CONTENTS</B></FONT></P>
                <P style="margin-left: 0pt; color: #000000; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 8pt; text-align: right; margin-right: 0pt; "><FONT>Page</FONT></P>
                <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 8pt; text-align: center; margin-right: 0pt; "><A href="#bcb_bancorp-def14aa309"><FONT>ARTICLE I</FONT></A></P>
                <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 8pt; text-align: center; margin-right: 0pt; "><FONT>OFFICES</FONT></P>
                <DIV style="margin-left: 0pt; color: #000000; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 8pt; text-align: justify; margin-right: 0pt; ">
                    <TABLE style="width: 637.2pt; margin-top: 4pt; margin-bottom: 8pt; table-layout: fixed; border-collapse: collapse; ">
                        <TR style="margin: 0; height: 0; ">
                            <TD style="border: 0; width: 84.96pt; padding: 0; margin: 0; ">
                            </TD>
                            <TD style="border: 0; width: 523.92pt; padding: 0; margin: 0; ">
                            </TD>
                            <TD style="border: 0; width: 28.32pt; padding: 0; margin: 0; ">
                            </TD>
                        </TR>
                        <TR style="min-height: 0pt; ">
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 21.24pt; color: #000000; text-indent: -21.24pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: left; margin-right: 0pt; "><A href="#bcb_bancorp-def14aa310"><FONT>Section 1.</FONT></A></P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: left; margin-right: 0pt; "><FONT>Registered Office </FONT></P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; color: #000000; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: right; margin-right: 0pt; "><FONT>1</FONT></P>
                            </TD>
                        </TR>
                        <TR style="min-height: 0pt; ">
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 21.24pt; color: #000000; text-indent: -21.24pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: left; margin-right: 0pt; "><A href="#bcb_bancorp-def14aa311"><FONT>Section 2.</FONT></A></P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
