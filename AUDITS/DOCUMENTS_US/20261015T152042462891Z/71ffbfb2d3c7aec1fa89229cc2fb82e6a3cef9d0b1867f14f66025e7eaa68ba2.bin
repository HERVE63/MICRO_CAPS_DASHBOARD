                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 21.24pt; color: #000000; text-indent: -21.24pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; margin-right: 0pt; "><FONT>All Directors, Nominees and Executive Officers as a group (16 persons)</FONT><SUP style="font-size: 8.0pt; line-height: 8.0pt; ">18</SUP><FONT> </FONT></P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 0pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 0pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; font-size: 1pt; line-height: 1pt; margin-top: 0pt; margin-bottom: 0; margin-right: 0pt; ">&#8203;</P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: center; margin-right: 0pt; "><FONT>2,807,499</FONT></P>
                            </TD>
                            <TD style="border-top: 0pt; padding-top: 0pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 0pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; font-size: 1pt; line-height: 1pt; margin-top: 0pt; margin-bottom: 0; margin-right: 0pt; ">&#8203;</P>
