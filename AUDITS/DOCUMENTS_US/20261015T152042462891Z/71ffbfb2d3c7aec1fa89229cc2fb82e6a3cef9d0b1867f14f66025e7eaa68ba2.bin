            <DIV style="border: 0pt; padding-top: 0pt; top: 42.48pt; left: 42.48pt; padding-left: 0pt; width: 637.2pt; padding-bottom: 0pt; position: absolute; padding-right: 0pt; height: 817.74pt; ">
                <P style="margin-left: 0pt; color: #000000; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 4pt; margin-bottom: 8pt; text-align: right; margin-right: 0pt; "><A name="bcb_bancorp-def14aa261"></A><FONT style="font-weight: bold; "><B>Annex C</B></FONT></P>
                <P style="color: #000000; font-size: 10pt; border-bottom: 1.0pt solid ; margin-right: 0pt; margin-left: 0pt; text-indent: 0pt; font-family: Times New Roman, Times, serif; margin-top: 0pt; margin-bottom: 84pt; text-align: center; "><FONT style="font-weight: bold; "><B>&#160;</B></FONT></P>
                <P style="margin-left: 0pt; text-transform: uppercase; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 4pt; margin-bottom: 8pt; text-align: center; margin-right: 0pt; "><FONT style="font-weight: bold; "><B>BYLAWS</B></FONT></P>
