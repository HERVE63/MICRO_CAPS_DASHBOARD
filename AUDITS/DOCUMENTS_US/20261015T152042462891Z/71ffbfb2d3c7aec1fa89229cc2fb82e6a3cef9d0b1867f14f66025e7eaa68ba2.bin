                            <TD style="border-top: 0pt; padding-top: 1.5pt; border-right: 0pt; border-left: 0pt; padding-left: 0pt; vertical-align: bottom; padding-bottom: 1.5pt; border-bottom: 0pt; padding-right: 0pt; ">
                                <P style="margin-left: 0pt; color: #000000; text-indent: 0pt; font-size: 10pt; font-family: Times New Roman, Times, serif; margin-top: 0; margin-bottom: 0; text-align: center; margin-right: 0pt; "><FONT>9.03%</FONT></P>
