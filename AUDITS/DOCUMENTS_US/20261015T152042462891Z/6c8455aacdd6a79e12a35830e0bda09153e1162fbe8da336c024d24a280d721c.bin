       <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><div><ix:continuation id="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_6" continuedAt="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_7"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p></ix:continuation></div></td>
       <td colspan="2" style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;"><div><ix:continuation id="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_7" continuedAt="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_8"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">2026</span></p></ix:continuation></div></td>
       <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;border-bottom:0.5pt solid #ffffff03;padding-right:0.01in;"><div><ix:continuation id="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_8" continuedAt="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_9"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p></ix:continuation></div></td>
       <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><div><ix:continuation id="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_9" continuedAt="F_acbbd908-50c0-4a1f-91c2-b330fad9f6a8_10"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p></ix:continuation></div></td>
