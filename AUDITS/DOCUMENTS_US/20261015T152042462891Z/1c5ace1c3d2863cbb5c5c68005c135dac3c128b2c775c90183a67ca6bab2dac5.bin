  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td colspan="29" style="font-weight: bold"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><b>Enterprise
    Profitability<sup>(1)</sup></b></span></td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="width: 30%; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">1a. Full-Year
    GAAP Net Income ($M)</span></td><td style="width: 2%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="width: 6%; text-align: right"><span style="font-family: Times New Roman, Times, Serif">25</span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td><td style="width: 2%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="width: 6%; text-align: right"><span style="font-family: Times New Roman, Times, Serif">43.5</span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="width: 2%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
