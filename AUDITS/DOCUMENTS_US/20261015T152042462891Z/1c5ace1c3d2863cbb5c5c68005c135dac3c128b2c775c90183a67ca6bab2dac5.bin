    <td style="padding-bottom: 1pt; width: 1%; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="padding-bottom: 1pt; width: 8%; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">15</span></td><td style="width: 1%; padding-bottom: 1pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td></tr>
