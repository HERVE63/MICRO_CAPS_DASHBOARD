    <td style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_98D_eus-gaap--LesseeOperatingLeaseLiabilityUndiscountedExcessAmount_iNI_pn3n3_di_c20260331_zN27nG60S1Bj" title="Less: present value discount" style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: right">(<ix:nonFraction name="us-gaap:LesseeOperatingLeaseLiabilityUndiscountedExcessAmount" contextRef="AsOf2026-03-31" id="Fact001569" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">9</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1pt; text-align: left">)</td>
