  <tr id="xdx_413_20260331__us-gaap--FiniteLivedIntangibleAssetsByMajorClassAxis__custom--BrandNameIndefiniteLivedMember_zj8MqHV5JkSf" style="font: 10pt Times New Roman, Times, Serif; vertical-align: bottom; background-color: White">
