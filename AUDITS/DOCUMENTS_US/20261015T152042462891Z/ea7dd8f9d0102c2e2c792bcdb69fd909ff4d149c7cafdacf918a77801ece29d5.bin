    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td id="xdx_989_eus-gaap--LesseeOperatingLeaseLiabilityPaymentsDue_iI_pn3n3_c20260331_zPP76e9sJ6de" title="Total minimum lease payments" style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="us-gaap:LesseeOperatingLeaseLiabilityPaymentsDue" contextRef="AsOf2026-03-31" id="Fact001567" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">601</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td>
