t; width: 6.22pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 36.01pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 6.22pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 6.22pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 42.68pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 6.22pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 6.22pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 40.02pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.25pt; width: 5pt;"><div style="font-size: 1pt;">&#8194;</div></td></tr></table></ix:continuation></ix:continuation></div></div><div class="BRDSX_block-frill" style="width: 522pt; margin-top: 12pt; margin-left: 0pt;"><table cellpadding="0" class="BRDSX_gftxt" style="border-spacing: 0; margin-top: 4pt; width: 522pt; margin-left: auto; margin-right: auto;"><tr class="BRDSX_boxspacer"><td style="height: 6pt; width: 237pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 24pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 237pt;"><div style="font-size: 1pt;">&#8194;</div></td></tr><tr><td style="width: 237pt; text-align: left; vertical-align: top;"><div class="BRDSX_unknown" style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; margin-top: 0pt; text-align: right;">Precision BioSciences, Inc.</div></td><td style="width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 24pt; text-align: left; vertical-align: bottom;"><div class="BRDSX_unknown" style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; margin-top: 0pt; text-align: center;">46</div></td><td style="width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 237pt; text-align: left; vertical-align: bottom;"><div class="BRDSX_unknown" style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">2026 Proxy Statement</div></td></tr><tr class="BRDSX_boxspacer"><td style="height: 2.75pt; width: 237pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 24pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 6pt;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 2.75pt; width: 237pt;"><div style="font-size: 1pt;">&#8194;</div></td></tr></table></div></div><div>
