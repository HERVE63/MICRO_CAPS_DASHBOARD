			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">DAVID SOMO</p>
			</td>
		</tr>
		<tr>
			<td style="vertical-align: middle; width: 60%;">&#160;</td>
			<td style="vertical-align: middle; width: 40%;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">President, Chief Executive Officer and Director</p>
			</td>
		</tr>

</tbody></table>

<p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#160;</p>

