<td style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman"><span style="white-space:nowrap">Non-Executive</span> Director Group (4 persons)</p></td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="vertical-align:bottom">$</td>
<td style="vertical-align:bottom;text-align:right">160,000</td>
