  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:InventoryDisclosureTextBlock" id="c3130343" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b><em style="font: inherit;">7.</em> INVENTORIES</b></p>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;text-indent:36pt;">The components of inventories&#160;as of <em style="font: inherit;"> December 31, 2025 </em>and <em style="font: inherit;">2024</em> are summarized as follows:</p>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">&#160;</p>
   <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:ScheduleOfInventoryCurrentTableTextBlock" id="c3130344" escape="true">
