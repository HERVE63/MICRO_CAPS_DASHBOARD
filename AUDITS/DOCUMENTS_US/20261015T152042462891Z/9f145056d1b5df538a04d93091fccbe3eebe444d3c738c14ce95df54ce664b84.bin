						<p class="TCH" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:9pt;font-style:normal;font-variant:normal;font-weight:bold;margin-bottom:0;margin-left:0;margin-right:3pt;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:center;text-indent:0;widows:1;margin-right:0;"><span class="CharOverride-2" style="font-style:normal;font-weight:bold;">Per Share Distribution <br/>Amount Declared</span></p>
					</td>
