ine"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_106">43</a></span></div></td></tr><tr style="height:14pt"><td colspan="3" style="background-color:#dbdbdb;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-indent:18pt"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_109">Stock Ownership Guidelines</a></span></div></td><td colspan="3" style="background-color:#dbdbdb;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_109">43</a></span></div></td></tr><tr style="height:14pt"><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-indent:18pt"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_112">Clawback Policy</a></span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_112">43</a></span></div></td></tr><tr style="height:14pt"><td colspan="3" style="background-color:#dbdbdb;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">PROPOSAL THREE: NON-BINDING ADVISORY VOTE ON EXECUTIVE COMPENSATION</span></div></td><td colspan="3" style="background-color:#dbdbdb;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_115">44</a></span></div></td></tr><tr style="height:14pt"><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76045fcb52888af7399feb4_118">EQUITY COMPENSATION PLAN INFORMATION</a></span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i8b1ef46fd76