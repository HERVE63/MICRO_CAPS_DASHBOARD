e:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">2,460,948&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/></tr><tr style="height:12pt"><td colspan="6" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-style:italic;font-weight:400;line-height:120%">President</span></td><td colspan="3" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">2025</span></td><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">477,405&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">629&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">2,119,967&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">451,148&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">14,692&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td style="padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">$</span></td><td style="padding:1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">3,063,841&#160;</span></td><td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/></tr><tr style="height:12pt"><td colspan="6" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:8pt;font-weight:400;line-height:120%">William Grant III</span></td><td colspan="3" style="background-col