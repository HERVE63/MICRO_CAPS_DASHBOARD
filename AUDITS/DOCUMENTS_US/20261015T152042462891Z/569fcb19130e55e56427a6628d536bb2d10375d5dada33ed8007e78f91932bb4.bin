    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_90D_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsRiskFreeInterestRateMinimum_dp_c20260101__20260630_zzBpwlFNWGn4" title="Risk free interest rate - 5 years"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsRiskFreeInterestRateMinimum" contextRef="From2026-01-01to2026-06-30" id="Fact001307" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">3.94</ix:nonFraction></span>%</td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: justify">Risk free interest rate - 10 years</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_906_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsRiskFreeInterestRateMaximum_dp_c20260101__20260630_zK7PLJ7Gx2l5" title="Risk free interest rate - 10 years"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsRiskFreeInterestRateMaximum" contextRef="From2026-01-01to2026-06-30" id="Fact001309" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">4.43</ix:nonFraction></span>%</td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(238,238,238)">
    <td style="text-align: justify">Dividend yield</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span id="xdx_90F_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedDividendRate_dp_c20260101__20260630_z4006B78YZ8d" title="Dividend yield"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedDividendRate" contextRef="From2026-01-01to2026-06-30" id="Fact001311" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">0.00</ix:nonFraction></span>%</td><td style="text-align: left">&#160;</td></tr>
  </table>


</ix:nonNumeric><p id="xdx_8A9_zUT0UKxKXWxd" style="font: 10pt Times New Roman, Times, Serif; margin: 0pt 0; text-align: justify">&#160;</p>

