    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c529" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InterestPayableCurrentAndNoncurrent" scale="3" unitRef="usd" id="ixv-21655">2,460</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
