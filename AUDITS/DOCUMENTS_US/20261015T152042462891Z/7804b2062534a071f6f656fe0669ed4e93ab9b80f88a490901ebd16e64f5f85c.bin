<td style="vertical-align:top"><span style="color:#050505"><span style="font-weight:bold">&#8195;SITE Centers Corp.</span></span><span style="color:#4b4b4b"><span style="font-style:italic">&#8199;</span><span style="font-family:Times New Roman;color:#696969"><span style="FONT-FAMILY:SYMBOL">&#239;</span></span><span style="color:#4b4b4b"><span style="font-style:italic"></span></span><span style="font-style:italic">&#8199;2026 Proxy Statement</span></span><span style="color:#050505"><span style="font-weight:bold">&#8195;</span></span></td></tr></table>

