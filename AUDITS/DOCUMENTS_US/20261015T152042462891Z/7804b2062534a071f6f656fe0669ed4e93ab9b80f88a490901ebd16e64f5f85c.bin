<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:right"><span style="font-family:Calibri Light;color:#050505">1,800,017</span></td>
<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;white-space:nowrap;vertical-align:bottom"/>
