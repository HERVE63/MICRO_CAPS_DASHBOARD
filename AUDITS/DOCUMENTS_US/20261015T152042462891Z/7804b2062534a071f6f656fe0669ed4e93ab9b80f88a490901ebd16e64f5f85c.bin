<td colspan="4" style="padding-bottom:2pt ;vertical-align:bottom;text-align:center"> <p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt; font-family:Calibri;text-align:center"><span style="font-family:Calibri;color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">AMOUNT AND NATURE OF</span></span></span></p> <p style="margin-top:0pt; margin-bottom:1pt; font-size:9pt; font-family:Calibri;text-align:center"><span style="font-family:Calibri;color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">BENEFICIAL</span><span style="color:#ffffff">&#160;OWNERSHIP&#160;</span><span style="color:#ffffff">OF</span><span style="color:#ffffff">&#160;COMMON</span><span style="color:#ffffff">&#160;SHARES</span></span></span></p></td>
