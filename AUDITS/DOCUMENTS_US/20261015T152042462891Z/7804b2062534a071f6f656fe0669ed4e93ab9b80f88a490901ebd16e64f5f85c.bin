<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:right"><span style="font-family:Calibri Light;color:#050505">2018</span></td>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:center"><span style="font-family:Calibri Light;color:#050505">Yes</span></td>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:center"><span style="font-family:Calibri Light;color:#050505"><span style="font-family:Times New Roman;color:#050505">&#10004;</span></span></td>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:center"><span style="font-family:Calibri Light;color:#050505">Chair</span></td>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
<td style="padding-bottom:3pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:center"><span style="font-family:Calibri Light;color:#050505"><span style="font-family:Times New Roman;color:#050505">&#10004;</span></span></td>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
