<td style="padding-bottom:2pt ;BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom;text-align:right"><span style="font-family:Calibri Light;color:#050505">675,000</span></td>
<td style="padding-bottom:2pt ;BORDER-BOTTOM:0.75pt solid #050505;white-space:nowrap;vertical-align:bottom"/>
<td style=" BORDER-BOTTOM:0.75pt solid #050505;vertical-align:bottom">&#160;&#160;</td>
