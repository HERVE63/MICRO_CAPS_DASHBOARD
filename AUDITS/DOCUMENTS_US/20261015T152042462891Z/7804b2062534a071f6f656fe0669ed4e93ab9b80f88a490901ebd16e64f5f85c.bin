<td style="BORDER-LEFT:0.75pt solid #e22382; padding-left:8pt;vertical-align:bottom"> <p style=" margin-top:0pt ; margin-bottom:0pt; font-family:Calibri; font-size:8pt;text-align:justify"><span style="font-family:Calibri;color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">NAME</span><span style="color:#ffffff">&#160;AND</span><span style="color:#ffffff">&#160;PRINCIPAL</span><span style="color:#ffffff">&#160;POSITION</span></span></span></p></td>
