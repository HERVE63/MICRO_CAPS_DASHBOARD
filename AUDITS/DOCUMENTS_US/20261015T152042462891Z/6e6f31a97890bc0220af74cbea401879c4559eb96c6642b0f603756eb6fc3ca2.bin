<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>

<table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;">

		<tbody><tr style="vertical-align: top;">
			<td style="width: 36pt; vertical-align: top;">
			<p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;">(1)</p>
			</td>
			<td style="width: auto;">
			<p style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">Audit fees consist of billed and unbilled fees for professional services rendered for the audit of Apyx&#8217;s annual financial statements and reviews of its interim consolidated financial statements included in quarterly reports and other services related to statutory and regulatory filings or engagements.</p>
			</td>
		</tr>

</tbody></table>

<table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;">

