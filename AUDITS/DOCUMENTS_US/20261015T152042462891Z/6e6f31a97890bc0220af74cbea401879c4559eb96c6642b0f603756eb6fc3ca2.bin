			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">Electromed, Inc.</p>
			</td>
			<td style="border-bottom: 1px solid rgb(0, 0, 0); vertical-align: top; width: 33%;">Utah Medical Products, Inc.</td>
		</tr>
		<tr style="background-color: rgb(204, 238, 255);">
			<td style="border-bottom: 1px solid rgb(0, 0, 0); vertical-align: top; width: 34%; border-left: 1px solid black; border-right: 1px solid black;">Neuronetics, Inc.</td>
