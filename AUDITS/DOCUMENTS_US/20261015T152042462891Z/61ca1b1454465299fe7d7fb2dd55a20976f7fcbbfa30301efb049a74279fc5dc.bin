nedContributionPlanCostRecognized" scale="6" id="f-2493">36.4</ix:nonFraction> million in the years ended December 31, 2025, 2024, and 2023, respectively.</span></div></ix:continuation><div style="height:36pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="margin-top:9pt;text-align:center;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">F-56</span></div></div></div><div id="if5186a3dc11d4fd3bff2957bff6646b9_211"></div><hr style="page-break-after:always"/><div style="min-height:36pt;width:100%"><div style="margin-top:9pt"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#if5186a3dc11d4fd3bff2957bff6646b9_19">Back to top</a></span></div></div><div style="margin-top:12pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Note 27. <ix:nonNumeric contextRef="c-1" name="us-gaap:CashFlowSupplementalDisclosuresTextBlock" id="f-2494" continuedAt="f-2494-1" escape="true">Supplemental Cash Flow Information</ix:nonNumeric></span></div><ix:continuation id="f-2494-1"><ix:continuation id="f-1453-1"><div style="margin-top:6pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:58.483%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.233%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.494%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.233%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.494%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.263%"/><td st