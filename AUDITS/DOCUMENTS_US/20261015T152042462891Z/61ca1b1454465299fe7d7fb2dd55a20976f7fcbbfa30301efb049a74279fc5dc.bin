om:0;position:absolute;width:100%"><div style="margin-top:9pt;text-align:center;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">F-22</span></div></div></div><hr style="page-break-after:always"/><div style="min-height:36pt;width:100%"><div style="margin-top:9pt"><span style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline" href="#if5186a3dc11d4fd3bff2957bff6646b9_19">Back to top</a></span></div></div><ix:continuation id="f-891-2"><ix:nonNumeric contextRef="c-1" name="us-gaap:ScheduleOfProductWarrantyLiabilityTableTextBlock" id="f-894" escape="true"><div style="margin-top:9pt;text-indent:36pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">An analysis of our warranty liability is as follows:</span></div><div style="margin-top:6pt;text-align:center"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:58.816%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.214%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.354%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.214%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.354%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.248%"/><td style="width:0.1%"/></tr><tr><td colspan="3" style="padding:0 1pt"/><td colspan="15" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:100%">Year Ended December 31,</span></td></tr><tr><td colspan="3" style="padd