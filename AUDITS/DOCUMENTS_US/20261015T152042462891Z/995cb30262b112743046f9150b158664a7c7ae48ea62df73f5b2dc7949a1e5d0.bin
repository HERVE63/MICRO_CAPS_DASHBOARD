  <div class="fixed-width-container" style="margin-left:auto;padding-left:0.5in;width:7.25in;box-sizing:content-box;margin-right:auto;padding-right:0.5in;"><div style="padding-top:0.5in;z-index:2;min-height:0.75in;position:relative;box-sizing:border-box;"><p style="font-size:10pt;margin-top:10pt;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:8pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></div></div>
  <div class="main-content-container" style="z-index:5;position:relative;"><div class="fixed-width-container" style="margin-left:auto;padding-left:0.5in;width:7.25in;box-sizing:content-box;margin-right:auto;padding-right:0.5in;"><h2 style="font-size:35pt;margin-top:0;font-family:DM Sans;margin-bottom:6pt;text-align:left;" id="executive_officers"><span style="color:#180e44;white-space:pre-wrap;font-size:35pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Executiv</span><span style="color:#180e44;white-space:pre-wrap;font-size:35pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">e Officers</span></h2><p style="text-indent:36pt;font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Below is biographical information for each of our current executive officers as of April 1, 2026, other than Travis Hess (whose biographical information is shown under &#8220;Class I Directors&#8221; on page 9). Each executive officer serves at the discretion of the Board of Directors and the Chief Executive Officer.</span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;"> </span></p><p style="text-indent:36pt;font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p>
    <table style="border-spacing:0;table-layout:auto;width:100.0%;border-collapse:separate;">
     <tr style="background-color:#ffffff;font-weight:bold;visibility:collapse;">
      <td style="width:30%;box-sizing:content-box;"/>
