      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
     </tr>
     <tr style="background-color:#5e62ac;white-space:pre-wrap;word-break:break-word;text-align:left;">
      <td style="padding-top:0.01in;text-indent:1pt;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="margin-left:1pt;text-indent:0;font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td colspan="2" style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td colspan="2" style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:1pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
