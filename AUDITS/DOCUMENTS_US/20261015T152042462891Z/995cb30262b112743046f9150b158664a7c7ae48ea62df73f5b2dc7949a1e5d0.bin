      <td colspan="2" style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">2025 Base <br/>Salary</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:12pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td colspan="2" style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">2024 Base <br/>Salary</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:12pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
