      <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:8pt;margin-top:2pt;font-family:DM Sans;margin-bottom:2pt;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Pay Element</span></p></td>
      <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:8pt;margin-top:2pt;font-family:DM Sans;margin-bottom:2pt;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:8pt;margin-top:2pt;font-family:DM Sans;margin-bottom:2pt;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Key Features</span></p></td>
      <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:8pt;margin-top:2pt;font-family:DM Sans;margin-bottom:2pt;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:8pt;margin-top:2pt;font-family:DM Sans;margin-bottom:2pt;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Objective</span></p></td>
     </tr>
     <tr style="height:8pt;white-space:pre-wrap;word-break:break-word;text-align:left;">
