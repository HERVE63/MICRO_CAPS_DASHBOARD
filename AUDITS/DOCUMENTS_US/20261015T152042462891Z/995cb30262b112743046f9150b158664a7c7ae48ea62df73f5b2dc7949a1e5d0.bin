     <tr style="height:9pt;white-space:pre-wrap;word-break:break-word;text-align:left;">
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><img src="img154241600_7.jpg" alt="img154241600_7.jpg" style="width:329px;height:190px;"/></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
      <td style="padding-top:0.01in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:9pt;margin-top:6pt;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#180e44;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Who Can Vote</span></p><p style="font-size:9pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Only owners of record of the Company&#8217;s issued and outstanding Common Stock as of the close of business on March 19, 2026. Each share of Common Stock is entitled to one vote.</span></p><p style="font-size:9pt;margin-top:12pt;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#180e44;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Number of Shares Outstanding as of Record Date</span></p><p style="font-size:9pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">82,316,230 shares of Common Stock</span></p></td>
     </tr>
    </table><p style="font-size:12pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p></div></div>
  <div class="fixed-width-container" style="margin-left:auto;padding-left:0.5in;width:7.25in;margin-top:auto;box-sizing:content-box;margin-right:auto;padding-right:0.5in;"><div style="z-index:2;flex-direction:column;display:flex;padding-bottom:0.36in;min-height:0.25in;justify-content:flex-end;position:relative;box-sizing:border-box;"><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:6pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><img src="img154241600_8.jpg" alt="img154241600_8.jpg" style="width:696px;height:39px;"/></p><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:6pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></div></div>
