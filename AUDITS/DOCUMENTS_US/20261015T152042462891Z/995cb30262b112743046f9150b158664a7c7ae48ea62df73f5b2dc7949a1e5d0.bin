xtRef="C_57894cb3-0e9e-4399-a3c8-b000f39c1759" name="ecd:MeasureName"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Adjusted EBITDA</span></ix:nonNumeric></span></div></div><div class="item-list-element-wrapper" style="margin-left:0.5in;display:flex;margin-top:10pt;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:0.25in;text-align:left;"><span style="color:#bad532;white-space:pre-wrap;font-size:12pt;font-family:Times New Roman;font-kerning:none;min-width:3.7034252387141127%;word-break:keep-all;display:inline-flex;justify-content:flex-start;">&#8226;</span><div style="display:inline;"><span style="font-size:9pt;font-family:'DM Sans',serif;"><ix:nonNumeric id="F_d4a0b2b0-3dd9-4187-8ebf-c3f817c46131" contextRef="C_2c9d8d29-d8ac-4378-b707-e5a862903057" name="ecd:MeasureName"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Annual revenue run-rate growth</span></ix:nonNumeric></span></div></div><div class="item-list-element-wrapper" style="margin-left:0.5in;display:flex;margin-top:10pt;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:0.25in;text-align:left;"><span style="color:#bad532;white-space:pre-wrap;font-size:12pt;font-family:Times New Roman;font-kerning:none;min-width:3.7034252387141127%;word-break:keep-all;display:inline-flex;justify-content:flex-start;">&#8226;</span><div style="display:inline;"><span style="font-size:9pt;font-family:'DM Sans',serif;"><ix:nonNumeric id="F_87d1fd73-aeb2-471c-a720-d86d91fb360b" contextRef="C_8652110d-9ed1-4fe1-b225-6bff53035a38" name="ecd:MeasureName"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Total shareholder return</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;"> </span></div></div></ix:nonNumeric></div><p style="text-indent:36pt;font-size:10pt;margin-top:10pt;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">For additional details regarding our most important financial performance measures, please see the sections titled </span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-style:italic;font-kerning:none;min-width:fit-content;">&#8220;2025 Compensation Highlights&#8221;</span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;"> and </span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-style:italic;font-kerning:none;min-width:fit-content;">&#8220;Cash Incentive Compensation&#8221;</span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;"> in our Compensation Discussion and Analysis (CD&amp;A) elsewhere in this Proxy Statement.</span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;"> </span></p></ix:continuation></div></div></div>
