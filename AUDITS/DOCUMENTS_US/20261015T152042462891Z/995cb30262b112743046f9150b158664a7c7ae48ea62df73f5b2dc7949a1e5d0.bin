      <td style="padding-top:0.01in;white-space:nowrap;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;text-align:left;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
