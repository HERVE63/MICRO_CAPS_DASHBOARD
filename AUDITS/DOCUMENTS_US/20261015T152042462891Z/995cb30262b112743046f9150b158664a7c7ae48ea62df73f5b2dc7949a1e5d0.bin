     <tr style="height:8pt;white-space:pre-wrap;word-break:break-word;text-align:left;">
      <td style="background-color:#5e62ac;padding-top:0.04in;padding-left:0in;vertical-align:middle;padding-bottom:0.04in;padding-right:0.01in;"><p style="font-size:8pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
