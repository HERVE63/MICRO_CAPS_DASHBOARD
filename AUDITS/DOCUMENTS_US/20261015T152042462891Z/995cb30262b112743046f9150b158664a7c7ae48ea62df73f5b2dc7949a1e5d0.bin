      <td colspan="2" style="padding-top:0in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;border-bottom:1pt solid #5e62ac;padding-right:0in;"><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:3pt;text-align:left;"><span style="color:#5e62ac;white-space:pre-wrap;font-weight:bold;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">Proposals</span></p></td>
