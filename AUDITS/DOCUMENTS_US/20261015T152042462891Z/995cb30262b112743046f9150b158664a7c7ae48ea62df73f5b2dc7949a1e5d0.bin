  <div class="fixed-width-container" style="margin-left:auto;padding-left:0.5in;width:7.25in;margin-top:auto;box-sizing:content-box;margin-right:auto;padding-right:0.5in;"><div style="z-index:2;flex-direction:column;display:flex;padding-bottom:0.36in;min-height:0.3in;justify-content:flex-end;position:relative;box-sizing:border-box;"><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:6pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><img src="img154241600_42.jpg" alt="img154241600_42.jpg" style="width:696px;height:40px;"/></p><p style="font-size:10pt;margin-top:0;font-family:DM Sans;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:6pt;font-family:'DM Sans',serif;font-kerning:none;min-width:fit-content;">&#160;</span></p></div></div>
