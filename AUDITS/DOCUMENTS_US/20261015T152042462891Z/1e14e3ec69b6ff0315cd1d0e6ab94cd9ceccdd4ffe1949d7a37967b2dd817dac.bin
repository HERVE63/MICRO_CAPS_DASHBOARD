="text-align: right;"><ix:nonFraction name="us-gaap:InterestReceivableCurrent" contextRef="cref_1849970678" unitRef="uref_82683962" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-8912">42,737</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><ix:nonFraction name="us-gaap:InterestReceivableCurrent" contextRef="cref_546829070" unitRef="uref_82683962" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-8913">25,223</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> </tr><tr style="vertical-align: bottom; background-color: White;"> <td style="padding-left: 0.125in; text-align: left;">Promissory note receivable, net of discount</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><ix:nonFraction name="us-gaap:AccountsNotesAndLoansReceivableNetCurrent" contextRef="cref_1849970678" unitRef="uref_82683962" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-8914">400,000</ix:nonFraction></td> <td style="text-align: left;">&#160;</td> <td>&#160;</td> <td style="text-align: left;">&#160;</td> <td style="text-align: right;"><span style="-sec-ix-hidden:fc_1973076563;">-</span></td> <td style="text-align: left;">&#160;</td> </tr><tr style="vertical-align: bottom; background-color: rgb(204,238,255);"> <td style="padding-left: 0.125in; text-align: left; padding-bottom: 1.5pt;">Short-term investments</td> <td style="padding-bottom: 1.5pt;">&#160;</td> <td style="border-bottom: Black 1.5pt solid; text-align: left;">&#160;</td> <td style="border-bottom: Black 1.5pt solid; text-align: right;"><ix:nonFraction name="us-gaap:ShortTermInvestments" contextRef="cref_1849970678" unitRef="uref_82683962" scale="0" decimals="0" format="ixt:num-dot-decimal" id="ixv-8915">19,929,164</ix:nonFraction></td> <td style="padding-bottom: 1.5pt; text-align: left;">&#160;</td> <td style="padding-bottom: 1.5pt;">&#160;</td>