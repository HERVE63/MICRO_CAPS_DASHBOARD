l;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_823841f8-3c81-4d57-b8eb-98d36f586fe1" contextRef="C_1f7e4386-eae3-4fcf-a98d-392805d399c3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">4.88</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_33f85e38-b2b1-4011-967a-ceaecfd82711" contextRef="C_0f94f724-30b0-4397-81da-b4c014f9a22e" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">6.88</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">% and </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_e0a9064a-475e-4dea-ac85-5c4209679276" contextRef="C_630dc93a-e36f-4f80-8e3f-db6e35a40d57" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">4.78</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">% to </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_d3c2d921-749e-4a8d-a3f7-41994981cc9c" contextRef="C_c66d42c1-0391-40f3-b298-f24fc1fb18f5" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">6.88</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">%, respectively, and the weighted average interest rates were </span><span style="font-size:10pt;font-family:Arial;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_23a00a18-f490-4466-8a2c-99d261696742" contextRef="C_d89d13b9-b1df-486a-9278-ee383d43f568" name="us-gaap:DebtWeightedAverageInterestRate" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal"><ix:nonFraction id="F_41b4056d-17e0-416b-9f76-fc4207a724bc" contextRef="C_23f9f56e-6386-4259-8ec8-bafd4c73e57d" name="us-gaap:DebtWeightedAverageInterestRate" unitRef="U_pure" scale="-2" decimals="4" format="ixt:num-dot-decimal">6.01</ix:nonFraction></ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">%. </span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Arial;font-kerning:none;min-width:fit-content;">Expected principal payments due under investment agreements in each of the next five years ending December 31, and thereafter, based upon contractual maturity dates, are as follows:</span></p><div style="font-size:10pt;font-family:Arial;"><ix:nonNumeric id="F_dd108796-6562-43b9-9ef3-f1bd64e7ea72" contextRef="C_94b559e1-722d-431f-a464-3bd7e7523f59" name="mbi:ExpectedPrincipalPaymentsDueUnderInvestmentAgreementsTableTextBlock" escape="true">
