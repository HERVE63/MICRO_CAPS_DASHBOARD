  <div style="padding-top:0.5in;z-index:2;min-height:0.5in;position:relative;box-sizing:border-box;"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p></div>
  <div class="main-content-container" style="z-index:5;position:relative;"><div><ix:continuation id="F_c92b5ae6-7400-45ee-a422-2156c9dfae5b_1"><p style="tab-size:26.66px;font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">lease costs were immaterial for the three and six months ended August 1, 2026 and August 2, 2025</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">. </span><span style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_b50abaf5-8052-4cac-8f15-f25f1989aab9" contextRef="C_9d7d1918-f951-47d2-b00b-ef3f51a1a4a1" name="us-gaap:LeaseCostTableTextBlock" escape="true" continuedAt="F_b50abaf5-8052-4cac-8f15-f25f1989aab9_1"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">The Company's lease cost is comprised of the following:</span></ix:nonNumeric></span></p><div style="font-size:11pt;font-family:'Calibri',sans-serif;"><ix:continuation id="F_b50abaf5-8052-4cac-8f15-f25f1989aab9_1"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
