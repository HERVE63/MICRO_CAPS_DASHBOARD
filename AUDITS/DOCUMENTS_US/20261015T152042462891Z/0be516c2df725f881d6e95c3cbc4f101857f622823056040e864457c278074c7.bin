eight:120%">405,069</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">99,654</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">4,040</span></td></tr><tr><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Non-Executive Director Group</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">120,000</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td></tr><tr><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Each Nominee for Election as a Director Group</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">328,555</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">97,352</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">4,040</span></td></tr><tr><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Each associate of any such directors, executive officers or nominees</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td><td colspan="3" style="background-color:#e6e7e8;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td></tr><tr><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Each other person received or is to receive 5% of such options, warrants or rights</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">&#8212;</span></td></tr><tr><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:2px 1pt;text-align:left;vertical-align:top"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Non-Executive Officer Employee Group</span></td><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">410,484</span></td><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">22,328</span></td><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid #c02026;padding:0 1pt"/><td colspan="3" style="background-color:#e6e7e8;border-bottom:1pt solid 