    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; text-align: right"><ix:nonFraction name="us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax" contextRef="From2024-01-012024-12-31_custom_DisposablesServiceAndAccessoriesMember" id="Fact000646" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">18,286</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">&#160;</td></tr>
