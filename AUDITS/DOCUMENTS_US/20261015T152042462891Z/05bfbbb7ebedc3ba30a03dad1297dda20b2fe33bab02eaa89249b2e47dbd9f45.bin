    <td style="text-align: left">$</td><td style="text-align: right">(<ix:nonFraction name="us-gaap:EarningsPerShareBasic" contextRef="From2024-01-012024-12-31" id="Fact001637" format="ixt:numdotdecimal" decimals="INF" sign="-" unitRef="USDPShares">0.30</ix:nonFraction></td><td style="text-align: left">)</td></tr>
