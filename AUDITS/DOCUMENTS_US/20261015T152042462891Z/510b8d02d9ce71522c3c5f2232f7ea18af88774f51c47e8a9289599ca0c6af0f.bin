     <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;text-align:left;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:8pt;font-kerning:none;min-width:fit-content;">Smaller reporting company </span><span style="font-size:8pt;"><ix:nonNumeric id="F_05a29231-9554-46e1-beaf-63b40b5dbec9" contextRef="C_5d56aa0d-11c4-4c3f-9c14-a792660af13c" name="dei:EntitySmallBusiness" format="ixt-sec:boolballotbox"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#9746;</span></ix:nonNumeric></span></p></td>
