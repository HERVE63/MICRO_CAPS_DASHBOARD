<tr style="background-color: rgb(255, 255, 255); vertical-align: bottom"><td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;">Other mineral properties</p> </td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c147082460" contextRef="i_2026-06-30_PropertyPlantAndEquipmentByTypeAxis-OtherMineralPropertiesMember" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:fixed-zero" decimals="INF">&#8212;</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c147082461" contextRef="i_2025-12-31_PropertyPlantAndEquipmentByTypeAxis-OtherMineralPropertiesMember" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:num-dot-decimal" decimals="INF">317,405</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt;">&#160;</td></tr>
<tr style="background-color: rgb(204, 238, 255); vertical-align: bottom"><td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;">Water rights</p> </td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 1px;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; border-bottom: 1px solid rgb(0, 0, 0);">&#160;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);"><ix:nonFraction id="c147082462" contextRef="i_2026-06-30_PropertyPlantAndEquipmentByTypeAxis-WaterRightsMember" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:num-dot-decimal" decimals="INF">730,597</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 1px;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; border-bottom: 1px solid rgb(0, 0, 0);">&#160;</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);"><ix:nonFraction id="c147082463" contextRef="i_2025-12-31_PropertyPlantAndEquipmentByTypeAxis-WaterRightsMember" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:num-dot-decimal" decimals="INF">820,595</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);">&#160;</td></tr>
<tr style="background-color: rgb(255, 255, 255); vertical-align: bottom"><td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt 0pt 0pt 9pt;">Total mineral rights and properties</p> </td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 3px;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">$</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"><ix:nonFraction id="c147082464" contextRef="i_2026-06-30" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:num-dot-decimal" decimals="INF">730,597</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 3px;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">$</td><td style="width: 12%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"><ix:nonFraction id="c147082465" contextRef="i_2025-12-31" unitRef="USD" name="us-gaap:MineralPropertiesNet" scale="0" format="ixt:num-dot-decimal" decimals="INF">11,980,716</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">&#160;</td></tr>
</tbody></table>
   </ix:nonNumeric>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">The Comstock Mineral Estate includes all of the Company's resource areas and exploration targets. During the <em style="font: inherit;">six</em>-months ended <em style="font: inherit;"> June 30, 2026 </em>and <em style="font: inherit;">2025</em>, we did <span style="-sec-ix-hidden:c147082386"><span style="-sec-ix-hidden:c147082423">not</span></span> record any depletion expense, as <em style="font: inherit;">none</em> of the mineral properties are currently in production. Our mineral exploration and mining lease payments are classified as selling, general and administrative expenses in the condensed consolidated statements of operations.</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">On <em style="font: inherit;"> December 18, 2024 </em>and amended on <em style="font: inherit;"> June 6, 2025,&#160;</em>the Company executed a membership interest purchase agreement (the &#8220;Mackay MIPA&#8221;) with Mackay Precious Metals Inc. (&#8220;Mackay&#8221;) pursuant to which the Company sold all of its right, title, and interest in its wholly owned subsidiary&#160;Comstock Northern Exploration LLC, and the Company's <em style="font: inherit;">25%</em> interest in Pelen Limited Liability Company (&#8220;Pelen&#8221;), for an aggregate purchase price of $<ix:nonFraction id="c147082389" contextRef="i_2025-06-06_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-BindingMipaWithMackayMember" unitRef="USD" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationConsideration" scale="0" format="ixt:num-dot-decimal" decimals="INF">2,950,000</ix:nonFraction>.&#160;Pursuant to a royalty agreement&#160;between the Company and Mackay, dated <em style="font: inherit;"> December 18, 2024 (</em>the &#8220;Mackay&#160;Royalty Agreement&#8221;) the Company was&#160;to receive&#160;a <ix:nonFraction id="c147082390" contextRef="i_2024-12-18_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-BindingMipaWithMackayMember" unitRef="Pure" name="lode:RoyaltyFeePercentage" scale="-2" format="ixt:num-dot-decimal" decimals="3">1.5</ix:nonFraction>% royalty of Net Smelter Returns&#160;(as such term is defined in the Mackay Royalty Agreement) (&#8220;NSR&#8221;).&#160;On <em style="font: inherit;"> January 9, 2026, </em>the Company and Mackay entered into a&#160;Royalty Purchase and Sale Agreement, wherein the Company sold&#160;to Mackay <ix:nonFraction id="c147082391" contextRef="i_2026-01-09_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-NsrRoyaltyAgreementMember" unitRef="Pure" name="lode:DisposalGroupPercentageOfRightTitleAndInterestSold" scale="-2" format="ixt:num-dot-decimal" decimals="0">100</ix:nonFraction>% of the Company&#8217;s right, title, and interest in and to a <ix:nonFraction id="c147082392" contextRef="i_2026-01-09_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-NsrRoyaltyAgreementMember" unitRef="Pure" name="lode:RoyaltyFeePercentage" scale="-2" format="ixt:num-dot-decimal" decimals="3">1.5</ix:nonFraction>% net smelter returns&#160;royalty covering certain patented and unpatented mining&#160;claims and leased properties located in Storey County, Nevada, for an aggregate purchase&#160;price of $<ix:nonFraction id="c147082393" contextRef="i_2026-01-09_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-NsrRoyaltyAgreementMember" unitRef="USD" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationConsideration" scale="6" format="ixt:num-dot-decimal" decimals="-5">1.1</ix:nonFraction> million, all of which was received on or before <em style="font: inherit;"> January 20,&#160;</em><em style="font: inherit;">2026.</em>&#160;On <em style="font: inherit;"> February 22, 2026, </em>the Company agreed to a minor modification to the non-compete language associated with the prior purchase of properties by Mackay and received an additional $<ix:nonFraction id="c147082395" contextRef="i_2026-02-22_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-NsrRoyaltyAgreementFebruary2026AmendmentMember" unitRef="USD" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationConsideration" scale="0" format="ixt:num-dot-decimal" decimals="INF">300,000</ix:nonFraction> in consideration from Mackay. During the <em style="font: inherit;">six</em>-months ended <em style="font: inherit;"> June 30, 2026</em>, the Company recognized a total gain on sale of royalty rights of $<ix:nonFraction id="c147082397" contextRef="d_2026-01-01_2026-03-31" unitRef="USD" name="lode:GainLossOnSaleOfRoyaltyRights" scale="0" format="ixt:num-dot-decimal" decimals="INF">1,400,010</ix:nonFraction> in the condensed consolidated statements&#160;of operations.&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><i>Assets and Liabilities Held for Sale</i>&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">In the <em style="font: inherit;">first</em> quarter of <em style="font: inherit;">2026,</em> the Company committed a plan to sell the mining assets and related mining entities.&#160;On <em style="font: inherit;"> June 21, 2026, </em>the Company&#160;entered into a Securities Purchase Agreement (the &#8220;Purchase Agreement&#8221;) with Mackay&#160;and Mackay Gold &amp; Silver Corp., a British Columbia corporation (&#8220;Mackay Parent&#8221;), pursuant to which the Company agreed to sell all of its rights, titles, and interest in and to the membership interests in Comstock Mining LLC, Comstock Processing LLC, and Comstock Exploration and Development LLC (each a Nevada limited liability company), and all of the issued and outstanding shares of capital stock of Comstock Real Estate Inc., a Nevada corporation whose primary asset is the Gold Hill Hotel that resides within the boundaries of the Comstock mining district (collectively, the &#8220;Acquired Interests&#8221;), to Mackay. The entities whose interests comprise the Acquired Interests (collectively, the &#8220;Acquired Entities&#8221;) own or control properties in Lyon County and Storey County, Nevada. This sale does <em style="font: inherit;">not</em> include the Company&#8217;s real estate in Silver Springs, Nevada.&#160;<br/> &#160;<br/> The aggregate purchase price for the Acquired Interests consists of the following:&#160; &#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <table border="0" cellpadding="0" cellspacing="0" style="width:100%;font-family:Times New Roman;font-size:10pt;"><tbody><tr><td style="width: 28px; text-align: justify; vertical-align: top;">&#8226;</td><td style="vertical-align: top; width: 2650px; text-align: justify;"> <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt;">$<ix:nonFraction id="c147082401" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationConsideration" scale="0" format="ixt:num-dot-decimal" decimals="INF">20,000,000</ix:nonFraction> in cash (the &#8220;Initial Payment&#8221;);</p> </td></tr>
</tbody></table>
   <table border="0" cellpadding="0" cellspacing="0" style="width:100%;font-family:Times New Roman;font-size:10pt;"><tbody><tr><td style="width: 29px; text-align: justify; vertical-align: top;">&#8226;</td><td style="vertical-align: top; width: 2649px;"> <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;"><ix:nonFraction id="c147082402" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="Share" name="lode:DisposalGroupIncludingDiscontinuedOperationConsiderationShares" scale="0" format="ixt:num-dot-decimal" decimals="INF">2,000,000</ix:nonFraction> shares of Mackay Parent common stock;</p> </td></tr>
<tr><td style="width: 29px; text-align: justify; vertical-align: top;">&#8226;</td><td style="vertical-align: top; width: 2649px; text-align: justify;">$<ix:nonFraction id="c147082403" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:DisposalGroupIncludingDiscontinuedOperationsReceivable" scale="0" format="ixt:num-dot-decimal" decimals="INF">7,000,000</ix:nonFraction> payable within <em style="font: inherit;">eighteen</em> (<ix:nonNumeric contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" name="lode:DisposalGroupIncludingDiscontinuedOperationReceivableTerm" id="c147082405" format="ixt-sec:durmonth">18</ix:nonNumeric>) months following the Effective Date (the &#8220;Second Tranche Payment&#8221;), which <em style="font: inherit;"> may </em>be paid partially in shares (up to $<ix:nonFraction id="c147082406" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:DisposalGroupIncludingDiscontinuedOperationMaximumValueOfSharesReceivable" scale="6" format="ixt:num-dot-decimal" decimals="-6">2</ix:nonFraction> million in total consideration) of Mackay Parent common stock under certain conditions based on the volume-weighted average trading price of Mackay Parent&#8217;s common stock;</td></tr>
<tr><td style="width: 29px; text-align: justify; vertical-align: top;">&#8226;</td><td style="vertical-align: top; width: 2649px; text-align: justify;">Assumption of all of the Acquired Entities reclamation obligations and the associated reclamation and surety bond deposits and collateral; and</td></tr>
<tr><td style="width: 29px; text-align: justify; vertical-align: top;">&#8226;</td><td style="vertical-align: top; width: 2649px; text-align: justify;">A contingent payment of $<ix:nonFraction id="c147082407" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:DisposalGroupIncludingDiscontinuedOperationContingentConsideration" scale="0" format="ixt:num-dot-decimal" decimals="INF">10,000,000</ix:nonFraction> in cash payable if, within <em style="font: inherit;">seven</em> (<ix:nonNumeric contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" name="lode:DisposalGroupIncludingDiscontinuedOperationContingentConsiderationTerm" id="c147082409" format="ixt-sec:duryear">7</ix:nonNumeric>) years after the Closing Date, Mackay or Mackay Parent makes a Construction Decision or a Change of Control occurs (the &#8220;Contingent Payment&#8221;)</td></tr>
</tbody></table>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">The Purchase Agreement also includes a <ix:nonFraction id="c147082410" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="Pure" name="lode:RoyaltyFeePercentage" scale="-2" format="ixt:num-dot-decimal" decimals="3">1.5</ix:nonFraction>% NSR&#160;royalty on minerals produced from the transferred properties, including a Royalty Agreement, and subject to Mackay's repurchase rights under specified conditions. The closing of the transaction is subject to TSX-V stock exchange approvals. Mackay shall have the right at any time to repurchase <ix:nonFraction id="c147082411" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="Pure" name="lode:DisposalGroupIncludingDiscontinuedOperationRoyaltyRepurchaseRightPercentage" scale="-2" format="ixt:num-dot-decimal" decimals="0">100</ix:nonFraction>% of the NSR Royalty for a payment of $<ix:nonFraction id="c147082412" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:DisposalGroupIncludingDiscontinuedOperationRoyaltyRepurchaseRightAmount" scale="0" format="ixt:num-dot-decimal" decimals="INF">3,500,000</ix:nonFraction>, provided that if the <span style="-sec-ix-hidden:c147082413">seven</span>-year period for the payment of the Contingent Payment has lapsed without the payment of the Contingent Payment, the royalty buyout payment shall be increased to $<ix:nonFraction id="c147082415" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:DisposalGroupIncludingDiscontinuedOperationRoyaltyRepurchaseRightAmountLapsedContingentPayment" scale="0" format="ixt:num-dot-decimal" decimals="INF">7,000,000</ix:nonFraction>. The Second Tranche Payment is secured by a Deed of Trust on the properties owned by the Acquired Entities and bears interest at the rate of <em style="font: inherit;">twelve</em> percent (<ix:nonFraction id="c147082417" contextRef="i_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="Pure" name="lode:DisposalGroupIncludingDiscontinuedOperationsReceivableSecuredInterestRate" scale="-2" format="ixt:num-dot-decimal" decimals="2">12</ix:nonFraction>%) per annum after its due date.&#160;A non-refundable deposit of $<ix:nonFraction id="c147082418" contextRef="d_2026-06-21_2026-06-21_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:ProceedsFromDivestitureOfBusinessesNonrefundableDeposits" scale="0" format="ixt:num-dot-decimal" decimals="INF">150,000</ix:nonFraction> previously paid by Buyer is credited against the Initial Payment at Closing.</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">The related assets and liabilities were classified as Held for Sale and $<ix:nonFraction id="c147082419" contextRef="i_2026-06-30_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="us-gaap:AssetsHeldForSaleNotPartOfDisposalGroup" scale="0" format="ixt:num-dot-decimal" decimals="INF">22,992,892</ix:nonFraction> was classified as Assets Held for Sale and&#160;$<ix:nonFraction id="c147082420" contextRef="i_2026-06-30_DisposalGroupClassificationAxis-DisposalGroupHeldforsaleNotDiscontinuedOperationsMember_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis-MackayPurchaseAgreementAcquiredInterestsMember" unitRef="USD" name="lode:LiabilitiesHeldforsaleNotPartOfDisposalGroup" scale="0" format="ixt:num-dot-decimal" decimals="INF">6,832,924</ix:nonFraction> was classified as Liabilities Held for Sale on the condensed consolidated balance sheet as of <em style="font: inherit;"> June 30, 2026</em>.&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
