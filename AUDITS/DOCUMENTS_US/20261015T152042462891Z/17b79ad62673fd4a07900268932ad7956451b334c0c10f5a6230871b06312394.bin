       <td style="width: 12%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: right; padding: 0; margin: 0"><ix:nonNumeric contextRef="d_2026-06-15_2026-06-15_AwardTypeAxis-PerformanceSharesMember" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardFairValueAssumptionsExpectedTerm1" id="c147083221" format="ixt-sec:duryear">3.25</ix:nonNumeric></td>
