gin:0pt;"><b style="font-weight:bold;">2026</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;&#160;&#8203;&#160;&#8203;</p></td><td colspan="2" style="vertical-align:bottom;white-space:nowrap;width:13.23%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2025</b></p></td></tr><tr style=""><td style="vertical-align:bottom;width:69.5%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Land and land development, at cost</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.7%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_QavEdheJL0iS4Zo-XnxLxg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LandAndLandImprovements" scale="3" id="Tc_cZ1Yv62JQEGf2S9IAaCRsQ_4_3">112,040</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.93%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2025_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_0aGCG5QFH0u3c5_JGwAqoA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LandAndLandImprovements" scale="3" id="Tc_oaUjDbFZS0mFOSs5vFZNxA_4_6">123,280</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:69.5%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Less: accumulated depreciation</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.7%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_QavEdheJL0iS4Zo-XnxLxg" decimals="-3" format="ixt:num-dot-decimal" name="stho:RealEstateInvestmentPropertyAccumulatedDepreciationAndAmortization" scale="3" id="Tc_YZf-VFZ730O5VsJhhtzsSg_5_3">10,651</ix:nonFraction>)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.93%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2025_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_0aGCG5QFH0u3c5_JGwAqoA" decimals="-3" format="ixt:num-dot-decimal" name="stho:RealEstateInvestmentPropertyAccumulatedDepreciationAndAmortization" scale="3" id="Tc_2WnfD0JjdUC8sJGbPEMrTw_5_6">10,444</ix:nonFraction>)</p></td></tr><tr style=""><td style="vertical-align:bottom;width:69.5%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Total land and development, net</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.7%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_QavEdheJL0iS4Zo-XnxLxg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InventoryRealEstateLandAndLandDevelopmentCosts" scale="3" id="Tc_Av-MTOz6tUG0NBTycDc54A_6_3">101,389</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.12%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.3%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.93%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2025_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_LandAndLandImprovementsMember_0aGCG5QFH0u3c5_JGwAqoA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InventoryRealEstateLandAndLandDevelopmentCosts" scale="3" id="Tc_wRsNfKnxdk6OYGTsQhOcuw_6_6">112,836</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;"><b style="font-weight:bold;">Dispositions&#8212;</b> During the three and six months ended June 30, 2026, the Company recognized land development revenue of $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_4_1_2026_To_6_30_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_3xhaBLFoWECInwd-bjAfwg" decimals="-5" format="ixt:num-dot-decimal" name="stho:RevenuesAdditionalRevenueRecognizedVariableConsiderationRelatedToPriorSale" scale="6" id="Narr_c95g9q4i5kuT6K3dSI7zpQ">1.2</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2026_To_6_30_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_p8N7n5uooEeQ7Y1zdsHxMg" decimals="-5" format="ixt:num-dot-decimal" name="stho:RevenuesAdditionalRevenueRecognizedVariableConsiderationRelatedToPriorSale" scale="6" id="Narr_raNwLOnUckWEyNIFBnkrlQ">1.5</ix:nonFraction> million, respectively, as variable consideration received in connection with a prior sale from its land and development portfolio. The variable consideration is based on the current owner&#8217;s sale activity from the land parcel and is recognized in revenue as earned upon actual sales occurring due to uncertainty around the extent and timing of such sales. During the three months ended June 30, 2025, the Company sold land parcels and residential lots and units and recognized land development revenue of $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_4_1_2025_To_6_30_2025_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_qIBgKJCVqUOZdLWI1wz6IA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="6" id="Narr_F4AxIJdkT0ulnlHGROAX7w">26.6</ix:nonFraction> million and land development cost of sales of $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_4_1_2025_To_6_30_2025_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_qIBgKJCVqUOZdLWI1wz6IA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="6" id="Narr_PTCdGbkElECXJYaSASxr2A">18.5</ix:nonFraction> million from its land and development portfolio. During the six months ended June 30, 2026 and 2025, the Company sold land parcels and residential lots and units and recognized land development revenue of $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2026_To_6_30_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_p8N7n5uooEeQ7Y1zdsHxMg" decimals="-5" format="ixt:num-dot-decimal" name="stho:RevenuesExcludingRevenueRelatedToPriorSale" scale="6" id="Narr_kZgfY3UfiEOwz8GC_-k9gQ">10.7</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2025_To_6_30_2025_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_74txUrDyP0KDsHeL05-BNg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="6" id="Narr_kNYZYTHFV0GEIdEcLOg62Q">31.8</ix:nonFraction> million, respectively, and land development cost of sales of $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2026_To_6_30_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_p8N7n5uooEeQ7Y1zdsHxMg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="6" id="Narr_t7nPiCbjakqT8D2sGd2rrg">9.3</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2025_To_6_30_2025_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_74txUrDyP0KDsHeL05-BNg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="6" id="Narr__NH_1FxbWUm_DnhuqpWd8w">25.3</ix:nonFraction> million, respectively, from its land and development portfolio. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt;">In December 2023, the Company transferred the ownership interests in a subsidiary land owner to a third-party venture (the &#8220;Venture&#8221;) for the development and construction of a multifamily project in Asbury Park, NJ (the &#8220;Project&#8221;). In connection with this transfer, the Company (i) provided the Venture with a $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_12_1_2023_To_12_31_2023_srt_ConsolidatedEntitiesAxis_stho_MultifamilyProjectInAsburyParkNjVentureMember_b9_zfPq7LkC_9eckl10Yrw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:PaymentsToFundLongtermLoansToRelatedParties" scale="6" id="Narr_aEjxgyYvT0mhqbi9PHXntw">10.6</ix:nonFraction> million mezzanine loan that was fully funded at closing and was secured by the ownership interests in the subsidiary land owner (until the mezzanine loan was repaid in full in March 2026); and (ii) provided a completion and carry guaranty on the Venture&#8217;s $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2023_srt_ConsolidatedEntitiesAxis_stho_MultifamilyProjectInAsburyParkNjVentureMember_s-MPIDLIo0-pXlPX2MHm1Q" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:GuaranteeObligationsMaximumExposure" scale="6" id="Narr_iFhGmGxYHkCeuF99WlpOxg">80.0</ix:nonFraction> million senior construction mortgage loan (refer to Note 9) with a third-party lender in return for a fee. The third-party members provided $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2023_srt_ConsolidatedEntitiesAxis_stho_MultifamilyProjectInAsburyParkNjVentureMember_s-MPIDLIo0-pXlPX2MHm1Q" decimals="-5" format="ixt:num-dot-decimal" name="stho:ThirdPartyCapitalContributions" scale="6" id="Narr_nfDYhbFX60m71XGTGQpgrA">21.0</ix:nonFraction> million in cash capital contributions to the Venture, exclusive of a $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_12_31_2023_srt_ConsolidatedEntitiesAxis_stho_MultifamilyProjectInAsburyParkNjVentureMember_s-MPIDLIo0-pXlPX2MHm1Q" decimals="-5" format="ixt:num-dot-decimal" name="stho:DeferredProfitInterestEquityCapitalization" scale="6" id="Narr__XM19MVh7kmI2_93fjjVVg">3.0</ix:nonFraction> million deferred profits interest, which combined represented the total equity capitalization and was included in noncontrolling interests in the Company&#8217;s consolidated balance sheet prior to the Venture&#8217;s deconsolidation in March 2026. The Venture began operations in September 2025. The Company was a non-member manager of the Venture and was entitled to certain fees, but otherwise </p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">9</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:10pt;margin:0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;background:#ffffff;margin:0pt;"><b style="color:#212529;font-weight:bold;">Star Holdings</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;background:#ffffff;margin:0pt;"><b style="color:#212529;font-weight:bold;">Notes to Consolidated Financial Statements (Continued)</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;background:#ffffff;margin:0pt 0pt 12pt 0pt;"><b style="color:#212529;font-weight:bold;">(unaudited)</b></p></div><div style="clear:both;max-width:100%;position:relative;min-height:11.5pt;"><ix:continuation id="Tb_n4tqLOkeCEmr4sb9Qio4Lg_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">had no expected member-related economics. The Company controlled all decision-making of the Venture until March 2026 when the mezzanine loan was repaid. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">At closing, the Company determined that the Venture (and its consolidated subsidiaries developing the Project) was a VIE for which the Company was the primary beneficiary and thus consolidated it under ASC 810.&#160;As a result, for accounting purposes, the Project was recorded on the Company&#8217;s consolidated financial statements and the mezzanine loan eliminated in consolidation prior to the mezzanine loan being repaid. The Company deconsolidated the Venture in March 2026 when the mezzanine loan was repaid in full and the Company&#8217;s senior loan guaranties were released by the lender. The Company recorded $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_3_1_2026_To_3_31_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_1s6q2ko-6EesP_zqJbZmpg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Revenues" scale="6" id="Narr_d1VcCl3qt0ytvcqJ4QQaRQ">10.6</ix:nonFraction> million of land development revenue, excluding $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="As_Of_3_31_2026_srt_ConsolidatedEntitiesAxis_stho_MultifamilyProjectInAsburyParkNjVentureMember_us-gaap_AccountsNotesLoansAndFinancingReceivableByReceivableTypeAxis_stho_MezzanineLoanMember_JgdU2doA8Eq19aO1naITHA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:InterestReceivable" scale="6" id="Narr_9sfusTQqHkS-yUO2JMI3yQ">2.4</ix:nonFraction> million of related accrued interest, and $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_3_1_2026_To_3_31_2026_srt_ProductOrServiceAxis_stho_LandDevelopmentMember_1s6q2ko-6EesP_zqJbZmpg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:CostOfRevenue" scale="6" id="Narr_C-_m3jVGZ0eDT8g8QwU90g">9.2</ix:nonFraction> million of land development cost of sales in its consolidated statement of operations when the mezzanine loan was repaid in full in March 2026, which represented the Company&#8217;s sale of land to the Venture. The Company recorded a $<ix:nonFraction unitRef="Unit_Standard_USD_asXWG_FmEESsDslGf8ISyQ" contextRef="Duration_1_1_2026_To_6_30_2026_d52ii-Pt10qeCtNdwjsYcg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DeconsolidationGainOrLossAmount" scale="6" id="Narr_bX4HtPVK00G4cztC0KydFA">0.4</ix:nonFraction> million loss on deconsolidation which is recorded in &#8220;Other expense&#8221; in the Company&#8217;s consolidated statement of operations.</p></ix:continuation><a id="_eb75f940_5cd3_4eb2_ba63_5ab815fe07d3"></a><a id="Tc_CjCUDEVXJEq0VWi2W_GLfQ_1_2"></a><a id="Tc_VphR9xjIwkCBdiVkTP-HvQ_2_2"></a><a id="Tc_4xell3moSUmDdDDGnG0J-g_2_5"></a><a id="Tc_yW1l5PSf0kmt6I0vziyZBw_3_0"></a><a id="Tc_PbDhjEVo00ijDYL3EVymXA_4_0"></a><a id="Tc_nnCz0lNYgEuJbBXWmeneAg_4_2"></a><a id="Tc_vmmXzDlXhUi4iiX_Aj6qSw_4_5"></a><a id="Tc_Pyq0HyqVhUenS4DD47Ozcw_5_0"></a><a id="Tc_KDkYVIy7U06QPPoBNEbkRw_6_0"></a><a id="Tc_9PyIC1C9lEOTbVAjl58iXA_7_0"></a><a id="Tc_nglw6FxKCkWRjcJ0GkaThg_8_0"></a><a id="Tc_xbN9PfqBJE-oHWrNIFbGkw_9_0"></a><a id="Tc_r-M3_LvRD0GBIZE_haElUg_10_0"></a><a id="Tc_9ryHJlsPWkmnbdYFhtPVog_11_0"></a><a id="Tc_1WBVn0y7wUu6tuUFoShTPA_12_0"></a><a id="Tc_AoorDBchRUeLc-7rONMKpA_12_2"></a><a id="Tc_0d0hRTNBfkWbyQEEBhcIWw_12_5"></a><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_d52ii-Pt10qeCtNdwjsYcg" name="us-gaap:LoansNotesTradeAndOtherReceivablesDisclosureTextBlock" id="Tb_OrQHJ19UGkaBCNGi0XQ2qw" continuedAt="Tb_OrQHJ19UGkaBCNGi0XQ2qw_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Note&#160;6&#8212;Loans Receivable and Other Lending Investments, net</p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_d52ii-Pt10qeCtNdwjsYcg" name="stho:ScheduleOfLoansAndOtherLendingInvestmentsTableTextBlock" id="Tb_IUnF7AR-FEmCJvpKmBM31A" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:18pt;margin:0pt 0pt 6pt 0pt;">The following is a summary of the Company&#8217;s loans receivable and other lending investments by class ($ in thousands): <sup style="font-size:7.5pt;line-height:100%;top:0pt;vertical-align:top;">(1) </sup></p><table style="border-co