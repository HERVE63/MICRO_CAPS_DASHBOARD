</td><td valign="top" style="background-color:#D3F0FE;width:58.5pt;border-left:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">192</p>
</td><td valign="top" style="background-color:#D3F0FE;width:58.5pt"><p style="font:10pt Times New Roman;margin:0;text-align:right">168</p>
</td></tr>
