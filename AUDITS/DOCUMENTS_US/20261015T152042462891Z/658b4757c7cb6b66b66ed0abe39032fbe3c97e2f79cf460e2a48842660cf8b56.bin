    <td style="font-size: 10pt; text-align: left; width: 1%">$</td><td style="font-size: 10pt; text-align: right; width: 15%">2.11</td><td style="font-size: 10pt; text-align: left; width: 1%">&#160;</td><td style="font-size: 10pt; width: 1%">&#160;</td>
    <td style="font-size: 10pt; text-align: left; width: 1%">&#160;</td><td style="font-size: 10pt; text-align: right; width: 15%">60,635</td><td style="font-size: 10pt; text-align: left; width: 1%">&#160;</td></tr>
