<tr style="page-break-inside:avoid ; font-family:Times New Roman; font-size:10pt;background-color:#cceeff">
<td style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Ralph A. Clark</p></td>
<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:bottom;white-space:nowrap">Chief Executive Officer, President and Director</td>
<td style="vertical-align:bottom">&#160;</td>
<td style="white-space:nowrap;vertical-align:top">&#160;</td>
<td style="white-space:nowrap;vertical-align:top;text-align:right">472,500</td>
<td style="white-space:nowrap;vertical-align:top">&#160;</td>
<td style="vertical-align:bottom">&#160;</td>
<td style="white-space:nowrap;vertical-align:top">&#160;</td>
<td style="white-space:nowrap;vertical-align:top;text-align:right">472,500</td>
<td style="white-space:nowrap;vertical-align:top">&#160;</td>
