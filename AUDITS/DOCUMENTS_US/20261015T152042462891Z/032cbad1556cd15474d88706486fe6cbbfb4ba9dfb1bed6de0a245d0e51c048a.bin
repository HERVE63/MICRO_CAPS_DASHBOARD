ecimals="-5" name="us-gaap:LongTermDebt" scale="6" id="f-1660">481.9</ix:nonFraction></span></td><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/></tr><tr style="height:6pt"><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="display:none"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;border-top:3pt double #000;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;border-top:3pt double #000;padding:0 1pt"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/></tr><tr><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/></tr></table></div><div style="margin-top:6pt;padding-left:18pt;text-indent:-18pt"><span style="background-color:#ffffff;color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">(1)</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%;padding-left:7.52pt">Different classes of Asset-Backed Notes were issued at a discount and a mandatory 3-year call date. We have the option to redeem the notes at any time prior to the mandatory call date, at a <ix:nonFraction unitRef="number" contextRef="c-455" decimals="INF" name="ocn:DebtInstruentRedemptionPercentageOfPremium" scale="-2" id="f-1661">1</ix:nonFraction>% premium for a specified period of time after issuance (generally one year) and at par value thereafter. Payments of interest and principal are made from available funds from a pool of reverse mortgage buyout loans and REOs in accordance with the indenture priority of payments. Also see Note&#160;2 &#8212; Securitizations and Variable Interest Entities.</span></div><div style="padding-left:18pt;text-indent:-18pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%">(2)</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:120%;padding-left:7.52pt">The Notes have a stated interest rate of <ix:nonFraction unitRef="number" contextRef="c-443" decimals="3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="f-1662">3.0</ix:nonFraction>%, <ix:nonFraction unitRef="number" contextRef="c-445" decimals="3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="f-1663">3.0</ix:nonFraction>%, <ix:nonFraction unitRef="number" contextRef="c-447" decimals="3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="f-1664">5.0</ix:nonFraction>%, <ix:nonFraction unitRef="number" contextRef="c-449" decimals="3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="f-1665">3.0</ix:nonFraction>% and <ix:nonFraction unitRef="number" contextRef="c-451" decimals="3" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="f-1666">3.0</ix:nonFraction>% respectively. The interest rate excludes the effect of the amortization of discount and debt issuance costs. </span></div></ix:nonNumeric></ix:continuation><div style="height:42.75pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">F-42</span></div></div></div><hr style="page-break-after:always"/><div style="min-height:42.75pt;width:100%"><div><span><br/></span></div></div><ix:continuation id="f-1639-1" continuedAt="f-1639-2"><ix:continuation id="f-1599-2" continuedAt="f-1599-3"><div style="margin-bottom:1pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:21.999%"/><td style="width:0.1%"/><td colspan="3" style="display:none"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.619%"/><td style="width:0.1%"/><td colspan="3" style="display:none"/><td colspan="3" style="display:none"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:8.695%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.619%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.619%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.619%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.384%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.626%"/><td style="width:0.1%"/><td colspan="3" style="display:none"/><td colspan="3"