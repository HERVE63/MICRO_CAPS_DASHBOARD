  <div class="main-content-container" style="z-index:5;position:relative;"><div style="font-size:10pt;font-family:Times New Roman;"><ix:continuation id="F_38166e27-a04d-4e54-87c4-ce81967b3f29_3"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:10pt;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">The Company also maintains qualified defined contribution plans, which provide benefits to their employees based on employee contributions and employee earnings, with discretionary contributions allowed. Expenses related to these plans were $</span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_4faeccd8-6df0-4cc3-aa2c-6a25414f8cff" contextRef="C_78c05b51-1208-467a-80a9-1736a4e74078" name="us-gaap:EmployeeBenefitsAndShareBasedCompensation" unitRef="U_USD" scale="6" decimals="-6" format="ixt:num-dot-decimal">428</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> and $</span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_f0415703-35d5-4486-9170-f83d0cb5922d" contextRef="C_c5bf577d-0481-4a69-8d32-5b5655bda661" name="us-gaap:EmployeeBenefitsAndShareBasedCompensation" unitRef="U_USD" scale="6" decimals="-6" format="ixt:num-dot-decimal">360</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> for the years ended December 31, 2025 and 2024</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">, respectively.</span></p></ix:continuation></div></div>
