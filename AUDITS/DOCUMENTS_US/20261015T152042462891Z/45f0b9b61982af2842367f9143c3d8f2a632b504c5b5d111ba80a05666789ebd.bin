           <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span><ix:nonNumeric id="F_73c3b6bf-6d5e-46b5-b55b-f5801d92676b" contextRef="C_f91c165b-ca3c-4813-b659-1f0693dec7f3" name="us-gaap:PropertyPlantAndEquipmentUsefulLife" format="ixt-sec:duryear"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">3</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">-</span><span><ix:nonNumeric id="F_2bff4c83-d154-4a3c-a3c7-a3375c5327d4" contextRef="C_9ad145d4-2c7f-45f3-b0f2-18458844ccb1" name="us-gaap:PropertyPlantAndEquipmentUsefulLife" format="ixt-sec:duryear"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">7 </span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">years</span></p></td>
