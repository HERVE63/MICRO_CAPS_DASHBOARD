an><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">  </span></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:12pt;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">Nonaccrual loans at January 1, 2025 were $</span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_69b1258c-9654-491e-857a-2efe47d6fc6d" contextRef="C_2720ba42-17a7-40cd-b500-f5beed5481af" name="us-gaap:FinancingReceivableRecordedInvestmentNonaccrualStatus" unitRef="U_USD" scale="3" decimals="-3" format="ixt:num-dot-decimal">14,538</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">.</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">  </span></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">Nonaccrual loans include both smaller balance single-family mortgage loans, consumer loans and commercial loans and leases that are collectively evaluated for impairment and individually evaluated loans.  </span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">There were </span><span style="font-size:10pt;font-family:Times New Roman;color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;"><ix:nonFraction id="F_6ad827a9-c965-4208-a6d6-558fdebe18b0" contextRef="C_948bc4ee-5f17-4cd9-8da2-a7707c6a5313" name="cfbk:FinancingReceivableModifiedInPeriodNumberOfLoans" unitRef="U_Loan" decimals="INF" format="ixt-sec:numwordsen"><ix:nonFraction id="F_b596d35b-5d28-4f16-9110-61fe671ffbba" contextRef="C_573dcbe2-6f11-41d7-8c8f-c8ce96ba8d6e" name="cfbk:FinancingReceivableModifiedInPeriodNumberOfLoans" unitRef="U_Loan" decimals="INF" format="ixt-sec:numwordsen">no</ix:nonFraction></ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> loans 90 days or more past due and still accruing interest at </span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">June 30, 2026 or December 31, 2025.</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> </span></p></ix:continuation></div></div>
