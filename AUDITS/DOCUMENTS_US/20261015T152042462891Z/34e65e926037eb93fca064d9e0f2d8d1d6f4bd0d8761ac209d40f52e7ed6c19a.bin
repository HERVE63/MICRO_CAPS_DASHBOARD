Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td><td colspan="3" style="border-left:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g70.jpg" alt="03 UIS_Election_Names__martin.jpg" style="height:76px;margin-bottom:5pt;vertical-align:text-bottom;width:13px" id="i-143"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td><td colspan="3" style="border-left:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g71.jpg" alt="03 UIS_Election_Names__paolillo.jpg" style="height:76px;margin-bottom:5pt;vertical-align:text-bottom;width:13px" id="i-144"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td><td colspan="3" style="border-left:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g72.jpg" alt="03 UIS_Election_Names__richardson.jpg" style="height:76px;margin-bottom:5pt;vertical-align:text-bottom;width:13px" id="i-145"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td><td colspan="3" style="border-left:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g73.jpg" alt="03 UIS_Election_Names__taylor.jpg" style="height:76px;margin-bottom:5pt;vertical-align:text-bottom;width:13px" id="i-146"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td><td colspan="3" style="border-left:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g74.jpg" alt="03 UIS_Election_Names__thomson.jpg" style="height:76px;margin-bottom:5pt;vertical-align:text-bottom;width:13px" id="i-147"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:10.00pt">&#160;</span></div></td></tr><tr><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="padding-right:-1.31pt;text-align:center"><img src="uis-20260316_g75.jpg" alt="02 UIS_Election_Leader.jpg" style="height:34px;margin-bottom:5pt;vertical-align:text-bottom;width:33px" id="i-148"/><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:1pt;font-weight:400;line-height:130%">&#160;</span></div></td><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"><div style="padding-right:-2.63pt;text-align:center"><span><br/></span></div></td><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-bottom:2pt;padding-right:7.2pt"><span style="color:#003134;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:120%">Senior Leadership</span><span style="color:#003134;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%"><br/></span><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">Experience serving in a senior leadership role in a complex organization </span></div></td><td colspan="3" style="border-left:0.5pt solid #dfdfdf;border-top:0.5pt solid #00e28b;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="padding-right:-2.63pt;text-align:center"><img src="uis-20260316_g76.jpg" alt="02 UIS_Election_KeySkill.jpg" style="height:9px;margin-bottom:5pt;vertical-align:text-bottom;width:9px" id="i-149"/><span style="color:#003b4c;font-family:'Arial',sans-serif;font-