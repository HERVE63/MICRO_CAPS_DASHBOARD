-size:8pt;font-weight:700;line-height:130%">Maximum ($M) </span></div></td><td colspan="3" style="padding:0 1pt"/><td colspan="3" style="padding:0 1pt"><div style="padding-right:-2.63pt"><span><br/></span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:130%">Vesting<br/>(as a % of</span></div><div style="text-align:right"><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:130%">target) </span></div></td></tr><tr style="height:3pt"><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/><td colspan="3" style="border-top:0.5pt solid #00e28b;padding:0 1pt"/></tr><tr style="height:48pt"><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:middle"><span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:130%">2023</span></td><td colspan="3" style="padding:0 1pt"><div style="padding-right:-2.63pt"><span><br/></span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:middle"><div><span style="color:#2