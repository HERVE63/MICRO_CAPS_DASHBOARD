  <tr style="font-size: 10pt; vertical-align: bottom">
    <td style="font: bold 10pt Times New Roman, Times, Serif; vertical-align: top; text-align: left"><a href="#a_0002"><span style="font-size: 10pt">2.</span></a></td>
    <td style="font: italic bold 10pt Times New Roman, Times, Serif; vertical-align: top; text-align: left; padding-bottom: 1pt"><a href="#a_0002"><span style="font-size: 10pt">Definitions</span></a></td>
    <td style="font: bold 10pt Times New Roman, Times, Serif; vertical-align: top; text-align: right"><a href="#a_0002"><span style="font-size: 10pt">1</span></a></td></tr>
