			<p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; font-variant: normal; margin: 0pt 0pt 0pt 18pt;">Pay Versus Performance</p>
			</td>
			<td style="vertical-align: middle; width: 96%; text-align: right;">17</td>
		</tr>
		<tr style="background-color: rgb(204, 238, 255);">
