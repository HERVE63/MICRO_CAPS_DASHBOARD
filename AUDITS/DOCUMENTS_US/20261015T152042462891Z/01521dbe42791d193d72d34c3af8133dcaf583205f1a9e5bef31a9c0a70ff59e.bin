  <ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:InventoryDisclosureTextBlock" id="c3256815" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>NOTE <em style="font: inherit;">6</em>&#160;&#8212; INVENTORIES</b>&#160;</p>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;text-indent:36pt;">The components of inventories as of <em style="font: inherit;"> June 30, 2026</em> and <em style="font: inherit;"> December 31, 2025</em> are summarized as follows:</p>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">&#160;</p>
