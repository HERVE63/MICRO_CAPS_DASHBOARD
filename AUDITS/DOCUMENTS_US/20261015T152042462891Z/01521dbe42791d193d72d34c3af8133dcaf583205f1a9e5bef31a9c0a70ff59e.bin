  <ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:DisclosureOfCompensationRelatedCostsShareBasedPaymentsTextBlock" id="c3256830" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>NOTE <em style="font: inherit;">14</em>&#160;&#8212; SHARE-BASED COMPENSATION</b>&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;text-indent:36pt;">&#8203;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;text-indent:36pt;">The following table&#160;summarizes the Company&#8217;s restricted stock unit and performance award activity during the <em style="font: inherit;">six</em> months ended <em style="font: inherit;"> June 30, 2026</em>:</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;text-indent:36pt;">&#160;</p>
