div></td><td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:112%">(8,922)</font></td><td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:112%">(8,163)</font></td><td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"></td><td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:112%">(6,886)</font></td><td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;text-indent:6.75pt;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:112%">Bargain purchase gain</font></td><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:112%">-&#160;</font></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"></td><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"><font style="color:#000000;font-family:'Times New Roman',ser