    <td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">4,527</span></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold; padding-bottom: 2.5pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">5,698</span></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
