    <td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="OPXS:WarrantyReserve" contextRef="AsOf2026-06-28" id="Fact000596" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">25</ix:nonFraction></span></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold; padding-bottom: 2.5pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="border-bottom: Black 2.5pt double; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="OPXS:WarrantyReserve" contextRef="AsOf2025-06-29" id="Fact000597" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">173</ix:nonFraction></span></td><td style="padding-bottom: 2.5pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
