    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><span id="xdx_90A_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedDividendRate_pid_dp_c20250929__20260628_fKDIp_zqyiLXU16bKe" title="Dividend yield"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedDividendRate" contextRef="From2025-09-29to2026-06-28" id="Fact001802" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">0.0</ix:nonFraction></span></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">%</span></td></tr>
