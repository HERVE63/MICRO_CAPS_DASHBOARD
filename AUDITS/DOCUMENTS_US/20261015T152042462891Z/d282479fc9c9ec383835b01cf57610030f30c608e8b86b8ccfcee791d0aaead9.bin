    <td style="border-bottom: Black 1pt solid; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 1pt solid; font-weight: bold; text-align: right"><span style="font-family: Times New Roman, Times, Serif">13,466</span></td><td style="padding-bottom: 1pt; font-weight: bold; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-weight: bold; padding-bottom: 1pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
