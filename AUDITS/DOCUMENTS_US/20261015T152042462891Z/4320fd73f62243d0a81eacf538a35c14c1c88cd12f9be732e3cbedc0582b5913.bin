mat="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsVestedAndExpectedToVestOutstandingAggregateIntrinsicValue" scale="3" id="Tc_HdvMigJ7fkKSVFLK8PeUMQ_13_10">2</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:55.62%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Options exercisable, December&#160;28,&#160;2024</p></td><td style="vertical-align:bottom;white-space:normal;width:2.19%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:normal;width:7.29%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="As_Of_12_28_2024_QUYhLXHd90ib9nVZLxJ29g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisableNumber" scale="3" id="Tc_MGuH5L-Bh0SJ4Zu0W9g2Kw_14_2">1,586</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:normal;width:2.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:normal;width:1.35%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:normal;width:7.3%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_v1QKNJk2yEqjO-z8RF-6yg" contextRef="As_Of_12_28_2024_QUYhLXHd90ib9nVZLxJ29g" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisableWeightedAverageExercisePrice" scale="0" id="Tc_tHppa59mtECDbsfsJDUNkg_14_5">2.62</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:normal;width:2.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:normal;width:11%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"><ix:nonNumeric contextRef="Duration_12_31_2023_To_12_28_2024_j-MXvrgm4EyfzvmZYgHU2w" format="ixt-sec:duryear" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardOptionsExercisableWeightedAverageRemainingContractualTerm1" id="Tc_sl67RwlxpEK-udOvvquOcQ_14_7"> 4.09</ix:nonNumeric></p></td><td style="vertical-align:bottom;white-space:normal;width:2.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:normal;width:1.35%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:normal;width:7.24%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.5pt 0.05pt 0pt;"> &#8212;</p></td></tr></table><div style="font-family:'Times New Roman','Times','serif';font-size:10.0pt;margin-bottom:0pt;min-height:1.19em;position:relative;width:100%;"><div style="background-color:#000000;height:1pt;position:relative;top:0.6em;width:25.0%;border:none;margin:0 auto 0 0;"></div></div><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">(1)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">These amounts represent the difference between the exercise price and the closing price of CarParts.com,&#160;Inc. common stock at the end of the respective fiscal year as reported on the NASDAQ Stock Market, for all options outstanding that have an exercise price currently below the closing price.</span></td></tr></table><div style="margin-top:12pt;"></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During fiscal years 2025 and 2024, <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_29_2024_To_1_3_2026_FzjzYLwB5EmXAMEQRM5Giw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="3" id="Narr_JDgWR9BhfUWIkxKrimqXZg">100</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_31_2023_To_12_28_2024_j-MXvrgm4EyfzvmZYgHU2w" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="3" id="Narr_CwucKAZby0mndOymP9hDrw">110</ix:nonFraction> stock options were granted under the 2016 Equity Plan, respectively. The intrinsic value of stock options at the date of the exercise is the difference between the fair value of the stock at the date of exercise and the exercise price. During fiscal years 2025 and 2024, as there were <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_31_2023_To_12_28_2024_j-MXvrgm4EyfzvmZYgHU2w" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="3" id="Narr_iLbFhAQgBEOckIXy_-PerA"><ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_29_2024_To_1_3_2026_FzjzYLwB5EmXAMEQRM5Giw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="3" id="Narr_2MVFskjZiUqXSCgowMus0g">no</ix:nonFraction></ix:nonFraction> stock options exercised, therefore, the total intrinsic value of the exercised options was $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_29_2024_To_1_3_2026_FzjzYLwB5EmXAMEQRM5Giw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisesInPeriodTotalIntrinsicValue" scale="3" id="Narr_01rJBMouOkisqUD5VmYIkA">0</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_31_2023_To_12_28_2024_j-MXvrgm4EyfzvmZYgHU2w" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisesInPeriodTotalIntrinsicValue" scale="3" id="Narr_lVozQVeGbEWWcdeAYGwG2w">0</ix:nonFraction>, respectively. The Company had $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="As_Of_1_3_2026_kSEUdn2Lf02nlUEIdIBIaA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedStockOptions" scale="3" id="Narr_J5QtIvgl50ehD2TYPhtDbw">82</ix:nonFraction> of unrecognized share-based compensation expense related to stock options outstanding as of January&#160;3,&#160;2026, which the expense is expected to be recognized over a weighted-average period of <ix:nonNumeric contextRef="Duration_12_29_2024_To_1_3_2026_FzjzYLwB5EmXAMEQRM5Giw" format="ixt-sec:duryear" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedPeriodForRecognition1" id="Narr_vv-ciO0Epkao-dY3SpGwNw">1.86</ix:nonNumeric>&#160;years. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 12pt 18pt;">Restricted Stock Units and Restricted Stock Awards</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;">During the fiscal years 2025 and 2024, the Company granted an aggregate of <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_e5sPL2SChk2WETjV2Fgr3Q" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="3" id="Narr_SImXMqatY0atTcK8oHP3kQ">3,736</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_31_2023_To_12_28_2024_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_VvUDbqNznkCT5JaHDvcrEg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="3" id="Narr_R2A3YNrcU02aVDPFRm-mAA">3,033</ix:nonFraction>, respectively, of Restricted Stock Units (&#8220;RSUs&#8221;) and Restricted Stock Awards (&#8220;RSAs&#8221;) to certain employees of the Company. The </p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-19</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:27.35pt;min-height:36pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_c4b8J3DeXEGXIuyoEuB3hw_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;">RSUs and RSAs were granted under the 2016 Equity Incentive Plan and reduced the pool of equity instruments available under that plan.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The vesting of each RSU and RSA is subject to the employee&#8217;s continued employment through applicable vesting dates. Some RSUs and RSAs granted to certain executives may vest on an accelerated basis in part or in full upon the occurrence of certain events.&#160;The RSUs and RSAs are accounted for as equity awards and are measured at fair value based upon the grant date price of the Company&#8217;s common stock. The closing price of the Company&#8217;s common stock on each grant date during 2025 ranged from $<ix:nonFraction unitRef="Unit_Divide_USD_shares_v1QKNJk2yEqjO-z8RF-6yg" contextRef="Duration_12_29_2024_To_1_3_2026_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_8dXXtgefYUaiaknivXTemQ" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_9X53O6SDrEKQgKvqO_BWCw">0.63</ix:nonFraction> to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_v1QKNJk2yEqjO-z8RF-6yg" contextRef="Duration_12_29_2024_To_1_3_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_W6Mw6U0QikuDCvGbJScl7g" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_gI-XxBbv2kGFm06IPZG43Q">1.02</ix:nonFraction>. The closing price of the Company&#8217;s common stock on each grant during 2024 ranged from $<ix:nonFraction unitRef="Unit_Divide_USD_shares_v1QKNJk2yEqjO-z8RF-6yg" contextRef="Duration_12_31_2023_To_12_28_2024_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_bn5zpFIJk0C-9rh8q_ij3w" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_4xsqPDCJA0OjUtukpJserw">0.74</ix:nonFraction> to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_v1QKNJk2yEqjO-z8RF-6yg" contextRef="Duration_12_31_2023_To_12_28_2024_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_SclB1e-NXkGcetKZHoGf8Q" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_rMvwOhDrU0WIB1qfnzAHEA">2.92</ix:nonFraction>. Compensation expense is recognized on a straight-line basis over the requisite service period of <span style="-sec-ix-hidden:Hidden_PcaRfshw-0-GzgHt92RY3w;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">one</span></span>-to-<ix:nonNumeric contextRef="Duration_12_29_2024_To_1_3_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_W6Mw6U0QikuDCvGbJScl7g" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardRequisiteServicePeriod1" id="Narr_v1Sl1aWga0OHlUilVMcgIQ">three years</ix:nonNumeric>. Compensation expense for performance-based RSUs (&#8220;PSUs&#8221;) is measured based on the amount of shares ultimately expected to vest, estimated at each reporting date based on management&#8217;s expectations regarding the relevant performance criteria. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">During 2025 there were <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_AwardTypeAxis_prts_TimeBasedRestrictedStockUnitMember_A1Vkxr_3qEenS0hv7C7a6Q" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="3" id="Narr_cVvmFLnaHUCnuYuQ-0W5Hg">3,736</ix:nonFraction> RSUs and RSAs granted that were time-based. During 2024 there were <ix:nonFraction unitRef="Unit_Standard_shares_m5mTOyDo1UCUbwRf9G33FQ" contextRef="Duration_12_31_2023_To_12_28_2024_us-gaap_AwardTypeAxis_prts_TimeBasedRestrictedStockUnitMember_Ac631YCBdUWq-owj4Kl_bw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" scale="3" id="Narr_o5z_R85AlEa7x4IXcfn5eQ">3,033</ix:nonFraction> RSUs and RSAs granted that were time-based.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">For the fiscal&#160;year ended January&#160;3,&#160;2026, we recorded compensation expense of $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_e5sPL2SChk2WETjV2Fgr3Q" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_ud0YyZRiYUWaDIzmqLnkmg">8,931</ix:nonFraction> related to RSUs and RSAs.&#160;As of January 3, 2026, there was unrecognized compensation expense of&#160;$<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="As_Of_1_3_2026_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_d-UrYLdlK0ytrxlceVGZzg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedShareBasedAwardsOtherThanOptions" scale="3" id="Narr_WCdycMBnQEC4jX8Vq_0wqg">4,924</ix:nonFraction>&#160;related to unvested RSUs and RSAs based on awards that are expected to vest. The unrecognized compensation expense is expected to be recognized over a weighted-average period of&#160;<ix:nonNumeric contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_e5sPL2SChk2WETjV2Fgr3Q" format="ixt-sec:duryear" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedPeriodForRecognition1" id="Narr_jSyQoGy5C0C-ZWPCooz8uA">1.27</ix:nonNumeric>&#160;years.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;font-weight:bold;margin:0pt 0pt 12pt 18pt;">Share-Based Compensation Expense</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The share-based compensation expense is net of amounts capitalized to internally-developed software of $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_FiniteLivedIntangibleAssetsByMajorClassAxis_prts_WebsiteAndSoftwareDevelopmentMember_GmnYiQH1BEKIqKOYANH-bg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CapitalizedComputerSoftwareAdditions" scale="3" id="Narr_SUpr4SOyrkCqjlFvsPSZsg">835</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_31_2023_To_12_28_2024_us-gaap_FiniteLivedIntangibleAssetsByMajorClassAxis_prts_WebsiteAndSoftwareDevelopmentMember_42-H9GRemUa-RC6EF6onBw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CapitalizedComputerSoftwareAdditions" scale="3" id="Narr_JKKGbLuaqUGEMQ_CPsfY7w">746</ix:nonFraction> during the fiscal&#160;years 2025 and 2024, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">For the fiscal years 2025 and 2024, the Company recorded share-based compensation expense related to stock options, RSUs and RSAs of $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_29_2024_To_1_3_2026_us-gaap_AwardTypeAxis_prts_RestrictedStockUnitsRsuAndEmployeeStockOptionsMember_cq5XzlW9oESRxBi_un3Hsg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_rzvEcXHlhUqRQEE07yL0gg">8,108</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_RSazBdMHr0GVYYpP2TiPSg" contextRef="Duration_12_31_2023_To_12_28_2024_us-gaap_AwardTypeAxis_prts_RestrictedStockUnitsRsuAndEmployeeStockOptionsMember_f5bHFqG-W0y4ebLYgMulvw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="3" id="Narr_wBbtsdwN2U6Lt_0FJWkAgg">11,985</ix:nonFraction>, respectively. </p></ix:continuation><a id="_f79cc9b9_8f52_4dfa_b812_bfa1599dc527"></a><a id="Tc_lKDCnJjzWU2kzRBewLf6Cg_1_2"></a><a id="Tc_8AdrhgO81EykejrXQYZ39w_2_2"></a><a id="Tc_PVnTPTEya0yQ17XzFvTKzQ_2_5"></a><a id="Tc_TqoglpybXU6Q0JcUDkOmjQ_3_0"></a><a id="Tc_q5ko59szhU2WTA6X7FWYMw_4_0"></a><a id="Tc_1bGuSi1NcUmRhg2N_oqYgw_5_0"></a><a id="Tc_btp2gifNaUiYEuoYtfw2vw_5_2"></a><a id="Tc_XOrHl5riBUasHwoV5El1tQ_5_5"></a><a id="Tc_yiSWHi19GUWMOfsE00kKHQ_6_0"></a><a id="Tc_Etbl1VIOH0i2Mdzq0_PdMQ_7_0"></a><a id="Tc_z4Ugz4rjn0eDHRmP