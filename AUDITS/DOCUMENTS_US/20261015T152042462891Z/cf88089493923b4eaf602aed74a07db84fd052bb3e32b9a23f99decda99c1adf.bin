    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction name="us-gaap:CashSurrenderValueOfLifeInsurance" contextRef="AsOf2025-12-31" id="Fact000718" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,150</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
