rning:none;min-width:fit-content;"><ix:nonFraction id="F_b7aea62e-bb19-4a38-ac67-ff3ac7605d1b" contextRef="C_0e29d068-c26e-45ee-94e9-88fefd1eb161" name="sitc:IncrementalFairValueOfServicesProvided" unitRef="U_USD" scale="6" decimals="-5" format="ixt:num-dot-decimal">1.7</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> million and</span></p></ix:nonNumeric></div></div>
