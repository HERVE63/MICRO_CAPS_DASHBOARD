<td style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:1.00em; text-indent:-1.00em; font-size:10pt; font-family:Times New Roman">Three-Year Average</p></td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="white-space:nowrap;vertical-align:bottom">&#160;</td>
<td style="white-space:nowrap;vertical-align:bottom;text-align:right">6,321,210</td>
<td style="white-space:nowrap;vertical-align:bottom">&#160;</td>
