shAndCashEquivalentsFairValueDisclosure" format="ixt:fixed-zero" scale="3" id="f-394">&#8212;</ix:nonFraction>&#160;</span></td><td style="background-color:#dbdbdb;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:middle"/><td colspan="3" style="background-color:#dbdbdb;padding:0 1pt"/><td style="background-color:#dbdbdb;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:100%">$</span></td><td style="background-color:#dbdbdb;padding:1.5pt 0;text-align:right;vertical-align:middle"><span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-60" decimals="-3" name="us-gaap:CashAndCashEquivalentsFairValueDisclosure" format="ixt:fixed-zero" scale="3" id="f-395">&#8212;</ix:nonFraction>&#160;</span></td><td style="background-color:#dbdbdb;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:middle"/><td colspan="3" style="background-color:#dbdbdb;padding:0 1pt"/><td style="background-color:#dbdbdb;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:100%">$</span></td><td style="background-color:#dbdbdb;padding:1.5pt 0;text-align:right;vertical-align:middle"><span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-3" decimals="-3" name="us-gaap:CashAndCashEquivalentsFairValueDisclosure" format="ixt:num-dot-decimal" scale="3" id="f-396">137,227</ix:nonFraction>&#160;</span></td><td style="background-color:#dbdbdb;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:middle"/></tr><tr><td colspan="3" style="padding:1.5pt 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight: