    <td style="text-align: left">$</td><td id="xdx_980_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue_pid_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zdfnUf0WJfof" title="Weighted Average Grant Date Fair Value per Unit, Granted" style="text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" contextRef="From2026-01-012026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001303" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">2.11</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td>Vested</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td id="xdx_983_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriod_iN_pid_di_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zXZeRG8nkufc" title="Number of Restricted Stock Units, Vested" style="text-align: right">(<ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriod" contextRef="From2026-01-012026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001305" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">115,000</ix:nonFraction></td><td style="text-align: left">)</td><td>&#160;</td>
    <td style="text-align: left">$</td><td id="xdx_988_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriodWeightedAverageGrantDateFairValue_pid_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zpjePKZAeSed" title="Weighted Average Grant Date Fair Value per Unit, Vested" style="text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsVestedInPeriodWeightedAverageGrantDateFairValue" contextRef="From2026-01-012026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001307" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">2.32</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="padding-bottom: 1pt">Forfeited</td><td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td id="xdx_981_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsForfeitedInPeriod_iN_pid_di_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zBTvakmFpj26" title="Number of Restricted Stock Units, Forfeited" style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsForfeitedInPeriod" contextRef="From2026-01-012026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001309" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">230,000</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)</td><td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">$</td><td id="xdx_98C_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsForfeituresWeightedAverageGrantDateFairValue_pid_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zhyUzltWgHt9" title="Weighted Average Grant Date Fair Value per Unit, Forfeited" style="border-bottom: Black 1pt solid; text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsForfeituresWeightedAverageGrantDateFairValue" contextRef="From2026-01-012026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001311" format="ixt:numdotdecimal" decimals="INF" unitRef="USDPShares">1.60</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="padding-bottom: 2.5pt">Outstanding, June 30, 2026</td><td style="padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 2.5pt double; text-align: left">&#160;</td><td id="xdx_98D_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedNumber_iE_pid_c20260101__20260630__us-gaap--AwardTypeAxis__us-gaap--RestrictedStockUnitsRSUMember_zo5SAFlYOjhb" title="Number of Restricted Stock Units, Outstanding, Ending" style="border-bottom: Black 2.5pt double; text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedNumber" contextRef="AsOf2026-06-30_us-gaap_RestrictedStockUnitsRSUMember" id="Fact001313" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">2,446,321</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td><td style="padding-bottom: 2.5pt">&#160;</td>
