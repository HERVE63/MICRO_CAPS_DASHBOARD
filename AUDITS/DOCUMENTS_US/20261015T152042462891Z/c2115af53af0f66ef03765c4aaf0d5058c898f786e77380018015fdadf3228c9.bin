  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: center">9</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td id="xdx_98C_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod_pid_c20210222__20210223__us-gaap--TypeOfArrangementAxis__custom--PerformanceShareUnitAwardAgreementMember__srt--TitleOfIndividualAxis__custom--Mr.FischelMember__us-gaap--VestingAxis__custom--ShareBasedCompensationAwardTrancheNineMember_z5kxgDV32iOj" title="Number of shares subject to PSU" style="text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" contextRef="From2021-02-222021-02-23_custom_PerformanceShareUnitAwardAgreementMember_custom_Mr.FischelMember_custom_ShareBasedCompensationAwardTrancheNineMember" id="Fact001227" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">1,000,000</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">$</td><td id="xdx_98A_ecustom--MarketCapitalizationMilestone_iI_pp0p0_c20210223__us-gaap--TypeOfArrangementAxis__custom--PerformanceShareUnitAwardAgreementMember__srt--TitleOfIndividualAxis__custom--Mr.FischelMember__us-gaap--VestingAxis__custom--ShareBasedCompensationAwardTrancheNineMember_znLHZTVsypyh" title="Market capitalization milestone, amount" style="text-align: right"><ix:nonFraction name="STXS:MarketCapitalizationMilestone" contextRef="AsOf2021-02-23_custom_PerformanceShareUnitAwardAgreementMember_custom_Mr.FischelMember_custom_ShareBasedCompensationAwardTrancheNineMember" id="Fact001229" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">5,000,000,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: center">10</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td id="xdx_98A_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod_pid_c20210222__20210223__us-gaap--TypeOfArrangementAxis__custom--PerformanceShareUnitAwardAgreementMember__srt--TitleOfIndividualAxis__custom--Mr.FischelMember__us-gaap--VestingAxis__custom--ShareBasedCompensationAwardTrancheTenMember_zQXAtli28yZb" title="Number of shares subject to PSU" style="text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" contextRef="From2021-02-222021-02-23_custom_PerformanceShareUnitAwardAgreementMember_custom_Mr.FischelMember_custom_ShareBasedCompensationAwardTrancheTenMember" id="Fact001231" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">1,000,000</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">$</td><td id="xdx_98B_ecustom--MarketCapitalizationMilestone_iI_pn8p0_c20210223__us-gaap--TypeOfArrangementAxis__custom--PerformanceShareUnitAwardAgreementMember__srt--TitleOfIndividualAxis__custom--Mr.FischelMember__us-gaap--VestingAxis__custom--ShareBasedCompensationAwardTrancheTenMember_zeFGV8RUzxK3" title="Market capitalization milestone, amount" style="text-align: right"><ix:nonFraction name="STXS:MarketCapitalizationMilestone" contextRef="AsOf2021-02-23_custom_PerformanceShareUnitAwardAgreementMember_custom_Mr.FischelMember_custom_ShareBasedCompensationAwardTrancheTenMember" id="Fact001233" format="ixt:numdotdecimal" decimals="-8" scale="0" unitRef="USD">5,500,000,000</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="font-weight: bold; text-align: center">Total:</td><td style="font-weight: bold">&#160;</td>
    <td style="font-weight: bold; text-align: left">&#160;</td><td id="xdx_98C_eus-gaap--ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod_pid_c20210222__20210223__us-gaap--TypeOfArrangementAxis__custom--PerformanceShareUnitAwardAgreementMember__srt--TitleOfIndividualAxis__custom--Mr.FischelMember_zGjaMS6uNmY1" title="Number of shares subject to PSU" style="font-weight: bold; text-align: right"><ix:nonFraction name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod" contextRef="From2021-02-222021-02-23_custom_PerformanceShareUnitAwardAgreementMember_custom_Mr.FischelMember" id="Fact001235" format="ixt:numdotdecimal" decimals="INF" unitRef="Shares">13,000,000</ix:nonFraction></td><td style="font-weight: bold; text-align: left">&#160;</td><td>&#160;</td>
