    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" contextRef="From2025-07-01to2026-06-30" id="Fact001027" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">3,159,400</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)&#160;</td><td style="padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; text-align: right">(<ix:nonFraction name="us-gaap:IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance" contextRef="From2024-07-012025-06-30" id="Fact001028" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">747,900</ix:nonFraction></td><td style="padding-bottom: 1pt; text-align: left">)</td></tr>
