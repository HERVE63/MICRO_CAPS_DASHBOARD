    <td style="width: 1%; text-align: left">$</td><td style="width: 13%; text-align: right"><ix:nonFraction name="us-gaap:IncomeTaxReconciliationIncomeTaxExpenseBenefitAtFederalStatutoryIncomeTaxRate" contextRef="From2025-07-01to2026-06-30" id="Fact001024" format="ixt:numdotdecimal" decimals="0" unitRef="USD">3,159,400</ix:nonFraction></td><td style="width: 1%; text-align: left"/><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 13%; text-align: right"><ix:nonFraction name="us-gaap:IncomeTaxReconciliationIncomeTaxExpenseBenefitAtFederalStatutoryIncomeTaxRate" contextRef="From2024-07-012025-06-30" id="Fact001025" format="ixt:numdotdecimal" decimals="0" unitRef="USD">747,900</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr id="xdx_400_eus-gaap--IncomeTaxReconciliationChangeInDeferredTaxAssetsValuationAllowance_maITEBzdg2_zR3aWt7GwbKb" style="vertical-align: bottom; background-color: White">
