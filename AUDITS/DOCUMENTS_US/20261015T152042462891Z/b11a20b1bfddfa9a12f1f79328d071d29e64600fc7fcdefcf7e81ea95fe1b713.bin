     <td style="padding-top:0in;padding-left:0.037in;vertical-align:top;padding-bottom:0in;padding-right:0.037in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">The Marcus Corporation</span></p></td>
