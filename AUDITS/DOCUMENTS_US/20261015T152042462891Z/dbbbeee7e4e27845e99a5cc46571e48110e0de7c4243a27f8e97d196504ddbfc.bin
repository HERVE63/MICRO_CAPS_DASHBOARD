  <div class="main-content-container" style="z-index:5;position:relative;"><div><ix:continuation id="F_9080ef0c-1b2e-48fa-9605-52cb0a94d538_1"><p style="font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">costs were immaterial for the fiscal years ended January 31, 2026 and February 1, 2025</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">. </span><span style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_bdb7bc1f-aa24-4c3c-8eb9-7df006d85d53" contextRef="C_17e2b030-4567-401b-b6fb-2fc757677249" name="us-gaap:LeaseCostTableTextBlock" escape="true" continuedAt="F_bdb7bc1f-aa24-4c3c-8eb9-7df006d85d53_1"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">The Company's lease cost is comprised of the following:</span></ix:nonNumeric></span></p><div style="font-size:11pt;font-family:'Calibri',sans-serif;"><ix:continuation id="F_bdb7bc1f-aa24-4c3c-8eb9-7df006d85d53_1"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
