ont-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#f0f0f0;border-top:1pt solid #ff1c3d;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#f0f0f0;border-top:1pt solid #ff1c3d;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#f0f0f0;border-top:1pt solid #ff1c3d;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#f0f0f0;border-top:1pt solid #ff1c3d;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#f0f0f0;border-top:1pt solid #ff1c3d;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:middle"><div style="margin-bottom:3pt"><span style="color:#000000;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:700;line-height:130%">Susan M. Collyns</span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">65,000</span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">99,995</span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">&#8212;</span></div></td><td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:400;line-height:130%">164,995</span></div></td><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#f0f0f0;padding:0 1pt"/><td colspan="3" style="background-color:#f0f0f0;padding:1.5pt 1pt;text-align:left;vertical-align:middle"><div style="margin-bottom:3pt"><span style="color:#000000;font-family:'Poppins',sans-serif;font-size:8pt;font-weight:700;line-height:130%">Neil F. Dimick</span><span style="color:#000000;font-family:'Poppins',sans-serif;font-size:5.2pt;font-weight:700;line-height:130%;position:relative;top:-2.8pt;vertical-align:baseline">(3)</span></div></td><td colspan="3" style="background-color:#f0f0f0;padding:1.5pt 1pt;text-align:right;vertical-align:middle"><div style="margin-bottom:3pt;text-align:right"><span style="color:#121212;font-family:'Poppins',sans-serif;f