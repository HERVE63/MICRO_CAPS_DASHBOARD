    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_902_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20260630__srt--RangeAxis__srt--MinimumMember__us-gaap--PropertyPlantAndEquipmentByTypeAxis__custom--OtherEquipmentMember_zolMs6x1xqu1" title="Property, plant and equipment, estimated useful life"><ix:nonNumeric contextRef="AsOf2026-06-30_srt_MinimumMember_custom_OtherEquipmentMember" format="ixt-sec:duryear" id="Fact000794" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">3</ix:nonNumeric></span> to <span id="xdx_905_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20260630__srt--RangeAxis__srt--MaximumMember__us-gaap--PropertyPlantAndEquipmentByTypeAxis__custom--OtherEquipmentMember_z1DR1WGIdjma" title="Property, plant and equipment, estimated useful life"><ix:nonNumeric contextRef="AsOf2026-06-30_srt_MaximumMember_custom_OtherEquipmentMember" format="ixt-sec:duryear" id="Fact000796" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">5</ix:nonNumeric></span></span></td><td style="text-align: left">&#160;</td></tr>
