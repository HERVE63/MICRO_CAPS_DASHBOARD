    <tr style="vertical-align: top;">
     <td style="width: 18pt;">&#160;</td>
     <td style="width: 18pt;"> <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#8226;</p> </td>
     <td style="width: auto;"> <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">our ability to make alternate arrangements to account for any disruptions or shutdowns that may affect suppliers&#8217; facilities or the operations upon which our business is dependent including technical and mechanical systems;</p> </td>
    </tr>

   </tbody>
  </table>
  <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;">
