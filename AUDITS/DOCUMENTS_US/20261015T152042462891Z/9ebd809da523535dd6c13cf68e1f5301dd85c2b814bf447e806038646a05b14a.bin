  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:ProductWarrantyDisclosureTextBlock" id="c3127738" escape="true">
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><b>NOTE <em style="font: inherit;">9.</em> </b>&#160;&#160;&#160;&#160;<b>PRODUCT WARRANTIES</b></p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">Product warranty activity consisted of the following for the years ended:</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;">&#160;</p>
