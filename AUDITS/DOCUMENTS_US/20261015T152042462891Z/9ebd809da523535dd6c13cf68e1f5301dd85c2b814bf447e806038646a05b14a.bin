     <td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; border-top: 1px solid black;">&#160;</td>
     <td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; border-top: 1px solid black;">&#160;</td>
     <td colspan="2" style="text-align: center; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; margin-left: 0pt; border-top: 1px solid black;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; font-variant: normal; text-align: center; margin: 0pt;"><b>All Other Compensation</b></p> </td>
