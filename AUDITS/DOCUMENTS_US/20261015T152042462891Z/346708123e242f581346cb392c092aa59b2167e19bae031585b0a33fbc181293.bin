    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="ecd:AdjToCompAmt" contextRef="From2023-01-012023-12-31_ecd_NonPeoNeoMember_custom_CAPOfUnvestedEquityAtFYEMember" id="Fact000091" format="ixt:numdotdecimal" decimals="0" unitRef="USD">39,180</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
