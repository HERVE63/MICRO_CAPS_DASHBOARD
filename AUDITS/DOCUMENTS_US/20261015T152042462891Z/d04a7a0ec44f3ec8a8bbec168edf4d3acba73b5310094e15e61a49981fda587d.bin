<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><td style="vertical-align: bottom; width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 3pt; text-align: left; text-indent: 0pt;"><a style="-sec-extract:exhibit;" href="#bs">Consolidated Balance Sheets as of&#160;December 28, 2025 and December 29, 2024</a></p> </td><td style="vertical-align: bottom; width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:right;"><a class="tocPGNUM" href="#bs">45</a></p> </td></tr>
<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><td style="vertical-align: bottom; width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 3pt; text-align: left; text-indent: 0pt;"><a style="-sec-extract:exhibit;" href="#ops">Consolidated Statements of Operations for the Fiscal Years 2025 and&#160;2024</a></p> </td><td style="vertical-align: bottom; width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:right;"><a class="tocPGNUM" href="#ops">46</a></p> </td></tr>
<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><td style="vertical-align: bottom; width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 3pt; text-align: left; text-indent: 0pt;"><a style="-sec-extract:exhibit;" href="#cf">Consolidated Statements of Cash Flows for the Fiscal Years 2025 and&#160;2024</a></p> </td><td style="vertical-align: bottom; width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:right;"><a class="tocPGNUM" href="#cf">47</a></p> </td></tr>
<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><td style="vertical-align: bottom; width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 3pt; text-align: left; text-indent: 0pt;"><a style="-sec-extract:exhibit;" href="#equity">Consolidated Statements of Stockholders&#8217; Equity for the Fiscal Years 2025 and&#160;2024</a></p> </td><td style="vertical-align: bottom; width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:right;"><a class="tocPGNUM" href="#equity">48</a></p> </td></tr>
<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><td style="vertical-align: bottom; width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><a style="-sec-extract:exhibit;" href="#notes">Notes to Consolidated Financial Statements</a></p> </td><td style="vertical-align: bottom; width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-top: 3px; padding-bottom: 3px;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:right;"><a class="tocPGNUM" href="#notes">49</a></p> </td></tr>
