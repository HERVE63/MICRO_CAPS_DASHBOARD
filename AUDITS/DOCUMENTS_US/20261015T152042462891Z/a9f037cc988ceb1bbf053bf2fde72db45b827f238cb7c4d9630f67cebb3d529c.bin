     <td style="padding-top:0.003in;padding-left:0.003in;vertical-align:top;padding-bottom:0.003in;padding-right:0.003in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="font-size:8pt;font-family:'Segoe UI Symbol',sans-serif;"><ix:nonNumeric id="F_ed7fcba6-513a-41ee-b95a-96cf86e9dd80" contextRef="C_e48bb663-14cf-409e-bf19-d16997d77fde" name="dei:EntitySmallBusiness" format="ixt:fixed-true"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#9746;</span></ix:nonNumeric></span></p></td>
