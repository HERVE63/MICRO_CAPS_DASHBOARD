<td style=" BORDER-LEFT:0.75pt solid #ffffff;vertical-align:bottom"/>
<td style="vertical-align:bottom;text-align:center" colspan="4"> <p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt; font-family:ARIAL;text-align:center"><span style="color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">2025&#160;Annual&#160;Base</span></span></span></p> <p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt; font-family:ARIAL;text-align:center"><span style="color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">Salary</span></span></span></p> <p style="margin-top:0pt; margin-bottom:1pt; font-size:9pt; font-family:ARIAL;text-align:center"><span style="color:#ffffff"><span style="font-weight:bold"><span style="color:#ffffff">($)</span></span></span></p></td>
