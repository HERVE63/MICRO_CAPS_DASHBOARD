<tr style="page-break-inside:avoid ; font-family:ARIAL; font-size:9pt">
<td style="BORDER-LEFT:2.00pt solid #7f7f7f; BORDER-BOTTOM:2.00pt solid #7f7f7f; padding-left:8pt;vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:0.56em; text-indent:-0.56em; font-size:9pt; font-family:ARIAL;font-weight:bold">Mr.&#160;Hanson<sup style="font-size:75%; vertical-align:top">(2)</sup></p></td>
<td style=" BORDER-LEFT:0.75pt solid #bfbfbf; BORDER-BOTTOM:2.00pt solid #7f7f7f;vertical-align:bottom">&#160;&#160;</td>
<td style="BORDER-BOTTOM:2.00pt solid #7f7f7f;vertical-align:bottom;text-align:center">70%</td>
<td style=" BORDER-LEFT:0.75pt solid #bfbfbf; BORDER-BOTTOM:2.00pt solid #7f7f7f;vertical-align:bottom">&#160;&#160;</td>
