  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 78%; text-align: left">Michael R. Chambrello</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 18%; text-align: right">22,555</td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: justify">Ira H. Raphaelson</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right">42,716</td><td style="text-align: left">&#160;</td></tr>
