n:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%">$</span></td><td style="background-color:#ffffff;border-bottom:3pt double #000;border-top:1pt solid #000;padding:2.62pt 0 1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:9pt;font-weight:400;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-590" decimals="-3" name="us-gaap:FinancingReceivableModifiedPast12Months" scale="3" id="f-2911">21</ix:nonFraction>&#160;</span></td><td style="background-color:#ffffff;border-bottom:3pt double #000;border-top:1pt solid #000;padding:2.62pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/></tr></table></div></ix:continuation><div style="padding-left:27pt;text-align:justify"><span><br/></span></div><div style="padding-left:27pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">There were no loans that were modified within the twelve months ended June 30, 2026 that subsequently defaulted during the period presented. </span></div><div style="padding-left:27pt;text-align:justify"><span><br/></span></div><div style="padding-left:13.5pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Other Real Estate Owned</span></div></ix:continuation><div style="padding-left:13.5pt;text-align:justify"><span><br/></span></div><div style="padding-left:27pt;text-align:justify"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%"><ix:continuation id="f-942-17">The Company had $<ix:nonFraction unitRef="usd" contextRef="c-5" decimals="-5" name="us-gaap:OtherRealEstate" scale="6" id="f-2912">4.1</ix:nonFraction>&#160;million in other real estate owned (&#8220;OREO&#8221;) as of June&#160;30, 2026, which consisted of <ix:nonFraction unitRef="property" contextRef="c-746" decimals="INF" name="inbk:OtherRealEstateOwnedNumberOfProperties" format="ixt-sec:numwordsen" scale="0" id="f-2913">three</ix:nonFraction> small business lending properties and <ix:nonFraction unitRef="property" contextRef="c-747" decimals="INF" name="inbk:OtherRealEstateOwnedNumberOfProperties" format="ixt-sec:numwordsen" scale="0" id="f-2914">one</ix:nonFraction> single tenant lease property. The Company had $<ix:nonFraction unitRef="usd" contextRef="c-6" decimals="-5" name="us-gaap:OtherRealEstate" scale="6" id="f-2915">2.6</ix:nonFraction>&#160;million in OREO as of December&#160;31, 2025, which consisted of <ix:nonFraction unitRef="property" contextRef="c-748" decimals="INF" name="inbk:OtherRealEstateOwnedNumberOfProperties" format="ixt-sec:numwordsen" scale="0" id="f-2916">three</ix:nonFraction> small business lending properties. There were <ix:nonFraction unitRef="loan" contextRef="c-5" decimals="INF" name="inbk:MortgageLoansInProcessOfForeclosureNumberOfLoans" format="ixt-sec:numwordsen" scale="0" id="f-2917">thirteen</ix:nonFraction> loans totaling $<ix:nonFraction unitRef="usd" contextRef="c-5" decimals="-5" name="us-gaap:MortgageLoansInProcessOfForeclosureAmount" scale="6" id="f-2918">0.4</ix:nonFraction>&#160;million and <ix:nonFraction unitRef="loan" contextRef="c-6" decimals="INF" name="inbk:MortgageLoansInProcessOfForeclosureNumberOfLoans" format="ixt-sec:numwordsen" scale="0" id="f-2919">eight</ix:nonFraction> loans totaling $<ix:nonFraction unitRef="usd" contextRef="c-6" decimals="-5" name="us-gaap:MortgageLoansInProcessOfForeclosureAmount" scale="6" id="f-2920">2.5</ix:nonFraction>&#160;million, in the process of foreclosure at June 30, 2026 and December&#160;31, 2025, respectively.</ix:continuation> </span></div><div style="padding-left:27pt;text-align:justify"><span><br/></span></div><div style="height:42.75pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">31</span></div></div></div><div id="i65644a038a724d8e9b07f645604213c7_61"></div><hr style="page-break-after:always"/><div style="min-height:42.75pt;width:100%"><div><span><br/></span></div></div><div><span><br/></span></div><div><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">Note 5:&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;<ix:nonNumeric contextRef="c-1" name="us-gaap:PropertyPlantAndEquipmentDisclosureTextBlock" id="f-2921" continuedAt="f-2921-1" escape="true">Premises and Equipment</ix:nonNumeric></span></div><ix:continuation id="f-2921-1" continuedAt="f-2921-2"><div style="text-indent:29.25pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">&#160;</span></div><ix:nonNumeric contextRef="c-1" name="us-gaap:PropertyPlantAndEquipmentTextBlock" id="f-2922" continuedAt="f-2922-1" escape="true"><div style="margin-bottom:6pt;text-align:justify;text-indent:29.25pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The following table summarizes premises and equipment at June&#160;30, 2026 and December&#160;31, 2025.</span></div></ix:nonNumeric></ix:continuation><div style="text-align:justify;text-indent:29.25pt"><span><br/></span></div><div style="text-align:center;text-indent:29.25pt"><ix:continuation id="f-2922-1"><ix:continuation id="f-2921-2"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.853%"><tr><td style="width:1.0%"/><td style="width:61.125%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.532%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:17.055%"/><td style="width:0.1%"/><td style="width:0.1%"/><td sty