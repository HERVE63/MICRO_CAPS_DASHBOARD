			<td style="vertical-align:bottom;width:28.2%;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">Chief Executive Officer and Chairman</p>
			</td>
		</tr>
		<tr style="background-color: rgb(255, 255, 255);">
			<td style="vertical-align:bottom;width:15.1%;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">Grant Dawson</p>
