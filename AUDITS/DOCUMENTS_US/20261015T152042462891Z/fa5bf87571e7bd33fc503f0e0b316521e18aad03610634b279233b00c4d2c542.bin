y:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Net loss</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.44%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.15%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NetIncomeLossAvailableToCommonStockholdersBasic" sign="-" scale="3" id="Tc_Afk2Fisoq0KPpO8fAEcPzg_4_3"><ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NetIncomeLossAvailableToCommonStockholdersDiluted" sign="-" scale="3" id="Tc_Afk2Fisoq0KPpO8fAEcPzg_4_3_2">153</ix:nonFraction></ix:nonFraction>)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.44%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.15%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2025_To_6_30_2025_zHtNOUhmF06JrqLoRO40hQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NetIncomeLossAvailableToCommonStockholdersBasic" sign="-" scale="3" id="Tc_sc9qZfc1BU-OY6QXyYMqkw_4_6"><ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2025_To_6_30_2025_zHtNOUhmF06JrqLoRO40hQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NetIncomeLossAvailableToCommonStockholdersDiluted" sign="-" scale="3" id="Tc_sc9qZfc1BU-OY6QXyYMqkw_4_6_2">597</ix:nonFraction></ix:nonFraction>)</p></td></tr><tr style=""><td style="vertical-align:bottom;width:63.72%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Net loss per share &#8211; basic and diluted</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.44%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.53%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:14.15%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 0pt 0.05pt 0pt;"> (<ix:nonFraction unitRef="Unit_Divide_USD_shares_W8uZoWMNrE6XwZm2yqsMwg" contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" decimals="2" format="ixt:num