pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.6%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_0cQY1qkac0idsw17AIVT_A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAndCapitalLeaseObligationsCurrent" scale="3" id="Tc_mSHLq3MFrEWPPcPLOy-xSQ_9_6">6,884</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:71.44%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Total long-term debt, net</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.6%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> &#8212;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.41%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:10.6%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> &#8212;</p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;"><i style="font-style:italic;">Amended and Restated Loan Agreement</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On August 25, 2021, the Company entered into the Loan Agreement. Under the Loan Agreement, the Bank will continue to provide the Ranor Term Loan and the revolving line of credit, or the Revolver Loan. In addition, the Bank provided the Stadco Term Loan (as defined below) in the original amount of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_8_25_2021_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_CreditFacilityAxis_tpcs_RevolverLoanMember_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_TpK9cLoHDEOEwcNEpJiRwQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_0Br00BtRcUaYlEzeetnmRg">4,000</ix:nonFraction>. The proceeds of the original Ranor Term Loan of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_8_25_2021_To_8_25_2021_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_3Wsddlths0abyDFk_tNVcA" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:ProceedsFromTermLoan" scale="3" id="Narr_UPItyfitfU-f87_CShnzbA">2,850</ix:nonFraction> were used to refinance existing mortgage debt at Ranor. The proceeds of the Revolver Loan are used for working capital and general corporate purposes of the Company. The proceeds of the Stadco Term Loan were to be used to support the acquisition of Stadco and refinance existing indebtedness of Stadco.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">Through January 12, 2026, Ranor and certain affiliates of the Company entered into thirteen separate amendments to the Amended and Restated Loan Agreement and First Amendment to Promissory Note that extended the maturity date of the Ranor Term Loan and Revolver Loan to December 15, 2027 and May 15, 2026, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On May 13, 2026, Ranor and the other Borrowers entered into a Fourteenth Amendment to Amended and Restated Loan Agreement and Tenth Amendment to Second Amended and Restated Promissory Note with the Bank. The Amendment, among other things, extends the maturity date of the Revolver Loan from May 15, 2026 to September 15, 2026.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;"><i style="font-style:italic;">Stadco Term Loan</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;">On August 25, 2021, Stadco borrowed $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_8_25_2021_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_sy18IGBTvk6l00ISQZVVYg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_xHh4o4dzq0O-qa_s8IbRLQ">4,000</ix:nonFraction> from the Bank, or the &#8220;Stadco Term Loan&#8221;. Interest on the Stadco Term Loan is due on unpaid balances at a fixed rate per annum equal to the&#160;<span style="-sec-ix-hidden:Hidden_p0pMFFOgBU-efkUMOSXDiw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">7 - year</span></span>&#160;Federal Home Loan Bank of Boston Classic <span style="-sec-ix-hidden:Hidden_DjarmINbA0ev0nh0YPCErw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">Advance</span></span> Rate plus&#160;<ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_8_25_2021_To_8_25_2021_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_wUKeTsL7bU2tcZLnrNjglw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_swUXf6QUgkyNM3VDy5MRhA">2.25</ix:nonFraction>%. Since September 25, 2021 and on the 25th day of each month thereafter, Stadco had made and will make monthly payments of principal and interest in the amount of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_8_25_2021_To_8_25_2021_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_wUKeTsL7bU2tcZLnrNjglw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentPeriodicPayment" scale="3" id="Narr_g6RJZ-BnJkO49BSctv8MRQ">54</ix:nonFraction> each, with all outstanding principal and accrued interest due and payable on August 25, 2028. Interest shall be calculated based on actual days elapsed and a 360-day year.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Unamortized debt issue costs on June 30, 2026 and March 31, 2026 were $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_in_L873IvEeCRboWwruQRg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:UnamortizedDebtIssuanceExpense" scale="3" id="Narr_T_2nkWYEDUWy4i8BtC0ubw">1</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_us-gaap_DebtInstrumentAxis_tpcs_StadcoTermLoanAt379PercentInterestDueAugust2028Member_RqDfehJtmUmJrRUVpvhl3A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:UnamortizedDebtIssuanceExpense" scale="3" id="Narr_xkgFCbJsv02uBtwoq782pw">3</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 10pt 0pt;"><i style="font-style:italic;">Ranor Term Loan and Revolver Loan</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">A term loan was made to Ranor by the Bank in 2016 in the amount of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_12_21_2016_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_CreditFacilityAxis_us-gaap_SecuredDebtMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_fo5JIKppB0y5JzJAznUiYQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_VMb_h0f_4UmaYbBKWIzLSw">2,850</ix:nonFraction>, or the &#8220;Ranor Term Loan&#8221;. Payments are made in monthly installments of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_1_20_2017_To_1_20_2017_us-gaap_CreditFacilityAxis_us-gaap_SecuredDebtMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_U7OdtrVM9EamXvOxqZsg3A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentPeriodicPayment" scale="3" id="Narr_JYdkZc5IKkuf-EAFnW56KQ">17</ix:nonFraction> each, inclusive of interest at a fixed rate of <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_1_20_2017_us-gaap_CreditFacilityAxis_us-gaap_SecuredDebtMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_gBUT6Qyd90mXT_SvlGHHVw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentInterestRateStatedPercentage" scale="-2" id="Narr_030Fj7x5v0eJ1fM7Xr4hrQ">6.05</ix:nonFraction>% per annum, with all outstanding principal and accrued interest due and payable on December 15, 2027.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Company agrees to pay the Bank, as consideration for the Bank&#8217;s agreement to make the Revolver Loan available, a nonrefundable Revolver Loan fee equal to <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_CreditFacilityAxis_tpcs_RevolverLoanMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_sjf3CEXsZUu77PH5jhjR4w" decimals="4" format="ixt:num-dot-decimal" name="tpcs:NonrefundableCommitmentFeePercentages" scale="-2" id="Narr_XzeZxeWWPkSlxQwoER8nZg">0.25</ix:nonFraction>% per annum (computed based on a year of 360 days and actual days elapsed) on the difference between the amount of: (a) $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_g3tsi4sz7kKbFxaE0S2--g" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:MaximumAmountOfBorrowingBaseRequiredToGrantLoanAdvance" scale="3" id="Narr_J99bCF-2G020fYpZ1Mu-Dw">4,500</ix:nonFraction>, and (b) the average daily outstanding balance of the Revolver Loan during the quarterly period then ended. All Revolver Loan fees are payable quarterly in arrears on the first day of each January, April, July and October and on the Revolver Maturity Date, or upon acceleration of the Revolver Loan, if earlier. Interest-only payments on advances made under the Revolver Loan will continue to be payable monthly in arrears. Under the amended promissory note for the Revolver Loan, the Company pays interest at the Term SOFR-based rate.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Between December 20, 2021 and May 13, 2026, Ranor and the other borrowers entered into fourteen separate amendments with the Bank to, among other things, extend the maturity date of the Revolver Loan to September 15, 2026.</p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">14</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_gxxgLQcqhUmC_8EPCtaUsg_cont1" continuedAt="Tb_gxxgLQcqhUmC_8EPCtaUsg_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Paid and accrued interest expense under the Revolver Loan during the three months ended June 30, 2026 and 2025 was $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_CreditFacilityAxis_tpcs_RevolverLoanMember_R8qyCOn-1kuGqdfcYPGcKw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InterestExpenseDebt" scale="3" id="Narr_Rh1cINaW5kGBtMNmdYoDcg">40</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_CreditFacilityAxis_tpcs_RevolverLoanMember_1a4zbP04g0ajQcRhFh5brw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InterestExpenseDebt" scale="3" id="Narr_Q4qiG4YV8Umyj4kUgR3OCQ">53</ix:nonFraction>, respectively. The weighted average interest rate as of June 30, 2026 and March 31, 2026 was <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_6_30_2026_us-gaap_CreditFacilityAxis_us-gaap_RevolvingCreditFacilityMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_LNFNBk2NUEOnSAbfM-bqjw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtWeightedAverageInterestRate" scale="-2" id="Narr_0L9IfNopyECu9WIzW2pUCw">6.26</ix:nonFraction>% and <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_3_31_2026_us-gaap_CreditFacilityAxis_us-gaap_RevolvingCreditFacilityMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_E7Xr5n3A2kCafyo0k1-4kA" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtWeightedAverageInterestRate" scale="-2" id="Narr_XkvewBytakmxWNn7r6zVzQ">6.70</ix:nonFraction>%, respectively. The weighted average amount outstanding during the three months ended June 30, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_g3tsi4sz7kKbFxaE0S2--g" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:WeightedAverageAmountOutstandingValue" scale="3" id="Narr_246IxCbBvUW09w6s7I89lQ">2,498</ix:nonFraction>. There was $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_CreditFacilityAxis_tpcs_RevolverLoanMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_ev0SJTt3EkOGGLKiBxtyEw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentCarryingAmount" scale="3" id="Narr_YNfrX3mmNUyqpw5FIehG4A">1,599</ix:nonFraction> outstanding under the Revolver Loan as of June 30, 2026. Unused borrowing capacity as of June 30, 2026 and March 31, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_CreditFacilityAxis_us-gaap_RevolvingCreditFacilityMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_LNFNBk2NUEOnSAbfM-bqjw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_q0MUq8urlEGUuBnicjf-_Q">1,788</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_us-gaap_CreditFacilityAxis_us-gaap_RevolvingCreditFacilityMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_E7Xr5n3A2kCafyo0k1-4kA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_zuieJWfHN0CZjiaIINzHTQ">1,054</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Unamortized debt issue costs on June 30, 2026 and March 31, 2026 were $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_4vqUC-V68kybulnFnyCpbQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:UnamortizedDebtIssuanceExpense" scale="3" id="Narr_0JluoLKvi0uHrqRQMznurQ">151</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_DebtInstrumentAxis_tpcs_RanorTermLoanMember_VRifSfc_eUCL2t6jdAWSzA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:UnamortizedDebtIssuanceExpense" scale="3" id="Narr_fNix7F3CE0ClBa_gXjTXAA">150</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Loan Covenants</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">For purposes of this discussion, Ranor and Stadco are referred to together as the &#8220;Borrowers&#8221;. The Company agreed to maintain compliance with certain financial covenants under the Loan Agreement. Namely, the Borrowers agree to maintain the ratio of the Cash Flow of TechPrecision-to-the Total Debt Service of TechPrecision of not less than <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_4_1_2026_To_6_30_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_bk9eT9FlMUmzO-A0KlG4hQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:CashFlowRatioOfDebtService" scale="0" id="Narr_CMM6Z3LPK0myGeFJPvMYkw">1.20</ix:nonFraction> to <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_4_1_2026_To_6_30_2026_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_eltp3uELPU6UrL4VzHWQZQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:CashFlowRatioOfDebtService" scale="0" id="Narr_2jFcsOGX70asMHRferGVFQ">1.00</ix:nonFraction>, measured quarterly on the last day of each fiscal quarter, or annual period of TechPrecision on a trailing 12-month basis. Calculations will be based on the audited (year-end) and unaudited (quarterly) consolidated financial statements of TechPrecision. Quarterly tests are measured based on the financial statements included in the Company&#8217;s quarterly reports on Form 10-Q within 60 days of the end of each quarter, and annual tests will be measured based on the financial statements included in the Company&#8217;s annual reports on Form 10-K within 120 days after the end of each fiscal annual period. Cash Flow means an amount, without duplication, equal to the sum of net income of TechPrecision plus (i) interest expense, plus (ii) taxes, plus (iii) depreciation and amortization, plus (iv) stock based compensation expense taken by TechPrecision, plus (v) non-cash losses and charges and one time or non-recurring expenses at the Bank&#8217;s discretion, less (vi) the amount of cash distributions, if any, made to stockholders or owners of TechPrecision, less (vii) cash taxes paid by the TechPrecision, all as determined in accordance with U.S. GAAP. &#8220;Total Debt Service&#8221; means an amount, without duplication, equal to the sum of (i) all amounts of cash interest paid on liabilities, obligations, and reserves of TechPrecision paid by TechPrecision, (ii) all amounts paid by TechPrecision in connection with current maturities of long-term debt and preferred dividends, and (iii) all payments on account of capitalized leases, all as determined in accordance with U.S. GAAP.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Borrowers agreed to cause their Balance Sheet Leverage to be less than or equal <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_4_1_2026_To_6_30_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_bk9eT9FlMUmzO-A0KlG4hQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:DebtInstrumentCovenantLeverageRatioYearOne" scale="0" id="Narr_okZ7GSPeAkSOQF4cCmfqbw">2.50</ix:nonFraction> to <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_4_1_2026_To_6_30_2026_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_eltp3uELPU6UrL4VzHWQZQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:DebtInstrumentCovenantLeverageRatioYearOne" scale="0" id="Narr_D6UWrcNlpUKXfbCa5VnBqg">1.00</ix:nonFraction>. For purposes of this covenant, &#8220;Balance Sheet Leverage&#8221; means, at any date of determination, the ratio of Borrowers&#8217; (a) Total Liabilities, less Subordinated Debt, to (b) Net Worth, plus Subordinated Debt.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Borrowers agree to maintain a Loan-to-Value Ratio of not greater than <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_6_30_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_ckkhkKRm4Ee33H3ilwdsuQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:DebtInstrumentCovenantLoanToValueRatio" scale="0" id="Narr_5fc4xpukjkO1LA-cxnHhrQ">0.75</ix:nonFraction> to <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_6_30_2026_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_BPCnk9fZdEq7cOhF4AahdQ" decimals="2" format="ixt:num-dot-decimal" name="tpcs:DebtInstrumentCovenantLoanToValueRatio" scale="0" id="Narr_06mUMCB8xU6O-WMvohgYVQ">1.00</ix:nonFraction>. &#8220;Loan-to-Value Ratio&#8221; means the ratio of (a) the sum of the outstanding balance of the Ranor Term Loan and the Stadco Term Loan to (b) the fair market value of the property pledged as collateral for the loan, as determined by an appraisal obtained from time to time by the Bank, but not more frequently than one time during each <ix:nonNumeric contextRef="Duration_4_1_2026_To_6_30_2026_dei_LegalEntityAxis_tpcs_RanorIncMember_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_s_1GHTaWCUC8hvzuTIVW1g" format="ixt-sec:durday" name="tpcs:DebtInstrumentCovenantTrailingPeriodForMeasurementOfLoanToValueRatio" id="Narr_gHPmUfP5GEiuwNE8zAcR4A">365</ix:nonNumeric> day period (provided that the Bank may obtain an appraisal at any time after either the Ranor Term Loan or the Stadco Term Loan has been accelerated), which appraisals shall be at the expense of the Borrowers.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Borrowers agree that their combined annual capital expenditures shall not exceed $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_IBQbML08-0KKDMEKFSdjLw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CapitalExpendituresIncurredButNotYetPaid" scale="3" id="Narr_VNhW5u5TwUW0b-yj6ckDOA">1,500</ix:nonFraction>. Compliance shall be tested annually. On June 12, 2023, the Company and the Bank executed a waiver under which the Bank waived the Company&#8217;s noncompliance with the capital expenditure limit and acknowledged that specified capital expenditures can be excluded from the calculation of the Borrowers combined annual expenditures for the fiscal year ended March 31, 2024. For the fiscal years ended March 31, 2026 and 2025, the Company, including specified capital expenditures, exceeded combined annual capital expenditures of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2024_To_3_31_2025_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_ExhGlcAzBEuKqEtThmzKaw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CapitalExpendituresIncurredButNotYetPaid" scale="3" id="Narr_CZJbnU5oj0-rXer-Y-WEHw"><ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2025_To_3_31_2026_us-gaap_DebtInstrumentAxis_tpcs_BerkshireLoanMember_prO77l8ALk25icCG2ViNvQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:CapitalExpendituresIncurredButNotYetPaid" scale="3" id="Narr_IpUIbVcadEyjyCsld9_8aw">1,500</ix:nonFraction></ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">As of June 30, 2026, the Company was not in compliance with the balance sheet leverage covenant. The Company was also not in compliance with the balance sheet leverage covenant as of March 31, 2026 and 2025. The Bank retains the right to act on covenant violations that occur after the date of delivery of any waiver. The lender has not granted us a waiver. It is also probable that the Company will not be in compliance with the balance sheet leverage and other debt covenants at subsequent measurement dates within the next twelve months. As a result of the above, all of our long-term debt has been classified as current in our condensed consolidated balance sheet.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Collateral securing all the above obligations comprises all personal and real property of the Company, including cash, accounts receivable, inventories, equipment, and financial assets. The Company&#8217;s short-term and long-term debt is all privately held with no public market for this debt and is considered to be Level 3 under the fair value hierarchy. The carrying value of short and long-term borrowings approximates their fair value.</p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">15</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_gxxgLQcqhUmC_8EPCtaUsg_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;"><i style="font-style:italic;">Stadco Equipment Financing</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">Stadco entered into a <ix:nonNumeric contextRef="Duration_5_1_2024_To_5_1_2024_us-gaap_DebtInstrumentAxis_tpcs_EquipmentFinancingAgreementMember_Ad9UIqQoWEeCQSwmpAQ9Pw" format="ixt-sec:durwordsen" name="tpcs:EquipmentFinancingAgreementTerm" id="Narr_mSr1Vs8CUEOya5ptq-5ZGg">two-year</ix:nonNumeric> equipment financing agreement dated May 1, 2024 to purchase certain computer hardware for $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_5_1_2024_To_5_1_2024_us-gaap_DebtInstrumentAxis_tpcs_EquipmentFinancingAgreementMember_Ad9UIqQoWEeCQSwmpAQ9Pw" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:EquipmentFinancingAgreementPurchasePrice" scale="3" id="Narr_hSLLRqGpEEew73sBYq47yA">65</ix:nonFraction>. On the last day of each month, Stadco made monthly payments of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_5_1_2024_To_5_1_2024_us-gaap_DebtInstrumentAxis_tpcs_EquipmentFinancingAgreementMember_Ad9UIqQoWEeCQSwmpAQ9Pw" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:EquipmentFinancingAgreementMonthlyInstallmentsPayment" scale="3" id="Narr_Us0QhFpvzkG0ylKrjgxP2g">3</ix:nonFraction>, with all remaining outstanding amounts due and paid in full on April 30, 2026.</p></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" name="us-gaap:OtherLiabilitiesDisclosureTextBlock" id="Tb_s8kJJWi1KU6GLThOPCgw3g" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;12&#160;- OTHER NONCURRENT LIABILITIES</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Under an addendum to a contract purchase order, one of our customers agreed to reimburse the Company for the cost of certain new equipment. Payments are received as the Company incurs construction costs. All payments have been received under this contract. In case of a contract breach, at the time of the breach, the customer may claw back the funds based on a prorated ten-year straight-line annual declining balance recovery period. This liability amount is included in the Company&#8217;s condensed consolidated balance sheets as a noncurrent liability. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">We also signed contracts to purchase new equipment for another customer who agreed to reimburse the Company for the cost of the equipment. We received the first payment in fiscal 2024, with additional payments received during fiscal 2025 and 2026. Advance payments from the customer accrue in the Company&#8217;s condensed consolidated balance sheets as a noncurrent liability.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">As of June 30, 2026 and March 31, 2026, a total of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_g3tsi4sz7kKbFxaE0S2--g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ContractWithCustomerLiabilityNoncurrent" scale="3" id="Narr_KpPw0DT8IE2aVvvzyJevkQ">2,793</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_0cQY1qkac0idsw17AIVT_A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ContractWithCustomerLiabilityNoncurrent" scale="3" id="Narr_1_Qx5tP8AEy9A1iTS0kwXw">2,793</ix:nonFraction>, in the aggregate, was included in other noncurrent liabilities under the programs described above.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In fiscal year 2023, Stadco entered into an agreement with the Los Angeles Department of Water and Power, or &#8220;LADWP&#8221;, to settle previously outstanding amounts for water, water service, electric energy and/or electric service in the aggregate amount of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2023_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_RpGySwkIpE6fINiXFAbXbA" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:AggregateDelinquentAndUnpaidOutstandingAmountsForWaterWaterServiceElectricEnergyAndOrElectricService" scale="3" id="Narr_JMSSqpnw9k2cSU5WI5lDqQ">1,800</ix:nonFraction> that were delinquent and unpaid. Under the agreement, on December 15, 2022, Stadco began to make monthly installment payments on the unpaid balance beginning in an aggregate amount of $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_GQhSH0WF8k2IHA9qrGe97w" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:PaymentArrangementAgreementMonthlyInstalmentsPayable" scale="3" id="Narr_WEYN7S0b_02i3u0teBPgwg">18</ix:nonFraction> per month until the earlier of November 15, 2030, or the amount due is paid in full. Late payments will accrue a late payment charge equal to an <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="As_Of_6_30_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_GQhSH0WF8k2IHA9qrGe97w" decimals="0" format="ixt:num-dot-decimal" name="tpcs:PaymentArrangementAgreementAnnualLatePaymentChargePercentage" scale="0" id="Narr_xDCPJ0pnTkWHxUOvxvnx_A">18</ix:nonFraction>% annual rate on the unpaid balance. This liability amount was included in the Company&#8217;s condensed consolidated balance sheet as a current and noncurrent liability as of June 30, 2026 and March 31, 2026, for $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_GQhSH0WF8k2IHA9qrGe97w" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:AggregateDelinquentAndUnpaidOutstandingAmountsForWaterWaterServiceElectricEnergyAndOrElectricServiceCurrent" scale="3" id="Narr_br-BmoAo7kGgo1Lfu8_cVw">254</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_6_30_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_GQhSH0WF8k2IHA9qrGe97w" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:AggregateDelinquentAndUnpaidOutstandingAmountsForWaterWaterServiceElectricEnergyAndOrElectricServiceNoncurrent" scale="3" id="Narr_Zq2aBf2TW0eD1eQhnuXHxg">763</ix:nonFraction>, and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_JRJuEmZ-HE2zPv9DcwY9RA" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:AggregateDelinquentAndUnpaidOutstandingAmountsForWaterWaterServiceElectricEnergyAndOrElectricServiceCurrent" scale="3" id="Narr_WCcVC53EKUaperT-CwTKxg">221</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="As_Of_3_31_2026_us-gaap_TypeOfArrangementAxis_tpcs_PaymentArrangementAgreementWithDepartmentOfWaterAndPowerOfCityOfLosAngelesMember_JRJuEmZ-HE2zPv9DcwY9RA" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:AggregateDelinquentAndUnpaidOutstandingAmountsForWaterWaterServiceElectricEnergyAndOrElectricServiceNoncurrent" scale="3" id="Narr_FZH4mCRkjkuo8z0ymYYOfw">775</ix:nonFraction>, respectively.</p></ix:nonNumeric><a id="Tc_tVAq2NUqEkiOi-aQwzppfw_1_2"></a><a id="Tc_2Tfoa3Y39k2zCWLC-psuCw_1_5"></a><a id="Tc_3o5Y1kg_VECd8LL81GhqCg_2_0"></a><a id="Tc_NEOuH8ugYUO2IviEWDV_Cg_2_2"></a><a id="Tc_NVNzJKyYoEO4AYThjcxEpQ_2_5"></a><a id="Tc_8rQ4cBvRCEGXB8RBccasLw_3_0"></a><a id="Tc_dV75jKq57Uq2zQ5NM-xGHQ_4_0"></a><a id="Tc_osMkElztIE2uiwoj5X2r1A_5_0"></a><a id="Tc_D-FdNWBIw0CZrfa7dS5D_w_5_2"></a><a id="Tc_aqoFwwt9Hk6BuVbE3a8VQQ_5_5"></a><a id="Tc_Fzvrxtq-yEm-IBhIScKOLQ_6_2"></a><a id="Tc_RcUWNiQ5rEus-cJxzBBqqQ_6_5"></a><a id="Tc_B5TFytVPlUyevCX0hIrA7w_8_0"></a><a id="Tc_lvqrHnsETkK6cd7kzyM0rA_8_2"></a><a id="Tc_ltroENcHnUmIhbnXESzx_Q_8_5"></a><ix:nonNumeric contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" name="tpcs:LeaseOfLesseeDisclosureTextBlock" id="Tb_8S6RaAj-ikaWwqKgKGJ5tA" continuedAt="Tb_8S6RaAj-ikaWwqKgKGJ5tA_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;13&#160;- LEASES</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Stadco is a party to an amended building and property operating lease and a right of use asset. Monthly base rent for the property is $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_PropertyPlantAndEquipmentMember_5dLJ5nzhnUGT5GQyiJ_8wg" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:LesseeFinanceLeaseMonthlyPayments" scale="3" id="Narr_cKsCX-BHNECUEzkOyuaXxA">78</ix:nonFraction> per month. The term of the lease will expire on June 30, 2030, and the lessee has no right of renewal beyond the expiration date. The lease contains customary default provisions allowing the landlord to terminate the lease if the lessee fails to remedy a breach of its obligations under the lease within the period specified in the lease, or upon certain events of bankruptcy or seizure or attachment of the lessee&#8217;s assets or interest in the lease. The lease also contains other customary provisions for real property leases of this type.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In June 2026 Ranor signed an agreement to lease <ix:nonFraction unitRef="Unit_Standard_item_Tfu8k23rvEKLf0rkc_ljig" contextRef="As_Of_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_EquipmentMember_us-gaap_StatementBusinessSegmentsAxis_tpcs_RanorIncMember_NgKMOgZhBkSrnHMWG_8GXw" decimals="INF" format="ixt-sec:numwordsen" name="tpcs:NumberOfCopiers" scale="0" id="Narr_9wFvVGJ2MES9RJKmsF7k9A">four</ix:nonFraction> copiers over a period of <ix:nonNumeric contextRef="As_Of_6_30_2026_us-gaap_PropertyPlantAndEquipmentByTypeAxis_us-gaap_EquipmentMember_us-gaap_StatementBusinessSegmentsAxis_tpcs_RanorIncMember_NgKMOgZhBkSrnHMWG_8GXw" format="ixt-sec:durwordsen" name="us-gaap:LesseeOperatingLeaseTermOfContract" id="Narr_sZhIMljcmUqrJ_2zU1C7cA">five-years</ix:nonNumeric>. The equipment was placed in service July 2026. We pay $<ix:nonFraction unitRef="Unit_Standard_USD_pXnJPY5THkizHo1t3VPMcA" contextRef="Duration_7_1_2026_To_7_31_2026_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_pcKtibk5HUy5JMuKXMZgdQ" decimals="-3" format="ixt:num-dot-decimal" name="tpcs:LesseeFinanceLeaseMonthlyPayments" scale="3" id="Narr_chu3eZZEDU-vVH7AhWDjpA">2</ix:nonFraction> each month in total under <ix:nonFraction unitRef="Unit_Standard_pure_mu-VEfPZ3ECvS3DKK7gX1w" contextRef="Duration_7_1_2026_To_7_31_2026_us-gaap_SubsequentEventTypeAxis_us-gaap_SubsequentEventMember_pcKtibk5HUy5JMuKXMZgdQ" decimals="INF" format="ixt-sec:numwordsen" name="tpcs:NumberOfFinanceLeaseAgreements" scale="0" id="Narr_vLqZSNbXXEmvGDbKLjD0Cw">two</ix:nonFraction> separate finance leases.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">The following table lists our right-of-use assets and liabilities on our condensed consolidated balance sheets at:</p><ix:nonNumeric contextRef="Duration_4_1_2026_To_6_30_2026_HAtD8fqiKkelfXsZSscDKA" name="tpcs:ScheduleOfSupplementalBalanceSheetInformationRelatedToLeasesTableTextBlock" id="Tb_Gix0le8mMkCBpTTCtpwAUw" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:71.44%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.25%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Tim