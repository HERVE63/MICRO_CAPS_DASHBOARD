gin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantTotalNetLeverageRatioQuarterFourNextFiscalYear" scale="0" id="Narr_dh34TL1pLkGu8bA-OM11tw">3.40</ix:nonFraction> to 1.00</p></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:69.33%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0.05pt 0pt 0.05pt 0pt;">Fiscal quarter ending March 31, 2027</p></td><td style="vertical-align:bottom;white-space:nowrap;width:30.66%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantTotalNetLeverageRatioQuarterOneYearTwo" scale="0" id="Narr_PkN5jlagMEKaD4B-K-QK9g">3.25</ix:nonFraction> to 1.00</p></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:69.33%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0.05pt 0pt 0.05pt 0pt;">Fiscal quarter ending June 30, 2027</p></td><td style="vertical-align:bottom;white-space:nowrap;width:30.66%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantTotalNetLeverageRatioQuarterTwoYearTwo" scale="0" id="Narr_ZO9exmbTLk6AYIgwH7eEoQ">3.00</ix:nonFraction> to 1.00</p></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:69.33%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0.05pt 0pt 0.05pt 0pt;">Fiscal quarter ending September 30, 2027 and each fiscal quarter thereafter</p></td><td style="vertical-align:bottom;white-space:nowrap;width:30.66%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantTotalNetLeverageRatioQuarterThreeYearTwoAndEachQuarterAfterYearTwo" scale="0" id="Narr_auk0_r2gOk6MVWillOy68w">2.50</ix:nonFraction> to 1.00</p></td></tr></table></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">15</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:36.7pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">BATTALION OIL CORPORATION</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTES TO THE UNAUDITED CONDENSED CONSOLIDATED FINANCIAL STATEMENTS (continued)</b></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_iZOj8WYgOEyBa4k8DJRaXQ_1_0"></a><a id="Tc_FBYFGyGfFkGQV8_PKiU7-Q_1_3"></a><a id="Tc_lGtbYTHc_kOffjMUatKEow_2_0"></a><a id="Tc_h7Y6srho4EiipxqxHyXWFA_2_3"></a><a id="Tc_SBthT9I4BUaWZj_IJfJWkw_3_0"></a><a id="Tc_-eavvS2c5kGJVZTFktp9iA_4_0"></a><a id="Tc_AMfyi23RkUW-LWhSvTaWBg_1_0"></a><a id="Tc_3wRtwdtO30e67M01k5Xxig_1_3"></a><a id="Tc_ZDeTZRSveUGOgQkbp0_9Sg_2_0"></a><a id="Tc_u-4gsBJgwUa61wIPXQ-kOg_2_3"></a><a id="Tc_EVfHqjsPl02zYQzdb05ztg_3_0"></a><a id="Tc_bUdc4UHi3E-o0W0rcPBdGg_4_0"></a><ix:continuation id="Tb_Vc6cIfTtcUeJI6el0u8I8w_cont3" continuedAt="Tb_Vc6cIfTtcUeJI6el0u8I8w_cont4"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;background:#ffffff;margin:0pt 0pt 6pt 0pt;">Additionally, the Second Amendment provided that the Borrower should not permit the Asset Coverage Ratio, as of the last day of any fiscal quarter (commencing with the fiscal quarter ending March 31, 2025) to be less than the applicable level set forth in the following table for the applicable fiscal quarter:</p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_LeqMErBSKUSMxTIrmvq7eA" name="batl:ScheduleOfThresholdAssetCoverageRatioForComplianceOfDebtCovenantTableTextBlock" id="Tb_ipYzuNgADUWO5IWtPDSv_g" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><div style="padding-left:45pt;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:82.51%;"><tr style="height:1pt;"><td style="vertical-align:bottom;white-space:nowrap;width:76.01%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0.05pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:23.98%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0.05pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:76.01%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Fiscal Quarter</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:23.98%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">Asset Coverage Ratio</b></p></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:76.01%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0.05pt 0pt 0.05pt 0pt;">Fiscal quarters ending March 31, 2025 through and including December 31, 2026</p></td><td style="vertical-align:bottom;white-space:nowrap;width:23.98%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantAssetCoverageRatioQuarterOneOfCurrentFiscalYearThroughAndIncludingQuarterFourOfNextFiscalYear" scale="0" id="Narr_vqZO8wmFDUSN-VV6WiCdlg">1.85</ix:nonFraction> to 1.00</p></td></tr><tr style=""><td style="vertical-align:bottom;white-space:nowrap;width:76.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0.05pt 0pt 0.05pt 0pt;">Each fiscal quarter thereafter</p></td><td style="vertical-align:bottom;white-space:nowrap;width:23.98%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:center;margin:0.05pt 0pt 0.05pt 0pt;"><ix:nonFraction unitRef="Unit_Standard_pure__HAJHAyJfkuHxmsBxJ_Eww" contextRef="As_Of_12_11_2025_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_WNGgqUbxE0GSh-SUNqlbfw" decimals="2" format="ixt:num-dot-decimal" name="batl:LineOfCreditCovenantAssetCoverageRatioEachFiscalQuarterThereafter" scale="0" id="Narr_aUWZaqNDlEWMyT7FHKyN2w">2.00</ix:nonFraction> to 1.00</p></td></tr></table></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;background:#ffffff;margin:12pt 0pt 12pt 0pt;">On February 24, 2026, the Company entered into the Limited Consent, Third Amendment to Second Amended and Restated Senior Secured Credit Agreement and First Amendment to Fee Letter (the &#8220;Third Amendment&#8221;) to the 2024 Amended Term Loan Agreement. Pursuant to the Third Amendment, among other changes specified therein, (a) the lenders consented to the transactions contemplated by the West Quito Divestiture sale agreement; and (b) the Company was required, upon receipt of the net cash proceeds from the West Quito Divestiture, to prepay the outstanding principal amount of the 2024 Amended Term Loan Agreement borrowings in an aggregate amount equal to $<ix:nonFraction unitRef="Unit_Standard_USD_wpAg_pixNk6daaxK7TuvSw" contextRef="Duration_2_24_2026_To_2_24_2026_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_us-gaap_RestrictedCashAndCashEquivalentsCashAndCashEquivalentsAxis_batl_ReinvestmentProceedsAndFundsToCollateralizeCreditCardsMember_cqRr2Cp_PU2Uw_wHvRFFmA" decimals="-5" format="ixt:num-dot-decimal" name="batl:MandatoryPrepayment" scale="6" id="Narr_-mg-jeNg5UutOh4WVsKOQQ">40.0</ix:nonFraction> million. The Company may retain the remaining net cash proceeds received from the West Quito Divestiture, subject to certain reinvestment requirements, set forth in the Third Amendment (the &#8220;Reinvestment Proceeds&#8221;). Pursuant to the Third Amendment and continuing pursuant to the terms of the 2026 Term Loan Agreement (as defined below), on February 24, 2026, $<ix:nonFraction unitRef="Unit_Standard_USD_wpAg_pixNk6daaxK7TuvSw" contextRef="Duration_2_24_2026_To_2_24_2026_ecr1-7NhQ0qjZQymtwurOw" decimals="-5" format="ixt:num-dot-decimal" name="batl:ProceedsFromSaleOfProductiveAssetsHeldInReinvestmentAccount" scale="6" id="Narr_KU7spV2fBUyGe_j8IjBuLQ">12.9</ix:nonFraction> million of the proceeds from the sale were initially retained and held in a reinvestment account and recorded as restricted cash. At June 30, 2026, $<ix:nonFraction unitRef="Unit_Standard_USD_wpAg_pixNk6daaxK7TuvSw" contextRef="Duration_1_1_2026_To_6_30_2026_LeqMErBSKUSMxTIrmvq7eA" decimals="-5" format="ixt:num-dot-decimal" name="batl:ProceedsFromSaleOfProductiveAssetsHeldInReinvestmentAccount" scale="6" id="Narr_nG43xIzxhkqOQEFhpRaymw">5.2</ix:nonFraction> million of Reinvestment Proceeds remained as restricted cash in a reinvestment account.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:12pt;text-indent:18pt;margin:6pt 0pt 0pt 0pt;">The Third Amendment was accounted for as a partial extinguishment and as such, the Company recorded a loss on extinguishment of debt in the amount of $<ix:nonFraction unitRef="Unit_Standard_USD_wpAg_pixNk6daaxK7TuvSw" contextRef="Duration_2_24_2026_To_2_24_2026_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_Kw3F2CAbD0aFtXX14G3DIg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:GainsLossesOnExtinguishmentOfDebt" sign="-" scale="6" id="Narr_AyvrVUhrIUS4frG4HmzJqg">0.9</ix:nonFraction> million to write-off the proportionate amount of deferred financing costs and debt discount associated with the February 24, 2026 principal prepayment. The Company deferred an additional $<ix:nonFraction unitRef="Unit_Standard_USD_wpAg_pixNk6daaxK7TuvSw" contextRef="As_Of_3_31_2026_us-gaap_DebtInstrumentAxis_batl_TermLoanCreditAgreement2024Member_Ue9ZJERB6k6BgrJmpcPiIQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DeferredFinanceCostsNet" scale="6" id="Narr_xIC-kWA0PE2YxVSHhXvnxg">0.6</ix:nonFraction> million of deferred financing costs at March 31, 2026 in conjunction with entry into the Third Amendment. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;background:#ffffff;margin:0pt 0pt 6pt 0pt;">The Borrower could elect, at its option, to prepay any borrowing outstanding under the 2024 Amended Term Loan Agreement. Such voluntary prepayments, certain mandatory prepayments and change of control prepayments were subject to the following prepayment premium, as applicable:</p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_srt_StatementScenarioAxis_batl_NoDisapprovalOfProposedBuyerMember_jjEgQGQyC0y533kgh_Emng" name="us-gaap:ScheduleOfDebtInstrumentsTextBlock" id="Tb_IO721PKUnkOw1CLMtNfeuQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><div style="padding-left:18pt;"><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:92.71%;"><tr style="height:1pt;"><td style="vertical-align:bottom;white-space:nowrap;width:14.95%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:10.47%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:14.2%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></d