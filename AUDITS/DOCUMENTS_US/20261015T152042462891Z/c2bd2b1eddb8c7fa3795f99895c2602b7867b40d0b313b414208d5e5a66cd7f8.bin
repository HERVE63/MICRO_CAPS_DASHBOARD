<td style="vertical-align:top"> <p style=" margin-top:0pt ; margin-bottom:0pt; margin-left:0.06em; text-indent:-0.06em; font-size:9pt; font-family:arial">Executive Officers as a Group</p></td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="vertical-align:top">$</td>
<td style="vertical-align:top;text-align:right">1,092,600</td>
<td style="white-space:nowrap;vertical-align:top">&#160;</td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="vertical-align:top;text-align:center">60,000</td></tr>
<tr style="font-size:1px">
<td style="BORDER-BOTTOM:0.75pt solid #000000;vertical-align:bottom">&#160;</td>
