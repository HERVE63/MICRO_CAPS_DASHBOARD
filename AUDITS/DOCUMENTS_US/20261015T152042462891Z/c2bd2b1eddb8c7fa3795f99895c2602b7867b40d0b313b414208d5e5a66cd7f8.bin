<td style="vertical-align:bottom;text-align:center" colspan="2"><span style="font-weight:bold">Fees&#160;Earned&#160;or&#160;Paid&#160;in<br/>Cash</span></td>
<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:bottom">&#160;&#160;</td>
<td style="vertical-align:bottom;text-align:center" colspan="2"><span style="font-weight:bold">Option<br/>Awards&#160;<sup style="font-size:75%; vertical-align:top">(1)</sup></span></td>
