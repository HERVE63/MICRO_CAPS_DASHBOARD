<tr style="page-break-inside:avoid ; font-family:ARIAL; font-size:9pt">
<td style="BORDER-LEFT:0.75pt solid #000000; BORDER-BOTTOM:0.75pt solid #000000; padding-left:8pt;vertical-align:bottom">&#160;</td>
<td style=" BORDER-LEFT:0.75pt solid #000000; BORDER-TOP:0.75pt solid #000000; BORDER-BOTTOM:0.75pt solid #000000;vertical-align:bottom">&#160;</td>
<td style="BORDER-TOP:0.75pt solid #000000; BORDER-BOTTOM:0.75pt solid #000000;white-space:nowrap;vertical-align:bottom"><span style="font-family:Arial">&#160;</span></td>
