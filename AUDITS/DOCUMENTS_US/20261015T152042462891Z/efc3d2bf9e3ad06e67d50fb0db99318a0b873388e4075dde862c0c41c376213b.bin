es New Roman',serif;font-size:7pt;font-weight:700;line-height:120%">($)</span></div></td></tr><tr style="height:16pt"><td colspan="3" rowspan="2" style="padding:2px 1pt;text-align:left;vertical-align:top"><div><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400;line-height:120%">Paul K. Voigt</span></div><div><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400;line-height:120%">Interim Chief Executive Officer</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:4.55pt;font-weight:400;line-height:120%;position:relative;top:-2.44pt;vertical-align:baseline">(6)</span></div></td><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400;line-height:100%">2025</span></td><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400;line-height:100%">500,000&#160;</span></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:middle"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400;line-height:100%">&#8212;&#160;</span></td><td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:middle"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:right;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:7pt;font-weight:400