    <td style="width: 1%; text-align: left">$</td><td style="width: 14%; text-align: right">3.49</td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">&#160;</td><td style="width: 14%; text-align: right">17,127,899</td><td style="width: 1%; text-align: left">&#160;</td></tr>
