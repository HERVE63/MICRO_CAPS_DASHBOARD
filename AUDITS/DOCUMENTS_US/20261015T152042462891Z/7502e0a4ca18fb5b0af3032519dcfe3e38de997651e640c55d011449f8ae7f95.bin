  <table cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; margin-right: 0pt; margin-bottom: 2pt;">
   <tbody>
    <tr style="vertical-align: top; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
     <td style="width: 5%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"> <p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-indent: 0pt;"><b>2004</b></p> </td>
     <td style="width: 95%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"> <p style="margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-indent: 0pt; text-align: justify;">Venator Merchant Fund LLC, an affiliate of Marc Gabelli, LGL Group Executive Chairman, financed the acquisition of Piezo Technology, Inc., based in Orlando, Florida, to re-direct M-tron Industries, Inc.'s strategic direction. This acquisition set the stage for the development of M-tron Industries, Inc.'s orientation toward the avionics, space, and defense industries.</p> </td>
    </tr>

   </tbody>
  </table>
  <table cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; margin-right: 0pt; margin-bottom: 2pt;">
   <tbody>
