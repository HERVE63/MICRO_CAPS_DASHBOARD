<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;"><td style="vertical-align: top; width: 38%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; font-variant: normal; margin: 0pt;"><ix:nonNumeric name="dei:Security12bTitle" contextRef="d_2025-01-01_2025-12-31" id="ixv-16912">Common Stock, $0.01 par value</ix:nonNumeric></p> </td><td style="vertical-align: top; width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;">&#160;</td><td style="vertical-align: top; width: 20%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; font-variant: normal; text-align: center; margin: 0pt;"><ix:nonNumeric name="dei:TradingSymbol" contextRef="d_2025-01-01_2025-12-31" id="ixv-16913">LGL</ix:nonNumeric></p> </td><td style="vertical-align: top; width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;">&#160;</td><td style="vertical-align: bottom; width: 38%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 9pt; font-variant: normal; text-align: center; margin: 0pt;"><ix:nonNumeric name="dei:SecurityExchangeName" format="ixt-sec:exchnameen" contextRef="d_2025-01-01_2025-12-31" id="ixv-16914">NYSE American</ix:nonNumeric></p> </td></tr>
