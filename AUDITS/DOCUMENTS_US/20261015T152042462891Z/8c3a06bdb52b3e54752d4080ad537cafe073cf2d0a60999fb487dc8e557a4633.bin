		</tr>
		<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 20%; text-align: justify; padding: 0px 0px 5px; border-right: 1px solid rgb(3, 79, 132);"><b>Meetings in&#160;2025</b></td>
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 1%; text-align: justify;">&#160;</td>
