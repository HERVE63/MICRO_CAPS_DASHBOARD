						<td style="width: 10%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; margin-left: 0pt;">(<ix:nonFraction id="c73" contextRef="d_2024-01-01_2024-12-31_AdjToCompAxis-EqtyAwrdsAdjsMember_ExecutiveCategoryAxis-NonPeoNeoMember" unitRef="USD" name="ecd:AdjToCompAmt" scale="0" format="ixt:num-dot-decimal" decimals="0" sign="-">122</ix:nonFraction></td>
						<td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; margin-left: 0pt;">)</td>
					</tr>

			</tbody></table>
			</div>

			<p style="margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; text-indent: 0pt; text-align: left;">&#160;</p>


<table cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; margin-right: 0pt;">

		<tbody><tr style="vertical-align: top; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"><sup style="vertical-align:top;line-height:120%;">(5)</sup></p>
			</td>
			<td style="width: 98%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;">The amounts shown for Value of Initial Fixed $100 Investment Based on Total Shareholder Return ("TSR") was set on December 31, 2020 and was adjusted for the impact of the spin-off of M-tron Industries, Inc. using the example allocation from the IRS Form 8937 which is posted on the Company's website.</p>
			</td>
		</tr>

</tbody></table>
</ix:nonNumeric></ix:nonNumeric>

<div>&#160;</div>

