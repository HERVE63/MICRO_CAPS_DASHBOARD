<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 12pt; margin: 0pt;"><b>Stockholder Voting Matters</b></p>

<p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">&#160;</p>

<table cellpadding="0" cellspacing="0" style="font-size: 10pt; font-family: &quot;Times New Roman&quot;, Times, serif; width: 100%; margin-left: 0pt; margin-right: 0pt;">

		<tbody><tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="width: 15%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom; border-bottom: 1px solid rgb(0, 0, 0);"><b>Proposal</b></td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom;">&#160;</td>
			<td style="width: 47%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom; border-bottom: 1px solid rgb(0, 0, 0);"><b>Matter</b></td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom;">&#160;</td>
			<td style="width: 20%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom; text-align: center; border-bottom: 1px solid rgb(0, 0, 0);"><b>Board Recommendation</b></td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; vertical-align: bottom; text-align: center;">&#160;</td>
			<td style="width: 15%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: center; vertical-align: bottom; border-bottom: 1px solid rgb(0, 0, 0);"><b>Page Reference</b></td>
		</tr>
		<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 15%; vertical-align: top;">Proposal 1</td>
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 1%;">&#160;</td>
			<td colspan="1" rowspan="2" style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 47%; vertical-align: top;">Election of Directors</td>
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 1%;">&#160;</td>
