			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; vertical-align: middle;">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle;">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle;">&#160;</td>
			<td style="width: 14%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; vertical-align: middle;">46,252</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin-left: 0pt; vertical-align: middle;">&#160;</td>
		</tr>
		<tr style="background-color: rgb(204, 238, 255); vertical-align: bottom">
			<td style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">
			<p style="margin: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;;">Colin J. Kilrain</p>
			</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 14%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">16,500</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 14%; text-align: right; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#8212;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
			<td style="width: 1%; font-family: &quot;Times New Roman&quot;; font-size: 10pt; vertical-align: middle; padding: 0; margin: 0">&#160;</td>
