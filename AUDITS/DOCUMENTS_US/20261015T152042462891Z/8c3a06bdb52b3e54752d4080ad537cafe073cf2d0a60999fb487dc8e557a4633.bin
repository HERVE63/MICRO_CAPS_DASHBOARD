		</tr>
		<tr style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">
			<td style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; width: 20%; text-align: justify; padding-left: 9pt; border-right: 1px solid rgb(3, 79, 132);">6</td>
