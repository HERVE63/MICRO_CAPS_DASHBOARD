ty:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.61%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.64%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="As_Of_12_31_2025_tCoCcgC-TkOYTphWoT267A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OtherLiabilitiesNoncurrent" scale="3" id="Tc_gO7IaFc8aE2K9kmdoJ7KlQ_8_6">19,892</ix:nonFraction></p></td></tr></table><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt 0pt 12pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_nCwf6P0tf0qor49ABJk3oA" name="us-gaap:DisposalGroupsIncludingDiscontinuedOperationsDisclosureTextBlock" id="Tb_pPp6NQAgo0u_FeCKVM_dwg" continuedAt="Tb_pPp6NQAgo0u_FeCKVM_dwg_cont1" escape="true"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;font-weight:bold;margin:0pt;">6.&#160;&#160;&#160;&#160;&#160;&#160;Discontinued Operations</p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;">On December 2, 2024, the Company and Intas entered into an asset purchase agreement (the &#8220;UDENYCA Purchase Agreement&#8221;), pursuant to which the Company agreed to divest the UDENYCA franchise (the &#8220;UDENYCA Business&#8221;) to Intas (the &#8220;UDENYCA Sale&#8221;). Intas designated Accord BioPharma, Inc., an indirect wholly owned subsidiary of Intas (&#8220;Accord&#8221; and, together with Intas, the &#8220;Intas Parties&#8221;) to purchase the physical assets, including product inventory. On April 11, 2025 (the &#8220;UDENYCA Closing Date&#8221;), the Company completed the divestiture of the UDENYCA Business to Intas for upfront, all-cash consideration of $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="As_Of_4_11_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_q8iDY6lssk-QN879A9224g" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationConsideration" scale="6" id="Narr_zMs9teFCIEiYFEm9R8EWtw">483.4</ix:nonFraction> million, inclusive of $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="As_Of_4_11_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_q8iDY6lssk-QN879A9224g" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DisposalGroupIncludingDiscontinuedOperationInventory1" scale="6" id="Narr_M-zmKVFHC0GN3nzjQ8EjDA">118.4</ix:nonFraction> million for UDENYCA product inventory. For the year ended December 31, 2025, the Company recognized a net gain on the UDENYCA Sale of $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_oLcB_atEsEitEfLBXLdogg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DiscontinuedOperationGainLossFromDisposalOfDiscontinuedOperationBeforeIncomeTax" scale="6" id="Narr_6aabCgAz8UaY_azbopybIg">338.3</ix:nonFraction> million, which included the cash receipts less net assets transferred to Accord or otherwise derecognized, and transaction expenses of $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_oLcB_atEsEitEfLBXLdogg" decimals="-5" format="ixt:num-dot-decimal" name="chrs:DisposalGroupIncludingDiscontinuedOperationTransactionExpense" scale="6" id="Narr_S1HMAL0tuk2ekIydGIRxPA">10.7</ix:nonFraction> million. The Company is eligible to receive two additional payments of $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="As_Of_4_11_2025_srt_StatementScenarioAxis_chrs_ScenarioNetSalesExceeding300MillionQuartersEndingSeptember302026Member_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_OFEaIKP0XUe6hJBBKQGf9g" decimals="-5" format="ixt:num-dot-decimal" name="chrs:DiscontinuedOperationAmountsOfMaterialContingentAssetsReceivable" scale="6" id="Narr_hl6zCcp_ekmi47TdEQDBKQ">37.5</ix:nonFraction> million <span style="-sec-ix-hidden:Hidden_7KVbtw1VzUqwkWcf68cskQ;"><span style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;font-style:normal;font-weight:normal;">each</span></span> (together, the &#8220;Earnout Payments&#8221;). The first such payment is payable by Intas to the Company if net sales (as defined in the UDENYCA Purchase Agreement, &#8220;Net Sales&#8221;) of UDENYCA for four consecutive fiscal quarters from July 1, 2025 through September 30, 2026 are equal to or greater than $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="Duration_4_11_2025_To_4_11_2025_srt_StatementScenarioAxis_chrs_ScenarioNetSalesExceeding300MillionQuartersEndingSeptember302026Member_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_4cTjvp3FmEOVfVCwhvG-oA" decimals="-6" format="ixt:num-dot-decimal" name="chrs:ThresholdNetSalesPaymentTrigger" scale="6" id="Narr_gVsnjP_m3UmMHkUL88jF2Q">300</ix:nonFraction> million, and the second such payment is payable by Intas to the Company if Net Sales of UDENYCA for four consecutive fiscal quarters from July 1, 2025 through March 31, 2027 are equal to or greater than $<ix:nonFraction unitRef="Unit_Standard_USD_tdqOe_f5-0CXD_azrlCFUA" contextRef="Duration_4_11_2025_To_4_11_2025_srt_StatementScenarioAxis_chrs_ScenarioNetSalesExceeding350MillionQuartersEndingMarch312027Member_us-gaap_DisposalGroupClassificationAxis_us-gaap_DiscontinuedOperationsDisposedOfBySaleMember_us-gaap_IncomeStatementBalanceSheetAndAdditionalDisclosuresByDisposalGroupsIncludingDiscontinuedOperationsAxis_chrs_UdenycaBusinessMember_sAp3SuDjWUGH0wR_C4OsuQ" decimals="-6" format="ixt:num-dot-decimal" name="chrs:ThresholdNetSalesPaymentTrigger" scale="6" id="Narr_AL-8B6KWm0SNPfgezj11LQ">350</ix:nonFraction> million. As of June 30, 2026, revenues reported to the Company by the Intas Parties did not meet either of the earnout thresholds.</p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;">On June 26, 2024, the Company completed the sale of its YUSIMRY immunology franchise (the &#8220;YUSIMRY Sale&#8221;). On March 1, 2024, the Company completed the sale of its CIMERLI ophthalmology franchise through the sale of its subsidiary, Coherus Ophthalmology LLC, to Sandoz (the &#8220;CIMERLI Sale&#8221; and, together with the UDENYCA Sale and the YUSIMRY Sale, the &#8220;Sale Transactions&#8221;). </p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;">The UDENYCA Sale represented the last and most significant divestiture of the Company&#8217;s biosimilar businesses, which comprised the UDENYCA, YUSIMRY and CIMERLI franchises. Accordingly, the associated results of operations have been classified as discontinued operations in the condensed consolidated financial statements for all periods presented.</p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:24.5pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">18</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 15pt 0pt;"><a style="font-family:'Times New Roman','Times','serif';" href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_CBdfnzhn2kuZZXHBg151jg_1_2"></a><a id="Tc_1w2AQACkSkWBZIDgxFzYpA_1_8"></a><a id="Tc_YZJ5sw9zbUis_5Q2IzzyQA_2_2"></a><a id="Tc_RLJ1u2jYw0O5dtHqhZM4fg_2_8"></a><a id="Tc_VT2CuBrYikKNmRj5uiiFMw_3_0"></a><a id="Tc_1-JmWrD7R0avpjnIalsBew_3_2"></a><a id="Tc_Wa4x2j9qT0qaAmJaXhisog_3_5"></a><a id="Tc_6ppSVmz00EWIKkFTvjsl5A_3_8"></a><a id="Tc_qPJWb_78TU6uvmJwoQjEEw_3_11"></a><a id="Tc_DspWtMK5rUuKo7Gp6CiOpw_4_0"></a><a id="Tc_E9u_tAsJ8kGuQxN5dVTcag_4_2"></a><a id="Tc_2qfybolreUWTRwE_qeHUOA_4_5"></a><a id="Tc_riwEivV4EE2RdBCzdpzXfg_4_8"></a><a id="Tc_l4G2sa7h9EOHREI9i4iwPQ_4_11"></a><a id="Tc_MIH145JB-0OGocaR23KBJw_5_0"></a><a id="Tc_lHtr4J8roUaL1-0qteBP2Q_6_0"></a><a id="Tc_D_aeGfR8NU6vQQeu0ePv1A_6_3"></a><a id="Tc_zvXeeAkzKU-aGgxRYL_7Hw_7_0"></a><a id="Tc_l9hFiDJuqUOKDb7wEJ2MtA_8_0"></a><a id="Tc_TY3-xTHT8kiys9-YUwQFJQ_9_0"></a><a id="Tc_doJvF7C6dESF45c6v0JHpQ_10_0"></a><a id="Tc_Vz9xjsYZW0-bzfvS4pEoDg_11_0"></a><a id="Tc_TQOv0y6xhk21LE_bi3AnFQ_11_3"></a><a id="Tc_MQqrpZ2qlU2_aENsWNSqFw_11_9"></a><a id="Tc_iXhRxjvj7U2B-ZeddVZfcA_12_0"></a><a id="Tc_sVKaCBGY30mDIdtd8RkRPw_13_0"></a><a id="Tc_iIdGO-uP5Eu_13QeS6fM-w_13_3"></a><a id="Tc_KQXrlp44JEuP9y-fUutK7Q_13_9"></a><a id="Tc_ivmi111uBEuGdUQg0NICCQ_14_0"></a><a id="Tc_sxH7NNnlB0qPxtz8HIs_Rw_14_3"></a><a id="Tc_xHro7eoncEi4yrnrNX6EGQ_14_9"></a><a id="Tc_Etfaa2S3nECcaAmMGFGirA_15_0"></a><a id="Tc_5K8CgRRWdEW-XApAd1dDSQ_