  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="padding-bottom: 2.5pt; padding-left: 0.125in; text-align: left">Total</td><td style="padding-bottom: 2.5pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c3" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:TimeDeposits" scale="3" unitRef="usd" id="ixv-35191">273,300</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td></tr>
