    <td style="padding-left: 0.125in; text-align: left">Interest bearing time deposits</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><ix:nonFraction contextRef="c3" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:InterestBearingDepositsInBanks" scale="3" unitRef="usd" id="ixv-35517">1,140</ix:nonFraction></td><td style="text-align: left">&#160;</td><td>&#160;</td>
