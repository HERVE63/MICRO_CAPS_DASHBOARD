    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right">(<ix:nonFraction contextRef="c424" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:FairValueNetDerivativeAssetLiabilityMeasuredOnRecurringBasisWithUnobservableInputs" scale="3" sign="-" unitRef="usd" id="ixv-35435">21</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">)</td></tr>
