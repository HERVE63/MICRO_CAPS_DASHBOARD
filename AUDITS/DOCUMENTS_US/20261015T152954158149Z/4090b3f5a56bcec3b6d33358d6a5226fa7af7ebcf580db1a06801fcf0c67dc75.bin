    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c4" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NotesAndLoansReceivableNetCurrent" scale="3" unitRef="usd" id="ixv-35013">1,040,136</ix:nonFraction></td><td style="padding-bottom: 2.5pt; text-align: left">&#160;</td><td style="padding-bottom: 2.5pt">&#160;</td>
