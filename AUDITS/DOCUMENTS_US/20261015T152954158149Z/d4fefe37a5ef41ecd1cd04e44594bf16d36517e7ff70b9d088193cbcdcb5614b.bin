"color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%">10.&#160;&#160;&#160;&#160;</span><ix:nonNumeric contextRef="c-1" name="us-gaap:FairValueDisclosuresTextBlock" id="f-798" continuedAt="f-798-1" escape="true"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%;text-decoration:underline">FAIR VALUE MEASUREMENTS</span><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:120%"> </span></ix:nonNumeric></div><ix:nonNumeric contextRef="c-1" name="us-gaap:FairValueAssetsAndLiabilitiesMeasuredOnRecurringAndNonrecurringBasisTableTextBlock" id="f-799" continuedAt="f-799-1" escape="true"><ix:continuation id="f-798-1" continuedAt="f-798-2"><div style="margin-bottom:6pt;margin-top:12pt;text-align:justify;text-indent:18pt"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The Company&#8217;s financial assets and liabilities subject to fair value measurements were as follows:</span></div><div style="text-align:center"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:42.090%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.448%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:9.405%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.448%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:11.091%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.448%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:8.368%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.448%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:9.665%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.318%"/><td style="width: