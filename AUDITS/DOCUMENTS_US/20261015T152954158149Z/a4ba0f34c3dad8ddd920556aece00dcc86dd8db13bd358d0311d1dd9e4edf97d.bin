     <td style="font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;padding-bottom:3px;padding-left:0;padding-right:0;padding-top:0;width:1%;"><p style="font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;margin:0pt;">&#160;</p></td>
     <td style="border-bottom:3px double rgb(0, 0, 0);font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;margin-left:0pt;padding:0;width:1%;">$</td>
     <td style="border-bottom:3px double rgb(0, 0, 0);font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;margin-left:0pt;padding:0;text-align:right;width:9%;">10,457</td>
     <td style="font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;margin-left:0pt;padding-bottom:3px;padding-left:0;padding-right:0;padding-top:0;width:1%;"><p style="font-family:&quot;Times New Roman&quot;, Times, serif;font-size:10pt;margin:0pt;">&#160;</p></td>
