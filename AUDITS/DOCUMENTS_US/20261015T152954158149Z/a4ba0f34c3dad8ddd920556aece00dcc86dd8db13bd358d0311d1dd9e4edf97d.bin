 for&#160;<ix:nonFraction id="c148835044" contextRef="d_2025-01-01_2025-06-30_ConcentrationRiskByBenchmarkAxis-SalesRevenueSegmentMember_ConcentrationRiskByTypeAxis-CustomerConcentrationRiskMember_MajorCustomersAxis-CustomerOneMember_StatementBusinessSegmentsAxis-IndiaBiodieselSegmentMember" unitRef="Pure" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" format="ixt:num-dot-decimal" decimals="2">19</ix:nonFraction>%,&#160;<ix:nonFraction id="c148835045" contextRef="d_2025-01-01_2025-06-30_ConcentrationRiskByBenchmarkAxis-SalesRevenueSegmentMember_ConcentrationRiskByTypeAxis-CustomerConcentrationRiskMember_MajorCustomersAxis-CustomerTwoMember_StatementBusinessSegmentsAxis-IndiaBiodieselSegmentMember" unitRef="Pure" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" format="ixt:num-dot-decimal" decimals="1">20</ix:nonFraction>%,&#160;<ix:nonFraction id="c148835046" contextRef="d_2025-01-01_2025-06-30_ConcentrationRiskByBenchmarkAxis-SalesRevenueSegmentMember_ConcentrationRiskByTypeAxis-CustomerConcentrationRiskMember_MajorCustomersAxis-CustomerThreeMember_StatementBusinessSegmentsAxis-IndiaBiodieselSegmentMember" unitRef="Pure" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" format="ixt:num-dot-decimal" decimals="2">26</ix:nonFraction>%, and&#160;<ix:nonFraction id="c148835047" contextRef="d_2025-01-01_2025-06-30_ConcentrationRiskByBenchmarkAxis-SalesRevenueSegmentMember_ConcentrationRiskByTypeAxis-CustomerConcentrationRiskMember_MajorCustomersAxis-CustomerFourMember_StatementBusinessSegmentsAxis-IndiaBiodieselSegmentMember" unitRef="Pure" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" format="ixt:num-dot-decimal" decimals="2">28</ix:nonFraction>%&#160;of the segment's revenues.&#160;</span> </p>
