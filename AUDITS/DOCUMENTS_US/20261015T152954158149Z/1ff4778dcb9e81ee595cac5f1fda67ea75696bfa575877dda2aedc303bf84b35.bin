t-family:'Arial',sans-serif;font-size:7.5pt;font-weight:700;line-height:112%">(i)</span></div><div style="text-align:center;text-indent:2.75pt"><span style="color:#002060;font-family:'Arial',sans-serif;font-size:7.5pt;font-weight:700;line-height:112%">Adjusted Operating Income</span></div><div style="text-align:center;text-indent:2.75pt"><span style="color:#002060;font-family:'Arial',sans-serif;font-size:7.5pt;font-style:italic;font-weight:700;line-height:112%">(in thousands)</span></div><div style="text-align:center;text-indent:2.75pt"><span style="color:#002060;font-family:'Arial',sans-serif;font-size:4.87pt;font-weight:700;line-height:112%;position:relative;top:-2.62pt;vertical-align:baseline">(6)</span></div></td></tr><tr style="height:15pt"><td colspan="30" style="display:none"/></tr><tr><td colspan="3" style="border-left:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:center;text-indent:6.25pt;vertical-align:middle"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:112%">2025</span></td><td colspan="3" style="border-left:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:100%">$<ix:nonFraction unitRef="usd" contextRef="c-6" decimals="0" name="ecd:PeoTotalCompAmt" format="ixt:num-dot-decimal" scale="0" id="f-15">1,487,735</ix:nonFraction></span></td><td colspan="3" style="border-left:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:100%">$<ix:nonFraction unitRef="usd" contextRef="c-7" decimals="0" name="ecd:PeoTotalCompAmt" format="ixt:fixed-zero" scale="0" id="f-16">&#8212;</ix:nonFraction></span></td><td colspan="3" style="border-left:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-alig