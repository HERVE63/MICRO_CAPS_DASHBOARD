    <p style="font: 9pt Arial, Helvetica, Sans-Serif; margin: 0pt 0 0pt 0.5in; text-indent: -0.25in"><span style="font-family: Arial, Helvetica, Sans-Serif"><span>&#9679;</span>&#8239;&#8239;&#8239;&#8239;&#8239;&#8239;&#8239;Unisys</span></p></td></tr>
