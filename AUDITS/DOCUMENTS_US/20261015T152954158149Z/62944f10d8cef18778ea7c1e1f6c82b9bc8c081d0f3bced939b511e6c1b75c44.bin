  <tr style="vertical-align: top">
    <td style="border-left: Black 1pt solid; border-bottom: Black 1pt solid; padding-right: 5.4pt; padding-left: 5.4pt; border-right: Black 1pt solid"><span style="font-family: Arial, Helvetica, Sans-Serif; font-size: 10pt">All
