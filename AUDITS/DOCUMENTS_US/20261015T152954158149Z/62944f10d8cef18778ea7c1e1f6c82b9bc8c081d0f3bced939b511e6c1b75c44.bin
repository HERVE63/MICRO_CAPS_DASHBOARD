    <td style="padding-bottom: 0.5pt; font: 10pt Arial, Helvetica, Sans-Serif; vertical-align: bottom; text-align: center"><span style="font-family: Arial, Helvetica, Sans-Serif">&#160;</span></td>
    <td style="padding-bottom: 0.5pt; font: 10pt Arial, Helvetica, Sans-Serif; text-align: center"><span style="font-family: Arial, Helvetica, Sans-Serif; font-size: 8pt">3,264,730</span></td></tr>
  <tr style="font: 10pt Arial, Helvetica, Sans-Serif; background-color: #F2F2F2">
