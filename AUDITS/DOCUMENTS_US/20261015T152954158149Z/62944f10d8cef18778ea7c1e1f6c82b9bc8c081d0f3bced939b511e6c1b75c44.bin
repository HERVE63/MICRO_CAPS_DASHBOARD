    <td style="padding-bottom: 2.5pt; font-family: Arial, Helvetica, Sans-Serif; white-space: nowrap; padding-right: 5.4pt; padding-left: 5.4pt; text-align: center"><span style="font-family: Arial, Helvetica, Sans-Serif; font-size: 7pt">&#8211;</span></td>
