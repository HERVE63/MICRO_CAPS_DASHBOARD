     <td style="padding-top:0in;text-indent:18pt;padding-left:0.075in;vertical-align:top;padding-bottom:0in;padding-right:0.075in;"><div class="item-list-element-wrapper" style="text-indent:0;display:flex;margin-top:0;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:3.333%;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:3.333%;word-break:keep-all;text-indent:0;display:inline-flex;justify-content:flex-start;">3.</span><div style="display:inline;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"></span></div></div></td>
     <td style="padding-top:0in;padding-left:0.075in;vertical-align:top;padding-bottom:0in;padding-right:0.075in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Ratification of the selection of Yount, Hyde &amp; Barbour, P.C. as the Company&#8217;s independent registered public accounting firm for 2026</span></p></td>
     <td style="padding-top:0in;padding-left:0.075in;vertical-align:top;padding-bottom:0in;padding-right:0.075in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#8220;FOR&#8221; or &#8220;AGAINST&#8221; or &#8220;ABSTAIN&#8221;</span></p></td>
     <td style="padding-top:0in;padding-left:0.075in;vertical-align:top;padding-bottom:0in;padding-right:0.075in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Majority of shares represented in person or by proxy and entitled to vote</span></p></td>
