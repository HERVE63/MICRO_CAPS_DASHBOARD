          <td style="width: 58%; padding: 3pt 5.4pt; text-align: center; font: 10pt Arial, Helvetica, Sans-Serif"><span style="font-family: Arial, Helvetica, Sans-Serif; font-size: 10pt; color: white"><b>Position</b></span></td>
        </tr>
