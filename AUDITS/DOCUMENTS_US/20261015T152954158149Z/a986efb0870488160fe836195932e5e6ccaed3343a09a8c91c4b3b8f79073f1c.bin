          <td style="background-color: #F2F2F2; line-height: normal; padding: 3pt 5.4pt; font-family: Arial, Helvetica, 'sans-serif'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal;"><span style="font-family: Arial, Helvetica, Sans-Serif;">Chief Financial Officer and Treasurer</span></td>
        </tr>
        <tr style="vertical-align: top; background-color: #F2F2F2; font: 10pt Arial, Helvetica, Sans-Serif">
          <td style="background-color: #FFFFFF; line-height: normal; padding: 3pt 5.4pt; font-family: Arial, Helvetica, 'sans-serif'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal;"><span style="font-family: Arial, Helvetica, Sans-Serif;">Robyn Tannenbaum</span></td>
          <td style="background-color: #FFFFFF; line-height: normal; padding: 3pt 5.4pt; font-family: Arial, Helvetica, 'sans-serif'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal; text-align: center;"><span style="font-family: Arial, Helvetica, Sans-Serif;">40</span></td>
          <td style="background-color: #FFFFFF; line-height: normal; padding: 3pt 5.4pt; font-family: Arial, Helvetica, 'sans-serif'; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: normal;"><span style="font-family: Arial, Helvetica, Sans-Serif;">President and Chief Investment Officer</span></td>
