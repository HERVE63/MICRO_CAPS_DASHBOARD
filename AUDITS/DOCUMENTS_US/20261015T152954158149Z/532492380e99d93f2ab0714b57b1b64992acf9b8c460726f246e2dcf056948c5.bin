                <span style="letter-spacing:-0.02pt;">Key Features </span>
              </div>
            </td>
            <td style="padding:0pt;border-bottom:1px solid #FFFFFF; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:9pt;white-space:nowrap;text-align:left;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial, Helvetica, sans-serif;font-size:9pt;">
            <td style="background:#CFE2FE;padding:3.75pt 0pt 1pt 0pt; width:89pt;">
              <div style="font-weight:bold;">
                <span style="letter-spacing:-0.02pt;">Base Salary</span>
              </div>
            </td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="background:#CFE2FE;padding:3.75pt 0pt 1pt 0pt; width:108pt;white-space:normal;">
              <span style="letter-spacing:-0.068pt;">Provides competitive fixed pay that is tied to the market and allows us to attract, retain, and motivate executives, particularly in light of our industry&#8217;s cyclical nature </span>
            </td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="background:#CFE2FE;padding:3.75pt 0pt 1pt 0pt; width:62.64pt;text-align:center;">
              <div style="text-align:center;">
                <span style="letter-spacing:-0.068pt;">Cash </span>
              </div>
            </td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="background:#CFE2FE;padding:3.75pt 0pt 1pt 0pt; width:160.36pt;white-space:normal;">
              <div style=" float:left; line-height:9pt; margin-top:0pt; margin-bottom:0pt; text-align:left; width:9pt;white-space:nowrap;">
                <span style="letter-spacing:-0.068pt;">&#8226;</span>
                <br/>
              </div>
              <div style=" line-height:9pt; text-align:left; margin-left:9pt;">
                <!--blacklining:none;-->
                <span style="letter-spacing:-0.068pt;">Reflects competitive market assessment, as well as individual skills, experience, responsibilities, and performance over time</span>
              </div>
              <div style="clear:both; padding:0pt; margin:0pt;font-size:0pt;line-height:0pt;">&#8203;</div>
              <div style=" float:left; line-height:9pt; margin-top:6pt; margin-bottom:0pt; text-align:left; width:9pt;white-space:nowrap;">
                <span style="letter-spacing:-0.068pt;">&#8226;</span>
                <br/>
              </div>
              <div style=" margin-top:6pt; margin-bottom:0pt; line-height:9pt; text-align:left; margin-left:9pt;">
                <!--blacklining:none;-->
                <span style="letter-spacing:-0.068pt;">Influences annual cash and long-term incentive opportunities </span>
              </div>
              <div style="clear:both; padding:0pt; margin:0pt;font-size:0pt;line-height:0pt;">&#8203;</div>
            </td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:9pt;white-space:normal;text-align:left;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Arial, Helvetica, sans-serif;font-size:9pt;">
            <td style="padding:4pt 0pt 0.5pt 0pt; width:89pt;">
              <div style="font-weight:bold;">
                <span style="letter-spacing:-0.02pt;">Short-Term Incentive</span><span style="letter-spacing:-0.112pt;">&#8201;&#8212;&#8201;</span>
                <br/>
                <span style="letter-spacing:-0.02pt;">Annual Cash Incentive</span>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:4pt 0pt 0.5pt 0pt; width:108pt;">
              <span style="letter-spacing:-0.068pt;">Encourages focus on short-term business performance </span>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:4pt 0pt 0.5pt 0pt; width:62.64pt;white-space:nowrap;text-align:center;">
              <div style="text-align:center;">
                <span style="letter-spacing:-0.068pt;">Cash </span>
              </div>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:4pt 0pt 0.5pt 0pt; width:160.36pt;">
              <div style=" float:left; line-height:9pt; text-align:left; width:9pt;white-space:nowrap;">
                <span style="letter-spacing:-0.068pt;">&#8226;</span>
                <br/>
              </div>
              <div style=" line-height:9pt; text-align:left; margin-left:9pt;">
                <!--blacklining:none;-->
                <span style="letter-spacing:-0.068pt;">Performance-based reward tied to achievement of annual operating income margin and strategic objectives</span>
              </div>
              <div style="clear:both; padding:0pt; margin:0pt;font-size:0pt;line-height:0pt;">&#8203;</div>
