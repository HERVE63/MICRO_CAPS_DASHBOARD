            <td style="background:#CFE2FE;padding:3.25pt 0pt 1.5pt 0pt; min-width:11.25pt; text-align:right; white-space:nowrap;">6<span style="position:absolute;">%</span></td>
            <td style="padding:0pt;background:#CFE2FE;padding-left:5.935pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#CFE2FE;padding-left:10.595pt;width:0pt;">&#8203;</td>
