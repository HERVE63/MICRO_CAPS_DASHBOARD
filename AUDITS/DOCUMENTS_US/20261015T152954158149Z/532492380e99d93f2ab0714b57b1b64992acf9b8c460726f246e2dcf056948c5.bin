            <td style="background:#CFE2FE;padding:3.5pt 0pt 1.5pt 0pt; min-width:11.25pt; text-align:right; white-space:nowrap;">50<span style="position:absolute;">%</span></td>
            <td style="padding:0pt;background:#CFE2FE;padding-left:54.08pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
