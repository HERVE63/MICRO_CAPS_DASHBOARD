      <div style="margin-top:6pt;margin-bottom:155pt;margin-left:69.66pt;width:456pt;">
        <div style="width:456pt; line-height:14pt;font-weight:bold;font-size:12pt;">
          <span style="letter-spacing:-0.027pt;">Board Committees and Committee Meetings</span>
        </div>
        <div style="margin-top:8pt; text-align:justify; width:456pt; line-height:11.5pt;">
          <span style="letter-spacing:-0.068pt;">The Board of Directors has three standing committees: the Audit Committee, the Compensation Committee, and the Nominating and Governance Committee.</span>
        </div>
        <table style="width:456pt;margin-top:10pt;border-collapse: collapse;border-top:0.75pt solid #000000; border-left:0.75pt solid #000000; border-right:0.75pt solid #000000; font-style:normal;font-weight:bold;font-variant:normal;text-transform:none;color:#000000;font-family:Arial, Helvetica, sans-serif;font-size:12pt;">
          <tr style="line-height:12pt;white-space:nowrap;text-align:left;vertical-align:top;font-style:normal;font-weight:bold;font-variant:normal;text-transform:none;color:#000000;font-family:Arial, Helvetica, sans-serif;font-size:12pt;">
            <td style="width:0pt;padding:0pt;font-size:0pt;line-height:0pt;">&#8203;</td>
