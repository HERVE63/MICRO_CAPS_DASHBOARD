  <div style="padding-top:0.5in;z-index:2;min-height:0.5in;position:relative;box-sizing:border-box;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p></div>
  <div class="main-content-container" style="z-index:5;position:relative;"><div><ix:continuation id="F_db192df6-37d4-4d8e-9979-85d03053a3e5_1" continuedAt="F_db192df6-37d4-4d8e-9979-85d03053a3e5_2"><div><ix:continuation id="F_07563063-ee2f-401a-aa2d-9b82eee079e2_1"><p style="font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">measure </span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">of performance reviewed by the chief operating decision-maker is net loss which is compared to the annual budget and quarterly forecasts.</span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> </span></p><p style="text-indent:4.533%;font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> </span><span style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_03700512-77a2-4cdc-b79a-32af4c858705" contextRef="C_93e06f21-1224-4deb-9db0-fa9564d37bc2" name="us-gaap:ReconciliationOfOperatingProfitLossFromSegmentsToConsolidatedTextBlock" escape="true" continuedAt="F_03700512-77a2-4cdc-b79a-32af4c858705_1"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">All financial information required for segment reporting that is provided to the chief operating decision-maker is contained within the financial statements and notes to financial statements, with the exception of the disaggregated amounts contained in the table below: </span></ix:nonNumeric></span><span style=""></span></p><div style="font-size:11pt;font-family:'Calibri',sans-serif;"><ix:continuation id="F_03700512-77a2-4cdc-b79a-32af4c858705_1"><p style="text-indent:4.533%;font-size:10pt;margin-top:6pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
         <table style="margin-left:auto;border-spacing:0;table-layout:auto;width:100.0%;border-collapse:separate;margin-right:auto;">
