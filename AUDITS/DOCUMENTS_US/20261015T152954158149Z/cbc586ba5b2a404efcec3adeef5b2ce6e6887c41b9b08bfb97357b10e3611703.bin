le="background-color:#ffffff;padding:1.5pt 0;text-align:right;vertical-align:top"><span style="color:#231f20;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:110%">1.9&#160;</span></td><td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:top"/><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/><td colspan="2" style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">(59.2)</span></td><td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:top"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">%</span></td></tr><tr><td colspan="3" style="background-color:#cceeff;padding:1.5pt 1pt;text-align:left;vertical-align:top"><div><span style="color:#231f20;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Other income, net</span></div></td><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:top"><span style="color:#231f20;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">$</span></td><td style="background-color:#cceeff;padding:1.5pt 0;text-align:right;vertical-align:top"><span style="color:#231f20;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#8212;&#160;</span></td><td style="background-color:#cceeff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:top"/><td colspan="3" style="background-color:#cceeff;padding:0 1pt"/><td style="background-color:#cceeff;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:top"><span style="color:#231f20;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">$</span></td><td style="background-color:#cceeff;padding:1.5pt 0;text-