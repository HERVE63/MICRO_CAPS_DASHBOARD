    </tr>
    <tr style="height:9pt;background-color:#dbe5f1;white-space:pre-wrap;word-break:break-word;text-align:left;">
     <td style="padding-top:0in;border-right:0.5pt solid #95b3d7;border-left:0.5pt solid #95b3d7;padding-left:0.075in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #95b3d7;padding-right:0.075in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">Eric Singer</span></p></td>
