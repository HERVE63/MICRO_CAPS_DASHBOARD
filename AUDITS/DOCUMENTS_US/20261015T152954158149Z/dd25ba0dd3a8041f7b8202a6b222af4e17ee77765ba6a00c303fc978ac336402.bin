     <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
     <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">Leadership</span></p></td>
     <td style="padding-top:0.02in;padding-left:0in;vertical-align:bottom;padding-bottom:0.02in;border-bottom:0.5pt solid;padding-right:0in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
