    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c0" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ConversionOfStockAmountConverted1" scale="0" unitRef="usd" id="ixv-7228">240,000</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td><td style="padding-bottom: 4pt">&#160;</td>
    <td style="border-bottom: Black 4pt double; text-align: left">$</td><td style="border-bottom: Black 4pt double; text-align: right"><ix:nonFraction contextRef="c12" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ConversionOfStockAmountConverted1" scale="0" unitRef="usd" id="ixv-7229">220,000</ix:nonFraction></td><td style="padding-bottom: 4pt; text-align: left">&#160;</td></tr>
