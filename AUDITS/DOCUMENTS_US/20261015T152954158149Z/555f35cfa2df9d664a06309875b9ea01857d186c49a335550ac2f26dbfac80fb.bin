    <td style="padding-bottom: 1.5pt; text-align: left">$</td><td style="border-bottom: Black 1.5pt solid; padding-bottom: 1.5pt; text-align: right"><div style="-sec-ix-hidden: hidden-fact-141">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;-</div></td><td style="padding-bottom: 1.5pt; text-align: left">&#160;</td></tr>
