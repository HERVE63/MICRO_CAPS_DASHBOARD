;min-width:fit-content;"><ix:nonFraction id="F_f2e8aed5-40d2-476a-acbd-da2267bec72c" contextRef="C_4038ecd0-ec0b-4e8a-9f62-16b5b1f4e89d" name="us-gaap:MortgageLoansInProcessOfForeclosureAmount" unitRef="U_USD" scale="3" decimals="-2" format="ixt:num-dot-decimal">106.3</ix:nonFraction></span><span style="color:#000000;white-space:pre-wrap;font-size:8pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> million</span><span style="color:#000000;white-space:pre-wrap;font-size:8pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> related to loans secured by New York taxi medallions, some of which may represent collection opportunities for the Company.</span></ix:footnote></div></div></ix:nonNumeric></div></ix:nonNumeric></div></ix:continuation></div></div>
