<table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; width: 100%; margin-top: 0; margin-bottom: 0"><tr style="font: 10pt Times New Roman, Times, Serif; vertical-align: top">
<td style="font: 10pt Times New Roman, Times, Serif; width: 0.5in"><span id="xdx_F02_zegTA34UIbI7" style="font-family: Times New Roman, Times, Serif; font-size: 10pt">(3)</span></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: justify"><span id="xdx_F1E_zZ7kOUi6Wjs7" style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:footnote id="Footnote001546" xml:lang="en-US">As
                                            of December 31, 2025, the investments noted had been placed on non-accrual status.</ix:footnote></span></td></tr></table>

