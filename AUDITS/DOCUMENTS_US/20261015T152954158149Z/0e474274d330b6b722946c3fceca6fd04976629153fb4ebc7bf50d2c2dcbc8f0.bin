4eXuUmZGcQYfkiFsQ" contextRef="Duration_1_1_2026_To_3_31_2026_us-gaap_GranteeStatusAxis_us-gaap_ShareBasedPaymentArrangementNonemployeeMember_OjvN-tUZak2RoR0aslVpew" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_4FVPdzvVf0KnL0CsY7dIpw">2,900</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_7_1_2025_To_3_31_2026_us-gaap_GranteeStatusAxis_us-gaap_ShareBasedPaymentArrangementNonemployeeMember_sN3ApRoYHU-nX1wfk3euew" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_VFiq_n_dq0GgrRDMO0KxTg">8,500</ix:nonFraction> during the three and nine months ended March 31, 2026, respectively. Total stock-based compensation includes expenses related to non-employee awards of $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_1_1_2025_To_3_31_2025_us-gaap_GranteeStatusAxis_us-gaap_ShareBasedPaymentArrangementNonemployeeMember_-uw2WnjRQ0m_ZpkZSzcQcQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_X3dIPZ-jzUGpLVEzD-YV0Q">11,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_7_1_2024_To_3_31_2025_us-gaap_GranteeStatusAxis_us-gaap_ShareBasedPaymentArrangementNonemployeeMember_1bsEck8Es02qLGUuZX24Gg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_4pDsPvfuHEWS6B5KfaJbBg">42,000</ix:nonFraction> during the three and nine months ended March 31, 2025, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">Total stock-based compensation includes expenses related to the ESPP of $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_1_1_2026_To_3_31_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockMember_JvTxBKbp30-_2gsOl6Om-A" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_OVcev25qAEiD-2ZRSCFeLg">93,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_7_1_2025_To_3_31_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockMember_qukcQhsTKEm5qsGvsDxq9g" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr__78Ae2-NPUuTw-7lUHXfnA">221,000</ix:nonFraction> for the three and nine months ended March 31, 2026, respectively. Total stock-based compensation includes expenses related to the ESPP of $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_1_1_2025_To_3_31_2025_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockMember_bphqiytw_Uy7GzZoi2Rv9w" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_oqSOkn6OD0yHReWSLaO6iw">84,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_9yXm54eXuUmZGcQYfkiFsQ" contextRef="Duration_7_1_2024_To_3_31_2025_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockMember_mQ7xIeAhwk6qecFh0iEs3A" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="0" id="Narr_RdY7o_CHtE2VpHPCHkn9ag">245,000</ix:nonFraction> for the three and nine months ended March 31, 2025, respectively. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">We utilize the Black-Scholes valuation model for estimating the fair value of the stock-based compensation of options granted and ESPP stock purchase rights. We estimate the fair value for stock based RSU awards based on the closing market price of grant date. All shares of our common stock issued pursuant to our stock option, RSUs, and ESPP plans are only issued out of an authorized reserve of shares of common stock which were previously registered with the SEC on Registration Statements on Form S-8.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="letter-spacing:-0.1pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="letter-spacing:-0.1pt;">During the three months ended March 31, 2026 and 2025, we </span>granted options to purchase <ix:nonFraction unitRef="Unit_Standard_shares_SrSp72-tq0i4mExDaNQiRQ" contextRef="Duration_1_1_2026_To_3_31_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_KN4wyH93RUu_LVekMNKRBw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriod" scale="0" id="Narr_CBxrFiVlrE6yhgap2cIkxQ">280,416</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_shares_SrSp72-tq0i4mExDaNQiRQ" contextRef="Duration_1_1_2025_To_3_31_2025_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_0VymuWRrV0q4Phf7M-tzNQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriod" scale="0" id="Narr_QdPcyOLFkUeu_IdLeTmA0A">149,700</ix:nonFraction> shares of common stock with a weighted-average grant date fair value <span style="letter-spacing:-0.1pt;">of </span><span style="letter-spacing:-0.1pt;">$<ix:nonFraction unitRef="Unit_Divide_USD_shares_vwbRnH3KUkSn_rGABcoCgw" contextRef="Duration_1_1_2026_To_3_31_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_KN4wyH93RUu_LVekMNKRBw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementsByShareBasedPaymentAwardOptionsGrantsInPeriodWeightedAverageExercisePrice" scal