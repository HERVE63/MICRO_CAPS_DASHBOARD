    <td style="text-align: left">$</td><td style="text-align: right"><ix:nonFraction name="us-gaap:CashAndCashEquivalentsAtCarryingValue" contextRef="AsOf2025-06-30" id="Fact000465" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">4,082</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr>
