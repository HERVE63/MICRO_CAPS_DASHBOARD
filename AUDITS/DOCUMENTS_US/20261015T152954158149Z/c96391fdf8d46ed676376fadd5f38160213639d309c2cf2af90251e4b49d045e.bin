       <td style="width: 25%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"><ix:nonFraction id="c148825472" contextRef="i_2026-06-30" unitRef="Share" name="us-gaap:EmployeeStockOwnershipPlanESOPNumberOfAllocatedShares" scale="0" format="ixt:num-dot-decimal" decimals="INF">597,986</ix:nonFraction></td>
