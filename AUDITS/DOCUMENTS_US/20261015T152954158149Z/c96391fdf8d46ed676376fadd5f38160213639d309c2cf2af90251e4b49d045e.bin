    </div>
   </ix:exclude>
   <ix:exclude>&#160;</ix:exclude>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;">The following tables detail&#160;activity in the allowance for credit losses on loans by class for the periods shown:</p>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 6pt; margin: 0pt;">&#160;</p>
   <ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:AllowanceForCreditLossesOnFinancingReceivablesTableTextBlock" id="DCE9280B-62BB-448C-9390-122D99C0E048" escape="true" continuedAt="A8A6DC94-87D7-4783-9C31-FBA5BF91DAA3">
