  <ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:ComprehensiveIncomeNoteTextBlock" id="c3246095" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:justify;"><b style="font-size: 10pt;">Note <em style="font: inherit;">12</em>- Change in Accumulated Other Comprehensive Income ("AOCI")</b></p>
   <p style="text-align: left; margin: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;, Times, serif;">&#160;</p>
   <p style="text-align: left; margin: 0pt; font-size: 10pt; font-family: &quot;Times New Roman&quot;, Times, serif;">Our AOCI includes unrealized gains (losses) on available-for-sale securities, defined benefit plan assets and derivatives as well as an unrecognized defined benefit plan prior service cost. The following table&#160;presents changes to accumulated other comprehensive income after-tax for the periods shown:</p>
   <p style="text-align: left; margin: 0pt; font-size: 6pt; font-family: &quot;Times New Roman&quot;, Times, serif;">&#160;</p>
   <ix:nonNumeric contextRef="d_2026-01-01_2026-06-30" name="us-gaap:ScheduleOfAccumulatedOtherComprehensiveIncomeLossTableTextBlock" id="DDCE70DB-85B3-448E-904A-46F5A1CB42E1" escape="true" continuedAt="c9EB9BC0E-FECE-4021-96B5-82BA22D52337">
