    <td style="width: 1%; text-align: left">$</td><td style="width: 13%; text-align: right"><ix:nonFraction name="us-gaap:InventoryRawMaterials" contextRef="AsOf2026-03-31" id="Fact000622" format="ixt:numdotdecimal" decimals="0" unitRef="USD">815,229</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td style="width: 13%; text-align: right"><ix:nonFraction name="us-gaap:InventoryRawMaterials" contextRef="AsOf2025-06-30" id="Fact000623" format="ixt:numdotdecimal" decimals="0" unitRef="USD">2,014,252</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr id="xdx_40F_eus-gaap--InventoryFinishedGoods_iI_maINzSmu_zaPBhCdoWQ21" style="vertical-align: bottom; background-color: White">
