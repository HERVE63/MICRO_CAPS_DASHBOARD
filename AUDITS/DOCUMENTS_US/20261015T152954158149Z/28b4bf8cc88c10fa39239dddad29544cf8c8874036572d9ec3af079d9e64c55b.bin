  <tr style="vertical-align: bottom; background-color: rgb(238,238,238)">
    <td style="width: 83%; font-weight: 400; font-style: normal; text-align: left; padding-left: 10pt">Tooling and manufacturing equipment<span style="font: normal 400 10pt Times New Roman, Times, Serif"></span></td><td style="width: 2%">&#160;</td>
    <td style="width: 1%; text-align: left">$</td><td id="xdx_987_eus-gaap--PropertyPlantAndEquipmentGross_iI_c20260331__us-gaap--FiniteLivedIntangibleAssetsByMajorClassAxis__custom--ToolingAndManufacturingEquipmentMember_zyT3KufR5s7i" title="Property and equipment" style="width: 13%; text-align: right"><ix:nonFraction name="us-gaap:PropertyPlantAndEquipmentGross" contextRef="AsOf2026-03-31_custom_ToolingAndManufacturingEquipmentMember" id="Fact000987" format="ixt:numdotdecimal" decimals="0" unitRef="USD">99,500</ix:nonFraction></td><td style="width: 1%; text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: White">
