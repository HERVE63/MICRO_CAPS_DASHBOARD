     <td style="padding-top:0in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><img src="img102459364_22.jpg" alt="img102459364_22.jpg" style="width:10px;height:21px;"/></p></td>
