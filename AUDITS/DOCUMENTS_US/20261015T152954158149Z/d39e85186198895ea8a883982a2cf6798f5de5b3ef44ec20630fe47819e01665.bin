     <td style="padding-top:0in;text-indent:48.95pt;padding-left:0.08in;vertical-align:top;padding-bottom:0in;padding-right:0.08in;"><div class="item-list-element-wrapper" style="margin-left:4.528%;text-indent:0;display:flex;margin-top:6pt;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:4.537%;text-align:left;"><span style="color:#8000ff;white-space:pre-wrap;font-size:9pt;font-family:Times New Roman;font-kerning:none;min-width:4.7521786492374725%;word-break:keep-all;text-indent:0;display:inline-flex;justify-content:flex-start;">&#8226;</span><div style="display:inline;"><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-family:Arial;font-kerning:none;min-width:fit-content;">We have enhanced our proxy statement&#8217;s disclosures regarding the Company&#8217;s peer group companies.</span></div></div><p style="text-indent:0;font-size:9pt;margin-top:0.1pt;font-family:Times New Roman;margin-bottom:0;margin-right:1.435%;text-align:left;"><span style="white-space:pre-wrap;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;</span></p></td>
