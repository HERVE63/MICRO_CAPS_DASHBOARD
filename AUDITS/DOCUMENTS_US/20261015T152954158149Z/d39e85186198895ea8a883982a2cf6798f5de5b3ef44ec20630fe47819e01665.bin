    </tr>
    <tr style="height:21.6pt;background-color:#8000ff;white-space:pre-wrap;word-break:break-word;text-align:left;">
     <td style="border-top:0.5pt solid #8000ff;padding-top:0in;border-right:0.5pt solid #ffffff;border-left:0.5pt solid #8000ff;padding-left:0.075in;vertical-align:middle;padding-bottom:0in;padding-right:0.075in;"><p style="font-size:7pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;Executive Officer</span></p></td>
     <td style="border-top:0.5pt solid #8000ff;padding-top:0in;border-right:0.5pt solid #8000ff;padding-left:0.075in;vertical-align:middle;padding-bottom:0in;padding-right:0.075in;"><p style="font-size:7pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:Arial;font-kerning:none;min-width:fit-content;">2022 PSUs Forfeited</span></p><p style="font-size:7pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-family:Arial;font-kerning:none;min-width:fit-content;">&#160;(at Target)</span></p></td>
