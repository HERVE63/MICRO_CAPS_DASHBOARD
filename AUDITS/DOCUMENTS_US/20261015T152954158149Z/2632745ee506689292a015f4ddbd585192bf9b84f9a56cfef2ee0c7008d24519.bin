            <td style="padding:0pt;background:#DEFAFE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#DEFAFE;padding-left:4.965pt;width:0pt;">&#8203;</td>
            <td style="background:#DEFAFE;padding:3.5pt 0pt 1.5pt 0pt; min-width:3.75pt; text-align:right; ">&#8203;</td>
