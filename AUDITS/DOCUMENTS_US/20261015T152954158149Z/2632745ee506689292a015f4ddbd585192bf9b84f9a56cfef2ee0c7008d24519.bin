            <td style="background:#DEFAFE;padding:0pt 0pt 0.5pt 0pt; line-height:12pt; min-width:24.75pt; text-align:right; white-space:nowrap;">&#8203;</td>
            <td style="padding:0pt;background:#DEFAFE;padding-left:6.655pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;height:15pt;white-space:nowrap;text-align:center;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
            <td style="padding:0pt;background:#DEFAFE; width:6pt;">&#8203;</td>
