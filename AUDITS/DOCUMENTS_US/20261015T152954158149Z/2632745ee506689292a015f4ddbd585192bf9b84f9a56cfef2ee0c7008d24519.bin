            <td style="background:#DEFAFE;padding:3.25pt 0pt 1.5pt 0pt; min-width:21pt; text-align:right; white-space:nowrap;">54,000</td>
            <td style="padding:0pt;background:#DEFAFE;padding-left:10.985pt;width:0pt;">&#8203;</td>
            <td style="padding:0pt;background:#DEFAFE; width:6pt;">&#8203;</td>
