            <td style="background:#DEFAFE;border-bottom:1px solid #000000;padding:1.32pt 0pt 3.99pt 0pt; width:132.75pt;">
              <div style="line-height:10.78pt;">
                <span style="letter-spacing:0.18pt;">Advance Named Central Nervous System Pipeline Toward Patients (50%) </span>
              </div>
            </td>
            <td style="padding:0pt;background:#DEFAFE;border-bottom:1px solid #000000; width:5.75pt;">&#8203;</td>
            <td style="width:0.25pt;padding:0pt;font-size:0pt;line-height:0pt;padding-left:0.75pt;background-color:#000000;border-bottom:1px solid #000000;">&#8203;</td>
            <td style="padding:0pt;background:#DEFAFE;border-bottom:1px solid #000000; width:5.75pt;">&#8203;</td>
