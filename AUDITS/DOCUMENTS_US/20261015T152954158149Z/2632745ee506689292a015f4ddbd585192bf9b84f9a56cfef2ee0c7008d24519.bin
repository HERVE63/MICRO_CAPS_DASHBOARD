              <span style="letter-spacing:0.2pt;">MeiraGTx Holdings plc </span>
            </td>
            <td style="padding:0pt;background:#DEFAFE; width:6pt;">&#8203;</td>
            <td style="padding:0pt;background:#DEFAFE; width:6pt;">&#8203;</td>
            <td style="background:#DEFAFE;padding:3.25pt 0pt 1.5pt 0pt; width:144pt;">
              <span style="letter-spacing:0.2pt;">Solid Biosciences, Inc. </span>
            </td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;white-space:nowrap;text-align:left;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
            <td style="padding:0pt; width:0pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:144pt;">
              <span style="letter-spacing:0.2pt;">Adverum Biotechnologies, Inc. </span>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:144pt;">
              <span style="letter-spacing:0.2pt;">Monte Rosa Therapeutics, Inc. </span>
            </td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:0pt; width:6pt;">&#8203;</td>
            <td style="padding:3.5pt 0pt 1.5pt 0pt; width:144pt;">
              <span style="letter-spacing:0.2pt;">Stoke Therapeutics, Inc. </span>
            </td>
            <td style="padding:0pt; width:0pt;">&#8203;</td>
          </tr>
          <tr style="line-height:10pt;white-space:nowrap;text-align:left;vertical-align:top;font-style:normal;font-weight:normal;font-variant:normal;text-transform:none;color:#000000;font-family:Times New Roman, Times, serif ;font-size:10pt;">
