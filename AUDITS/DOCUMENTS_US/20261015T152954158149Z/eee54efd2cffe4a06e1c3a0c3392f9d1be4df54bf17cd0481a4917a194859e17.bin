</td><td valign="top" style="background-color:#CCEEFF;width:17.2%;border-top:0.5pt solid #000000;border-left:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">4,477</p>
</td><td valign="top" style="background-color:#CCEEFF;width:18.76%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td></tr>
<tr><td valign="top" style="width:31.2%;border-bottom:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0">IRE</p>
</td><td valign="top" style="width:15.64%;border-bottom:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">767</p>
</td><td valign="top" style="width:17.2%;border-bottom:0.5pt solid #000000;border-right:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="top" style="width:17.2%;border-left:0.5pt solid #000000;border-bottom:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">364</p>
</td><td valign="top" style="width:18.76%;border-bottom:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td></tr>
<tr><td valign="top" style="background-color:#CCEEFF;width:31.2%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0">AUS</p>
</td><td valign="top" style="background-color:#CCEEFF;width:15.64%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">266</p>
</td><td valign="top" style="background-color:#CCEEFF;width:17.2%;border-top:0.5pt solid #000000;border-right:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="top" style="background-color:#CCEEFF;width:17.2%;border-top:0.5pt solid #000000;border-left:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">115</p>
</td><td valign="top" style="background-color:#CCEEFF;width:18.76%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td></tr>
<tr><td valign="top" style="width:31.2%"><p style="font:10pt Times New Roman;margin:0">CAN</p>
</td><td valign="top" style="width:15.64%"><p style="font:10pt Times New Roman;margin:0;text-align:right"><span style="border-bottom:1px solid #000000">127</span></p>
</td><td valign="top" style="width:17.2%;border-right:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="top" style="width:17.2%;border-left:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0;text-align:right"><span style="border-bottom:1px solid #000000">124</span></p>
</td><td valign="top" style="width:18.76%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
