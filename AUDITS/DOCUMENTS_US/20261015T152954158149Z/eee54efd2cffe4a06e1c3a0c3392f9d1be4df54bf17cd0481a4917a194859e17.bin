</td><td valign="middle" style="background-color:#CCEEFF;width:10.72%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:58pt"><ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="E25_StEqComps-AddPaidInCap" decimals="-3" unitRef="USD" format="ixt:fixed-zero" id="ixv-12933">-</ix:nonFraction>&#160;</kbd>&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:1.7%"><p style="font:10pt Times New Roman;margin:0">&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:13.46%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:78pt">(<ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="E25_StEqComps-ComprIncome" decimals="-3" unitRef="USD" sign="-" scale="3" format="ixt:num-dot-decimal" id="ixv-12934">9,416</ix:nonFraction>)</kbd>&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:1.86%"><p style="font:10pt Times New Roman;margin:0">&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:11.86%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:66pt"><ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="E25_StEqComps-RetainedEarnings" decimals="-3" unitRef="USD" scale="3" format="ixt:num-dot-decimal" id="ixv-12935">128,652</ix:nonFraction>&#160;</kbd>&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:1.86%"><p style="font:10pt Times New Roman;margin:0">&#160;</p>
</td><td valign="middle" style="background-color:#CCEEFF;width:13.98%;border-top:0.5pt solid #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:81pt"><ix:nonFraction name="us-gaap:StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest" contextRef="E25" decimals="-3" unitRef="USD" scale="3" format="ixt:num-dot-decimal" id="ixv-12936">119,268</ix:nonFraction>&#160;</kbd>&#160;</p>
</td></tr>
<tr style="height:7.2pt"><td valign="middle" style="width:24.44%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="middle" style="width:7.98%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="middle" style="width:1.82%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="middle" style="width:8.62%"><p style="font:10pt Times New Roman;margin:0;text-align:center">&#160;</p>
</td><td valign="middle" style="width:1.7%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="middle" style="width:10.72%"><p style="font:10pt Times New Roman;margin:0;text-align:center">&#160;</p>
</td><td valign="middle" style="width:1.7%"><p style="font:10pt Times New Roman;margin:0;text-align:right">&#160;</p>
</td><td valign="middle" style="width:13.46%"><p style="font:10pt Times New Roman;margin:0;text-align:center">&#160;</p>
