</td><td colspan="3" valign="top" style="width:212pt"><p style="font:10pt Times New Roman;margin:0;text-align:center"><span style="border-bottom:1px solid #000000">Years ended December 31,</span></p>
</td></tr>
<tr><td valign="top" style="width:256.9pt"/><td valign="top" style="width:13.5pt"><p style="font:10pt Times New Roman;margin:0">&#160;</p>
</td><td valign="top" style="width:71.95pt"><p style="font:10pt Times New Roman;margin:0;text-align:center"><span style="border-bottom:1px solid #000000">2025</span></p>
</td><td valign="top" style="width:71.95pt"><p style="font:10pt Times New Roman;margin:0;text-align:center"><span style="border-bottom:1px solid #000000">2024</span></p>
