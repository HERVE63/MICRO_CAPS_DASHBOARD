</td><td valign="top" style="background-color:#CCEEFF;width:64.85pt;border-top:0.5pt solid #000000;border-bottom:3px double #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:58pt"><ix:nonFraction name="us-gaap:PropertyPlantAndEquipmentNet" contextRef="E24_StGeo-IE" decimals="-3" unitRef="USD" scale="3" format="ixt:num-dot-decimal" id="ixv-13140">2,784</ix:nonFraction>&#160;</kbd>&#160;</p>
</td><td valign="top" style="background-color:#CCEEFF;width:73.15pt;border-top:0.5pt solid #000000;border-bottom:3px double #000000"><p style="font:10pt Times New Roman;margin:0"><kbd style="position:absolute;font:10pt Times New Roman;margin-left:7pt">$</kbd><kbd style="position:absolute;text-align:right;font:10pt Times New Roman;width:66pt"><ix:nonFraction name="us-gaap:PropertyPlantAndEquipmentNet" contextRef="E24" decimals="-3" unitRef="USD" scale="3" format="ixt:num-dot-decimal" id="ixv-13141">9,763</ix:nonFraction>&#160;</kbd>&#160;</p>
