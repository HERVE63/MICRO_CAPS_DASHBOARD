f="c81" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" unitRef="usd" id="ixv-8534">34,771</ix:nonFraction></td><td style="text-align: left">&#160;</td></tr> </table></ix:continuation></ix:continuation></ix:continuation></ix:continuation><div>

