   <table cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; margin: 6pt 0pt 1pt;"><tbody><tr style="vertical-align: top; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"><td style="width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"> <p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"><sup style="vertical-align:top;line-height:120%;">(a)</sup></p> </td><td style="width: 98%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"> <p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;">Interest revenue is included in Net investment income on the Condensed Consolidated Statements of Operations.</p> </td></tr>
</tbody></table>
   <table cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt; margin-left: 0pt; margin-right: 0pt; margin-bottom: 1pt;"><tbody><tr style="vertical-align: top; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"><td style="width: 2%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"> <p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"><sup style="vertical-align:top;line-height:120%;">(b)</sup></p> </td><td style="width: 98%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;"> <p style="margin: 0pt; text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 8pt;">Amortization is included within the other segment expense captions such as Manufacturing cost of sales, Engineering or Other segment items.</p> </td></tr>
