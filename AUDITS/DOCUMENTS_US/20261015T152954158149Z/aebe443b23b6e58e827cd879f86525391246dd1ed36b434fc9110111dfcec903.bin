oration:underline" href="#ia27cd6e53c484cf69c23d226eadf8f8c_424">Annexes</a></span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#3a4294;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%"><a style="color:#3a4294;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:none" href="#ia27cd6e53c484cf69c23d226eadf8f8c_424">95</a></span></div></td></tr><tr><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-left:12pt"><span style="color:#0000ff;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:underline" href="#ia27cd6e53c484cf69c23d226eadf8f8c_427">Annex A. Amended and Restated OraSure Technologies, Inc. 2000 Stock Award Plan</a></span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="text-align:right"><span style="color:#3a4294;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%"><a style="color:#3a4294;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:none" href="#ia27cd6e53c484cf69c23d226eadf8f8c_427">95</a></span></div></td></tr><tr><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"><div style="padding-left:12pt"><span style="color:#0000ff;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%;text-decoration:underline" href="#ia27cd6e53c484cf69c23d226eadf8f8c_430">Annex B. Proposed Amendment to Certificate of Incorporation </a></span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;ver