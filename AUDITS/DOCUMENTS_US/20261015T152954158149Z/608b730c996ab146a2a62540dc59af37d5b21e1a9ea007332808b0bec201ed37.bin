oman','Times','serif';font-size:10pt;text-align:right;margin:6pt 0pt 0pt 0pt;">41</p></td></tr><tr style=""><td style="vertical-align:top;width:90.58%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:10.8pt;text-indent:-10.8pt;margin:6pt 0pt 0pt 0pt;"><a href="#EXECUTIVECOMPENSATIONTABLES_156593"><span style="font-style:normal;font-weight:normal;">EXECUTIVE COMPENSATION </span></a></p></td><td style="vertical-align:bottom;width:9.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:6pt 0pt 0pt 0pt;">42</p></td></tr><tr style=""><td style="vertical-align:top;width:90.58%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:10.8pt;text-indent:-10.8pt;margin:6pt 0pt 0pt 0pt;"><a href="#EQUITYCOMPENSATIONPLANINFORMATION_996494"><span style="font-style:normal;font-weight:normal;">EQUITY COMPENSATION PLAN INFORMATION</span></a></p></td><td style="vertical-align:bottom;width:9.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:6pt 0pt 0pt 0pt;">50</p></td></tr><tr style=""><td style="vertical-align:top;width:90.58%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:10.8pt;text-indent:-10.8pt;margin:6pt 0pt 0pt 0pt;"><a href="#SECURITYOWNERSHIPOFCERTAINBENEFICIALOWNE"><span style="font-style:normal;font-weight:normal;">SECURITY OWNERSHIP OF CERTAIN BENEFICIAL OWNERS AND MANAGEMENT</span></a></p></td><td style="vertical-align:bottom;width:9.41%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:6pt 0pt 0pt 0pt;">51</p></td></tr><tr style=""><td style="vertical-align:top;width:90.58%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-left:10.8p