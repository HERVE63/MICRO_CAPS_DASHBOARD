<ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="dei:EntityCentralIndexKey" id="thunderdome-EntityCentralIndexKey">0001478454</ix:nonNumeric>
<ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="dei:EntityRegistrantName" id="thunderdome-EntityRegistrantName">Eagle Bancorp Montana, Inc.</ix:nonNumeric>
<ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="dei:AmendmentFlag" format="ixt:fixed-false" id="ixv-35138">false</ix:nonNumeric>
