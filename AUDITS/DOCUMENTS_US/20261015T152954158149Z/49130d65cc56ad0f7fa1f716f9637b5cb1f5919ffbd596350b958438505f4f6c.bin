  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:IncomeTaxDisclosureTextBlock" id="c3126147" escape="true">
   <p style="margin: 0pt 7.2pt; text-align: center; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><b></b></p><ix:exclude><p style="margin: 0pt 7.2pt; text-align: center; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><b>EAGLE BANCORP MONTANA, INC. AND SUBSIDIARIES</b></p>
   <p style="margin: 0pt 7.2pt; text-align: center; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</p>
   <p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
   <p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p></ix:exclude><p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"></p>
   <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;"><tbody><tr><td style="width: 54pt; vertical-align: top;"> <p style="text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;"><b><span style="background-color:#ffffff;">NOTE <em style="font: inherit;">11:</em> </span></b></p> </td><td style="vertical-align: top;"> <p style="text-align: left; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt;"><b><span style="background-color:#ffffff;">Income Taxes</span></b></p> </td></tr>
</tbody></table>
   <p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: -54pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
   <p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">The components of the Company&#8217;s provision (benefit) for income taxes was&#160;as follows:</p>
   <p style="margin: 0pt 0pt 0pt 54pt; text-align: justify; text-indent: -54pt; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
