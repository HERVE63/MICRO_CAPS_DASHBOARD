  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="ecd:MtrlTermsOfTrdArrTextBlock" id="c3126101" escape="true">
   <table border="0" cellpadding="0" cellspacing="0" style="font-size: 10pt; width: 100%; text-indent: 0px;"><tbody><tr style="vertical-align: top;"><td style="width: 81pt;"> <p style="font-size: 10pt; margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif;"><b><a id="Item9b" title="Item9b" href="#"></a>ITEM <em style="font: inherit;">9B.</em></b></p> </td><td> <p style="font-size: 10pt; margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif;"><b><span style="background-color:#ffffff;">OTHER INFORMATION.</span></b></p> </td></tr>
</tbody></table>
   <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
   <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">Adoption or Termination of Trading Arrangements by Directors and Executive Officers.</p>
   <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
   <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">During the quarter ended <em style="font: inherit;"> December 31, 2025</em>, <span style="-sec-ix-hidden:c141590588"><span style="-sec-ix-hidden:c141591335"><span style="-sec-ix-hidden:c141591336"><span style="-sec-ix-hidden:c141591337">no</span></span></span></span> director or officer (as defined in Rule <em style="font: inherit;">16a</em>-<em style="font: inherit;">1</em>(f) under the Securities Exchange Act of <em style="font: inherit;">1934</em>) of the Company adopted or terminated a "Rule <em style="font: inherit;">10b5</em>-<em style="font: inherit;">1</em> trading arrangement" or "non-Rule <em style="font: inherit;">10b5</em>-<em style="font: inherit;">1</em> trading arrangement," as each term is defined in Item <em style="font: inherit;">408</em>(a) of Regulation S-K.&#160;</p>
  </ix:nonNumeric>
  <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
  <div>
   &#160;
  </div>
  <table border="0" cellpadding="0" cellspacing="0" style="font-size: 10pt; width: 100%; text-indent: 0px;">
   <tbody>
    <tr style="vertical-align: top;">
     <td style="width: 81pt;"> <p style="font-size: 10pt; margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif;"><b><a id="item9c" title="item9c" href="#"></a>ITEM 9C.</b></p> </td>
     <td> <p style="font-size: 10pt; margin: 0pt; font-family: &quot;Times New Roman&quot;, Times, serif;"><b>DISCLOSURE REGARDING FOREIGN JURISDICTIONS THAT PREVENT INSPECTION.</b></p> </td>
    </tr>

   </tbody>
  </table>
  <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
  <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">Not applicable.</p>
  <p style="margin: 0pt; text-align: justify; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</p>
