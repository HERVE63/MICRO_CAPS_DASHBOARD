			<td colspan="2" style="vertical-align:bottom;width:25.6%;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b>Annual Shareholders Meeting</b></p>
			</td>
			<td style="vertical-align:bottom;width:0.5%;">&#160;</td>
			<td style="vertical-align:bottom;width:0.5%;">&#160;</td>
