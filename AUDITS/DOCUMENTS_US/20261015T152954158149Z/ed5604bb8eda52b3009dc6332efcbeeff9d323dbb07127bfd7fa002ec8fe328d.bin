		<tbody><tr>
			<td style="vertical-align:top;width:auto;">&#160;</td>
		</tr>
		<tr>
			<td style="vertical-align:top;width:auto;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">PLEASE DATE, SIGN AND RETURN PROXY PROMPTLY.</p>
			</td>
		</tr>
		<tr>
			<td style="vertical-align:top;width:auto;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">Receipt of Notice of Annual Meeting and Proxy Statement is hereby acknowledged.</p>
			</td>
		</tr>
		<tr>
			<td style="vertical-align:middle;width:auto;">&#160;</td>
		</tr>
