			<td style="vertical-align:top;width:5.4%;">&#160;</td>
			<td style="vertical-align:top;width:24.9%;">&#160;</td>
		</tr>
		<tr>
			<td style="vertical-align:top;width:5.7%;">&#160;</td>
			<td style="vertical-align:top;width:4.9%;">
