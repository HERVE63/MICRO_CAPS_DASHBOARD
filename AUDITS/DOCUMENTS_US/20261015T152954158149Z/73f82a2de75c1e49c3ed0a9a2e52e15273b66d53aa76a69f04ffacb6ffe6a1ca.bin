e;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="text-align:center"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">13</span></div></div></div><div id="ib5b888172ee14eb18f57f10b8132708b_58"></div><hr style="page-break-after:always"/><div style="min-height:45pt;width:100%"><div style="margin-top:10pt"><span style="color:#0000ff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%;text-decoration:underline" href="#ib5b888172ee14eb18f57f10b8132708b_7">Table of Contents</a></span></div></div><ix:continuation id="f-351-5" continuedAt="f-351-6"><div style="margin-top:10pt"><span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">ACCRUED EXPENSES AND OTHER LIABILITIES</span></div><ix:nonNumeric contextRef="c-1" name="us-gaap:ScheduleOfAccruedLiabilitiesTableTextBlock" id="f-480" escape="true"><div style="margin-top:8pt;text-align:justify"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Accrued expenses and other liabilities consisted of the following as of June&#160;30, 2026, and December&#160;31, 2025</span><span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">: </span></div><div style="margin-top:8pt;text-align:justify"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:71.778%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.081%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.557%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:12.0