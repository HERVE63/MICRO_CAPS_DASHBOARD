<td style="vertical-align:bottom;background-color:#d1ffff">&#160;&#160;</td>
<td style="vertical-align:bottom;background-color:#d1ffff">$</td>
<td style="vertical-align:bottom;background-color:#d1ffff;text-align:right">698,840</td>
<td style="white-space:nowrap;vertical-align:bottom;background-color:#d1ffff">&#160;</td>
