tRef="C_95b2255d-34e8-4ba5-9704-c227e38fa889" name="ecd:NonRule10b51ArrTrmntdFlag" format="ixt:fixed-false"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">No</span></ix:nonNumeric></ix:nonNumeric></ix:nonNumeric></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">ne.</span></div></div><div class="item-list-element-wrapper" style="margin-left:2.667%;display:flex;margin-top:8pt;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:2.667%;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:2.7400778769790306%;word-break:keep-all;display:inline-flex;justify-content:flex-start;">(b)</span><div style="display:inline;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">None.</span></div></div><div class="item-list-element-wrapper" style="margin-left:2.667%;display:flex;margin-top:8pt;justify-content:flex-start;align-items:baseline;margin-bottom:0;min-width:2.667%;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:2.7400778769790306%;word-break:keep-all;display:inline-flex;justify-content:flex-start;">(c)</span><div style="display:inline;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> </span></div></div><p style="text-indent:-4.749%;padding-left:4.533%;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:justify;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p><p style="text-indent:-4.749%;padding-left:4.533%;font-si