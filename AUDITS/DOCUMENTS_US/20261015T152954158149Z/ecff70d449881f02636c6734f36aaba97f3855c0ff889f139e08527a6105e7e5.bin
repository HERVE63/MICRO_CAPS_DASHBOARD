     <td style="width:10.444%;box-sizing:content-box;"/>
     <td style="width:10.444%;box-sizing:content-box;"/>
     <td style="width:10.444%;box-sizing:content-box;"/>
     <td style="width:10.444%;box-sizing:content-box;"/>
     <td style="width:11.741%;box-sizing:content-box;"/>
    </tr>
    <tr style="height:10pt;background-color:#1b2e59;word-break:break-word;white-space:pre-wrap;text-align:left;">
     <td style="padding-top:0in;border-right:0.5pt solid #000000;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-weight:bold;font-kerning:none;min-width:fit-content;">Experience / Skills*</span></p></td>
     <td style="padding-top:0in;border-right:0.5pt solid #000000;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="white-space:pre-wrap;font-kerning:none;min-width:fit-content;">&#160;</span></p><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span style="color:#ffffff;white-space:pre-wrap;font-style:italic;font-kerning:none;min-width:fit-content;">Nguyen</span></p></td>
