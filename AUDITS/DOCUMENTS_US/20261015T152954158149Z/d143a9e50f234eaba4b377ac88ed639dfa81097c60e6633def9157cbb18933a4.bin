f';font-size:9pt;padding-left:7.2pt;text-indent:-7.2pt;margin:0pt;">Unvested as of December&#160;31, 2025</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.06%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.98%;background:#cceeff;border-bottom:3px double #000000;border-top:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_IFQ0-aTtbkCDKWjhAc6XgA" contextRef="As_Of_12_31_2025_yex944g7NUmURe-rJzFzUg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedNumber" scale="0" id="Tc_txS8GDhjgU-i7v3OWz4iQA_10_2">3,478,941</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.06%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:9pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:7.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Divide_USD_shares_lkJJTSlZCUaeVZ100Qstng" contextRef="As_Of_12_31_2025_yex944g7NUmURe-rJzFzUg" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsNonvestedWeightedAverageGrantDateFairValue" scale="0" id="Tc_2FmBsjO1pk266FL9zCg3xQ_10_5">11.64</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.52%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:9pt;visibility:hidden;">&#8203;</span></p></td></tr></table></ix:nonNumeric><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">Beginning in the third quarter of 2024, all vesting will be from the 2020 equity plan and new common shares will be issued. As of December&#160;31, 2025, there was approximately $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="As_Of_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_gNLehOvcBUmJ9bOhRMOt3w" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognized" scale="6" id="Narr_1j0uhjSOWkODXulrtedMdQ">16.0</ix:nonFraction> million of total unrecognized compensation expense and approximately $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="As_Of_12_31_2025_yex944g7NUmURe-rJzFzUg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardEquityInstrumentsOtherThanOptionsAggregateIntrinsicValueNonvested" scale="6" id="Narr_IgJ66ztVWUuaRZPU07zp2g">12.5</ix:nonFraction> million in total intrinsic value related to non-vested RSU grants. The unrecognized compensation expense will be recognized over the remaining weighted-average vesting period of <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_XP3Q4Ojn3keQX0hUdPysOw" format="ixt-sec:duryear" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardRequisiteServicePeriod1" id="Narr_1_2qlS2nCEOo3v9qpQWkmw">1.3</ix:nonNumeric> years using the straight-line method.</p></ix:continuation><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-44</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.41%;border:0;margin:30pt 10.29% 30pt 10.29%;"></div><div style="max-width:100%;padding-left:10.29%;padding-right:10.29%;position:relative;"><div style="margin-top:21.6pt;min-height:41.4pt;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><a href="#Toc"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">TTEC HOLDINGS, INC. AND SUBSIDIARIES</b></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:0pt 0pt 6pt 0pt;"><b style="font-weight:bold;">Notes to the Consolidated Financial Statements</b></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_zyD8AS5Wbki7ljkdRW2qOA" name="us-gaap:DefinedContributionPlanTextBlock" id="Tb_-CN0hbgnk02ubrsp8QDGYw" escape="true"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><span style="display:inline-block;text-indent:0pt;width:36pt;"><b style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;font-style:normal;font-weight:bold;">(20)</b></span><b style="font-weight:bold;">NON-QUALIFIED DEFERRED COMPENSATION PLAN</b></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt;">The Company maintains a <span style="-sec-ix-hidden:Hidden_ssq8U_62ok-Y34wBkhJnBQ;"><span style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;font-style:normal;font-weight:normal;">non-qualified</span></span> deferred compensation plan for executive officers and other eligible employees that permits such employees to defer a portion of their compensation, on a pretax basis, until after their termination of employment (the &#8220;NQ Deferred Compensation Plan&#8221;). The Plan allows for deferral of up to <ix:nonFraction unitRef="Unit_Standard_pure_pIFYEG--0kK_DOWwcZuHVg" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_RetirementPlanSponsorLocationAxis_country_US_JAIG_54-7UOqMr1EIphnIA" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:DefinedContributionPlanMaximumAnnualContributionsPerEmployeePercent" scale="-2" id="Narr_J3FAhtEiWUCpwy0ff5hKfw">75</ix:nonFraction>% of a participant&#8217;s base salary, bonus, commissions, and any amounts that U.S. highly compensated employees are limited from contributing into TTEC&#8217;s Deferred Tax Retirement Savings Plan (the &#8220;401K Plan&#8221;). All amounts deferred under the Plan are unfunded, unsecured obligations and are recorded within Other long-term liabilities in the accompanying Consolidated Balance Sheets. In the event of bankruptcy, the assets of this plan are available to satisfy the claims of general creditors. Participants may choose among alternative earnings rates for the amounts they defer, which are primarily based on investment options within the 401K Plan. Amounts contributed and deferred under the Plan are credited or charged with the performance of investment options offered under the plan as elected by the participants. The Company manages the risk of changes in the fair value of the liability for deferred compensation by electing to match its liability under the plan with investment vehicles that offset a portion of its exposure including a Company owned life insurance policy held in a rabbi trust. In the fourth quarter of 2024 the Company suspended additional deferrals into the Plan for 2025 and until further notice.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;visibility:hidden;">&#8203;</span></p></ix:nonNumeric><a id="_Hlk508624287"></a><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_zyD8AS5Wbki7ljkdRW2qOA" name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock" id="Tb_3gxVIVSAEkiUijMmcZExjQ" escape="true"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><span style="display:inline-block;text-indent:0pt;width:36pt;"><b style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;font-style:normal;font-weight:bold;">(21)</b></span><b style="font-weight:bold;">RELATED PARTY TRANSACTIONS</b></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">The Company entered into an agreement under which Avion, LLC (&#8220;Avion&#8221;) and Airmax LLC (&#8220;Airmax&#8221;) provide certain aviation flight services as requested by the Company. Such services include the use of an aircraft and flight crew. Kenneth D. Tuchman, Chairman and Chief Executive Officer of the Company, has an indirect <ix:nonFraction unitRef="Unit_Standard_pure_pIFYEG--0kK_DOWwcZuHVg" contextRef="As_Of_12_31_2025_srt_CounterpartyNameAxis_ttec_AvionAndAirmaxMember_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_ttec_AvionAndAirmaxMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_ChiefExecutiveOfficerMember_Znef3oroV0GJA1mPN-F3PQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:EquityMethodInvestmentOwnershipPercentage" scale="-2" id="Narr_H92__9xK8kmQE8fBnSd9yQ">100</ix:nonFraction>% beneficial ownership interest in Avion and Airmax. During 2025, 2024 and 2023, the Company expensed $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_CounterpartyNameAxis_ttec_AvionAndAirmaxMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_AffiliatedEntityMember_ZKxa35Mi_0yyfsim0Kp8fQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:RelatedPartyTransactionPurchasesFromRelatedParty" scale="6" id="Narr_zTW1DtNYGkCv19vmMR9N6g">0.8</ix:nonFraction>&#160;million, $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2024_To_12_31_2024_srt_CounterpartyNameAxis_ttec_AvionAndAirmaxMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_AffiliatedEntityMember_w-2PN4PKokGACWD7l4ffbQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:RelatedPartyTransactionPurchasesFromRelatedParty" scale="6" id="Narr_L0Cs0Fjxn0er6rG919YMRQ">0.6</ix:nonFraction>&#160;million and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_srt_CounterpartyNameAxis_ttec_AvionAndAirmaxMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_AffiliatedEntityMember_M3_4w8qTZkit9UcjaV3NrA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:RelatedPartyTransactionPurchasesFromRelatedParty" scale="6" id="Narr_AADyHXcchUim1ZEBp5rAXQ">1.0</ix:nonFraction>&#160;million, respectively, to Avion and Airmax for services provided to the Company. There was $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="As_Of_12_31_2025_srt_CounterpartyNameAxis_ttec_AvionAndAirmaxMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_AffiliatedEntityMember__iTOjmlAOEyFWCxO1_pesg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:AccountsPayableCurrent" scale="6" id="Narr_PHhE5Pz0r0W50dOit7eKqA">0.2</ix:nonFraction> million in payments due and outstanding to Avion and Airmax as of December&#160;31, 2025. </p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">In 2025, the Company entered into service agreements with Mantucket Capital Management Corporation (&#8220;Mantucket&#8221;) to provide staff augmentation and cloud migration services. Kenneth D. Tuchman, Chairman and Chief Executive Officer of the Company, has a <ix:nonFraction unitRef="Unit_Standard_pure_pIFYEG--0kK_DOWwcZuHVg" contextRef="As_Of_12_31_2025_srt_ScheduleOfEquityMethodInvestmentEquityMethodInvesteeNameAxis_ttec_MantucketMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_ChiefExecutiveOfficerMember_2dwX-Pkg9EWq4I8h_aCy-w" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:EquityMethodInvestmentOwnershipPercentage" scale="-2" id="Narr_Y-jwXczBq0SgoywSUbKizQ">100</ix:nonFraction>% beneficial ownership interest in Mantucket. During the year ended December&#160;31, 2025, the Company recognized revenue under these agreements of $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_CounterpartyNameAxis_ttec_MantucketMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_srt_ChiefExecutiveOfficerMember_nRMlFE3i8k611c8IMGECQA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax" scale="6" id="Narr_Bt6NYL8xB0-o_lr_rIBhSg">0.2</ix:nonFraction> million.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">Ms. Michelle Swanback, former President of the Company, whose resignation was effective on December 31, 2024, is a member of the board of directors of WTW (NYSE:WTW) (aka &#8220;Willis&#8221;), that provides compensation consulting and insurance brokerage services to the Company. During the year ended December 31, 2024, the Company expensed $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2024_To_12_31_2024_srt_CounterpartyNameAxis_ttec_WillisTowersWatsonMember_BsiMZGtp10i2Ko2yBNh0yQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:RelatedPartyTransactionPurchasesFromRelatedParty" scale="6" id="Narr_RWDo0H-yRUSBzPIFy0yYEA">2.8</ix:nonFraction> million for these services.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:5pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;background:#00ffff;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:6pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:4pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-45</p></div></div>
