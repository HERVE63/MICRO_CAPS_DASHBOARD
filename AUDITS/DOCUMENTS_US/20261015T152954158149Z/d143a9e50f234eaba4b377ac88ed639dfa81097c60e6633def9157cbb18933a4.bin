gaap:EmployeeServiceShareBasedCompensationTaxBenefitFromCompensationExpense" scale="3" id="Tc_K1LgCeyudU2_3sLl2YGClQ_8_6">747</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.27%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:9pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.27%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:8.19%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_h8ncht8wBE62JCkZFZ7E8Q" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:EmployeeServiceShareBasedCompensationTaxBenefitFromCompensationExpense" scale="3" id="Tc_cjjYpryZJUmmP-MDXkE3sA_8_9">2,329</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.82%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:9pt;visibility:hidden;">&#8203;</span></p></td></tr></table></ix:nonNumeric><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><i style="font-style:italic;">Restricted Stock Units</i></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;"><i style="font-style:italic;">2023, 2024 and 2025 RSU Awards: </i>The Company granted RSUs in 2023, 2024 and 2025 to new and existing employees that vest over <span style="-sec-ix-hidden:Hidden_wwA77pfbgUuJ0aA71P3-bw;"><span style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;font-style:normal;font-weight:normal;">three</span></span> to <ix:nonNumeric contextRef="Duration_1_1_2023_To_12_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_MGg3IwNfrkOKZpBEWfLUOw" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_fKA3kJQVLUedl1qtgH2-qA">five years</ix:nonNumeric>. The Company also granted RSUs in 2023, 2024 and 2025 to members of the Board of Directors that vest over <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_srt_TitleOfIndividualAxis_ttec_BoardOfDirectorsMember_3LzGeKsIhUWvJe2zOtc-xA" format="ixt-sec:durwordsen" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardAwardVestingPeriod1" id="Narr_9KmvlTWwbEGFF36JobMkzA">one year</ix:nonNumeric>. </p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;"><i style="font-style:italic;">Summary of RSUs: </i>Settlement of the RSUs shall be made in shares of the Company&#8217;s common stock by delivery of one share of common stock for each RSU then being settled. The Company calculates the fair value for RSUs based on the closing price of the Company&#8217;s stock on the date of grant and records compensation expense over the vesting period using a straight-line method. The Company factors an estimated forfeiture rate in calculating compensation expense on RSUs and adjusts for actual forfeitures upon the vesting of each tranche of RSUs. The Company also factors in the present value of the estimated dividend payments that will have accrued as these RSUs are vesting.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">The weighted average grant-date fair value of RSUs, including performance-based RSUs, granted during the years ended December&#160;31, 2025, 2024, and 2023 was $<ix:nonFraction unitRef="Unit_Divide_USD_shares_lkJJTSlZCUaeVZ100Qstng" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_XP3Q4Ojn3keQX0hUdPysOw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_axcbkIIE8kGrqlxsZDxLMA">4.36</ix:nonFraction>, $<ix:nonFraction unitRef="Unit_Divide_USD_shares_lkJJTSlZCUaeVZ100Qstng" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_eDCO2ubfmUC2CCR99pym3A" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_T69Bim41OUS9nV_gZflu6g">6.55</ix:nonFraction>, and $<ix:nonFraction unitRef="Unit_Divide_USD_shares_lkJJTSlZCUaeVZ100Qstng" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_IxzaOozWAkCyy25Mc7wTdw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriodWeightedAverageGrantDateFairValue" scale="0" id="Narr_9Fp5DuwoY0Gkl412eGCb_Q">33.34</ix:nonFraction>, respectively. The total intrinsic value and fair value of RSUs vested during the years ended December&#160;31, 2025, 2024, and 2023 was $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_XP3Q4Ojn3keQX0hUdPysOw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardEquityInstrumentsOtherThanOptionsAggregateIntrinsicValueVested" scale="6" id="Narr_spQ1rnRm9kuB95jCb71XKg">15.6</ix:nonFraction> million, $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2024_To_12_31_2024_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_eDCO2ubfmUC2CCR99pym3A" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardEquityInstrumentsOtherThanOptionsAggregateIntrinsicValueVested" scale="6" id="Narr_GyeGsIL8aE-JUwxy6WVm5A">22.6</ix:nonFraction> million, and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_AwardTypeAxis_us-gaap_RestrictedStockUnitsRSUMember_IxzaOozWAkCyy25Mc7wTdw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardEquityInstrumentsOtherThanOptionsAggregateIntrinsicValueVested" scale="6" id="Narr_hLBTXx8rxUO-nGlUizR66g">17.7</ix:nonFraction> million, respectively.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><i style="font-style:italic;">Performance Based Restricted Stock Unit Grants</i></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;"><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_PlanNameAxis_ttec_Prsus2021Member_bCEu46w1mU-qdrH2szIQLg" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardDescription" id="Narr_UVIijuhie0GZw_EVxPFJXQ">During 2021, the Company awarded performance-based RSUs (&#8220;PRSUs&#8221;) that were subject to service and performance vesting conditions. If defined minimum targets were met, the annual value of the PRSUs issued would be between $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2021_To_12_31_2021_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2021Member_M1Jszs9nZEaUjpd74MGzPg" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_D0cacJoaZk2gCy9zjGvxmA">1.2</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2021_To_12_31_2021_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2021Member_v1xW5Qiym06JX_aIVTCyrw" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_lUlGmAMlH0WY8ietHUvBxA">4.9</ix:nonFraction> million and vest immediately in 2024. If the defined minimum targets were not met, then no shares would be issued. The number of shares that were awarded was based on the Company's annual revenue and adjusted operating income for the fiscal year 2023. The Company recognized compensation expense related to the 2021 PRSUs of $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2021Member_2p1DJTKAbEGwdIyT08y8Jw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensation" scale="6" id="Narr_-NQPMKlIiUav22e1nowmOA">0.7</ix:nonFraction> million for the year ended December 31, 2023 with <ix:nonFraction unitRef="Unit_Standard_shares_IFQ0-aTtbkCDKWjhAc6XgA" contextRef="Duration_3_1_2024_To_3_31_2024_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2021Member_G9POSFWI-0GGOlDgVzt4qA" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriod" scale="0" id="Narr_4x96r6MvlEq6Xb5q-ysUQg">7,452</ix:nonFraction> shares issued in March 2024. </ix:nonNumeric></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">F-43</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.41%;border:0;margin:30pt 10.29% 30pt 10.29%;"></div><div style="max-width:100%;padding-left:10.29%;padding-right:10.29%;position:relative;"><div style="margin-top:21.6pt;min-height:41.4pt;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt 0pt 6pt 0pt;"><a href="#Toc"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">TTEC HOLDINGS, INC. AND SUBSIDIARIES</b></p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:0pt 0pt 6pt 0pt;"><b style="font-weight:bold;">Notes to the Consolidated Financial Statements</b></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_R-JqtXx-zkCjCUuN3vx6NA_1_4"></a><a id="Tc_tdyhtUst6U2MLM0HOwFNkA_2_4"></a><a id="Tc_wDOdZ8Pkh0GzUeFDuIoXOQ_3_4"></a><a id="Tc_9489Z0D00Eer0s2M7s_lmA_4_2"></a><a id="Tc_LVCd3IqhZU6Kmye2PxwCGA_4_4"></a><a id="Tc_eFGSVoFiTkSx7ofY0n6LAQ_6_0"></a><a id="Tc_uxo001-0F0eUyFoQoN4SFw_6_4"></a><a id="Tc_32AlE_TOuUaicBR__zZWFg_7_0"></a><a id="Tc_suu-3HZMaEGYb_OUTsDrhA_7_4"></a><a id="Tc_dCPp3a40MECwH2-4f65ryQ_8_0"></a><a id="Tc_Mo-dch-HUk2qfmfD2r7nmw_8_4"></a><a id="Tc_PsgOVjj6JE-lChV_lFI4MQ_9_0"></a><a id="Tc_djrWjZHjokWBmFOmHB32Ww_9_4"></a><a id="Tc_6M5t64F1JkOu-5u7e-YULA_10_0"></a><a id="Tc_X5JmQEKsnUOnTmm3PIDYaw_10_4"></a><ix:continuation id="Tb_1SS_EikMdkSGVedUR9ewYQ_cont2"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">During 2022, the Company granted awards of two different PRSU programs that were subject to service and performance vesting conditions: &#160;ordinary course annual PRSUs and one-time stretch financial goals PRSUs. <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022Member_cS3u62EWXEWMWddeybHcVQ" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardDescription" id="Narr_mad-j1r3L0CYjcKX4gNBYA">For the ordinary course annual PRSUs, if defined minimum targets were met, the annual value of the PRSUs issued would have been between $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2022_To_12_31_2022_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022Member_qWJDHSb7zk2Y06TIVSBuOg" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_5AcGo72uZ0yZjKe865BUZQ">0.9</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2022_To_12_31_2022_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022Member_lg9Dxrm8okWLUWnIWFMnig" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_-bg3oq7_O0yi-uFpDmY9YQ">3.5</ix:nonFraction> million and the PRSUs would have vested in March 2025. If the defined minimum targets were not met, then no shares would be issued. The number of shares that would have been awarded would have been based on the Company&#8217;s annual revenue and adjusted EBITDA for the fiscal year 2024.</ix:nonNumeric> <ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022VcpMember_uklJ7ocaxE-YZUKiJwQtVA" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardDescription" id="Narr_S-E86IrEb0qT-k0qmA5p-w">For the 2022 ordinary course annual PRSUs, no shares were issued in March 2025 as defined minimum targets were not met. For the one-time stretch financial goals PRSUs, if defined minimum targets at TTEC Engage and TTEC Digital business segments&#8217; levels were met, the number of shares of PRSUs issued would be between <ix:nonFraction unitRef="Unit_Standard_shares_IFQ0-aTtbkCDKWjhAc6XgA" contextRef="As_Of_12_31_2023_srt_RangeAxis_srt_MinimumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022VcpMember_560UdZzs9EuTIL2vbWd0hQ" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedNumberOfNonvestedPrsuSharesToBeGranted" scale="6" id="Narr_gxWDySU890eUKZgkpKC__g">0.0</ix:nonFraction> million shares and <ix:nonFraction unitRef="Unit_Standard_shares_IFQ0-aTtbkCDKWjhAc6XgA" contextRef="As_Of_12_31_2023_srt_RangeAxis_srt_MaximumMember_us-gaap_AwardTypeAxis_us-gaap_PerformanceSharesMember_us-gaap_PlanNameAxis_ttec_Prsus2022VcpMember_CBJV7YuaoU2NmyZdC1PDiw" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedNumberOfNonvestedPrsuSharesToBeGranted" scale="6" id="Narr_sqMszlShW06q4Y7jzTw4eQ">0.5</ix:nonFraction> million shares and would vest immediately in March 2026. If the defined minimum targets were not met, then no shares would be issued. The number of shares to be awarded would be based on the TTEC Engage and TTEC Digital business segments&#8217; annual revenue and adjusted EBITDA for the fiscal year 2025.</ix:nonNumeric> The Company did not recognize any compensation expense related to these awards for the year ended December 31, 2025, as defined minimum targets were not met.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">During 2023, the Company awarded PRSUs that are subject to service and performance vesting conditions. If defined minimum targets were met, the annual value of the PRSUs issued would be between <ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_srt_RangeAxis_srt_MinimumMember_us-gaap_PlanNameAxis_ttec_Prsus2023Member_f80NWaIczEKTdm5edMiyPA" decimals="INF" format="ixt-sec:numwordsen" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="0" id="Narr_EwggB5B_eEyGzRS29plmGA">zero</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2023_To_12_31_2023_srt_RangeAxis_srt_MaximumMember_us-gaap_PlanNameAxis_ttec_Prsus2023Member_TAAGGRU26EeUvw8NvaHqnw" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_brZ1UeBgPES5P2YMfZeFGg">8.9</ix:nonFraction> million and would vest immediately in 2026. If the defined minimum targets were not met, then no shares would be issued. The number of shares that would be awarded would be based on the Company&#8217;s annual revenue and adjusted EBITDA for fiscal year 2025. The Company did not recognize any compensation expense related to these awards for the year ended December 31, 2025, as defined minimum targets were not met.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt 0pt 6pt 0pt;">During 2024, the Company awarded PRSUs to senior executives that are subject to service and performance vesting conditions. If defined minimum targets are met, the Company will issue PRSUs with an annual value between <ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2024_To_12_31_2024_srt_RangeAxis_srt_MinimumMember_us-gaap_PlanNameAxis_ttec_Prsus2024Member_Lbl57-h_REuTxVG9hng77g" decimals="INF" format="ixt-sec:numwordsen" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="0" id="Narr_vg0WiiOjxUyuT5ZfprlUBQ">zero</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_Dze-CAjoCUOfvtJoEMTwxg" contextRef="Duration_1_1_2024_To_12_31_2024_srt_RangeAxis_srt_MaximumMember_us-gaap_PlanNameAxis_ttec_Prsus2024Member_3nVHppWJq0yevl_SO-A3UA" decimals="-5" format="ixt:num-dot-decimal" name="ttec:ForecastedAmountOnNoncashExpenseForShareBasedPaymentArrangement" scale="6" id="Narr_mNKI2QszbkCwOxpf23hVqw">5.9</ix:nonFraction> million that vest in 2026. If the defined minimum targets are not met, then no PRSUs will be issued. The number of PRSUs awarded will be based on the Company&#8217;s annual revenue and adjusted EBITDA for fiscal year 2026 and on TTEC Digital&#8217;s annual revenue and adjusted EBITDA for fiscal year 2026. Expense for these awards will begin at the start of the requisite service period, beginning January 1, 2026.</p><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;text-align:justify;margin:0pt;">A summary of the status of the Company&#8217;s non-vested RSUs and PRSUs and activity for the year ended December&#160;31, 2025 is as follows:</p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_zyD8AS5Wbki7ljkdRW2qOA" name="us-gaap:ScheduleOfShareBasedCompensationRestrictedStockUnitsAwardActivityTableTextBlock" id="Tb_notoNE1zyUqqDeiVFcFhiA" escape="true"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:75.87%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Arial','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:9pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:2.06%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position: