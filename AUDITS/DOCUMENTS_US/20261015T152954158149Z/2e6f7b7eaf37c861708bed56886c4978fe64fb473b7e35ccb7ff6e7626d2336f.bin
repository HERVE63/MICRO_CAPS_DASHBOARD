ical-align:bottom;white-space:nowrap;width:2.07%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.2%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_us-gaap_VestingAxis_vuzi_TrancheThreeMember_67CDuvDhYk6EZdrQDL570A" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ConvertiblePreferredStockSharesIssuedUponConversion" scale="0" id="Tc_SKGYM11hjUGZgoQUTeF4XQ_3_10">2,302,420</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td></tr><tr style=""><td style="vertical-align:bottom;width:26.77%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 6pt;"><b style="font-weight:bold;">Totals</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.07%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.19%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_VCSuC3jfjUqzFrEN9Js5bg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:TemporaryEquitySharesIssued" scale="0" id="Tc_rcAsCsjQSUyuElXZK17htA_4_2">419,959</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.07%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:center;margin:0pt 0pt 0.05pt 0pt;"><b style="font-weight:bold;">$</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.2%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_VCSuC3jfjUqzFrEN9Js5bg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:TemporaryEquityCarryingAmountAttributableToParent" scale="0" id="Tc_3_9BcfMYDU2L0XoAoFdJIA_4_5">10,000,000</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.07%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.2%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.07%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-weight:bold;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.2%;background:#cceeff;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:right;margin:0pt 3pt 0.05pt 0pt;"><b style="font-weight:bold;"> <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_VCSuC3jfjUqzFrEN9Js5bg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ConvertiblePreferredStockSharesIssuedUponConversion" scale="0" id="Tc_4WeocLZmgUueXerzk4oGpA_4_10">4,199,590</ix:nonFraction></b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8pt;margin-bottom:0pt;visibility:hidden;">&#8203;</span></p></td></tr></table></div></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:0pt;margin:0pt 0pt 12pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">The Series B Preferred Stock entitles the holders to cumulative dividends at the annual rate of <ix:nonFraction unitRef="Unit_Standard_pure_rDitsLzvCE6RaAkcVtAKQg" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_JDMGcrBQ0EKkPxSRPAyCWg" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockDividendRatePercentage" scale="-2" id="Narr_vtUFcrzFdEexTrD_3kPXGw">1.5</ix:nonFraction>% of the original issuance price, payable quarterly in cash. During the three months ended June 30, 2026 and 2025, there were $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_8VtrD9u-90WlC9pbp_0lrg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PaymentsOfDividendsPreferredStockAndPreferenceStock" scale="0" id="Narr_s2ZpC-JGG0GBI9JpsEzLQQ">37,500</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_aNgnRz6mfkGxuODLFlU1vQ" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:PaymentsOfDividendsPreferredStockAndPreferenceStock" scale="0" id="Narr_l0DeIGXAbUaotUyB_-9DdA">nil</ix:nonFraction> of preferred dividends paid, respectively. During the six months ended June 30, 2026 and 2025, there were $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_JDMGcrBQ0EKkPxSRPAyCWg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PaymentsOfDividendsPreferredStockAndPreferenceStock" scale="0" id="Narr_E-X6sSsKakuenwnrI3sxDg">77,424</ix:nonFraction> and <ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_1_1_2025_To_6_30_2025_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_HL7XPFKzKkKTRTd0Kzwk5Q" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:PaymentsOfDividendsPreferredStockAndPreferenceStock" scale="0" id="Narr_AIwzP_sLWUCjxutVg8L5Ig">nil</ix:nonFraction> of preferred dividends paid, respectively. As of June 30, 2026 and December 31, 2025, total accumulated and unpaid preferred dividends were $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_VCSuC3jfjUqzFrEN9Js5bg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DividendsPayableCurrentAndNoncurrent" scale="0" id="Narr_xohaYb__OEKFZDnK1C4flw">37,500</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="As_Of_12_31_2025_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_jOcQNNW_rE2dEmMRFyAimQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DividendsPayableCurrentAndNoncurrent" scale="0" id="Narr_iinUXxrEdkOVHAepKkXcxQ">39,923</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:36pt;margin:0pt 0pt 12pt 0pt;">Holders of the Series B Preferred Stock will have the right upon the occurrence of certain triggering events, as defined in the certificate of designation, that are not all solely within the control of the Company to require the Company to redeem all or part of their Series B Preferred Stock for cash at a price equal to <ix:nonFraction unitRef="Unit_Standard_pure_rDitsLzvCE6RaAkcVtAKQg" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_JDMGcrBQ0EKkPxSRPAyCWg" decimals="2" format="ixt:num-dot-decimal" name="vuzi:TemporaryEquityPercentageOfLiquidationPreferencePrice" scale="-2" id="Narr_3ISQ_cGj9ka6Rq1weSDaiA">100</ix:nonFraction>% of the liquidation preference plus accrued but unpaid dividends.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:36pt;margin:14pt 0pt 0pt 0pt;">Because the Series B Preferred Stock contains redemption features that are not solely within the control of the Company and may be triggered by events outside the Company&#8217;s control, the Series B Preferred Stock is classified outside of permanent equity, in accordance with ASC 480-10-S99-3A (SEC guidance on redeemable securities).</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:14pt 0pt 12pt 36pt;"><b style="font-weight:bold;">Common Stock</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:36pt;margin:0pt;">As of June 30, 2026, the Company&#8217;s authorized common stock consists of <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_i9TKxczFt0SgRScz6Y1thw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_xe6-DF6DcU6_y_wS1MdgfQ">200,000,000</ix:nonFraction> shares, par value of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_o2WRIXv010e-73VQZYSZWg" contextRef="As_Of_6_30_2026_i9TKxczFt0SgRScz6Y1thw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_WyMdQRt0AUyGfBtHAiKerA">0.001</ix:nonFraction>. There were <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_i9TKxczFt0SgRScz6Y1thw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_KVuYECcIgUyRT-62scCESA">84,993,902</ix:nonFraction> shares issued and <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_i9TKxczFt0SgRScz6Y1thw" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesOutstanding" scale="0" id="Narr_SlKSJBrzI0-Q0zMKuacpBw">84,414,230</ix:nonFraction> shares outstanding as of June 30, 2026 and <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_12_31_2025_Ex75R_pd_UWhTxQ42s4UaQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesIssued" scale="0" id="Narr_8mFHqJ0t_U2p6Lo93CQT8g">81,679,367</ix:nonFraction> shares issued and <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_12_31_2025_Ex75R_pd_UWhTxQ42s4UaQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesOutstanding" scale="0" id="Narr_RHjpmEDKgUChqxWA2NjNxg">81,099,695</ix:nonFraction> shares outstanding as of December 31, 2025.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:36pt;margin:0pt;">The <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_us-gaap_SubsidiarySaleOfStockAxis_vuzi_SecurityPurchaseAgreementWithQuantaComputerIncMember_8B-bVLSkh0yBim2oWVUTKg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockSharesOutstanding" scale="0" id="Narr_70C4ZlHO-E-zpIMQA2Qdrg">419,959</ix:nonFraction> shares of Series B Preferred Stock outstanding as of June 30, 2026 held by Quanta are convertible into <ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="As_Of_6_30_2026_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesBPreferredStockMember_us-gaap_SubsidiarySaleOfStockAxis_vuzi_SecurityPurchaseAgreementWithQuantaComputerIncMember_8B-bVLSkh0yBim2oWVUTKg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ConvertiblePreferredStockSharesIssuedUponConversion" scale="0" id="Narr_WW_PeCtdwUi2FopY4ppl0w">4,199,590</ix:nonFraction> shares of common stock.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-indent:0pt;margin:0pt;"><span style="margin-bottom:12pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;margin:0pt 0pt 12pt 36pt;"><b style="font-weight:bold;">ATM Program</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:justify;text-indent:18pt;margin:0pt;">The Company filed a Registration Statement on Form S-3 with the SEC that became effective in May 2024, which includes a sales agreement prospectus for the issuance and sale of up to $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="As_Of_5_31_2024_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_A2NIjx6KAU-YEqMlvcqCEA" decimals="0" format="ixt:num-dot-decimal" name="vuzi:EstimatedTotalCommonStockValueToBeSold" scale="0" id="Narr_9456KobsL0qEjtAxuo_oqg">50,000,000</ix:nonFraction> of our common stock from time to time under a sales agreement with an investment bank in an &#8220;at the market&#8221; (&#8220;ATM&#8221;) offering.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:justify;text-indent:18pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:justify;text-indent:18pt;margin:0pt;">During the three months ended June 30, 2026, the Company sold&#160;<ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_p2fd-aiuPUa9r3LnCTwLqQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_r4KjPewDo0yk5gSpL5gx3A">1,000,000</ix:nonFraction> shares of common stock for gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_p2fd-aiuPUa9r3LnCTwLqQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromIssuanceOfCommonStock" scale="0" id="Narr_VBXhTebuvUyNNuha5E63Bg">4,284,250</ix:nonFraction> (average sales price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_o2WRIXv010e-73VQZYSZWg" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_p2fd-aiuPUa9r3LnCTwLqQ" decimals="2" format="ixt:num-dot-decimal" name="vuzi:SharesIssuedAveragePricePerShare" scale="0" id="Narr_SJz8-cO8P0uhJzYyfBD_hA">4.28</ix:nonFraction>&#160;per share) under the ATM before deducting broker expenses paid by the Company of $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_p2fd-aiuPUa9r3LnCTwLqQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PaymentsOfStockIssuanceCosts" scale="0" id="Narr_9qS4myqzTEK6geKsNeqQPA">154,233</ix:nonFraction>. During the three months ended June 30, 2025, the Company sold&#160;<ix:nonFraction unitRef="Unit_Standard_shares_wfuAh-FoWkC2pIwPnWyafQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_yLgBip2Kk06jdmp6L41fjg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_MNG2AGdprUSlS20ozXoo3Q">1,060,194</ix:nonFraction> shares of common stock for gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_yLgBip2Kk06jdmp6L41fjg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromIssuanceOfCommonStock" scale="0" id="Narr_zcOl4_yH8EKBVvAiaF_OvA">2,941,294</ix:nonFraction> (average sales price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_o2WRIXv010e-73VQZYSZWg" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_yLgBip2Kk06jdmp6L41fjg" decimals="2" format="ixt:num-dot-decimal" name="vuzi:SharesIssuedAveragePricePerShare" scale="0" id="Narr_G9cxieA1-k-9Hu5aX81bdw">2.77</ix:nonFraction>&#160;per share) under the ATM before deducting broker expenses paid by the Company of $<ix:nonFraction unitRef="Unit_Standard_USD_9-Bty0nPM0W2JIJ7ScmAOQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_SubsidiarySaleOfStockAxis_vuzi_AtMarketAtmOfferingMember_yLgBip2Kk06jdmp6L41fjg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PaymentsOfStockIssuanceCosts" scale="0" id="Narr_3j2WKZsyZEWRmiYBd1oprg">105,887</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:justify;text-indent:18pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;line-height:1.19;text-align:center;margin:24pt 0pt 0pt 0pt;">16</p></div></div>
