  <tr style="vertical-align: bottom; background-color: White">
    <td style="text-align: left">Second Quarter</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right">3.34</td><td style="text-align: left">&#160;</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right">2.48</td><td style="text-align: left">&#160;</td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: left">Third Quarter</td><td>&#160;</td>
