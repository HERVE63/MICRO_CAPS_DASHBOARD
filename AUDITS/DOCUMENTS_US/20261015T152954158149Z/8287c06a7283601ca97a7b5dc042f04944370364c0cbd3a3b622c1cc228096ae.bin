As of June 30, 2025, NetSol PK used Rs. <span id="xdx_902_eus-gaap--LineOfCreditFacilityMaximumBorrowingCapacity_iI_pp0p0_uPKR_c20250630__us-gaap--LineOfCreditFacilityAxis__custom--HabibMetroBankLimitedMember__dei--LegalEntityAxis__custom--NetSolPKMember__us-gaap--CreditFacilityAxis__custom--SaleAndLeasebackFinancingMember_zPnaPLU4DeVd" title="Line of credit facility, maximum borrowing capacity" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityMaximumBorrowingCapacity" contextRef="AsOf2025-06-30_custom_HabibMetroBankLimitedMember_custom_NetSolPKMember_custom_SaleAndLeasebackFinancingMember" id="Fact001493" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="PKR">21,771,042</ix:nonFraction></span> or $<span id="xdx_905_eus-gaap--LineOfCreditFacilityMaximumBorrowingCapacity_iI_pp0p0_uUSD_c20250630__us-gaap--LineOfCreditFacilityAxis__custom--HabibMetroBankLimitedMember__dei--LegalEntityAxis__custom--NetSolPKMember__us-gaap--CreditFacilityAxis__custom--SaleAndLeasebackFinancingMember_zu99re9fTRC1" title="Line of credit facility, maximum borrowing capacity" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityMaximumBorrowingCapacity" contextRef="AsOf2025-06-30_custom_HabibMetroBankLimitedMember_custom_NetSolPKMember_custom_SaleAndLeasebackFinancingMember" id="Fact001495" format="ixt:numdotdecimal" decimals="0" scale="0" unitRef="USD">76,618</ix:nonFraction></span> of which $<span id="xdx_903_eus-gaap--LongTermLineOfCredit_iI_pp0p0_uUSD_c20250630__us-gaap--LineOfCreditFacilityAxis__custom--HabibMetroBankLimitedMember__dei--LegalEntityAxis__custom--NetSolPKMember__us-gaap--CreditFacilityAxis__custom--SaleAndLeasebackFinancingMember_zcRuW1MOmCsk" title="Line of credit, long