    <td style="font: 10pt Times New Roman, Times, Serif; text-align: center"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span id="xdx_90E_eus-gaap--PropertyPlantAndEquipmentUsefulLife_iI_dtY_c20260630__us-gaap--PropertyPlantAndEquipmentByTypeAxis__us-gaap--AutomobilesMember_zW1BtlTywuU2" title="Estimated useful life of assets"><ix:nonNumeric contextRef="AsOf2026-06-30_us-gaap_AutomobilesMember" format="ixt-sec:duryear" id="Fact000658" name="us-gaap:PropertyPlantAndEquipmentUsefulLife">5</ix:nonNumeric></span>
