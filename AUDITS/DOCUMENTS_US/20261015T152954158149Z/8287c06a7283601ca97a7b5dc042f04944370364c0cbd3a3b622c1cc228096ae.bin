    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td id="xdx_988_eus-gaap--MinorityInterest_iI_c20250630__srt--OwnershipAxis__custom--NetSolThaiMember_zfO63ti4LZhf" title="Non-Controlling Interest" style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction name="us-gaap:MinorityInterest" contextRef="AsOf2025-06-30_custom_NetSolThaiMember" id="Fact002454" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">184</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td></tr>
  <tr style="vertical-align: bottom; background-color: White">
