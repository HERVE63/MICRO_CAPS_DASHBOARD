    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td id="xdx_987_eus-gaap--MinorityInterest_iI_c20250630__srt--OwnershipAxis__custom--NIAIMember_zTk22HPtO6mj" title="Non-Controlling Interest" style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction name="us-gaap:MinorityInterest" contextRef="AsOf2025-06-30_custom_NIAIMember" id="Fact002450" format="ixt:numdotdecimal" decimals="0" sign="-" unitRef="USD">1,471</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td></tr>
  <tr style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="text-align: justify"><span style="font-family: Times New Roman, Times, Serif">NetSol Thai</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
