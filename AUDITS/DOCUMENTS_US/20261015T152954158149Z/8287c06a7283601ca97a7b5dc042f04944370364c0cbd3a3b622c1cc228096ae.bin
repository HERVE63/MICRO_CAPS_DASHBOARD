    <td style="text-align: left">&#160;</td><td style="text-align: right">5.3</td><td style="text-align: left">%</td><td>&#160;</td>
    <td style="text-align: left">$</td><td style="text-align: right">2,854,410</td><td style="text-align: left">&#160;</td><td>&#160;</td>
