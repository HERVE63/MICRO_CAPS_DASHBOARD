<table cellpadding="0" cellspacing="0" style="font: 10pt Times New Roman, Times, Serif; margin-top: 0; margin-bottom: 6pt; width: 100%"><tr style="vertical-align: top; text-align: justify">
<td style="width: 15pt; text-align: right"><span id="xdx_F09_zRZp9DDrMYMj" style="font-family: Times New Roman, Times, Serif; font-size: 10pt">(1)</span></td><td style="width: 5pt"/><td style="text-align: justify"><span id="xdx_F12_zmT3Edly94B8" style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><ix:footnote id="Footnote001350" xml:lang="en-US">The Company finances
Directors&#8217; and Officers&#8217; (&#8220;D&amp;O&#8221;) liability insurance and Errors and Omissions (&#8220;E&amp;O&#8221;) liability
insurance, for which the D&amp;O and E&amp;O balances are renewed on an annual basis and, as such, are recorded in current maturities.
The interest rates on these financings range from <span id="xdx_904_eus-gaap--LineOfCreditFacilityInterestRateAtPeriodEnd_iI_pid_dp_uPure_c20260630__srt--ProductOrServiceAxis__custom--DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember__srt--RangeAxis__srt--MinimumMember_zCaYoatC3xik" title="Line of credit facility interest rate" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityInterestRateAtPeriodEnd" contextRef="AsOf2026-06-30_custom_DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember_srt_MinimumMember" id="Fact001352" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">7.4</ix:nonFraction></span>% to <span id="xdx_906_eus-gaap--LineOfCreditFacilityInterestRateAtPeriodEnd_iI_pid_dp_uPure_c20260630__srt--ProductOrServiceAxis__custom--DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember__srt--RangeAxis__srt--MaximumMember_zenIeA25GgYf" title="Line of credit facility interest rate" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityInterestRateAtPeriodEnd" contextRef="AsOf2026-06-30_custom_DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember_srt_MaximumMember" id="Fact001354" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">7.8</ix:nonFraction></span>% and <span id="xdx_905_eus-gaap--LineOfCreditFacilityInterestRateAtPeriodEnd_iI_pid_dp_uPure_c20250630__srt--ProductOrServiceAxis__custom--DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember__srt--RangeAxis__srt--MinimumMember_zb7B2BLlLr88" title="Line of credit facility interest rate" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityInterestRateAtPeriodEnd" contextRef="AsOf2025-06-30_custom_DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember_srt_MinimumMember" id="Fact001356" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">8.4</ix:nonFraction></span>% to <span id="xdx_905_eus-gaap--LineOfCreditFacilityInterestRateAtPeriodEnd_iI_pid_dp_uPure_c20250630__srt--ProductOrServiceAxis__custom--DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember__srt--RangeAxis__srt--MaximumMember_zPbfKOnmpe94" title="Line of credit facility interest rate" class="xdx_phnt_RGlzY2xvc3VyZSAtIFNDSEVEVUxFIE9GIENPTVBPTkVOVFMgT0YgTk9URVMgUEFZQUJMRSBBTkQgQ0FQSVRBTCBMRUFTRVMgKERldGFpbHMpIChQYXJlbnRoZXRpY2FsKQA_"><ix:nonFraction name="us-gaap:LineOfCreditFacilityInterestRateAtPeriodEnd" contextRef="AsOf2025-06-30_custom_DirectorsAndOfficersAndErrorAndOmissionsLiabilityInsuranceMember_srt_MaximumMember" id="Fact001358" format="ixt:numdotdecimal" decimals="INF" scale="-2" unitRef="Pure">11.6</ix:nonFraction></span>% as of June 30, 2026 and 2025, respectively.</ix:footnote></span></td>
</tr></table>

