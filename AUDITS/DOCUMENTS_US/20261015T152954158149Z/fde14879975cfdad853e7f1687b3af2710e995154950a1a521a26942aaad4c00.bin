lapse;font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="width:18.5pt;"/><td style="font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;font-style:italic;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">(2)</td><td style="padding:0pt;"><i style="font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;font-style:italic;font-weight:normal;">The Non-PEO NEOs were, for the respective year(s): (a) Daniel P. Rohling and Walter R. Mayer for 2025 and 2024; and (b) Daniel P. Rohling, Walter R. Mayer and Leah R. Kasparek for 2023.</i></td></tr></table></ix:nonNumeric></ix:nonNumeric><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:6pt 0pt 6pt 0pt;"><b style="color:#003b5c;font-weight:bold;">Pay versus Performance Graphs. </b></p><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:1pt;margin:0pt;">&#160;&#160;&#160;&#160;</p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_3e3ATOjeN02nxJzTcboUSg" name="batl:SummaryCompensationTableVs.TotalShareholderReturn" id="Tb_tcQ8nku9hEm4U-S5CJbzGA" escape="true"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><img src="batl-20260611xdef14a_a025.jpg" alt="Graphic" style="display:inline-block;height:172.9pt;left:0%;padding-bottom:0pt;position:relative;top:0pt;width:230.4pt;"/><span style="color:#003b5c;">&#160;&#160;</span></p></ix:nonNumeric><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:1pt;margin:0pt;">&#160;&#160;&#160;&#160;</p></div><div style="clear:both;display:table;margin-bottom:30pt;min-height:36pt;width:100%;"><div style="display:table-cell;vertical-align:bottom;width:100%;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">21</p></div></div></div>
