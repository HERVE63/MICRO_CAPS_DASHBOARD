idth:95.49%;border-top:2.25pt double #003b5c;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:4.5%;border-top:2.25pt double #003b5c;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:right;margin:0pt;"><span style="font-size:5pt;visibility:hidden;">&#8203;</span></p></td></tr><tr style=""><td style="vertical-align:top;width:95.49%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><a href="#SUBMISSIONOFSTOCKHOLDERPROPOSALS"><b style="font-style:normal;font-weight:bold;">Submission&#160;of Stockholder Proposals for&#160;Our&#160;Next&#160;Annual&#160;Meeting&#160;of&#160;Stockholders</b></a></p></td><td style="vertical-align:top;width:4.5%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-weight:bold;">27</span></p></td></tr><tr style=""><td style="vertical-align:top;width:95.49%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:top;width:4.5%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;text-align:right;margin:0pt;"><span style="font-size:5pt;visibility:hidden;">&#8203;</span></p></td></tr><tr style="height:2.75pt;"><td style="vertical-align:top;width:95.49%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><a href="#OTHERMATTERS"><b style="font-style:normal;font-weight:bold;">Other Matters</b></a></p></td><td style="vertical-align:top;width:4.5%;margin:0pt;padding:0pt;"><p style="font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin: