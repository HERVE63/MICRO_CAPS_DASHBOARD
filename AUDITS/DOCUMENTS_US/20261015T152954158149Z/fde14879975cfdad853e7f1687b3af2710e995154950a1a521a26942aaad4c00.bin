:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;margin:0pt;"><b style="font-weight:bold;">&#160;&#160;&#8203;&#160;&#8203;&#160;&#8203;</b></p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:13.1%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2026&#160;Bonus&#160;&amp; </b></p></td><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:1.65%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;margin:0pt;">&#160;&#160;&#8203;&#160;&#8203;&#160;&#8203;</p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:13.98%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">Change in Control</b></p></td><td style="color:#ffffff;vertical-align:top;width:1.65%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;margin:0pt;">&#160;&#160;&#8203;&#160;&#8203;&#160;&#8203;</p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:6.69%;background:#003b5e;margin:0pt;padding:0pt;"/><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:1.65%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;margin:0pt;">&#160;&#160;&#8203;&#160;&#8203;&#160;&#8203;</p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:9.43%;background:#003b5e;margin:0pt;padding:0pt;"/><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:0.42%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;line-height:1.26;margin:0pt;">&#160;</p></td></tr><tr style=""><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:25.24%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:1.65%;background:#003b5e;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:10.17%;background:#003b5e;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">Payment </b><sup style="font-size:6pt;font-style:italic;font-weight:bold;line-height:100%;top:0pt;vertical-align:top;">(1)</sup></p></td><td style="color:#ffffff;vertical-align:bottom;white-space:nowrap;width:1.65%;background:#003b5e;border-bottom:1px solid transparent;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;font-weight:bold;visibility:hidden;">&#8203;</span></p></td><td colspan="2" style="color:#ffffff;vertical-align:bottom;width:10.99%;background:#003b5e;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="color:#ffffff;font-family:'Calibri','Helvetica','sans-serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">RSUs </b><sup style="font-size:6pt;font-style:italic;font-weight:bold;line-height:100%;top:0pt;vertical-align:top;">(2)</sup></p></td><td style="color:#ffffff;vertical-align:top;width:1.65%;background:#003b5e;margin:0pt