       <td style="padding-top:0.01in;border-right:0.5pt solid #000000;border-left:0.5pt solid #000000;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="font-size:9pt;"><ix:nonNumeric id="F_5a80a677-8d47-40c9-a345-3511165f0db8" contextRef="C_80ef0de6-beed-4cde-af12-cae83403e602" name="ecd:TrdArrIndName"><span style="color:#000000;white-space:pre-wrap;font-style:italic;font-kerning:none;min-width:fit-content;">Nancy Vitale</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-style:italic;font-kerning:none;min-width:fit-content;"><br/>(</span><span style="font-size:9pt;"><ix:nonNumeric id="F_f1c9c251-c7f6-4059-b465-f57c86ed23ba" contextRef="C_80ef0de6-beed-4cde-af12-cae83403e602" name="ecd:TrdArrIndTitle"><span style="color:#000000;white-space:pre-wrap;font-style:italic;font-kerning:none;min-width:fit-content;">Director</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-style:italic;font-kerning:none;min-width:fit-content;">)</span></p></td>
       <td style="padding-top:0.01in;border-right:0.5pt solid #000000;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="font-size:9pt;"><ix:nonNumeric id="F_b392fcfe-5bdf-48aa-860a-c4d5e346b6e5" contextRef="C_80ef0de6-beed-4cde-af12-cae83403e602" name="ecd:Rule10b51ArrAdoptedFlag" format="ixt:fixed-true"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Adoption</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-kerning:none;min-width:fit-content;">&#160;(</span><span style="font-size:9pt;"><ix:nonNumeric id="F_cf046493-0e28-407b-8759-d8a572e35abb" contextRef="C_80ef0de6-beed-4cde-af12-cae83403e602" name="ecd:TrdArrAdoptionDate"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">June 7, 2026</span></ix:nonNumeric></span><span style="color:#000000;white-space:pre-wrap;font-size:9pt;font-kerning:none;min-width:fit-content;">)</span></p></td>
       <td style="padding-top:0.01in;border-right:0.5pt solid #000000;padding-left:0in;vertical-align:top;padding-bottom:0in;border-bottom:0.5pt solid #000000;padding-right:0.01in;"><p style="font-size:9pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Rule 10b5-1 trading arrangement for exercises of options and sales of shares</span></p></td>
