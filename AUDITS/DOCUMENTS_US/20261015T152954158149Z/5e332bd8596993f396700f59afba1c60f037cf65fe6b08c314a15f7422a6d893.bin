xtRef="Duration_4_1_2026_To_6_30_2026_oCD6xHs36UOrz82ZkF9EUw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Depreciation" scale="6" id="Narr_pGaCvDCSyE2dVeLBPQZL3A">0.1</ix:nonFraction></ix:nonFraction> million for both periods. Depreciation expense related to other property and equipment for the six months ended June&#160;30,&#160;2026 and 2025, was approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2025_To_6_30_2025_tKkFz0DKVEO5CPolkGTXiw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Depreciation" scale="6" id="Narr_zb0BA243KUSUIQj112wanQ"><ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:Depreciation" scale="6" id="Narr_M0as7GEMOkyGDxo0cw49Pg">0.2</ix:nonFraction></ix:nonFraction> million for both periods. </p></ix:continuation><a id="Tc_cOOum-D4_EmYcLGWYuQWUA_1_1"></a><a id="Tc_05WYOMEgKEClQRKCCx_AWA_2_1"></a><a id="Tc_GGC4E_3zjUGSGKzZ483mDg_2_4"></a><a id="Tc_DqI_4Rbd30ikKC5IoBWj0w_3_0"></a><a id="Tc_3f_dZ2mz2Eex6vIbbowweg_3_1"></a><a id="Tc_dNDzI16nIUyNrap1sHLyAw_3_4"></a><a id="Tc_osU1iF8zzUaxmsDNnqPGAQ_4_0"></a><a id="Tc_aAEMIZclk02q9osbqqLRcg_4_5"></a><a id="Tc_LXZSBiZQl0WK7XMaZZUz5g_5_0"></a><a id="Tc_HAUT80zvv0ykupvwYMFDig_5_2"></a><a id="Tc_LrUGcP3JbU2u7SRYS_MCFw_5_5"></a><a id="Tc_Lz3LuDFRekm9TfhkOH_7QA_6_0"></a><a id="Tc_TuQNHnnam06r4rPde83T2Q_7_0"></a><a id="Tc_bi3X_k1nDE6koyLKrd025Q_8_0"></a><a id="Tc_gv-VX8DKWUaPL0MllRPoGA_8_1"></a><a id="Tc_ILAPCKl6h0qUD6Z778sKrA_8_4"></a><a id="Tc_jjUT8lC3M0OAw_auiwMyRA_9_0"></a><a id="Tc_wx790fZr6UuuyKwZGZYsTA_10_0"></a><a id="Tc_B5JDzXCKKkGPjdyBlVZCGw_10_1"></a><a id="Tc_DubIPCkg-kCB22Eev4ryng_10_4"></a><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" name="us-gaap:AssetRetirementObligationDisclosureTextBlock" id="Tb_X-EnXZ6zbEe4aOeTKJONFQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Note&#160;4&#160;&#8211; Asset Retirement Obligations</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Company&#8217;s asset retirement obligations (&#8220;ARO&#8221;) represent the estimated present value of the estimated cash flows the Company will incur to plug, abandon and remediate its producing properties at the end of their productive lives, in accordance with applicable state laws. Market risk premiums associated with asset retirement obligations are estimated to represent a component of the Company&#8217;s credit-adjusted risk-free rate that is utilized in the calculations of AROs.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Company&#8217;s ARO activities are summarized in the following table:</p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" name="us-gaap:ScheduleOfAssetRetirementObligationsTableTextBlock" id="Tb_uSXpzPByDEizrPTueZS6YA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:80%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:71.59%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;margin:0pt;padding:0pt;"><div style