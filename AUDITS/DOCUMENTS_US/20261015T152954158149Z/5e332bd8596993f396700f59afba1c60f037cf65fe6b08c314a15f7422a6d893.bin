_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="ep:OilAndGasSuccessfulEffortsMethodPropertyAndEquipmentWorkInProgressBeforeAccumulatedDepreciationDepletionAmortizationAndImpairment" scale="3" id="Tc_DU7B4KluF0ysarbHEhtkzA_5_2">11,097</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.56%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.69%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="-3" format="ixt:num-dot-decimal" name="ep:OilAndGasSuccessfulEffortsMethodPropertyAndEquipmentWorkInProgressBeforeAccumulatedDepreciationDepletionAmortizationAndImpairment" scale="3" id="Tc_cqJW8-bZiE-l9N1sm7YU6w_5_5">626</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:75.57%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">Gross capitalized costs</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.38%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodGross" scale="3" id="Tc_gnca3awOx0-EQfC5OTs-zg_6_2">162,273</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.56%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.69%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodGross" scale="3" id="Tc_V4pOeNgnmUWQXnRWSNrtdg_6_5">148,238</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:75.57%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">Accumulated depletion, amortization and impairment</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.38%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodAccumulatedDepreciationDepletionAmortizationAndImpairment" scale="3" id="Tc_LRjs7f0BEE21BNophHpJbQ_7_2">96,190</ix:nonFraction>)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.56%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.69%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodAccumulatedDepreciationDepletionAmortizationAndImpairment" scale="3" id="Tc_tX74BHv820u_psVDD0HePA_7_5">93,425</ix:nonFraction>)</p></td></tr><tr style=""><td style="vertical-align:bottom;width:75.57%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt 0pt 0pt 12pt;">Total Oil and gas properties, net</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.38%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodNet" scale="3" id="Tc_tydxRHVd50q91VpuovZKfw_8_2">66,083</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.32%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.56%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.69%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OilAndGasPropertySuccessfulEffortMethodNet" scale="3" id="Tc_9AhHS25D3E6MlILcyK4pYA_8_5">54,813</ix:nonFraction></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Depletion and amortization expense related to oil and gas properties for the three&#160;months ended June&#160;30,&#160;2026 and 2025, was approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_4_1_2026_To_6_30_2026_oCD6xHs36UOrz82ZkF9EUw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ResultsOfOperationsDepreciationDepletionAmortizationAndAccretion" scale="6" id="Narr_Nv9kPEATqkK1SIC6jT-8aA">1.3</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_4_1_2025_To_6_30_2025_7JaygdHYnEe8oSZsf2mn7A" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ResultsOfOperationsDepreciationDepletionAmortizationAndAccretion" scale="6" id="Narr_MC4zPQt-tUyNbqEenOFaDw">2.5</ix:nonFraction> million, respectively. Depletion and amortization expense related to oil and gas properties for the six months ended June&#160;30,&#160;2026 and 2025, was approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ResultsOfOperationsDepreciationDepletionAmortizationAndAccretion" scale="6" id="Narr_uFPsrDjrlEqtLnc3cNAXVA">2.6</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2025_To_6_30_2025_tKkFz0DKVEO5CPolkGTXiw" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ResultsOfOperationsDepreciationDepletionAmortizationAndAccretion" scale="6" id="Narr_Ah-fw-DZ5Uug-c4RrdAKlw">4.6</ix:nonFraction> million, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Proved oil and natural gas properties are reviewed for impairment at least annually, or as indicators of impairment arise. There were <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" decimals="0" format="ixt-sec:numwordsen" name="us-gaap:ResultsOfOperationsImpairmentOfOilAndGasProperties" scale="0" id="Narr_oMFeB6324kuhd61kWYhjbg">no</ix:nonFraction> indicators of impairment identified during the six months ended June&#160;30,&#160;2026.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On May 1, 2025, the Company extended its option to purchase certain New Mexico interests from Energy Evolution which also allowed for payment for such extension to be made in cash in lieu the issuance of common shares, due and payable on or before September 30, 2025. The Company made a cash payment to Energy Evolution on September 30, 2025 to extend the purchase option for <span style="-sec-ix-hidden:Hidden_pBUezlH8B0-SraUo35sxQw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">an additional year</span></span>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On December 10, 2025, the Company entered into a letter agreement with Energy Evolution to acquire the remaining <ix:nonFraction unitRef="Unit_Standard_pure_FtPzn1B8r0uM5ys9Zl8t-w" contextRef="Duration_12_10_2025_To_12_10_2025_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_ulGYe7V7MU-FDo2qsEt-rQ" decimals="2" format="ixt:num-dot-decimal" name="ep:PercentageOfWorkingInterestsAcquired" scale="-2" id="Narr_iZQbBhRXXUymd9RMQQi6BQ">40</ix:nonFraction>% of certain New Mexico interests and closed on the transaction on January 5, 2026. As consideration, Empire issued <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_1_5_2026_To_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_c0bxxeJmwEmQp4DYB615EA" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesAcquisitions" scale="0" id="Narr_PNSPekYVcUuyjTaFYj4P5Q">562,500</ix:nonFraction> shares of common stock based on an agreed upon price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_HGHbBeD2aUerDI_sI2gdqw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_IWqk7hEcuU2bjGBWSTqd6A">3.20</ix:nonFraction> per share for an aggregate agreed upon value of $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_5_2026_To_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_c0bxxeJmwEmQp4DYB615EA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodValueAcquisitions" scale="6" id="Narr_q5qTbjsz50GuxridNwF39g">1.8</ix:nonFraction> million. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In January 2026, Empire paid approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_1_2026_To_1_31_2026_srt_StatementGeographicalAxis_stpr_ND_L_fzWIXC9UaTV2HqPhQu4Q" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:CostsIncurredAcquisitionOfUnprovedOilAndGasProperties" scale="6" id="Narr_PaR9QZJ_SkCQW9AuN6x2fg">0.1</ix:nonFraction> million for certain interests in undeveloped properties in North Dakota. The transaction was subject to customary regulatory procedures and finalized in the second quarter of 2026.</p></ix:nonNumeric></div><div style="clear:both;display:table;margin-bottom:21.6pt;min-height:14.4pt;width:100%;"><div style="display:table-cell;vertical-align:bottom;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">11</p></div></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="min-height:36pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_Ik1g7fJGV02DAYwLQnebbg_1_1"></a><a id="Tc_lY0On9eLxkW_QgasKM2EDg_1_4"></a><a id="Tc_KKfHHCeY00O0sLL3vbgyxA_2_1"></a><a id="Tc_OP5UBXLRWESC4sn8dWNKzg_2_4"></a><a id="Tc_zbC1mMKFrkuJZ5bD7MievQ_3_0"></a><a id="Tc_ly0VyaA9oUe8YsWbR8bTgw_3_1"></a><a id="Tc_Bj_wi3iAu0KoUgmyejLBjw_3_4"></a><a id="Tc_dM_cJWLDyEaqxgNAAIpgrA_4_0"></a><a id="Tc_SUxaClAPx0OFXB0yk5n15g_5_0"></a><a id="Tc_iY89YdKKOkyFcjZiK4oZOg_5_1"></a><a id="Tc_gdNFbxdO6E6IilLCmOKGSQ_5_4"></a><ix:continuation id="Tb_QR9TyZJjRkuSP2g55dloeg_cont1"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On March 18, 2026, Empire elected to participate in a three-well oil and natural gas development program with various related parties in Louisiana for a <ix:nonFraction unitRef="Unit_Standard_pure_FtPzn1B8r0uM5ys9Zl8t-w" contextRef="Duration_3_18_2026_To_3_18_2026_us-gaap_RelatedPartyTransactionAxis_ep_ThreeWellOilAndNaturalGasDevelopmentProgramMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_JGELmvZUwk6SwK3uhOtqVg" decimals="2" format="ixt:num-dot-decimal" name="ep:PercentageOfWorkingInterestsAcquired" scale="-2" id="Narr_mGDiH5XXz06kLk3f75HAhw">25</ix:nonFraction>% working interest. Participation was funded by issuance of approximately <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_3_18_2026_To_3_18_2026_us-gaap_RelatedPartyTransactionAxis_ep_ThreeWellOilAndNaturalGasDevelopmentProgramMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_JGELmvZUwk6SwK3uhOtqVg" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesAcquisitions" scale="6" id="Narr_fYEfttTO6k6Id6Pqu1mrxQ">1.8</ix:nonFraction> million shares of Empire common stock at a price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_3_18_2026_us-gaap_RelatedPartyTransactionAxis_ep_ThreeWellOilAndNaturalGasDevelopmentProgramMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_e_gzSXyrOk2ZqlNC9MgdCw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_xvxgqdnlh0Cl0cVCAuzT0Q">3.00</ix:nonFraction> per share issued in the second quarter of 2026. As of June&#160;30,&#160;2026, we have accrued approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_us-gaap_RelatedPartyTransactionAxis_ep_ThreeWellOilAndNaturalGasDevelopmentProgramMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_4l53-EWj2Uq3Dc0G5vLWbA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:AccountsPayableCurrent" scale="6" id="Narr_HPz83qbd8EWa3ZQMbKY6qw">1.0</ix:nonFraction> million of additional costs incurred related to the gas development program reflected within accounts payable &#8211; related party on the unaudited interim condensed consolidated balance sheets.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Other property and equipment consists of operating lease assets, vehicles, office furniture, and equipment with lives ranging from <span style="-sec-ix-hidden:Hidden_unMVSL6NDUOFfKQRHAhpHw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">three</span></span> to <ix:nonNumeric contextRef="As_Of_6_30_2026_srt_RangeAxis_srt_MaximumMember_cDkENAADBkq-mFWmtn13Vw" format="ixt-sec:durwordsen" name="us-gaap:PropertyPlantAndEquipmentUsefulLife" id="Narr_BcHEcHmC2UG0rBmBbz9KtA">five&#160;years</ix:nonNumeric>. The capitalized costs of other property and equipment are as follows:</p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" name="us-gaap:PropertyPlantAndEquipmentTextBlock" id="Tb_RC--eVr0t0yENiydqQnigQ" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;margin-left:auto;margin-right:auto;padding-left:0pt;padding-right:0pt;width:80%;"><tr style="height:1pt;"><td style="vertical-align:bottom;width:75.57%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:1.44%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:bottom;white-space:nowrap;width:9.38%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="bottom:0pt;position:absolute;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="ve