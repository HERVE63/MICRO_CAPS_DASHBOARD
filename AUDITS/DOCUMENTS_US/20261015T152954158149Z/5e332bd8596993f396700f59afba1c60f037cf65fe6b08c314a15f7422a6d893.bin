solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="-sec-ix-hidden:Hidden_usjy8R03lkeQX9RAHbWOUg;"><span style="font-family:'Times New Roman','Times','serif';font-size:8pt;font-style:normal;font-weight:normal;"> &#8212;</span></span></p></td></tr><tr style=""><td style="vertical-align:bottom;width:89.15%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">Total lease payments</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.06%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LesseeOperatingLeaseLiabilityPaymentsDue" scale="3" id="Tc_Rh_mgyjs20aTStegXV1HMg_8_2">940</ix:nonFraction></p></td></tr><tr style=""><td style="vertical-align:bottom;width:89.15%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">Less: imputed interest</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.06%;background:#cceeff;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt;"> (<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LesseeOperatingLeaseLiabilityUndiscountedExcessAmount" scale="3" id="Tc_5mWA8uksGES3ORn9yOTfmg_9_2">39</ix:nonFraction>)</p></td></tr><tr style=""><td style="vertical-align:bottom;width:89.15%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">Total lease obligation</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.78%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;margin:0pt;">$</p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.06%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 3pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseLiability" scale="3" id="Tc_iB_Xk1jDu0eMwfSx1d-oPw_10_2">901</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><a id="_5661c2ac_c292_4709_8452_0ce2ddf3aa01"></a><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_Bhgi9LYilUasJxTHBaDyEw" name="us-gaap:StockholdersEquityNoteDisclosureTextBlock" id="Tb_KCqXel-dqEa2rURcqDVQmg" continuedAt="Tb_KCqXel-dqEa2rURcqDVQmg_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Note&#160;10&#160;&#8211; Equity</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Pursuant to the Company&#8217;s Amended and Restated Certificate of Incorporation (&#8220;Charter&#8221;), effective as of March&#160;4, 2022, the total number of shares of all classes of stock that the Company has the authority to issue is <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="INF" format="ixt:num-dot-decimal" name="ep:NumberOfSharesAuthorized" scale="0" id="Narr_GSBCJyn2TkqOF8ns9jBeSg"><ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="INF" format="ixt:num-dot-decimal" name="ep:NumberOfSharesAuthorized" scale="0" id="Narr_4eud1heBoUmwgJX3mp85RQ">200,000,000</ix:nonFraction></ix:nonFraction>, consisting of <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_oOZ3rt4eQEG9Xjj4eUO5Zg"><ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockSharesAuthorized" scale="0" id="Narr_fURdtAWoAEKZGhl-qT5-5Q">190,000,000</ix:nonFraction></ix:nonFraction> shares of common stock, par value $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_cgtH_BCio0-q9g2Lxgv6Ow"><ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:CommonStockParOrStatedValuePerShare" scale="0" id="Narr_t9hvvA5D9k6j5geijkS6eg">0.001</ix:nonFraction></ix:nonFraction> per share, and <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockSharesAuthorized" scale="0" id="Narr_lmCvp-WrCkGwnvKJ_mqguA"><ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockSharesAuthorized" scale="0" id="Narr_lZTzDVuKOEOsijVZVLZvBQ">10,000,000</ix:nonFraction></ix:nonFraction> shares of preferred stock, par value $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_6_30_2026_GGd0L36K2Uim4p1oI7e7VQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockParOrStatedValuePerShare" scale="0" id="Narr_zztFdLcecECEVVyayrPY-Q"><ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_12_31_2025_0mLGGjCFy0KW6m_-zYrXVg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockParOrStatedValuePerShare" scale="0" id="Narr_AN6QWAVvMk2NNRKalHHFCw">0.001</ix:nonFraction></ix:nonFraction> per share.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Preferred Stock</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Preferred stock may be issued from time to time in one or more series at the direction of the Company&#8217;s Board of Directors and the directors also have the ability to fix dividend rates and rights, liquidation preferences, voting rights, conversion rights, rights and terms of redemption and other rights, preferences, privileges and restrictions as determined by the Company&#8217;s Board of Directors, subject to certain limitations set forth in the Charter.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;margin:0pt 0pt 12pt 0pt;">Series&#160;A Voting Preferred Stock</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On March&#160;8, 2022, the Company formalized the issuance of preferred stock as was required under the terms of the Company&#8217;s May&#160;2021 financing agreements with Energy Evolution and issued <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_3_8_2022_To_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_znS2i8F7kU2qTI_yX3Qm2g" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr__L-qWdvBs02OraIDzqONRQ">six</ix:nonFraction> shares of Series&#160;A Voting Preferred Stock. The Series&#160;A Voting Preferred Stock was issued in connection with the strategic investment in the Company by Energy Evolution. For so long as the Series&#160;A Voting Preferred Stock is outstanding, the Company&#8217;s Board of Directors will consist of <ix:nonFraction unitRef="Unit_Standard_director_Vg2zAO-SHkud2IeGFb6opQ" contextRef="As_Of_3_8_2022_poG3sMidoEe1v76eg5eG4A" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfDirectorsAppointedInBoard" scale="0" id="Narr_i20yRIyx7EyfQsaEAZfpFQ">six</ix:nonFraction> directors. <ix:nonFraction unitRef="Unit_Standard_director_Vg2zAO-SHkud2IeGFb6opQ" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfSeriesaDirectorsAppointedInBoard" scale="0" id="Narr_-2KoNN5be0W-LHZs2egH-g">Three</ix:nonFraction> of the directors are designated as the Series&#160;A Directors and the <ix:nonFraction unitRef="Unit_Standard_director_Vg2zAO-SHkud2IeGFb6opQ" contextRef="As_Of_3_8_2022_poG3sMidoEe1v76eg5eG4A" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfCommonDirectorsAppointedInBoard" scale="0" id="Narr_BOh3vWmx80-YsYA3zMFWxg">three</ix:nonFraction> other directors (each, a &#8220;common director&#8221;) are elected by the holders of common stock and/or any preferred stock (other than the Series&#160;A Voting Preferred Stock) granted the right to vote on the common directors. Any Series&#160;A Director may be removed with or without cause but only by the affirmative vote of the holders of a majority of the Series&#160;A Voting Preferred Stock voting separately and as a single class. The holders of the Series&#160;A Voting Preferred Stock have the exclusive right, voting separately and as a single class, to vote on the election, removal and/or replacement of the Series&#160;A Directors. Holders of common stock or other preferred stock do not have the right to vote on the Series&#160;A Directors. The approval of the holders of the Series&#160;A Voting Preferred Stock, voting separately and as a single class, is required to authorize any resolution or other action to issue or modify the number, voting rights or any other rights, privileges, benefits, or characteristics of the Series&#160;A Voting Preferred Stock, including without limitation, any action to modify the number, structure and/or composition of the Company&#8217;s current Board of Directors.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Series&#160;A Voting Preferred Stock is held by Phil Mulacek, Chairman of the Board of Directors of the Company and one of the principals of Energy Evolution, as Energy Evolution&#8217;s designee (the &#8220;Initial Holder&#8221;). The Series&#160;A Voting Preferred Stock may be transferred only to certain controlled affiliates of the Initial Holder (&#8220;Permitted Transferees&#8221;), and the voting rights of the Series&#160;A Voting Preferred Stock are contingent upon the Initial Holder and Permitted Transferees (collectively, the &#8220;Series&#160;A Holders&#8221;) holding together at least <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="INF" format="ixt:num-dot-decimal" name="ep:PreferredStockVotingRightsThresholdCommonShares" scale="0" id="Narr_zTvZGS1Ni0iEophRTpmPxg">3,000,000</ix:nonFraction> shares of the Company&#8217;s outstanding common stock.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Series&#160;A Voting Preferred Stock is not entitled to receive any dividends or distributions of cash or other property except in the event of any liquidation, dissolution or winding up of the Company&#8217;s affairs. In such event, before any amount is paid to the holders of the Company&#8217;s common stock but after any amount is paid to the holders of the Company&#8217;s senior securities, the holders of the Series&#160;A Voting Preferred Stock will be entitled to receive an amount per share equal to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockLiquidationPreference" scale="0" id="Narr_23HfPRY73U-qxmgkCZY1Ng">1.00</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">Except as discussed above or as otherwise set forth in the certificate of designation of the Series&#160;A Voting Preferred Stock, the holders of the Series&#160;A Voting Preferred Stock have <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="INF" format="ixt-sec:numwordsen" name="ep:PreferredStockVotingRightsPerShare" scale="0" id="Narr_rdEpvtkXq0-00MW7MxUJ0A">no</ix:nonFraction> voting rights.</p></ix:nonNumeric></div><div style="clear:both;display:table;margin-bottom:21.6pt;min-height:14.4pt;width:100%;"><div style="display:table-cell;vertical-align:bottom;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">17</p></div></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="min-height:36pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><ix:continuation id="Tb_KCqXel-dqEa2rURcqDVQmg_cont1" continuedAt="Tb_KCqXel-dqEa2rURcqDVQmg_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Series&#160;A Voting Preferred Stock is not redeemable at the Company&#8217;s election or the election of any holder, except the Company may elect to redeem the Series&#160;A Voting Preferred Stock for $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:PreferredStockLiquidationPreference" scale="0" id="Narr_L6x-Qq9zbU-Mo1sB6cn6MQ">1.00</ix:nonFraction> per share following satisfaction of its notice and cure requirements in the event that:</p><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;text-align:justify;width:100%;border:0pt;"><tr><td style="width:36pt;"/><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">&#9679;</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">any or all shares of Series&#160;A Voting Preferred Stock are held by anyone other than the Initial Holder or a Permitted Transferee; or</span></td></tr></table><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;text-align:justify;width:100%;border:0pt;"><tr><td style="width:36pt;"/><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">&#9679;</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">the Series&#160;A Holders together hold less than </span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"><ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_3_8_2022_us-gaap_StatementClassOfStockAxis_us-gaap_SeriesAPreferredStockMember_gs3CRYw6a0StA-MCa4jOLQ" decimals="INF" format="ixt:num-dot-decimal" name="ep:PreferredStockVotingRightsThresholdCommonShares" scale="0" id="Narr_xaxzLnc7Ak663Dqa3Tehdw">3,000,000</ix:nonFraction></span><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;"> shares of the Company&#8217;s outstanding common stock.</span></td></tr></table><div style="margin-top:12pt;"></div><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Series&#160;A Voting Preferred Stock is not convertible into common stock or any other security.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">Common Stock</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The holders of shares of common stock are entitled to <ix:nonFraction unitRef="Unit_Standard_Vote_qthyaJCpH0CmgoIK04Xn1w" contextRef="As_Of_8_27_2021_1Mwxegxiz0ijtPoPWGa1EQ" decimals="INF" format="ixt-sec:numwordsen" name="ep:CommonStockVotingRightsPerShare" scale="0" id="Narr_DXhBfhCRO0Ok7YRQYBmimg">one</ix:nonFraction> vote per share for all matters on which common stockholders are authorized to vote on. Examples of matters that common stockholders are entitled to vote on include, but are not limited to, the election of <ix:nonFraction unitRef="Unit_Standard_director_Vg2zAO-SHkud2IeGFb6opQ" contextRef="As_Of_8_27_2021_1Mwxegxiz0ijtPoPWGa1EQ" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfCommonDirectorsAppointedInBoard" scale="0" id="Narr_ID5EzYxq0kSt0Xwon9vFJw">three</ix:nonFraction> of the <ix:nonFraction unitRef="Unit_Standard_director_Vg2zAO-SHkud2IeGFb6opQ" contextRef="As_Of_8_27_2021_1Mwxegxiz0ijtPoPWGa1EQ" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfDirectorsAppointedInBoard" scale="0" id="Narr_INdleyXPsk6Pw2urCanPPQ">six</ix:nonFraction> directors and other common voting situations afforded to common stockholders.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In August 2025, Empire completed a subscription rights offering (the &#8220;August Rights Offering&#8221;) which raised gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromWarrantExercises" scale="6" id="Narr_PybZyR8MGEOMpr94JBYjcg">2.5</ix:nonFraction> million. Empire distributed at no charge to holders of its common stock, as of the close of business on July 10, 2025 (the record date for the August Rights Offering), <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfSubscriptionRightsIssuedPerShare" scale="0" id="Narr_OEPrU7e_X0a0-08sYmgJ5Q">one</ix:nonFraction> non-transferable subscription right for each whole share of common stock owned by that stockholder on the record date. Each subscription right entitled a rights holder to purchase <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfUnitsIssuedForEachSubscriptionRight" scale="0" id="Narr_tee_rN6SjEiXE38aWGkZfg">one</ix:nonFraction> unit at a subscription price equal to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="5" format="ixt:num-dot-decimal" name="ep:SubscriptionPriceOfUnit" scale="0" id="Narr_of5UxadUpEmKJd1YpasCFw">0.07367</ix:nonFraction> per unit, each unit consisting of <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="4" format="ixt:num-dot-decimal" name="ep:NumberOfSecuritiesCalledByEachUnit" scale="0" id="Narr_x_PDrK4qq0G1l3UBnSfIpA">0.0139</ix:nonFraction> shares of the Company&#8217;s common stock and <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfWarrantsIssuedForEachUnit" scale="0" id="Narr_luZ64TSGSUWBI9S4e-czHA">one</ix:nonFraction> rights warrant to purchase <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_4Qen8F7XuUuLd_m8AEKBkw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByEachWarrantOrRight" scale="0" id="Narr_ffTU3099sk2Sbj9mID_7Ag">0.0136</ix:nonFraction> shares of the Company&#8217;s common stock equal to $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="2" format="ixt:num-dot-decimal" name="ep:SubscriptionRightsOfferingSharePrice" scale="0" id="Narr_UdQSK6ZK40Cw43Iqbn4Puw">5.46</ix:nonFraction> per whole share. <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_8_1_2025_To_8_31_2025_us-gaap_SubsidiarySaleOfStockAxis_ep_August2025RightsOfferingMember_1R7H2Kss90-ELiwmQGrp9w" decimals="INF" format="ixt-sec:numwordsen" name="ep:StockIssuedDuringPeriodSharesNewIssuesUponExercisesOfWarrants" scale="0" id="Narr_k31iYCXIt0-A5IRHoYm0Pg">No</ix:nonFraction> fractional shares of common stock are issued in the rights offering, including upon exercise of the warrants. The subscription rights were initially set to expire if they were not exercised or extended at the discretion of the Company by July 25, 2025; however, this date was subsequently extended to August 20, 2025. The warrants expired 90 days after the August extension date. No warrants were exercised.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On September 24, 2025 and as amended on November 5, 2025, Empire issued Mr. Mulacek a warrant certificate granting him the right to purchase up to <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="As_Of_11_5_2025_srt_CounterpartyNameAxis_ep_PhilMulacekMember_srt_RangeAxis_srt_MaximumMember_us-gaap_ClassOfWarrantOrRightAxis_ep_SeptemberNoteWarrantMember_us-gaap_DebtInstrumentAxis_ep_SeptemberNoteMember_7Q3g-DLYkUix1lmI0bzWTQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightNumberOfSecuritiesCalledByWarrantsOrRights" scale="0" id="Narr_dZgrSU9QEEWzyW7Wkz7xuA">138,889</ix:nonFraction> shares of common stock of Empire at $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_11_5_2025_srt_CounterpartyNameAxis_ep_PhilMulacekMember_us-gaap_ClassOfWarrantOrRightAxis_ep_SeptemberNoteWarrantMember_us-gaap_DebtInstrumentAxis_ep_SeptemberNoteMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_G21M0tNG20i6KJuWFX9fPA" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:ClassOfWarrantOrRightExercisePriceOfWarrantsOrRights1" scale="0" id="Narr_HszBnwMfCU-W6y99Imu9sQ">4.32</ix:nonFraction> per share in conjunction with the September Note further described in Note 8 &#8211; Debt including Debt with Related Parties. The warrant certificate expires on September 24, 2028.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On December 10, 2025, Empire entered into a letter agreement with Energy Evolution to acquire the remaining <ix:nonFraction unitRef="Unit_Standard_pure_FtPzn1B8r0uM5ys9Zl8t-w" contextRef="Duration_12_10_2025_To_12_10_2025_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_ulGYe7V7MU-FDo2qsEt-rQ" decimals="2" format="ixt:num-dot-decimal" name="ep:PercentageOfWorkingInterestsAcquired" scale="-2" id="Narr_uyY-JU6NjEWfVcYP2iJytw">40</ix:nonFraction>% of certain New Mexico interests and closed the transaction on January 5, 2026. As consideration, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_1_5_2026_To_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_c0bxxeJmwEmQp4DYB615EA" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesAcquisitions" scale="0" id="Narr_OAW4TXCy9EOMjPvvqOaQeg">562,500</ix:nonFraction> shares of common stock on January 5, 2026, which is the closing date of the letter agreement, based on an agreed upon price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="As_Of_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_HGHbBeD2aUerDI_sI2gdqw" decimals="2" format="ixt:num-dot-decimal" name="us-gaap:SharesIssuedPricePerShare" scale="0" id="Narr_dL6LnDesok6t5UJGf5bltA">3.20</ix:nonFraction> per share for an aggregate agreed upon value of $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_1_5_2026_To_1_5_2026_srt_CounterpartyNameAxis_ep_EnergyEvolutionMasterFundLtdMember_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_c0bxxeJmwEmQp4DYB615EA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodValueAcquisitions" scale="6" id="Narr_mwY5qv2sc0WH2jZWaObgnw">1.8</ix:nonFraction> million.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In February 2026, Empire announced a subscription rights offering which was expected to raise gross proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_2_28_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_bMe7tvsK-UGeazDxUkVyiA" decimals="-5" format="ixt:num-dot-decimal" name="ep:SaleOfStockMaximumProceeds" scale="6" id="Narr_8LxUYQtVM0iOoaJ_b0aFKQ">6.0</ix:nonFraction> million. Empire distributed at no charge to holders of its common stock, as of the close of business on February 2, 2026 (the record date), <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_2_1_2026_To_2_28_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_42yXLtmP10a17_Bot6m-yw" decimals="INF" format="ixt-sec:numwordsen" name="ep:NumberOfSubscriptionRightsIssuedPerShare" scale="0" id="Narr_RJMrYQgRg0KAewBK26vkeg">one</ix:nonFraction> non-transferable subscription right for each whole share of common stock owned by that stockholder on the record date. Each subscription right entitled the holder to purchase <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_2_1_2026_To_2_28_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_42yXLtmP10a17_Bot6m-yw" decimals="3" format="ixt:num-dot-decimal" name="ep:NumberOfUnitsIssuedForEachSubscriptionRight" scale="0" id="Narr_8KjXJtfzsU6hlorG5tsozg">0.057</ix:nonFraction> shares of common stock at a subscription price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="Duration_2_1_2026_To_2_28_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_42yXLtmP10a17_Bot6m-yw" decimals="2" format="ixt:num-dot-decimal" name="ep:SubscriptionPriceOfUnit" scale="0" id="Narr_OXxxM9J-gkaGhTkiMNai7g">2.99</ix:nonFraction> per whole share. The offering includes an oversubscription privilege, which entitles stockholders who fully exercise their subscription rights the right to purchase at the same exercise price additional units in the rights offering that other stockholders do not purchase, subject to availability and pro-rata allocation of units among rights holders exercising such oversubscription privilege. No fractional shares of common stock were issued in the rights offering. The subscription rights were set to expire if they were not exercised or extended at the discretion of the Company by February 27, 2026. On February 25, 2026, the subscription rights offering was modified to entitle each holder to purchase <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_2_25_2026_To_2_25_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_qzK_dyeVDU6qmoayeJD8nQ" decimals="3" format="ixt:num-dot-decimal" name="ep:NumberOfSecuritiesCalledByEachSubscriptionRight" scale="0" id="Narr_PJSxHXtg-UaCwulYBBJmcg">0.095</ix:nonFraction> shares of common stock at a subscription price of $<ix:nonFraction unitRef="Unit_Divide_USD_shares_Nv2_tNrxtEScLjFk6ezpag" contextRef="Duration_2_25_2026_To_2_25_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_qzK_dyeVDU6qmoayeJD8nQ" decimals="2" format="ixt:num-dot-decimal" name="ep:SubscriptionRightsOfferingSharePrice" scale="0" id="Narr_ayDpyRIvNkud1jEXmbddWg">2.99</ix:nonFraction> per one whole share of common stock for gross proceeds of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="As_Of_2_25_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_February2026RightsOfferingMember_QEo0O4pJY0ubihvKAd3AfQ" decimals="-5" format="ixt:num-dot-decimal" name="ep:SaleOfStockMaximumProceeds" scale="6" id="Narr_0-jIokmqDUWS8sIvMGZ5GQ">10.0</ix:nonFraction> million. The expiration date was also extended to, and the subscription rights offering was completed on March 18, 2026. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">In March 2026, Mr. Mulacek converted the full February 2026 Note for total common shares of <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_3_1_2026_To_3_31_2026_srt_CounterpartyNameAxis_ep_PhilMulacekMember_us-gaap_DebtInstrumentAxis_ep_ConvertibleNoteFebruary2026Member_us-gaap_RelatedPartyTransactionsByRelatedPartyAxis_us-gaap_RelatedPartyMember_h_nT45NXD0SGRK8nD5BV5g" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:DebtConversionConvertedInstrumentSharesIssued1" scale="0" id="Narr_V6xxvztHkUyJCmdKM1Wbfg">1,003,344</ix:nonFraction> in accordance with the terms of the February 2026 Note. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">On May 1, 2026, the Company entered into a sales agreement with Roth Capital Partners, LLC ("Roth"), as sales agent and/or principal, under which the Company may sell from time to time shares of the Company's common stock having an aggregate offering price of up to $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_5_1_2026_To_5_1_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_AtMarketOfferingMember_zRujuFZBI0KiGVA-sHaxVQ" decimals="-5" format="ixt:num-dot-decimal" name="ep:SubscriptionRightsOfferingMaximumValueOfOfferingAgreedToBeMade" scale="6" id="Narr_N5aLIZRfPkSlSBqve5ncRw">30.0</ix:nonFraction> million in at-the-market offerings through or to Roth. Such shares will be issued pursuant to the Company's shelf registration statement on Form S-3 previously filed with the SEC and declared effective on September 22, 2023 (the &#8220;2023 S-3 Registration Statement&#8221;). &#160;Under the 2023 S-3 Registration Statement, as of May 1, 2026, the Company is able to offer and sell shares of common stock having an aggregate gross sales price of up to $<ix:nonFraction unitRef="Unit_Standard_USD_EEjv9s4NyUiYWHqSlmIU-Q" contextRef="Duration_5_1_2026_To_5_1_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_AtMarketOfferingMember_zRujuFZBI0KiGVA-sHaxVQ" decimals="-5" format="ixt:num-dot-decimal" name="ep:SubscriptionRightsOfferingMaximumValueOfOfferingAbleToBeMadeUnderShelfRegistrationStatement" scale="6" id="Narr_H88W9ijHwE2W90P2xSt7lA">7.5</ix:nonFraction> million from time to time in an at-the-market offering at prices and terms to be determined at the time of the sale. All proceeds are subject to customary agency fees. At this time <ix:nonFraction unitRef="Unit_Standard_shares_MOuEhyCsn06L0UNY7zc4nQ" contextRef="Duration_5_1_2026_To_5_1_2026_us-gaap_SubsidiarySaleOfStockAxis_ep_AtMarketOfferingMember_zRujuFZBI0KiGVA-sHaxVQ" decimals="INF" format="ixt-sec:numwordsen" name="us-gaap:StockIssuedDuringPeriodSharesNewIssues" scale="0" id="Narr_MCZ1ZcTgdUKBAQTV1okGAg">no</ix:nonFraction> shares have been issued.</p></ix:continuation></div><div style="clear:both;display:table;margin-bottom:21.6pt;min-height:14.4pt;width:100%;"><div style="display:table-cell;vertical-align:bottom;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">18</p></div></div></div>
