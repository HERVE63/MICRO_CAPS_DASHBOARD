t-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 41.11pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 38.89pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="height: 6pt; width: 4pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td></tr><tr class="BRDSX_header"><td style="width: 4pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 216pt; padding-bottom: 3.63pt; text-align: left; vertical-align: bottom; background-color: #3B5F8E;"><div class="BRDSX_fpara" style="color: #FFFFFF; font-family: 'Times New Roman', Times, serif; font-size: 8pt; font-weight: bold; margin-top: 0pt; margin-left: 2pt; text-align: left;">Name</div></td><td style="width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 45.56pt; padding-bottom: 3.63pt; text-align: left; vertical-align: bottom; background-color: #3B5F8E;"><div class="BRDSX_fpara" style="color: #FFFFFF; font-family: 'Times New Roman', Times, serif; font-size: 8pt; font-weight: bold; margin-top: 0pt; text-align: center;">Bonus Target</div></td><td style="width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 6pt; background-color: #3B5F8E;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 41.11pt; padding-