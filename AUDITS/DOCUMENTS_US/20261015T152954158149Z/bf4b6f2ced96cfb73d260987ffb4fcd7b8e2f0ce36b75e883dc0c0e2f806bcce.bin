e-space:nowrap;width:9.67%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2025</b></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.46%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><span style="font-size:8pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.65%;border-bottom:1px solid #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">2024</b></p></td></tr><tr style=""><td style="vertical-align:bottom;width:77.42%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Weighted average remaining lease term (years)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.77%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.67%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;">&#160;&#160;&#8203;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.65%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr style=""><td style="vertical-align:bottom;width:77.42%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0pt 6pt;">Operating Leases</p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.77%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.67%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.4pt 0pt 0pt;"><ix:nonNumeric contextRef="As_Of_12_31_2025_N87P92Z8vE6XTfQ-rzx94g" format="ixt-sec:duryear" name="us-gaap:OperatingLeaseWeightedAverageRemainingLeaseTerm1" id="Tc_L8tRyaXaJ0ad-0wXm25cZA_4_2"> 1.00</ix:nonNumeric></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.46%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.65%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.4pt 0pt 0pt;"><ix:nonNumeric contextRef="As_Of_12_31_2024_RcxKF29BtESuHSowlmXoAg" format="ixt-sec:duryear" name="us-gaap:OperatingLeaseWeightedAverageRemainingLeaseTerm1" id="Tc_MQt2eU-igkKU-PjK42YyJw_4_4"> 2.00</ix:nonNumeric></p></td></tr><tr style=""><td style="vertical-align:bottom;width:77.42%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;">Weighted average discount rate (%)</p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.77%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.67%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;">&#160;&#160;&#8203;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.46%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.65%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr style=""><td style="vertical-align:bottom;width:77.42%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0pt 6pt;">Operating Leases</p></td><td style="vertical-align:bottom;white-space:nowrap;width:0.77%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.67%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.4pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="As_Of_12_31_2025_N87P92Z8vE6XTfQ-rzx94g" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseWeightedAverageDiscountRatePercent" scale="-2" id="Tc_7mGRbu2e0E2KEVFkvC6AXA_6_2">6.00</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.46%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:9.65%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3.4pt 0pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="As_Of_12_31_2024_RcxKF29BtESuHSowlmXoAg" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:OperatingLeaseWeightedAverageDiscountRatePercent" scale="-2" id="Tc_nZN_l-UztkC7-E148J5GbQ_6_4">6.00</ix:nonFraction></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_GWJI_GDVXkqDEu1UVT4TKQ" name="us-gaap:DebtDisclosureTextBlock" id="Tb_kPUNqqNa-Uub7pU7qqZvyg" continuedAt="Tb_kPUNqqNa-Uub7pU7qqZvyg_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">NOTE 6 &#8212; DEBT</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:12pt;text-align:justify;margin:0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Term Loan and Revolving Credit Facility with Western Alliance Bank</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;">On March&#160;31, 2025, the Company entered into a Loan and Security Agreement (the &#8220;Credit Facility Agreement&#8221;) with Western Alliance Bank, an Arizona corporation (the &#8220;Lender&#8221;). The Credit Facility Agreement provides for borrowings of up to $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_YZIBIuJ5nkicEudiUwFArQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="6" id="Narr_r8ZBFCtBZ0yvtmcKv50XwA">20.0</ix:nonFraction> million, including (i)&#160;a term loan facility, comprising of a $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_SVoqJjxItUq4wGl_UZqZPA" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="6" id="Narr_Ezad_7BmdkS9MrzCuUWa3w">12.0</ix:nonFraction>&#160;million term loan advance funded on March&#160;31, 2025, and subsequent term loan advances at the Company&#8217;s request within the Draw Period (March&#160;31, 2025 through March&#160;31, 2026) subject to the terms and conditions of the Credit Facility Agreement, in a minimum amount of $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_3_31_2025_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_dktxjMMGiEewiTv5-0zvZQ" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentSubsequentLoanAdvanceAmount" scale="6" id="Narr_s65mhciqR0KMBoH04cN3Jw">1.0</ix:nonFraction> million and an aggregate principal amount not to exceed $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_3_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_A4JW1tBJiUKSjbmYNJKQMg" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentSubsequentLoanAdvanceAmount" scale="6" id="Narr_0of3fdTEVUq-mMnS6xGuMg">5.0</ix:nonFraction> million (the &#8220;Term Advances&#8221;); and (ii)&#160;a revolving line of credit in an aggregate outstanding amount not to exceed $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_3_31_2025_us-gaap_DebtInstrumentAxis_us-gaap_RevolvingCreditFacilityMember_mzqYopj_HU2I62hWCgVXTQ" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityMaximumBorrowingCapacity" scale="6" id="Narr_xCgb0I491EWQBwOZIgXMNA">3.0</ix:nonFraction> million (the &#8220;Revolving Facility&#8221;). The Term Advances and the Revolving Facility have a maturity date of March&#160;31, 2030. In the twelve months ended December&#160;31,&#160;2025, we drew $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_hWPnHbJSNUGQPCE3E_myew" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentSubsequentLoanAdvanceAmountDrawn" scale="6" id="Narr_T3uK5FGl_0O03H7Av9m45Q">1.4</ix:nonFraction> million from the $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_RQRH085TCkSPev4X1skE8w" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentSubsequentLoanAdvanceAmount" scale="6" id="Narr_OrTS-1gB80OpOckTGT8aRA">5.0</ix:nonFraction> million available as subsequent term loan advances. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;background:#ffffff;margin:0pt;">&#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;">The outstanding Term Advances and the Revolving Facility bear interest on the outstanding daily balance at a floating rate equal to <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_3_31_2025_To_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrMember_DNWsBRhDBEuJItFl2UzNcQ" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_09-BIswQtUCznZmmf8xGCA">3.25</ix:nonFraction>% above the term SOFR rate, which is defined as the greater of (i)&#160;<ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_3_31_2025_To_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_us-gaap_VariableRateAxis_us-gaap_SecuredOvernightFinancingRateSofrMember_DNWsBRhDBEuJItFl2UzNcQ" decimals="4" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentBenchmarkInterestRateFloorRate" scale="-2" id="Narr_nBlw8agbuEOW5JsmSQ-VDA">2.30</ix:nonFraction>% and (ii)&#160;the 1-month Term SOFR Reference Rate.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;"><span style="text-transform:uppercase;">F-</span><span style="text-transform:uppercase;">18</span></p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:88.24%;border:0;margin:30pt 5.88% 30pt 5.88%;"></div><div style="max-width:100%;padding-left:5.88%;padding-right:5.88%;position:relative;"><div style="margin-top:21.6pt;min-height:14.4pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 12pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">AUDIOEYE,&#160;INC.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt;"><b style="font-weight:bold;">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:0pt 0pt 12pt 0pt;"><b style="font-weight:bold;">DECEMBER 31, 2025 and 2024</b></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="Tc_kNYZwecqvU-x62n5wUUb3g_2_0"></a><a id="Tc_g0kvGjxgLk2lnug5GR9icw_2_2"></a><a id="Tc_Nyg9WLd1X0KZwDEje_XX-w_3_0"></a><a id="Tc_aRSM87cMCk2L6CP4fcQdrg_3_2"></a><a id="Tc_w0asOUeUaUS5jaWTfhtqPw_4_0"></a><a id="Tc_NlRI4Pnyb06A_qaoqIlwsA_5_0"></a><a id="Tc_sQAhD2-TJEGRpR-XPO9iKQ_6_0"></a><a id="Tc_NCJlWzBD6UCyEcQcVWHAMg_7_0"></a><a id="Tc_sEUgfvYRP0e_rUxtBoN5yQ_8_0"></a><a id="Tc_L4OuUqwC6UmMcVBeDG6-jA_8_2"></a><ix:continuation id="Tb_kPUNqqNa-Uub7pU7qqZvyg_cont1" continuedAt="Tb_kPUNqqNa-Uub7pU7qqZvyg_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;">For each Term Advance, the Company is obligated to pay interest-only payments with respect to such Term Advance through April&#160;9, 2026. Beginning on April&#160;10, 2026, the Company shall repay each outstanding Term Advance in (i)&#160;quarterly principal payments in the amount of <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_4_10_2026_To_4_10_2026_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_jBL3094GrEu1AAYxXedQ0g" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_fSTiidg2c0m_C-rdVtOhTA">1.25</ix:nonFraction>% of the aggregate principal amount of Term Advances outstanding as of April&#160;10, 2026, payable on the tenth (10th) day of each calendar quarter, plus (ii)&#160;monthly payments of accrued interest, payable on the tenth (10th) day of each month. The final payment for each Term Advance, due on March&#160;31, 2030, shall include all outstanding principal and accrued and unpaid interest under such Term Advance. Once repaid, the Term Advances may not be reborrowed. The interest on the Revolving Facility is payable monthly with the principal outstanding amount due at maturity.&#160;</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt 0pt 12pt 0pt;">The Company incurred $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="Duration_3_31_2025_To_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_ohqdvyivykG1sro4CgiLUw" decimals="0" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentFacilityFeePaid" scale="0" id="Narr_E6sT4p3tYEiWAMnI2biUjA">50,000</ix:nonFraction> in facility fees on the closing date, which <span style="background:#ffffff;">were recorded as debt discount.</span> <span style="background:#ffffff;">The Company also incurred </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="Duration_3_31_2025_To_3_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_ohqdvyivykG1sro4CgiLUw" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:PaymentsOfDebtIssuanceCosts" scale="0" id="Narr_vDgr5X-VhkynSgoom1bJ8w">443,000</ix:nonFraction> in <span style="background:#ffffff;">third-party expenses in connection with the term loan, which were recorded as debt issuance costs</span>. <span style="background:#ffffff;">Debt discount and debt issuance costs are presented as a direct deduction from the carrying amount </span>of our term loan and are amortized to interest expense over the term of the loan on a straight-line basis, which is not materially different from the&#160;effective interest method.<span style="background:#ffffff;">&#160;</span> </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;padding-bottom:12pt;text-align:justify;margin:0pt;">In the twelve months ended December&#160;31,&#160;2025, amortization of debt discount and debt issuance costs (associated with the Western Alliance Bank credit facility and the SG Credit Partners term loan, discussed below) totaled $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="Duration_1_1_2025_To_12_31_2025_GWJI_GDVXkqDEu1UVT4TKQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AmortizationOfDebtDiscountPremium" scale="0" id="Narr_bUCrRqSlpUuMV0VNsRlGew">25,000</ix:nonFraction> and $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="Duration_1_1_2025_To_12_31_2025_GWJI_GDVXkqDEu1UVT4TKQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AmortizationOfFinancingCosts" scale="0" id="Narr_YpHk89GXSEeXtq2MEd_NOw">72,000</ix:nonFraction>, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;">The Credit Facility Agreement is secured by substantially all of our assets and contains certain customary financial covenants, including the requirements that the Company maintain at all times from the closing date through and including the calendar quarter ended June&#160;30, 2026, (a)&#160;unrestricted and unencumbered cash held in accounts with the Lender equal to at least $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_GmCgFE8AS0KWC_AEhJuF6A" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantsMinimumUnencumberedAndUnrestrictedCashHeldInAccountsWithLender" scale="6" id="Narr_u9KAAo5uckG63GwCVBR2Qg">3.0</ix:nonFraction> million measured as of the last day of each calendar month, and (b)&#160;a ratio of certain total committed debt to its Annual Recurring Revenue between <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_GNLe8HWg4kKbF_Zm8LQK1A" decimals="6" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantTotalCommittedDebtToAnnualRecurringRevenueRatio" scale="-4" id="Narr_SDjwuAj_jkuDCEJLwLY1Fg">0.70</ix:nonFraction> to <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_RangeAxis_srt_MinimumMember_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_Iry_AWpNRU-18Bvj7SIhig" decimals="6" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantTotalCommittedDebtToAnnualRecurringRevenueRatio" scale="-4" id="Narr_zkpT9AkJkUWG10tKWDojbA">0.55</ix:nonFraction>, depending on the testing date, measured as of the last day of each calendar quarter.&#160;During the period of time commencing on September&#160;30, 2026, and continuing through and including March&#160;31, 2030, the Company shall maintain (a)&#160;a ratio of its aggregate funded indebtedness to its adjusted EBITDA for the prior twelve months of no greater than (i)&#160;<ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_StatementScenarioAxis_aeye_QuartersCommencingSeptember302026ThroughJune302027Member_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_zWQAD2k4akOLCCSd2xk7OQ" decimals="6" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantAggregateFundedIndebtednessToAdjustedEbitdaRatio" scale="-4" id="Narr_qzYPtSxa3ES8ZbEv03qDxw">2.50</ix:nonFraction> to 1.00 for the calendar quarters commencing September&#160;30, 2026 through and including June&#160;30, 2027, and (ii)&#160;<ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_1_1_2025_To_12_31_2025_srt_StatementScenarioAxis_aeye_ForPeriodAfterJune302027Member_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_EpFhMZe7Wk2U2q4nXp_Ptw" decimals="6" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantAggregateFundedIndebtednessToAdjustedEbitdaRatio" scale="-4" id="Narr_7mAcQsRHfUSmW8-pK6D5rQ">2.00</ix:nonFraction> to 1.00 at all times thereafter, in each case measured as of the last day of each calendar quarter, and (b)&#160;a Fixed Charge Coverage Ratio of at least <ix:nonFraction unitRef="Unit_Standard_pure_Bw5QC5McPUa3s352AniCXg" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanFacilityMember_QVZ1K904Nk-Lg8K0PGj7Iw" decimals="6" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentCovenantMinimumFixedChargeCoverageRatio" scale="-4" id="Narr_-5friAyyDUOhqojlUXWHDg">1.50</ix:nonFraction> to 1.00. As of December&#160;31,&#160;2025, the Company was&#160;in compliance with&#160;the applicable financial covenants.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">As of December&#160;31,&#160;2025, the outstanding principal balance of our term loan totaled $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_hWPnHbJSNUGQPCE3E_myew" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentCarryingAmount" scale="0" id="Narr_xHdqEq7MPUuNpu6Qr8WMEA">13,401,000</ix:nonFraction> and there were no outstanding borrowings under the revolving line of credit. As of December&#160;31,&#160;2025, term loan advances and revolving line of credit available for future draws totaled $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_aeye_TermLoanAdvanceMember_hWPnHbJSNUGQPCE3E_myew" decimals="-5" format="ixt:num-dot-decimal" name="aeye:DebtInstrumentSubsequentLoanAdvanceAmountAvailable" scale="6" id="Narr_Y_adQEi-X0iXxgRuYN1agA">3.6</ix:nonFraction> million and $<ix:nonFraction unitRef="Unit_Standard_USD_L889iYIeZU-MgdBCMH11WQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_us-gaap_RevolvingCreditFacilityMember_8mCGqEBviUSxgNxBquCQ2Q" decimals="-5" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="6" id="Narr_8asXM_FyukK1vpeGUsFUqg">3.0</ix:nonFraction> million, respectively.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;margin:0pt;">As of December&#160;31,&#160;2025, future principal payments of debt based on the principal balance then outstanding are as follows (in thousands):</p><ix:nonNumeric contextRef="Duration_1_1_2025_To_12_31_2025_GWJI_GDVXkqDEu1UVT4TKQ" name="srt:ContractualObligationFiscalYearMaturityScheduleTableTextBlock" id="Tb_BKdevpYm3EyRDcs6jd0lFA" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;background:#ffffff;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;fon