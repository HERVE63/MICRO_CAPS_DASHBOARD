margin:0pt 0pt 0.05pt 0pt;"><span style="font-size:8.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:15.83%;border-bottom:3px double #000000;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:8pt;text-align:right;margin:0pt 2.5pt 0.05pt 0pt;"><span style="font-size:8.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_12_31_2025_GInpYwGT1E6PwSY3ep8CnQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Tc_7AZESEYFJU6o7-w7OyjP7w_9_13">100,000</ix:nonFraction></span></p></td></tr></table></ix:continuation><div style="font-family:'Times New Roman','Times','serif';font-size:6.0pt;margin-bottom:0pt;min-height:1.19em;position:relative;width:100%;"><div style="background-color:#000000;height:1px;position:relative;top:0.6em;width:25.0%;border:none;margin:0 auto 0 0;"></div></div><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">(1)</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">Amounts presented represent outstanding amounts held by external parties (i.e., not eliminated in consolidation) on an aggregate basis with the interest rate representing the weighted-average stated coupon rate based on principal amounts outstanding; refer to &#8220;2025 CLO Securitization&#8221; within this Note 6 for further details.</span></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0pt 18pt;"><span style="margin-left:0pt;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Credit Facility</span>: WhiteHorse Credit initially entered into a revolving credit and security agreement with JPMorgan, as administrative agent and lender as amended (the &#8220;Credit Facility&#8221;) on December 23, 2015. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">On January 17, 2025, the terms of the Credit Facility were amended to, among other things, (i) reduce the applicable margins for interest rates to <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="As_Of_1_17_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_hHiBqKplO0ao7F1LX6Kqrw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DerivativeBasisSpreadOnVariableRate" scale="-2" id="Narr_fko3j_TMFU2MdtODrSOUxQ">2.25</ix:nonFraction>%, (ii) extend the non-call period to January 17, 2027, (iii) extend the reinvestment period to January 17, 2028, and (iv) extend the scheduled termination date to January 17, 2030.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">On June 27, 2025, the terms of the Credit Facility were amended to, among other things, reduce the availability under the Credit Facility to $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_27_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_1deY1LIw-ESB3Dqezfvc1A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_UVCmemRUp0WCoJfEkS9qjQ">100,000</ix:nonFraction> from $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_26_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_dbrKpvXfZkmjtd_rLtP6Tg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_r5oLxDtjlUC1XVOLoQozvg">335,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">On March 10, 2026, the terms of the Credit Facility were amended to, among other things, reduce the availability under the Credit Facility to $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_3_9_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_3XcT_MzQlkWqrk6CoY6UIQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_i1eVGxuCaEyg4NOBTjUocQ">50,000</ix:nonFraction>&#160;from $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_3_10_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_VQfhPNKc10yCTJyUz2b89Q" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_H2w66xR-vUeeidbc7XlsPw">100,000</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0.25pt;">The Credit Facility bears interest at <span style="-sec-ix-hidden:Hidden_w6-M6S5gKkOGpBwrwltWgw;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">SOFR</span></span> for USD denominated borrowings, EurIBOR for EUR denominated borrowings, CORRA for CAD denominated borrowings, and SONIA for GBP denominated borrowings, plus, in each case, a spread of <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_4_12_2023_To_4_12_2023_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_us-gaap_VariableRateAxis_whfcl_SterlingOvernightIndexAverageMember_TLqqekhc9EWle3L4ZRVyAg" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentBasisSpreadOnVariableRate1" scale="-2" id="Narr_Q7nP092fe0uc8M8mrfah7Q">2.25</ix:nonFraction>% on outstanding borrowings. The Company is required to pay a non-usage fee which accrues at <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_4_12_2023_To_4_12_2023_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_dPN4rMDYzkO9OMp5aCPJDw" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityUnusedCapacityCommitmentFeePercentage" scale="-2" id="Narr_vk-iLFME_kqU9QAsShuCPw">0.55</ix:nonFraction>% per annum on the average daily unused amount of the financing commitments to the extent the aggregate principal amount available under the Credit Facility has not been borrowed. The Company is also required to pay a minimum outstanding borrowing fee which accrues at <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_PWUr3QyphkGBnc5DBYJzaw" decimals="4" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityBorrowingsBelowFundingAmountMinimumBorrowingFee" scale="-2" id="Narr_g8jpQHfKr0uf65g5R-uZcg">2.25</ix:nonFraction>% per annum on the average daily outstanding principal borrowing amounts below the minimum funding amount. The minimum borrowing requirement is $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_PWUr3QyphkGBnc5DBYJzaw" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:LineOfCreditFacilityMinimumBorrowingCapacity" scale="3" id="Narr_ql2e6eeTO0CyKyYnznCRlQ">25,000</ix:nonFraction> as of June&#160;30,&#160;2026. In connection with the Credit Facility, WhiteHorse Credit pledged securities with a fair value of approximately $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bx4odfsof0C4gMIhp7_Lhg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:SecuritiesLoanedFairValueOfCollateral" scale="3" id="Narr_kfMg-1-hokSs_XxW6GKfxA">118,118</ix:nonFraction> as of June&#160;30,&#160;2026. The Credit Facility has a maturity date of January 17, 2030.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Under the Credit Facility, the Company has made certain customary representations and warranties and is required to comply with various covenants, including leverage restrictions, reporting requirements and other customary requirements for similar credit facilities. </p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">As of June&#160;30,&#160;2026, the Company had <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bx4odfsof0C4gMIhp7_Lhg" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:DebtInstrumentCarryingAmount" scale="3" id="Narr_-tdAA-i_FUKhyXvHo9s-vw">no</ix:nonFraction> outstanding borrowings and $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_bx4odfsof0C4gMIhp7_Lhg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_oepAnsTHKUWu0Agilz0rGw">50,000</ix:nonFraction> undrawn under the Credit Facility. Weighted average outstanding borrowings was <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_PWUr3QyphkGBnc5DBYJzaw" decimals="-3" format="ixt-sec:numwordsen" name="whfcl:WeightedAverageBorrowingsOutstandingDuringPeriod" scale="3" id="Narr_jscDKcMtZUeD593TKvEw6Q"><ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_4_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_eAWcmiAfckGZEDX8GRZDBA" decimals="-3" format="ixt-sec:numwordsen" name="whfcl:WeightedAverageBorrowingsOutstandingDuringPeriod" scale="3" id="Narr_wbionUqlXEaEAz5-NYb6yQ">zero</ix:nonFraction></ix:nonFraction> for the three and six months ended June&#160;30,&#160;2026. As of June&#160;30,&#160;2026, the interest rate in effect on outstanding borrowings was <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_PWUr3QyphkGBnc5DBYJzaw" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:InterestExpenseLongTermDebt" scale="3" id="Narr_48AsEH33dEeag5ky4ACzdw">zero</ix:nonFraction>. The Company&#8217;s ability to draw down undrawn funds under the Credit Facility is determined by collateral and portfolio quality requirements stipulated in the credit and security agreement. As of June&#160;30,&#160;2026, due to borrowing base limitations, approximately $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_srt_RangeAxis_srt_MaximumMember_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_cLvRzQqKzkq5DpK8sifqOg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityCurrentBorrowingCapacity" scale="3" id="Narr_HLxnHEzGxk20IPH2Nd7Fmg">39,801</ix:nonFraction> was available to be drawn by the Company based on these requirements.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="background:#ffffff;">As of&#160;December 31,&#160;2025, the Company had&#160;</span><ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_Hp23vZuEQEObAOClzrJYSA" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:DebtInstrumentCarryingAmount" scale="3" id="Narr_cVKLgCe1R0yUz1zHu0AOmw">no</ix:nonFraction><span style="background:#ffffff;">&#160;outstanding borrowings and </span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_Hp23vZuEQEObAOClzrJYSA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LineOfCreditFacilityRemainingBorrowingCapacity" scale="3" id="Narr_a-TFEscWw0e7vz7T4BzTBg">100,000</ix:nonFraction><span style="background:#ffffff;">&#160;undrawn under the Credit Facility. Weighted average outstanding borrowings were&#160;</span><span style="background:#ffffff;">$</span><ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_b3hZbw9NREa1vYWaNcCycA" decimals="-3" format="ixt:num-dot-decimal" name="whfcl:WeightedAverageBorrowingsOutstandingDuringPeriod" scale="3" id="Narr_oeS7P1zCaUOszJJZlR38PQ">77,300</ix:nonFraction><span style="background:#ffffff;">&#160;at a weighted average interest rate of&#160;</span><ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_b3hZbw9NREa1vYWaNcCycA" decimals="4" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtWeightedAverageInterestRateOverTime" scale="-2" id="Narr_wt_T6iA-HEe8xL6AgIjInA">6.54</ix:nonFraction>%<span style="background:#ffffff;">&#160;for the year ended December 31,&#160;2025. As of&#160;December 31,&#160;2025, the interest rate in effect on outstanding borrowings was&#160;</span><ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2025_To_12_31_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_b3hZbw9NREa1vYWaNcCycA" decimals="-3" format="ixt-sec:numwordsen" name="us-gaap:InterestExpenseLongTermDebt" scale="3" id="Narr_tF0po28t3kC6UW1VwXIBUw">zero</ix:nonFraction><span style="background:#ffffff;">. The Company&#8217;s ability to draw down undrawn funds under the Credit Facility is determined by collateral and portfolio </span></p></ix:continuation></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:2.75pt 0pt 0pt 0pt;">61</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">WhiteHorse Finance,&#160;Inc.</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">Notes&#160;to Consolidated Financial Statements (Unaudited)</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt;"><b style="font-weight:bold;">June&#160;30,&#160;2026</b></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;text-indent:0pt;margin:0pt 0pt 4pt 0pt;"><i style="font-style:italic;">(in thousands, except share and per share data)</i></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></div><div style="clear:both;max-width:100%;position:relative;min-height:6.9pt;"><a id="Tc_5r2WZTSg-0CIk2aNfpm8Pw_1_2"></a><a id="Tc_6CSsix0uS0OMOeXtIpfjIg_1_12"></a><a id="Tc_CXizAy3V7UekS2knqsHh9g_2_0"></a><a id="Tc_q79T8Upkp0qEZyNCwORTmA_2_3"></a><a id="Tc_x0C1HvHz_UWwbSA6vo_7vw_2_6"></a><a id="Tc_J6ZDhmb_tki8mcOKkz9z7Q_2_11"></a><a id="Tc_xgYYf1A8l0GmwemDMQDuAQ_2_14"></a><a id="Tc_GtC8iLuJk0Wu5MyJ1MhFAw_3_0"></a><a id="Tc_hDPEAL-7AUWs2JJNqVOqDA_3_2"></a><a id="Tc_IyyUM5-wGUeZVr8jGAKagw_3_5"></a><a id="Tc_NvSNwVcS7UuzNTr8M4PRYA_3_11"></a><a id="Tc_loKg7A97MkmoMSLkv_YH4Q_3_14"></a><a id="Tc_TeNhNKB33EOWz2Rw8FbEPQ_4_0"></a><a id="Tc_E4Ie3fGzukW9VCuNd15F7g_5_0"></a><a id="Tc_ogZT2QdwJUOfBAHbs9ULcg_5_2"></a><a id="Tc_D9EePy3FpkO7BNgq8-pXWA_5_5"></a><a id="Tc_8ztF5IO-hU-Pf