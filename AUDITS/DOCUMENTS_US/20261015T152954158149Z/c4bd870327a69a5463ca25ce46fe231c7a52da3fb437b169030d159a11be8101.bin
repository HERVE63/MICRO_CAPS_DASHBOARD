5%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_DebtInstrumentAxis_whfcl_SeniorUnsecuredNotesMember_qbBVdwq8xkG_-b4FoUus4g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAverageAmountOutstanding" scale="3" id="Tc_2_t_0CyljUCd7OK9YlQ2OQ_8_6">194,500</ix:nonFraction></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_SeniorUnsecuredNotesMember_foEW0jU3KUC16up_c08Fmw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAverageAmountOutstanding" scale="3" id="Tc_-GexXfxRhUucoLcRoBJqNw_8_12">154,500</ix:nonFraction></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.94%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2025_To_6_30_2025_us-gaap_DebtInstrumentAxis_whfcl_SeniorUnsecuredNotesMember_gpy_ga5XPkioUM_GlQJ3sg" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAverageAmountOutstanding" scale="3" id="Tc_rLzSYVr0OE-jDL9E9qyGeA_8_15">194,500</ix:nonFraction></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.94%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td></tr></table><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></ix:continuation><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_QLNszTluDESRwa8mkkCy9w" name="us-gaap:RelatedPartyTransactionsDisclosureTextBlock" id="Tb_EjsT4hZUuE-oE0v4Rxf4Cg" continuedAt="Tb_EjsT4hZUuE-oE0v4Rxf4Cg_cont1" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;"><span style="font-weight:normal;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-weight:bold;margin:0pt 0pt 12pt 0pt;">NOTE&#160;7&#160;- RELATED PARTY TRANSACTIONS</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">Investment Advisory Agreement</span>: WhiteHorse Advisers serves as the Company&#8217;s investment adviser in accordance with the terms of an investment advisory agreement, which was executed by the Company on February 22, 2024 (the &#8220;Investment Advisory Agreement&#8221;). The Company&#8217;s board of directors most recently re-approved the Investment Advisory Agreement on October 29, 2025. Subject to the overall supervision of the Company&#8217;s board of directors, WhiteHorse Advisers manages the day-to-day operations of, and provides investment management services to, the Company. Under the terms of the Investment Advisory Agreement, WhiteHorse Advisers:</p><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:12pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="width:18pt;"/><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">&#9679;</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">determines the composition of the investment portfolio, the nature and timing of the changes to the portfolio and the manner of implementing such changes;</span></td></tr></table><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:12pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="width:18pt;"/><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">&#9679;</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">identifies, evaluates and negotiates the structure of the investments the Company makes (including performing due diligence on the Company&#8217;s prospective portfolio companies); and</span></td></tr></table><table style="border-collapse:collapse;font-family:'Times New Roman','Times','serif';font-size:10pt;margin-bottom:0pt;margin-top:0pt;table-layout:fixed;width:100%;border:0pt;"><tr><td style="width:18pt;"/><td style="font-family:'Times New Roman','Times','serif';font-size:10pt;vertical-align:text-top;white-space:nowrap;width:18pt;padding:0pt;">&#9679;</td><td style="padding:0pt;"><span style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:normal;font-weight:normal;">closes, monitors and administers the investments the Company makes, including the exercise of any voting or consent rights.</span></td></tr></table><div style="margin-top:12pt;"></div><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">In addition, WhiteHorse Advisers provides the Company with access to personnel and an Investment Committee. Under the Investment Advisory Agreement, the Company pays WhiteHorse Advisers a fee for investment management services consisting of a base management fee and an incentive fee. The Investment Advisory Agreement may be terminated by either party without penalty upon <ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_RelatedPartyTransactionAxis_whfcl_InvestmentAdvisoryAgreementMember_wursKnJIC0CGE8Gi0D8ONw" format="ixt-sec:durday" name="whfcl:InvestmentAdvisoryAgreementTerminationTerm" id="Narr_hzt0pzj0v0mc_NNnwly8vA">60</ix:nonNumeric>&#160;days&#8217; written notice to the other party.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;font-style:italic;margin:0pt 0pt 12pt 0pt;">Base Management Fee</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">Effective January 1, 2024, the base management fee is calculated at an annual rate equal to <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_1_1_2024_To_1_1_2024_us-gaap_RelatedPartyTransactionAxis_whfcl_InvestmentAdvisoryAgreementMember_0S_Ff_wJaEa5ghLsnrxZkA" decimals="4" format="ixt:num-dot-decimal" name="whfcl:PercentageOfBaseManagementFeeOnGrossAssets" scale="-2" id="Narr_HfWx9wy-V0qpIpjP_KihRQ">1.75</ix:nonFraction>% based on the Company&#8217;s consolidated gross assets (including cash and cash equivalents and assets purchased with borrowed funds); provided, however, the base management fee will be calculated at an annual rate equal to <ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_1_1_2024_To_1_1_2024_us-gaap_RelatedPartyTransactionAxis_whfcl_InvestmentAdvisoryAgreementMember_0S_Ff_wJaEa5ghLsnrxZkA" decimals="4" format="ixt:num-dot-decimal" name="whfcl:PercentageOfBaseManagementFeeOnGrossAssetsIfValueExceededTotalAssets" scale="-2" id="Narr_mV4DjkVNXUSvXdLZw6EBLQ">1.25</ix:nonFraction>% of the Company&#8217;s consolidated gross assets (including cash and cash equivalents and assets purchased with borrowed funds) at the end of the <ix:nonFraction unitRef="Unit_Standard_item_Z8EZpQnxekWzFf7h85qa1g" contextRef="Duration_1_1_2024_To_1_1_2024_us-gaap_RelatedPartyTransactionAxis_whfcl_InvestmentAdvisoryAgreementMember_0S_Ff_wJaEa5ghLsnrxZkA" decimals="INF" format="ixt-sec:numwordsen" name="whfcl:NumberOfCalendarQuarters" scale="0" id="Narr_CpCTNIFthEWSIKxBWn8Egw">two</ix:nonFraction> most recently completed calendar quarters, that exceed the product of (i)&#160;<ix:nonFraction unitRef="Unit_Standard_pure_5-a6OUbAHUyLzLTqFwSM-w" contextRef="Duration_1_1_2024_To_1_1_2024_us-gaap_RelatedPartyTransactionAxis_whfcl_InvestmentAdvisoryAgreementMember_0S_Ff_wJaEa5ghLsnrxZkA" decimals="2" format="ixt:num-dot-decimal" name="whfcl:ThresholdPercentageForCalculationOfBaseManagementFee" scale="-2" id="Narr_P8Ghiy2QdUK13tdUDkGsAg">200</ix:nonFraction>% and (ii)&#160;the value of the Company&#8217;s total net assets. Base management fees are payable quarterly in arrears and are appropriately pro-rated for any partial&#160;<span style="white-space:pre-wrap;">month or quarter.  </span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:2.75pt 0pt 0pt 0pt;">65</p></div></div>
