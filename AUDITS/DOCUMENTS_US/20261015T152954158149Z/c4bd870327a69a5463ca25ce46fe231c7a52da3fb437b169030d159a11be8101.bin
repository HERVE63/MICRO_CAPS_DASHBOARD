t;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> &#8212;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.95%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_4_1_2025_To_6_30_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_RddbPwM6BEe1_KH-SroU0g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAverageAmountOutstanding" scale="3" id="Tc_ORofdZqs5kazgaN6YZHNhQ_8_6">136,630</ix:nonFraction></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.47%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> &#8212;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.94%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.31%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;margin:0pt;"><span style="font-size:9.5pt;">$</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.01%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:9pt;text-align:right;margin:0pt 3pt 0pt 0pt;"><span style="font-size:9.5pt;"> <ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_1_1_2025_To_6_30_2025_us-gaap_DebtInstrumentAxis_whfcl_JpmCreditFacilityMember_B08UfWSJp0WEAXs33ZKvsQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:LongTermDebtAverageAmountOutstanding" scale="3" id="Tc_l9SrA1_ys0i33_huM-8_YQ_8_15">155,881</ix:nonFraction></span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.94%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:9.5pt;visibility:hidden;">&#8203;</span></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-line:underline;text-decoration-style:solid;visibility:hidden;">&#8203;</span></p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;"><span style="text-decoration-color:#000000;text-decoration-line:underline;text-decoration-style:solid;">2025 CLO Securitization</span>: On June 10, 2025, the Company completed a $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="Duration_6_10_2025_To_6_10_2025_us-gaap_DebtInstrumentAxis_whfcl_CloNotes2025Member_cE22VcHbikCHhEVl7MHCkw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromIssuanceOfLongTermDebt" scale="3" id="Narr_zffmWT4jXUecZbyBbbpHZQ">298,150</ix:nonFraction> term debt securitization transaction (the &#8220;2025 CLO Securitization&#8221;). The 2025 CLO Securitization functions as a source of long-term balance sheet financing for a portion of the Company&#8217;s portfolio investments and, as a result, the debt issued in connection with the 2025 CLO Securitization that is held by external counterparties to the Company is subject to the Company&#8217;s regulatory asset coverage requirement.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The debt tranches offered in the 2025 CLO Securitization were issued by WHF CLO, a wholly-owned subsidiary of WhiteHorse Finance, and executed through a private placement comprised of both senior secured floating rate notes and loans (the &#8220;2025 Senior CLO Notes&#8221;) as well as subordinated notes (the &#8220;2025 Subordinated CLO Notes&#8221;). The 2025 Senior CLO Notes consisted of (i) $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_10_2025_us-gaap_DebtInstrumentAxis_whfcl_SeniorCloNotes2025AaaRatedClassMember_VJsfUoVJQE-1wre5WW7bYQ" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_KhWjdCsceEKSPNSG9ka01w">174,000</ix:nonFraction> of AAA-rated Class A Notes and Class A-L Loans, issued in the aggregate and pari passu to one another (the &#8220;Class A Notes&#8221;); (ii) $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_10_2025_us-gaap_DebtInstrumentAxis_whfcl_SeniorCloNotes2025AaRatedClassBMember_EdcapyXQWECVFBmNXvCI0w" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_-SJAy2oTzkOP3Ubk80BJyw">30,000</ix:nonFraction> of AA-rated Class B Notes (the &#8220;Class B Notes&#8221;); (iii) $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_10_2025_us-gaap_DebtInstrumentAxis_whfcl_SeniorCloNotes2025RatedClassCMember_XucL7a24VU-KqFPxhTNbVw" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_2ndXTYYbYEGW-KNC_mockA">24,000</ix:nonFraction> of A-rated Class C Notes (the &#8220;Class C Notes&#8221;). Additionally, $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_10_2025_us-gaap_DebtInstrumentAxis_whfcl_SubordinatedCloNotes2025Member_d_rZMcrvR06W7BqALRW98A" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_X6X9u5nXj02EsO8kBVb93g">70,150</ix:nonFraction> of 2025 Subordinated CLO Notes were issued, which do not bear interest but are entitled to all of the residual principal and interest payments made on the loan portfolio of assets collateralizing the 2025 CLO Securitization, net of the interest expense and debt principal payments distributed to the holders of the 2025 Senior CLO Notes. The 2025 Senior CLO Notes, together with the 2025 Subordinated CLO Notes, are collectively referred to herein as the &#8220;2025 CLO Notes&#8221;. As of June&#160;30,&#160;2026, the Company indirectly retained $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_SeniorCloNotes2025AaRatedClassBMember_Iye2ECiy3E2WwtlGnd-vIA" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_zU8XLl_MgUGrWKRmdv0kMA">30,000</ix:nonFraction> of the Class B Notes, $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_SeniorCloNotes2025RatedClassCMember_w6kP4Hx6q0Wnc84YBh8A_g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr__rKIOjBAbEaBUE8TAuOvSQ">24,000</ix:nonFraction> of the Class C Notes and $<ix:nonFraction unitRef="Unit_Standard_USD_AGiQhSd38EGpcvsuBHjTBQ" contextRef="As_Of_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_SubordinatedCloNotes2025Member_Zk6zqnwxIkmzgv0gVnMb-g" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:DebtInstrumentFaceAmount" scale="3" id="Narr_qvL7MRf9HUeRD88-m6RoGQ">70,150</ix:nonFraction> of the 2025 Subordinated CLO Notes. The Class A Notes are included in the consolidated statements of assets and liabilities as debt of the Company. As of June&#160;30,&#160;2026, the Class B Notes, Class C Notes and 2025 Subordinated CLO Notes were eliminated in consolidation.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-indent:18pt;margin:0pt 0pt 12pt 0pt;">The following table presents <span style="letter-spacing:0.05pt;">additional </span>information<span style="letter-spacing:0.05pt;"> </span>on<span style="letter-spacing:0.1pt;"> </span>the<span style="letter-spacing:0.05pt;"> 2025 CLO </span>Notes<span style="letter-spacing:0.05pt;"> </span>issued<span style="letter-spacing:0.05pt;"> </span>in<span style="letter-spacing:0.05pt;"> </span>the<span style="letter-spacing:0.05pt;"> 2025 CLO Securitization </span>as<span style="letter-spacing:0.05pt;"> </span>of June&#160;30,&#160;2026<span style="letter-spacing:-0.1pt;">:</span></p><ix:nonNumeric contextRef="Duration_1_1_2026_To_6_30_2026_us-gaap_DebtInstrumentAxis_whfcl_CloNotes2025Member_vtXXvvku8ECxZAu-sb5bgg" name="us-gaap:ScheduleOfDebtTableTextBlock" id="Tb_gTjqxXQPcEOgjmzLORycaw" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;min-height:0.0pt;margin:0pt;"><span style="font-size:0pt;visibility:hidden;">&#8203;</span></p><table style="border-collapse:collapse;font-size:16pt;height:max-content;padding-left:0pt;padding-right:0pt;width:100%;"><tr style="height:1pt;"><td style="vertical-align:middle;width:45.51%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:50%;transform:translate(0,-50%);width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:middle;width:1.89%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:50%;transform:translate(0,-50%);width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:middle;width:14.68%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:50%;transform:translate(0,-50%);width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt;"><span style="font-size:1pt;visibility:hidden;">&#8203;</span></p></div></div></td><td style="vertical-align:middle;width:2.29%;margin:0pt;padding:0pt;"><div style="height:1pt;overflow:hidden;overflow-wrap:break-word;position:relative;"><div style="position:absolute;top:50%;transform:translate(0,-50%);width:100%;"><p style="font-fam