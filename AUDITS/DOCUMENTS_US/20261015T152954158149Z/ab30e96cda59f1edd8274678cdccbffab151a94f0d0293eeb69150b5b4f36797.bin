nt-family:'Times New Roman',serif;font-size:10pt;font-weight:700;line-height:100%">Skills, Qualifications and Experience</span></td></tr><tr><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Director Nominees</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Age</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Director<br/>Since</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Senior Leadership</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Public<br/>Company<br/>Board</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Industry<br/></span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Corporate<br/>Governance</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Risk<br/>Management </span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">International</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:middle"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">Financial</span></td></tr><tr><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">G. Pratt</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">77</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">2014</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td><td colspan="3" style="background-color:#ffffff;border-top:1pt solid #000;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#95b3d7;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">&#9679;</span></td></tr><tr><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">A. DasGupta</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">68</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:center;vertical-align:bottom"><span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:100%">2026</span></td><td colspan="3" style="background-color:#d9e2f3;padding:2px 1pt;text-align:c