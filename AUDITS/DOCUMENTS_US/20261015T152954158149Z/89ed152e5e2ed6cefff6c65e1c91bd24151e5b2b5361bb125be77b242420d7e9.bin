                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">120,000</div>
              </td>

    <td style="width: 18.69%; vertical-align: top; background-color: rgb(204, 238, 255); white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">145,865</div>
              </td>

    <td style="width: 23.46%; vertical-align: top; background-color: rgb(204, 238, 255); white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">&#8212;</div>
              </td>

    <td style="width: 14.73%; vertical-align: top; background-color: rgb(204, 238, 255); white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">265,865</div>
              </td>

  </tr>

  <tr>

    <td colspan="1" style="width: 1%; vertical-align: top; white-space: nowrap;">&#160;</td>

    <td style="width: 23.8%; vertical-align: top; white-space: nowrap;">
                <div style="text-align: left; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">Daniel W. Campbell</div>
              </td>

    <td style="width: 19.32%; vertical-align: top; white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">140,500</div>
              </td>

    <td style="width: 18.69%; vertical-align: top; white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">145,865</div>
              </td>

    <td style="width: 23.46%; vertical-align: top; white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">27,992</div>
              </td>

    <td style="width: 14.73%; vertical-align: top; white-space: nowrap;">
                <div style="text-align: center; color: rgb(101, 102, 106); font-family: Arial; font-size: 10pt;">314,357</div>
              </td>

  </tr>

