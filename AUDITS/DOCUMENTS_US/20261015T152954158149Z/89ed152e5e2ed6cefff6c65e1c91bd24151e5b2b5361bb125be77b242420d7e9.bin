          <table cellspacing="0" cellpadding="0" class="DSPFListTable" style="font-family: Arial; font-size: 10pt; width: 100%; text-align: left; color: rgb(0, 0, 0); border-spacing: 0;">


  <tr>

    <td style="width: 22.35pt; vertical-align: top; color: rgb(101, 102, 106); font-family: Arial; font-size: 9pt;">(1)</td>

    <td style="width: auto; vertical-align: top; text-align: left;">
                  <div style="color: rgb(101, 102, 106); font-family: Arial; font-size: 9pt;">Award types are as follows:</div>
