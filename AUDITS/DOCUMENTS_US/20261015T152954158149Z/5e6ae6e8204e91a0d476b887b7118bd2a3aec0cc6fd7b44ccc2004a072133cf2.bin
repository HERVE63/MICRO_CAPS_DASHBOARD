    <td style="border-bottom: Black 1pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td id="xdx_982_eus-gaap--DeferredTaxLiabilitiesOther_iNI_pn3n3_di_c20241231_fKGEp_zlkZqgmAwGI9" title="Total deferred tax Liabilities, other" style="border-bottom: Black 1pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction name="us-gaap:DeferredTaxLiabilitiesOther" contextRef="AsOf2024-12-31" id="Fact002049" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">46</ix:nonFraction></span></td><td style="padding-bottom: 1pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td></tr>
