  <div class="main-content-container" style="z-index:5;position:relative;"><div><ix:continuation id="F_513ac9af-2b34-4e8a-bab3-3c9e846f3a8c_5"><div style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_915e237d-86e4-4cb3-bc3d-bcaa22105d15" contextRef="C_a7ab1d31-d56f-471e-bc51-10fabe5b4b70" name="us-gaap:FairValueByBalanceSheetGroupingTextBlock" escape="true" continuedAt="F_915e237d-86e4-4cb3-bc3d-bcaa22105d15_1"><p style="font-size:10pt;margin-top:10pt;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">The estimated net fair value and related carrying or notional amounts, as well as the level within the fair value hierarchy, of the Company&#8217;s financial instruments as of </span><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">June 30, 2026 and December 31, 2025 were as follows:</span></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
