-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_5e1628a1-46fb-4bbe-ba19-5d03f92fc877" contextRef="C_a7ab1d31-d56f-471e-bc51-10fabe5b4b70" name="fusb:ScheduleOfDerivativeInstrumentsEffectOnStatementOfOperationsTableTextBlock" escape="true" continuedAt="F_5e1628a1-46fb-4bbe-ba19-5d03f92fc877_1"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">The effects, which include the reclassification of unrealized gains on terminated swap contracts, are presented as either an increase or decrease to income before income taxes in the relevant caption of the Company&#8217;s interim condensed consolidated statements of operations.</span></ix:nonNumeric></span></p><div style="font-size:10pt;font-family:Times New Roman;"><ix:continuation id="F_5e1628a1-46fb-4bbe-ba19-5d03f92fc877_1"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
