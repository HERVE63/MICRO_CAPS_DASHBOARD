if';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;background:#cceeff;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr><tr style=""><td style="vertical-align:bottom;width:66.38%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">Expected volatility</p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.57%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_A26hpODeBE-Yzjl8TVC2YQ" contextRef="Duration_7_1_2025_To_6_30_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_mxJ2wjXaxkiJ1sxZQ9HT4w" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedVolatilityRate" scale="-2" id="Tc_jZCf2h40i0CfcI-MzOXHhA_7_2">44.4</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:3.43%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">%&#160;&#160;</p></td><td style="vertical-align:bottom;white-space:nowrap;width:11.89%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:right;margin:0pt 3pt 0.05pt 0pt;"> <ix:nonFraction unitRef="Unit_Standard_pure_A26hpODeBE-Yzjl8TVC2YQ" contextRef="Duration_7_1_2024_To_6_30_2025_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_yCqMx94IvEaoqVbDNTXgVA" decimals="3" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardFairValueAssumptionsExpectedVolatilityRate" scale="-2" id="Tc_g1m036E0qECPMDps19n3AQ_7_4">46.3</ix:nonFraction></p></td><td style="vertical-align:bottom;white-space:nowrap;width:2.16%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;">%</p></td><td style="vertical-align:bottom;white-space:nowrap;width:1.63%;margin:0pt;padding:0pt;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 0.05pt 0pt;"><span style="visibility:hidden;">&#8203;</span></p></td></tr></table></ix:nonNumeric><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:0pt;margin:0pt;"><span style="margin-bottom:10pt;visibility:hidden;">&#8203;</span></p></ix:nonNumeric></div><div style="clear:both;margin-bottom:30pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:center;margin:24pt 0pt 0pt 0pt;">52</p></div></div>
<div style="background-color:#000000;clear:both;height:2pt;page-break-after:always;width:79.3%;border:0;margin:30pt 10.35% 30pt 10.35%;"></div><div style="max-width:100%;padding-left:10.35%;padding-right:10.35%;position:relative;"><div style="margin-top:21.6pt;min-height:41.75pt;width:100%;"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;margin:0pt 0pt 30pt 0pt;"><a href="#TOC"><span style="font-style:normal;font-weight:normal;">Table of Contents</span></a></p></div><div style="clear:both;max-width:100%;position:relative;"><a id="_309b0cad_a9be_410b_98dd_c163e923868f"></a><a id="Tc_aHfnb11ZXUO_yAqUdoUf9Q_1_1"></a><a id="Tc_coWBOdA-90Sz3zc3UdAiNQ_1_5"></a><a id="Tc_9JpkOLvQ6E-4AilHyx2H6g_2_1"></a><a id="Tc_kUwR13C67UOBgbkTUsYAAA_2_3"></a><a id="Tc_hTWCA_8bF0mLJT0x9wY4tA_2_5"></a><a id="Tc_FBcJNARoFESgx7LGpd3KWw_2_7"></a><a id="Tc_RSdy3d8pFk2ATusJnj1AuA_3_1"></a><a id="Tc_YxsGmKGd7Eu2RBbZIt6SpA_3_3"></a><a id="Tc_tyWJIDFRpkuXbt-MpbTnHA_3_5"></a><a id="Tc_PqguVX-sGku7Yh_niT4Bhw_3_7"></a><a id="Tc_hnMjMdT0I0Cq-eONKiQ2YQ_4_0"></a><a id="Tc_EPCtY-eS4UG04CeZ-HuMfg_4_1"></a><a id="Tc_C5ucefOpl0KTRF2y9e34eQ_4_5"></a><a id="Tc_bxxLACOPhUekyiKuNzkeww_5_1"></a><a id="Tc_L6zjyJ4vIEqhbJk8WImNHQ_5_5"></a><a id="Tc_QYnJ3nSL_keqvGdVqdh2Jg_6_1"></a><a id="Tc_FPK-1KKm9k6XC6vvC8pk8w_6_5"></a><a id="Tc_TfliGrmTq0K92bckvCO7xw_7_1"></a><ix:continuation id="Tb_IvynlxcQeEeefsGTcyrX_A_cont1" continuedAt="Tb_IvynlxcQeEeefsGTcyrX_A_cont2"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 10pt 0pt;">The weighted average remaining contractual life of all options outstanding as of June 30, 2026 was <ix:nonNumeric contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" format="ixt-sec:duryear" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardOptionsOutstandingWeightedAverageRemainingContractualTerm2" id="Narr_DaGWgUfm7Eq7Qz28mJvTbw">4.86</ix:nonNumeric>&#160;years. The remaining contractual life for options vested and exercisable at June 30, 2026 was <ix:nonNumeric contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" format="ixt-sec:duryear" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardOptionsExercisableWeightedAverageRemainingContractualTerm1" id="Narr_8-7nUtxmV0OTtqkYwVCVDg">4.16</ix:nonNumeric> years. Furthermore, the aggregate intrinsic value of options outstanding as of June 30, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="As_Of_6_30_2026_lGfTMIk8U02KeD9zfct_bg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingIntrinsicValue" scale="0" id="Narr_FEwW5uSlrEmRNaDHKDXkDg">743,304</ix:nonFraction>, and the aggregate intrinsic value of options vested and exercisable as of June 30, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="As_Of_6_30_2026_lGfTMIk8U02KeD9zfct_bg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardOptionsExercisableIntrinsicValue1" scale="0" id="Narr_CUPRWUxz3kOd1rbCtUJpUg">743,304</ix:nonFraction>, in each case based on the fair value of the Company&#8217;s common stock on June 30, 2026. The aggregate intrinsic value of options outstanding as of June 30, 2025 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="As_Of_6_30_2025_WjgvnHt0q0K__9ck3rxJew" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingIntrinsicValue" scale="0" id="Narr_MqBdhtn2zk2-75LGYhzlCg">2,265,673</ix:nonFraction>, and the aggregate intrinsic value of options vested and exercisable as of June 30, 2025 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="As_Of_6_30_2025_WjgvnHt0q0K__9ck3rxJew" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:SharebasedCompensationArrangementBySharebasedPaymentAwardOptionsExercisableIntrinsicValue1" scale="0" id="Narr_D6JvHFm8L0yg3Kqn54rNzw">2,229,827</ix:nonFraction>, in each case based on the fair value of the Company&#8217;s common stock on June 30, 2025.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 10pt 0pt;">During the&#160;year ended June 30, 2026, the Company granted <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="0" id="Narr_PqFfN4YZMkuf1R5MExwmWA">260,000</ix:nonFraction> options to directors with a fair value of $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" decimals="0" format="ixt:num-dot-decimal" name="rsss:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantedInPeriodFairValue" scale="0" id="Narr_e_OFdgaYeUeMkg_ddvbe-g">382,200</ix:nonFraction> which will be amortized over the vesting period. The total stock options expense during the&#160;year ended June 30, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2025_To_6_30_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_mxJ2wjXaxkiJ1sxZQ9HT4w" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="0" id="Narr_aQqg313ezUmfro843jqBIw">330,374</ix:nonFraction> and was included in selling, general and administrative expenses in the accompanying consolidated statement of operations and comprehensive income. As of June 30, 2026, the amount of unvested compensation related to the unvested options was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="As_Of_6_30_2026_lGfTMIk8U02KeD9zfct_bg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedStockOptions" scale="0" id="Narr_uhepa7O2I0uasR41c6rOvA">466,689</ix:nonFraction> which will be recorded as an expense in future weighted average vesting periods of <ix:nonNumeric contextRef="Duration_7_1_2025_To_6_30_2026_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_mxJ2wjXaxkiJ1sxZQ9HT4w" format="ixt-sec:duryear" name="us-gaap:EmployeeServiceShareBasedCompensationNonvestedAwardsTotalCompensationCostNotYetRecognizedPeriodForRecognition1" id="Narr_nCKOb_ssY0-F4cWpcl8tUQ">1.03</ix:nonNumeric> years. During the year ended June 30, 2026, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2025_To_6_30_2026_us-gaap_StatementEquityComponentsAxis_us-gaap_CommonStockMember_K2ng-WyTIUyqKzTsqv2Z2g" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="0" id="Narr_WZkrOErwOkqH0e09cSx7Uw">250,624</ix:nonFraction> net shares of common stock upon the exercise of options underlying <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="0" id="Narr_dsodlg_b_kuQKtJ6PoZmnQ">278,500</ix:nonFraction> shares of common stock, resulting in net cash proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromStockOptionsExercised" scale="0" id="Narr_Rt2oppes40Sb7n58-_WS7w">157,500</ix:nonFraction>. The aggregate intrinsic value of options exercised during the year ended June 30, 2026 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisesInPeriodTotalIntrinsicValue" scale="0" id="Narr_ysYlu-DEhUGrcIRpqXiPVQ">573,770</ix:nonFraction>.</p><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt 0pt 10pt 0pt;">During the&#160;year ended June 30, 2025, the Company granted <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2024_To_6_30_2025_FKyOfCPQK0m44cvkPkH5TQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantsInPeriodGross" scale="0" id="Narr_70sgZ15htkuI8Zgt-rBWQg">260,000</ix:nonFraction> options to directors with a fair value of $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2024_To_6_30_2025_FKyOfCPQK0m44cvkPkH5TQ" decimals="0" format="ixt:num-dot-decimal" name="rsss:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsGrantedInPeriodFairValue" scale="0" id="Narr_KssdRvrZoUydGIkU2yw3lw">364,000</ix:nonFraction> which will be amortized over the vesting period. The total stock options expense during the&#160;year ended June 30, 2025 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2024_To_6_30_2025_us-gaap_AwardTypeAxis_us-gaap_EmployeeStockOptionMember_yCqMx94IvEaoqVbDNTXgVA" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:AllocatedShareBasedCompensationExpense" scale="0" id="Narr_MTEh-0f4YE23eg0NlWKUcQ">205,457</ix:nonFraction> and was included in selling, general and administrative expenses in the accompanying consolidated statement of operations and comprehensive income. During the year ended June 30, 2025, the Company issued <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2024_To_6_30_2025_us-gaap_StatementEquityComponentsAxis_us-gaap_CommonStockMember_bl5-X9wfvkq4S15r88HyuQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="0" id="Narr_qkFA_aLizk2XkHEvTMcY-A">223,534</ix:nonFraction> net shares of common stock upon the exercise of options underlying <ix:nonFraction unitRef="Unit_Standard_shares_di-FZ6GKZE-ANlWE4HUrvQ" contextRef="Duration_7_1_2024_To_6_30_2025_FKyOfCPQK0m44cvkPkH5TQ" decimals="INF" format="ixt:num-dot-decimal" name="us-gaap:StockIssuedDuringPeriodSharesStockOptionsExercised" scale="0" id="Narr_5TJdcAXLcUSFnHYQQlQSsQ">309,821</ix:nonFraction> shares of common stock, resulting in net cash proceeds of $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2024_To_6_30_2025_FKyOfCPQK0m44cvkPkH5TQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ProceedsFromStockOptionsExercised" scale="0" id="Narr_sJX0OaEnlkCfyOBBXmsCjw">180,800</ix:nonFraction>. The aggregate intrinsic value of options exercised during the year ended June 30, 2025 was $<ix:nonFraction unitRef="Unit_Standard_USD_dWw5jbCz-0q4_XMGyHpImQ" contextRef="Duration_7_1_2024_To_6_30_2025_FKyOfCPQK0m44cvkPkH5TQ" decimals="0" format="ixt:num-dot-decimal" name="us-gaap:ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExercisesInPeriodTotalIntrinsicValue" scale="0" id="Narr_oJmF2gTpNUaDnlmPfb4ZTg">471,452</ix:nonFraction>.</p><ix:nonNumeric contextRef="Duration_7_1_2025_To_6_30_2026_TTMuJ8akHEyNSbvl-jNDpg" name="us-gaap:ScheduleOfShareBasedCompensationSharesAuthorizedUnderStockOptionPlansByExercisePriceRangeTextBlock" id="Tb_CMA8TuHGek-aJwaAgthAQg" escape="true"><p style="font-family:'Times New Roman','Times','serif';font-size:10pt;text-align:justify;text-indent:36pt;margin:0pt;">Additional information regarding stock options outstanding and exercisable as of June 30, 2026 is as follows:</p><p style="font