<td style="vertical-align:middle;background-color:#000000"> <p style="font-size:4pt; margin-top:0pt; margin-bottom:0pt">&#160;</p> <p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt; font-family:ARIAL;text-align:justify"><span style="color:#FFFFFF"><span style="font-weight:bold">&#8194;B&#8194;</span></span></p> <p style="font-size:4pt; margin-top:0pt; margin-bottom:1pt;text-align:left">&#160;</p></td>
