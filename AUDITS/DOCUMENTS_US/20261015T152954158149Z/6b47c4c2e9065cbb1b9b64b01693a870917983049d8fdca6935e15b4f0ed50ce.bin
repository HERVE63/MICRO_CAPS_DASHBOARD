<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:top" colspan="3"><span style="font-weight:bold">THIS PROXY IS SOLICITED ON BEHALF OF THE BOARD OF DIRECTORS</span></td>
<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:top"/>
<td style="vertical-align:bottom">&#160;</td>
<td style="vertical-align:top"/></tr>
