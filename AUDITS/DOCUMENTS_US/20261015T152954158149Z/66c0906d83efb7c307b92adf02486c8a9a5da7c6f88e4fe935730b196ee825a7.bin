          </tr>
          <tr style="height:10pt;background-color:#cff0fc;white-space:pre-wrap;word-break:break-word;">
           <td style="padding-top:0in;padding-left:0in;vertical-align:top;padding-bottom:0in;padding-right:0in;text-align:left;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">Laboratory equipment</span></p></td>
