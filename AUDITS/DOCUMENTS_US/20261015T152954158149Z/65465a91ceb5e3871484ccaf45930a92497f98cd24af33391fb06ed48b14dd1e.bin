    <td style="font: 10pt Times New Roman, Times, Serif; vertical-align: top; text-underline-color: black; text-align: justify"><span style="font-family: Times New Roman, Times, Serif; font-size: 10pt"><span style="text-decoration: underline">investors@netsoltech.com</span></span></td></tr>
