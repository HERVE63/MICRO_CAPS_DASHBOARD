e #000000;border-top:0.75pt solid #000000;padding:2.62pt 0 1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-1" decimals="-3" name="us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax" format="ixt:num-dot-decimal" scale="3" id="f-797">69,199</ix:nonFraction>&#160;</span></td><td style="background-color:#ffffff;border-bottom:3pt double #000000;border-top:0.75pt solid #000000;padding:2.62pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="background-color:#ffffff;padding:0 1pt"/><td style="background-color:#ffffff;border-bottom:3pt double #000000;border-top:0.75pt solid #000000;padding:2.62pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">$</span></td><td style="background-color:#ffffff;border-bottom:3pt double #000000;border-top:0.75pt solid #000000;padding:2.62pt 0 1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"><ix:nonFraction unitRef="usd" contextRef="c-7" decimals="-3" name="us-gaap:RevenueFromContractWithCustomerIncludingAssessedTax" format="ixt:num-dot-decimal" scale="3" id="f-798">54,767</ix:nonFraction>&#160;</span></td><td style="background-color:#ffffff;border-bottom:3pt double #000000;border-top:0.75pt solid #000000;padding:2.62pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/></tr></table></div></ix:continuation><div style="margin-bottom:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%;text-decoration:underline">Major Customers</span></div><div style="margin-bottom:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">During the three and six months ended June&#160;30, 2026, one customer (&#8220;Customer A&#8221;) exceeded 10% of our consolidated revenue.  Customer A accounted for <ix:nonFraction unitRef="number" contextRef="c-218" decimals="2" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" id="f-799">24</ix:nonFraction>% and <ix:nonFraction unitRef="number" contextRef="c-219" decimals="2" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" id="f-800">19</ix:nonFraction>% of our consolidated revenue for the three and six months ended June&#160;30, 2026, respectively.  During the three and six months ended June&#160;30, 2025, one customer (&#8220;Customer B&#8221;) exceeded 10% of our consolidated revenue.  Customer B accounted for <ix:nonFraction unitRef="number" contextRef="c-220" decimals="2" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" id="f-801">11</ix:nonFraction>% and <ix:nonFraction unitRef="number" contextRef="c-221" decimals="2" name="us-gaap:ConcentrationRiskPercentage1" scale="-2" id="f-802">12</ix:nonFraction>% of our consolidated revenue for the three and six months ended June&#160;30, 2025, respectively.  These revenues in the periods presented were generated by our Electronic Test segment.</span></div></ix:continuation><div style="height:45pt;position:relative;width:100%"><div style="bottom:0;position:absolute;width:100%"><div style="margin-bottom:12pt;text-align:center"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">- 25 -</span></div></div></div><hr style="page-break-after:always"/><div style="min-height:72pt;width:100%"><div><span style="color:#0000ff;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%;text-decoration:underline"><a style="color:#0000ff;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%;text-decoration:underline" href="#i7a70f8f40b8c49a8b80536f6955ee71b_7">Table of Contents</a></span></div><div style="text-align:center"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">InTest CORPORATION</span></div><div style="text-align:center"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS (continued)</span></div><div style="margin-bottom:10pt;text-align:center"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">(Unaudited)</span></div></div><ix:continuation id="f-721-3"><div style="margin-bottom:10pt;margin-top:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%;text-decoration:underline">Contract Liabilities</span></div><div style="margin-bottom:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">As of June&#160;30, 2026, and December&#160;31, 2025, we had total contract liabilities of $<ix:nonFraction unitRef="usd" contextRef="c-3" decimals="-5" name="us-gaap:ContractWithCustomerLiability" scale="6" id="f-803">5.9</ix:nonFraction> million and $<ix:nonFraction unitRef="usd" contextRef="c-4" decimals="-5" name="us-gaap:ContractWithCustomerLiability" scale="6" id="f-804">7.4</ix:nonFraction> million, respectively.  Our contract liabilities consist of our customer deposits and deferred revenue as well as deferred revenue net of current portion on our Consolidated Balance Sheets.  For the three months ended June&#160;30, 2026, the amount recognized as revenue from the contract liabilities balance as of March 31, 2026, was $<ix:nonFraction unitRef="usd" contextRef="c-5" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" scale="6" id="f-805">2.9</ix:nonFraction> million, while for the three months ended June&#160;30, 2025, the amount recognized as revenue from the contract liabilities balance as of March 31, 2025, was $<ix:nonFraction unitRef="usd" contextRef="c-6" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" scale="6" id="f-806">2.4</ix:nonFraction> million.  For the six months ended June&#160;30, 2026, the amount recognized as revenue from the contract liabilities balance as of December 31, 2025, was $<ix:nonFraction unitRef="usd" contextRef="c-1" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" scale="6" id="f-807">4.3</ix:nonFraction> million, while for the six months ended June&#160;30, 2025, the amount recognized as revenue from the contract liabilities balance as of December 31, 2024, was $<ix:nonFraction unitRef="usd" contextRef="c-7" decimals="-5" name="us-gaap:ContractWithCustomerLiabilityRevenueRecognized" scale="6" id="f-808">3.1</ix:nonFraction> million.  </span></div><div style="margin-bottom:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%;text-decoration:underline">Allowance for Credit Losses</span></div><ix:nonNumeric contextRef="c-1" name="us-gaap:ScheduleOfAccountsNotesLoansAndFinancingReceivableTextBlock" id="f-809" escape="true"><div style="margin-bottom:10pt"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Activity related to our allowance for credit losses was as follows:</span></div><div style="margin-bottom:12pt;text-align:center"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:48.693%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.351%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:10.900%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.351%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:10.900%"/><td style="width:0.1%"/><td style="width:0.1%"/><td style="width:0.