0pt; text-align:right; ">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:30.75pt; text-align:right; white-space:nowrap;"><ix:nonFraction contextRef="c16" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" unitRef="usd" id="ixv-10656">3,884,200</ix:nonFraction></td> <td style="padding:0pt;padding-left:0pt;width:0pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt;padding-left:2.995pt;width:0pt;">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:33pt; text-align:right; white-space:nowrap;">(<ix:nonFraction contextRef="c17" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" sign="-" unitRef="usd" id="ixv-10657">1,605,551</ix:nonFraction><span style="position:absolute;">)</span></td> <td style="padding:0pt;padding-left:2.995pt;width:0pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt;padding-left:4.165pt;width:0pt;">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:27pt; text-align:right; white-space:nowrap;">(<ix:nonFraction contextRef="c18" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" sign="-" unitRef="usd" id="ixv-10658">298,100</ix:nonFraction><span style="position:absolute;">)</span></td> <td style="padding:0pt;padding-left:4.165pt;width:0pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt;padding-left:19.25pt;width:0pt;">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:7.5pt; text-align:right; white-space:nowrap;"><span style="-sec-ix-hidden: hidden-fact-9">&#8212;</span></td> <td style="padding:0pt;padding-left:19.25pt;width:0pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt; width:6pt;">&#8203;</td> <td style="padding:0pt;padding-left:0.330000000000002pt;width:0pt;">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:0pt; text-align:right; ">&#8203;</td> <td style="padding:3.25pt 0pt 2.167pt 0pt; min-width:30.75pt; text-align:right; white-space:nowrap;"><ix:nonFraction contextRef="c14" decimals="0" format="ixt:num-dot-decimal" name="ecd:AdjToCompAmt" scale="0" unitRef="usd" id="ixv-10659">1,980,549</ix:nonFraction></td> <td style="padding:0pt;padding-left:0.330000000000002pt;width:0pt;">&#8203;</td> <td style="padding:0pt; width:0pt;">&#8203;</td> </tr> </table></ix:continuation></ix:continuation>
