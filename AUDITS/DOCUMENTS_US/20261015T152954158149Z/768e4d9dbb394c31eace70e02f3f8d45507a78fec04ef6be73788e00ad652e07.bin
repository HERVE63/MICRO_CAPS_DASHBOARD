an="3" style="border-top:2pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;font-family:'Poppins',sans-serif;font-size:8.5pt;font-weight:700;line-height:130%">Key Skills &amp; Experience</span></td><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/><td colspan="3" style="border-top:2pt solid #8e7630;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:8.5pt;font-weight:400;line-height:130%">Public Company Director (Other than DMC)</span></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g18.jpg" alt="02_PRO014677_Check_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-33"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;&#160;&#160;</span></div></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g19.jpg" alt="02_PRO014677_Key Skills_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-34"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%"> </span></div></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g18.jpg" alt="02_PRO014677_Check_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-35"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;&#160;&#160;</span></div></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g18.jpg" alt="02_PRO014677_Check_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-36"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;&#160;&#160;</span></div></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g18.jpg" alt="02_PRO014677_Check_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-37"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;&#160;&#160;</span></div></td><td colspan="3" style="background-color:#e7e7e8;border-top:0.5pt solid #8e7630;padding:2px 1pt;text-align:left;vertical-align:middle"><div style="margin-top:4pt;text-align:center"><img src="boom-20260330_g18.jpg" alt="02_PRO014677_Check_gray.jpg" style="height:22px;margin-bottom:5pt;vertical-align:text-bottom;width:22px" id="i-38"/><span style="color:#000000;font-family:'Poppins Light',sans-serif;font-size:1pt;font-weight:400;line-height:120%">&#160;&#160;&#160;</span></div></td></tr><tr><td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:middle"><span style="color:#000000;fon