			<p style="font-family: Arial, Helvetica, sans-serif; font-size: 8pt; font-variant: normal; text-align: center; margin: 0pt;"><span style="color:#00a64d;"><b>DECEMBER 31, 2024</b></span></p>
			</td>
			<td style="font-family: Arial, Helvetica, sans-serif; font-size: 8pt; width: 1%; border-bottom: 2px solid rgb(0, 166, 77);">&#160;</td>
			<td style="font-family: Arial, Helvetica, sans-serif; font-size: 8pt; width: 1%; border-bottom: 2px solid rgb(0, 166, 77);">&#160;</td>
			<td style="text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; margin-left: 0pt; width: 25%; border-bottom: 2px solid rgb(0, 166, 77);">
			<p style="font-family: Arial, Helvetica, sans-serif; font-size: 8pt; font-variant: normal; text-align: center; margin: 0pt;"><span style="color:#00a64d;"><b>YEAR ENDED </b></span></p>

			<p style="font-family: Arial, Helvetica, sans-serif; font-size: 8pt; font-variant: normal; text-align: center; margin: 0pt;"><span style="color:#00a64d;"><b>DECEMBER 31, 2025</b></span></p>
			</td>
