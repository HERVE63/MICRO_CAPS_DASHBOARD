			<p style="font-family: Calibri, Arial, sans-serif; font-size: 11pt; font-variant: normal; margin: 0pt 0pt 0pt 12pt; text-indent: -12pt;"><a href="#prop1" style="-sec-extract:exhibit;"><b>PROPOSAL 1: </b>Election of Directors</a></p>
			</td>
			<td style="vertical-align: bottom; width: 9%; font-family: Calibri, Arial, sans-serif; font-size: 11pt;">
			<p style="font-family: Calibri, Arial, sans-serif; font-size: 11pt; font-variant: normal; text-align: center; margin: 0pt; text-indent: -5pt;"><b><a class="tocPGNUM" href="#prop1">4</a></b></p>
			</td>
		</tr>
