			<p style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt; font-variant: normal; margin: 0pt 0pt 0pt 27pt; text-align: left;">1.2 Purpose</p>
			</td>
			<td style="vertical-align: top; width: 10%; text-align: right; font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color: rgb(255, 0, 0); font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color:#ff0000;"><span style="text-decoration: line-through; ">6</span></span><span style="text-decoration: underline; ">5</span></span></td>
		</tr>
		<tr style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt;">
			<td style="vertical-align: top; width: 90%; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">&#160;</td>
			<td style="vertical-align: top; width: 10%; text-align: right; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">&#160;</td>
		</tr>
		<tr style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt;">
			<td style="vertical-align: top; width: 90%; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">
			<p style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt; font-variant: normal; margin: 0pt 0pt 0pt 27pt; text-align: left;"><span style="color: rgb(255, 0, 0); font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color:#ff0000;"><span style="text-decoration: line-through; ">1.3 Prior Plan</span></span></span></p>
			</td>
			<td style="vertical-align: top; width: 10%; text-align: right; font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="text-decoration: line-through; color:#ff0000;">6</span></td>
		</tr>
		<tr style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt;">
			<td style="vertical-align: top; width: 90%; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">&#160;</td>
			<td style="vertical-align: top; width: 10%; text-align: right; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">&#160;</td>
		</tr>
		<tr style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt;">
			<td style="vertical-align: top; width: 90%; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">
			<p style="font-family: &quot;Calibri&quot;, Arial, sans-serif; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: left;">ARTICLE 2. DEFINITIONS</p>
			</td>
			<td style="vertical-align: top; width: 10%; text-align: right; font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color: rgb(255, 0, 0); font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color:#ff0000;"><span style="text-decoration: line-through; ">6</span></span><span style="text-decoration: underline; ">5</span></span></td>
		</tr>
