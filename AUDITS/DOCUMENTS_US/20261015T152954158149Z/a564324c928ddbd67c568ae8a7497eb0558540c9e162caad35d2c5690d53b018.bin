			<td style="width: 27pt; font-family: Calibri, Arial, sans-serif; font-size: 10pt;">
			<p style="margin: 0pt; text-align: left; font-family: Calibri, Arial, sans-serif; font-size: 10pt;"><span style="color: rgb(0, 166, 77); font-family: Calibri, Arial, sans-serif; font-size: 10pt;">&#8226;</span></p>
			</td>
