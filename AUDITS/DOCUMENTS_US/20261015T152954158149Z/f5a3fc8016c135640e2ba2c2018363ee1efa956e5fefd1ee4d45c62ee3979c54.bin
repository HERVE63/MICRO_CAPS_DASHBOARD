  <div class="main-content-container" style="z-index:5;position:relative;"><p style="tab-size:26.66px;font-size:1pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><img src="img122965679_6.jpg" alt="img122965679_6.jpg" style="width:677px;height:814px;"/><span style="color:#ffffff;white-space:pre-wrap;font-size:1pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">Company Logo OUTDOOR HOLDING COMPANY 7681 E G</span></p><p style="tab-size:26.66px;font-size:1pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-size:1pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">RAY RD. SCOTTSDALE, AZ 85260 SCAN TO OUTDOO</span></p><p style="tab-size:26.66px;font-size:1pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-size:1pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">60 SCAN TO VIEW MATERIALS &amp; VOTE VOTE BY INTERN</span></p><p style="tab-size:26.66px;font-size:1pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#ffffff;white-space:pre-wrap;font-size:1pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;"> Barcode above Use</span></p></div>
  <div style="z-index:2;flex-direction:column;display:flex;padding-bottom:0.5in;min-height:0.5in;justify-content:flex-end;position:relative;box-sizing:border-box;"><p style="tab-size:26.66px;font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;margin-left:0;margin-right:0;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p></div>
