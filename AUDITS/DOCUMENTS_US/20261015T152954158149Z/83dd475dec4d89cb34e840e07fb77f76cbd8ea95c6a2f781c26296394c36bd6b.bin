    <td style="font: 10pt Times New Roman, Times, Serif; text-align: left">$</td><td style="font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="us-gaap:NetCashProvidedByUsedInOperatingActivities" contextRef="From2023-12-312024-12-28" id="Fact003669" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,777</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td></tr>
