    <td style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl3664">&#8212;</span></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1pt; text-align: left">&#160;</td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1pt">&#160;</td>
    <td style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: left">&#160;</td><td style="border-bottom: Black 1pt solid; font: 10pt Times New Roman, Times, Serif; text-align: right"><ix:nonFraction name="ALTS:IncreaseDecreaseInDigitalAssetsPayable" contextRef="From2023-12-312024-12-28" id="Fact003665" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">14,155</ix:nonFraction></td><td style="font: 10pt Times New Roman, Times, Serif; padding-bottom: 1pt; text-align: left">&#160;</td></tr>
