    <td style="padding-left: 10pt; font-style: italic; text-align: left">No liabilities measured at fair value on a recurring basis</td><td>&#160;</td>
    <td style="text-align: left">&#160;</td><td style="text-align: right"><span style="-sec-ix-hidden: xdx2ixbrl1530">&#8212;</span></td><td style="text-align: left">&#160;</td><td>&#160;</td>
