  <ix:nonNumeric contextRef="d_2025-12-29_2026-06-28" name="us-gaap:DisclosureOfCompensationRelatedCostsShareBasedPaymentsTextBlock" id="c3258335" escape="true">
   <p style="font-family: Times New Roman; font-size: 10pt; margin: 0pt;"><b>Note <em style="font: inherit;">11</em> &#8212; Stock-Based Compensation</b></p>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 10pt; margin: 0pt;">&#160;</p>
   <p style="font-family: Times New Roman; font-size: 10pt; margin: 0pt; text-indent: 53pt; background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0);">Stock-based compensation expense included in the Company's unaudited condensed consolidated financial statements for the&#160;<em style="font: inherit;">three</em> and <em style="font: inherit;">six</em> months ended <em style="font: inherit;"> June 28, 2026 </em>and <em style="font: inherit;"> June 29, 2025</em> was as follows (in thousands):</p>
   <p style="font-family: Times New Roman; font-size: 10pt; margin: 0pt; text-indent: 53pt; background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0);">&#160;</p>
   <ix:nonNumeric contextRef="d_2025-12-29_2026-06-28" name="us-gaap:ScheduleOfEmployeeServiceShareBasedCompensationAllocationOfRecognizedPeriodCostsTextBlock" id="c3258336" escape="true">
