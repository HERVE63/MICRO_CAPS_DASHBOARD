			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">$162,000</p>
			</td>
			<td style="border-top: 1px solid rgb(0, 0, 0); border-bottom: 1px solid rgb(0, 0, 0); border-left: 1px solid rgb(0, 0, 0); border-image: initial; vertical-align: middle; width: 7.9%;">
			<p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;">$&#160; &#160; &#8213;</p>
			</td>
