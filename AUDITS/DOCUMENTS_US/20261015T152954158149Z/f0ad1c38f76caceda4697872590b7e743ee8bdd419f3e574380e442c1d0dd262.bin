      </span></div>
</ix:continuation>
      <div>
        <ix:nonNumeric name="us-gaap:PriorPeriodReclassificationAdjustmentDescription" id="Text_19930240490149e39b22093c23ab9cb1" contextRef="c20250101to20251231" escape="true" continuedAt="Text_ad6f10ba9f5241aeacd2052f5e808fcb1"><ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d20" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d21">
<div style="color: #000000; font-family: 'Times New Roman'; font-size: 10pt; font-style: italic; font-variant: normal; font-weight: normal; text-align: justify; text-transform: none;">Reclassifications</div>
</ix:continuation></ix:nonNumeric>
        <ix:continuation id="Text_ad6f10ba9f5241aeacd2052f5e808fcb1" continuedAt="Text_ad6f10ba9f5241aeacd2052f5e808fcb2"><ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d21" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d22">
<div style="font-family: 'Times New Roman'; background-color: rgb(255, 255, 255); font-weight: normal; color: rgb(0, 0, 0); font-size: 10pt; font-style: normal; font-variant: normal; text-transform: none;"><span style="font-family: 'Times New Roman'; font-size: 10pt;"><br/>
          </span> </div>
</ix:continuation></ix:continuation>
        <ix:continuation id="Text_ad6f10ba9f5241aeacd2052f5e808fcb2"><ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d22" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d23">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt; background-color: rgb(255, 255, 255); font-weight: normal; color: rgb(0, 0, 0); font-style: normal; font-variant: normal; text-transform: none;"><span style="display: inline; float: none; letter-spacing: normal; white-space: normal; word-spacing: 0px; color: #000000; font-family: 'Times New Roman'; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: justify; text-indent: 0px; text-transform: none;">Certain prior period amounts have been reclassified to conform with current presentation. The Company reclassified $<ix:nonFraction name="us-gaap:InterestExpenseNonoperating" id="Fact_6b3fa711010a4ec79021679b21e215a0" contextRef="c20230101to20231231_IncomeStatementLocationAxis_OtherNonoperatingIncomeExpenseMember_ReclassificationTypeAxis_ReclassificationOtherMember" unitRef="U001" decimals="-5" scale="6" sign="-" format="ixt:num-dot-decimal">25.6</ix:nonFraction>
            million of <span style="-sec-ix-hidden:Fact_1f77e5191e4a4359b20de10f03cf7239">interest expense</span> from other income (expense), net to the interest expense line on the consolidated statement of income
            for the fiscal year 2023. The reclassification had no impact on net income for fiscal year 2023.</span></div>
</ix:continuation></ix:continuation>
        <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d23" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d24">
<div style="text-align: left; font-family: 'Times New Roman'; font-size: 10pt; background-color: rgb(255, 255, 255); font-weight: normal; color: rgb(0, 0, 0); font-style: normal; font-variant: normal; text-transform: none;"> <span style="font-family: 'Times New Roman'; font-size: 10pt;"><br/>
          </span> </div>
</ix:continuation>
      </div>

    </div>

