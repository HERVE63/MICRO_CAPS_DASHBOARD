    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97110" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97111">
<div><br/>
    </div>
</ix:continuation>
    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97111" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97112">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">For the years ended December 31, 2025, 2024 and 2023, other stock options totaling <ix:nonFraction name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" id="Fact_220e2821a1044e3db172ac9c4ae8621d" contextRef="c20250101to20251231_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_EmployeeStockOptionMember" unitRef="U002" decimals="-5" scale="6" format="ixt:num-dot-decimal">1.6</ix:nonFraction> million, <ix:nonFraction name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" id="Fact_b8fadc074a8c442ebcbd85fbbe7c98b2" contextRef="c20240101to20241231_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_EmployeeStockOptionMember" unitRef="U002" decimals="-5" scale="6" format="ixt:num-dot-decimal">1.5</ix:nonFraction> million and <ix:nonFraction name="us-gaap:AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareAmount" id="Fact_92c00a3e42724bf3928cbfbe49f8a7d2" contextRef="c20230101to20231231_AntidilutiveSecuritiesExcludedFromComputationOfEarningsPerShareByAntidilutiveSecuritiesAxis_EmployeeStockOptionMember" unitRef="U002" decimals="-5" scale="6" format="ixt:num-dot-decimal">1.8</ix:nonFraction> million, respectively, were excluded from the calculation of diluted earnings per share because they were anti-dilutive.</div>
</ix:continuation>
    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97112" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97113">
<div><span style="font-family: 'Times New Roman';"> </span></div>
</ix:continuation>
