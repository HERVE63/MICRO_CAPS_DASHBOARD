  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d24" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d25"><ix:nonNumeric name="us-gaap:CashAndCashEquivalentsPolicyTextBlock" id="Text_4dc95efbaedb4354bdb539dad45bd37a" contextRef="c20250101to20251231" escape="true" continuedAt="Text_f2155f1e105449299a002f10571fcc221">
