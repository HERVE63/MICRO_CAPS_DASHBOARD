    <ix:nonNumeric name="us-gaap:TradeAndOtherAccountsReceivablePolicy" id="Text_89f02fb500fc4ddda7f03b7be3bc5260" contextRef="c20250101to20251231" escape="true" continuedAt="Text_f9102c1eda86452bb30c4f39c155730e1"><ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d33" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d34">
