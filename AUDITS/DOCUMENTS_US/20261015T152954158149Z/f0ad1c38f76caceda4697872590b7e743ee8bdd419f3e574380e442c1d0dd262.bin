    <div style="text-align: left; font-family: 'Times New Roman'; font-size: 10pt; font-weight: bold;">NU SKIN ENTERPRISES, INC.</div>

    <div>
      <div style="text-align: left; text-indent: -36pt; margin-left: 36pt; font-family: 'Times New Roman'; font-size: 10pt;"><a id="NotestoConsolidatedFinanc"><!--Anchor--></a><!--Anchor--><!--Anchor-->Notes to Consolidated Financial Statements</div>

