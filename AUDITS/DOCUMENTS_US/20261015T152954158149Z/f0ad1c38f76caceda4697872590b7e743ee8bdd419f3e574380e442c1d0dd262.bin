      </span> </div>
</ix:continuation>
    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97114" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97115">
<div><span style="font-family: 'Times New Roman';"> </span></div>
</ix:continuation>
    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97115" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97116">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt; font-style: italic;">Dividends</div>
</ix:continuation>
    <div><ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97116" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97117">
<div><br/></div>
</ix:continuation>
      <div style="text-align: justify; color: rgb(0, 0, 0); font-family: 'Times New Roman'; font-size: 10pt; background-color: rgb(255, 255, 255); font-weight: normal; font-style: normal; font-variant: normal; text-transform: none;">
        <div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">
          <div>
            <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97117" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97118">
<div style="text-align: justify; font-family: 'Times New Roman', Times, serif; font-size: 10pt;">Quarterly cash dividends for the years ended December 31, 2025, 2024, and 2023 totaled $<ix:nonFraction name="us-gaap:PaymentsOfDividendsCommonStock" id="Fact_52bd847166464d1888b30273955b5a73" contextRef="c20250101to20251231" unitRef="U001" decimals="-5" scale="6" format="ixt:num-dot-decimal">11.8</ix:nonFraction> million, $<ix:nonFraction name="us-gaap:PaymentsOfDividendsCommonStock" id="Fact_b16e0ee05ec14e8cad4b0d97094e6166" contextRef="c20240101to20241231" unitRef="U001" decimals="-5" scale="6" format="ixt:num-dot-decimal">11.9</ix:nonFraction> million, and $<ix:nonFraction name="us-gaap:PaymentsOfDividendsCommonStock" id="Fact_e13b38db1baa4a81a39de3e2568489df" contextRef="c20230101to20231231" unitRef="U001" decimals="-5" scale="6" format="ixt:num-dot-decimal">77.6</ix:nonFraction> million or $<ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_d289ab428d20427f9f268e8aec5488e1" contextRef="c20240701to20240930_DividendsAxis_O2024Q3DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_c6ece11b03c340d096b403edaf603c9a" contextRef="c20250401to20250630_DividendsAxis_O2025Q2DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_c63f70243fda49b281fb0ef8b9784652" contextRef="c20251001to20251231_DividendsAxis_O2025Q4DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_b904c07b2c394f8d8164ca642db95854" contextRef="c20241001to20241231_DividendsAxis_O2024Q4DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_883f5227c97544cfbf1291b0cfb08d87" contextRef="c20240101to20240331_DividendsAxis_O2024Q1DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_5e1e8b30cb9b4fe983d169b6a4c72fda" contextRef="c20250701to20250930_DividendsAxis_O2025Q3DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_562dfaae27754efe88d75bbd7335f6bc" contextRef="c20250101to20250331_DividendsAxis_O2025Q1DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_0871ee416d0342c68ff22c0a645a17d2" contextRef="c20240401to20240630_DividendsAxis_O2024Q2DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal">0.06</ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction> per share
              in all quarters of 2025 and 2024 and $<ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_bee199ff356b4cb7bb3c562681536115" contextRef="c20230701to20230930_DividendsAxis_O2023Q3DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_40ece2cb03f24571aa5a57deec389257" contextRef="c20230401to20230630_DividendsAxis_O2023Q2DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_1ee70246404a408088ad33736f33bfcc" contextRef="c20230101to20230331_DividendsAxis_O2023Q1DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal"><ix:nonFraction name="us-gaap:CommonStockDividendsPerShareCashPaid" id="Fact_0cd52b438ac5481b8f13f6b25a2d31bd" contextRef="c20231001to20231231_DividendsAxis_O2023Q4DividendsMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal">0.39</ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction> for all quarters of 2023. <span style="font-size: 10pt; font-family: 'Times New Roman', Times, serif;">T</span>he board of directors has declared a quarterly cash dividend of $<ix:nonFraction name="us-gaap:CommonStockDividendsPerShareDeclared" id="Fact_5122df0b291d418fa4fe25b9af496961" contextRef="c20260101to20260212_DividendsAxis_O2026Q1DividendsMember_SubsequentEventTypeAxis_SubsequentEventMember" unitRef="U003" decimals="2" scale="0" format="ixt:num-dot-decimal">0.06</ix:nonFraction><span style="font-size: 10pt; font-family: 'Times New Roman', Times, serif;"> </span>per share of Class A common stock to be paid on <ix:nonNumeric name="us-gaap:DividendPayableDateToBePaidDayMonthAndYear" id="Fact_e7d19111cdc84ec183fc4aa4fc4d7540" contextRef="c20260101to20260212_DividendsAxis_O2026Q1DividendsMember_SubsequentEventTypeAxis_SubsequentEventMember" format="ixt:date-monthname-day-year-en">March 11, 2026</ix:nonNumeric> to
              stockholders of record on <ix:nonNumeric name="us-gaap:DividendsPayableDateOfRecordDayMonthAndYear" id="Fact_71e3092461cd4e9da961542c47c157fe" contextRef="c20260101to20260212_DividendsAxis_O2026Q1DividendsMember_SubsequentEventTypeAxis_SubsequentEventMember" format="ixt:date-monthname-day-year-en">February 27, 2026</ix:nonNumeric>.</div>
</ix:continuation>
          </div>

        </div>

        <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e97118" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e97119">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;"> <br/>
        </div>
</ix:continuation>
