                <div style="text-align: justify; color: rgb(0, 0, 0);">One global team</div>
              </td>

  </tr>

  <tr>

    <td colspan="1" style="width: 5%; vertical-align: top;">&#160;</td>

    <td style="width: 3%; vertical-align: top;">
                <div style="text-align: justify; color: rgb(0, 0, 0);">&#9679;</div>
              </td>

    <td style="width: 52%; vertical-align: top;">
                <div style="text-align: justify; color: rgb(0, 0, 0);">Customer obsessed</div>
              </td>

