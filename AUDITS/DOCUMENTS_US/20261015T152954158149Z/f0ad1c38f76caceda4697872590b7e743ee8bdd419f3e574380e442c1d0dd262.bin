</ix:continuation>
    <ix:continuation id="Text_0bae08990b134fcab88e7e0375b11be436" continuedAt="Text_0bae08990b134fcab88e7e0375b11be437">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">The Company is subject to regular audits by federal, state and foreign tax authorities. These audits may result in proposed assessments that may result in additional tax
      liabilities.</div>
</ix:continuation>
    <ix:continuation id="Text_0bae08990b134fcab88e7e0375b11be437" continuedAt="Text_0bae08990b134fcab88e7e0375b11be438">
<div><br/>
    </div>
</ix:continuation>

