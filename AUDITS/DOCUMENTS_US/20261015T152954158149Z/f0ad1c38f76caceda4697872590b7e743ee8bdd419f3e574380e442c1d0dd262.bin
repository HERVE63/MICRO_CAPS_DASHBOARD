            <div style="text-align: center; font-family: 'Times New Roman'; font-size: 10pt;"><ix:nonNumeric name="dei:SecurityExchangeName" id="Fact_23d87af09800482fbd7b5e05441bb189" contextRef="c20250101to20251231" format="ixt-sec:exchnameen">New York Stock Exchange</ix:nonNumeric></div>
