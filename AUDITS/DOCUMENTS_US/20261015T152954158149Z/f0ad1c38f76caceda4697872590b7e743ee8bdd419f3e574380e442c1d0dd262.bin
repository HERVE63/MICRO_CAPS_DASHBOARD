<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt; font-style: italic;">Inventories</div>
</ix:continuation></ix:continuation>
  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d44" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d45"><ix:continuation id="Text_1df2c16d73e24c0287c0602494ee25f22" continuedAt="Text_1df2c16d73e24c0287c0602494ee25f23">
