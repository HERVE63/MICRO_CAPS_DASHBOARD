    <ix:nonNumeric name="nus:ScheduleOfActualIncomeTaxesPaidTableTextBlock" id="Text_12d9fa00c9334c9982a05badb9be5d7d" contextRef="c20250101to20251231" escape="true" continuedAt="Text_34378ddb1e194c469c604ccdea13af751"><ix:continuation id="Text_0bae08990b134fcab88e7e0375b11be449" continuedAt="Text_0bae08990b134fcab88e7e0375b11be450">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">The actual taxes paid for the year ended December 31, 2025 was as follows:</div>
</ix:continuation></ix:nonNumeric>
    <ix:continuation id="Text_34378ddb1e194c469c604ccdea13af751" continuedAt="Text_34378ddb1e194c469c604ccdea13af752"><ix:continuation id="Text_0bae08990b134fcab88e7e0375b11be450" continuedAt="Text_0bae08990b134fcab88e7e0375b11be451">
