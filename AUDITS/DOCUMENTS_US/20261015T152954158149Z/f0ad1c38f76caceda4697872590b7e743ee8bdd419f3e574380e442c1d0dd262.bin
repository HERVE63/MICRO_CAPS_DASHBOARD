<div>
        <table cellspacing="0" cellpadding="0" class="DSPFListTable" style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; width: 100%; text-align: left; color: #000000; border-spacing: 0;">


  <tr>

    <td style="width: 18pt; vertical-align: top; font-family: 'Times New Roman',Times,serif; font-size: 10pt;">(1)</td>

    <td style="width: auto; vertical-align: top; text-align: justify;">
                <div style="font-family: 'Times New Roman', Times, serif; font-size: 10pt;"><ix:footnote id="Foot_9de0201034f849fdb10a859e7e1300fa" footnoteRole="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">State and Local taxes in California and New Jersey made up
                  the majority (greater than 50 percent) of the tax effect in this category.</ix:footnote></div>
