  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d197" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d198"><ix:continuation id="Text_889b5834ddfc48758b0e6a90a85ae0bb22" continuedAt="Text_889b5834ddfc48758b0e6a90a85ae0bb23">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">Please refer to Note 16 - Segment Information for revenue by segment and product line.</div>
</ix:continuation></ix:continuation>
  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d198" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d199"><ix:continuation id="Text_889b5834ddfc48758b0e6a90a85ae0bb23" continuedAt="Text_889b5834ddfc48758b0e6a90a85ae0bb24">
<div><span style="font-family: 'Times New Roman'; font-size: 10pt;"> </span></div>
</ix:continuation></ix:continuation>
  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d199" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d200"><ix:continuation id="Text_889b5834ddfc48758b0e6a90a85ae0bb24" continuedAt="Text_889b5834ddfc48758b0e6a90a85ae0bb25">
