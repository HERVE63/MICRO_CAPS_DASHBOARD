    <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d66" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d67"><ix:continuation id="Text_1df2c16d73e24c0287c0602494ee25f224"><ix:continuation id="Text_1a704ebcd7aa45d492d8866ed9c1b2ad8">
<table cellspacing="0" cellpadding="0" style="font-family: 'Times New Roman'; font-size: 10pt; width: 100%; text-align: left; color: rgb(0, 0, 0); border-spacing: 0;" class="DSPFListTable">


  <tr>

    <td style="width: 18pt; vertical-align: top; text-align: right; font-family: 'Times New Roman';">
            <div style="text-align: left; font-size: 10pt; font-weight: normal; color: rgb(0, 0, 0); font-style: normal; font-variant: normal; text-transform: none; font-family: 'Times New Roman';">(1)</div>
          </td>

    <td style="width: auto; vertical-align: top; font-family: 'Times New Roman'; text-align: justify;">
            <div style="text-align: justify;"><span style="font-family: 'Times New Roman'; font-size: 10pt;"><ix:footnote id="Foot_b00c41ee74ba4d5b8a095e3c48d82ead" footnoteRole="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US"><span style="color: rgb(0, 0, 0); font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; text-indent: 0px; text-transform: none; word-spacing: 0px; white-space: normal; text-decoration-style: initial; text-decoration-color: initial; display: inline ! important; float: none;">During the fourth quarter of 2024, the Company </span>further executed on its product portfolio optimization initiative<span style="color: rgb(0, 0, 0); font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; text-indent: 0px; text-transform: none; word-spacing: 0px; white-space: normal; text-decoration-style: initial; text-decoration-color: initial; display: inline ! important; float: none;"> which
                  resulted in an incremental </span>inventory write-off charge of<span style="color: rgb(0, 0, 0); font-style: normal; font-variant: normal; font-weight: normal; letter-spacing: normal; text-indent: 0px; text-transform: none; word-spacing: 0px; white-space: normal; text-decoration-style: initial; text-decoration-color: initial; display: inline ! important; float: none;"> $<span style="text-indent: 0pt;"><ix:nonFraction name="us-gaap:ValuationAllowancesAndReservesChargedToCostAndExpense" id="Fact_409f5986bc23443190b3d22942c03744" contextRef="c20241001to20241231" unitRef="U001" decimals="-5" scale="6" format="ixt:num-dot-decimal">38.8</ix:nonFraction></span>
                  million to the inventory carrying value.</span><span style="font-weight: normal; color: rgb(0, 0, 0); font-style: normal; font-variant: normal; text-transform: none;"> During the third quarter of 2023, the Company made the strategic
                  decision to re-balance and narrow its product portfolio, which resulted in an incremental inventory write-off charge of $<ix:nonFraction name="us-gaap:ValuationAllowancesAndReservesChargedToCostAndExpense" id="Fact_38920cfb09fe4e2a87318c273989b05e" contextRef="c20230701to20230930" unitRef="U001" decimals="-5" scale="6" format="ixt:num-dot-decimal">65.7</ix:nonFraction>
                  million.</span></ix:footnote></span> </div>
          </td>

  </tr>


</table>
</ix:continuation></ix:continuation></ix:continuation>
  </div>

