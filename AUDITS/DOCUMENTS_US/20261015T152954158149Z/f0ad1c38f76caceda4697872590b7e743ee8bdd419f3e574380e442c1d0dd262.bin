    <ix:continuation id="Text_822fc62e885c49fea9346b0ffdc4e9712" continuedAt="Text_822fc62e885c49fea9346b0ffdc4e9713">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">The Company&#8217;s authorized capital stock consists of <ix:nonFraction name="us-gaap:PreferredStockSharesAuthorized" id="Fact_4f7a6cd076074efa9f2de763e9014e6a" contextRef="c20251231" unitRef="U002" decimals="-6" scale="6" format="ixt:num-dot-decimal">25</ix:nonFraction>
      million shares of preferred stock, par value $<ix:nonFraction name="us-gaap:PreferredStockParOrStatedValuePerShare" id="Fact_415d6d32285940759de3500422f2f7c1" contextRef="c20251231" unitRef="U003" decimals="3" scale="0" format="ixt:num-dot-decimal">0.001</ix:nonFraction> per share, <ix:nonFraction name="us-gaap:CommonStockSharesAuthorized" id="Fact_8fed9629f8be4155a21d2f34dab38ece" contextRef="c20251231_StatementClassOfStockAxis_CommonClassAMember" unitRef="U002" decimals="-6" scale="6" format="ixt:num-dot-decimal">500</ix:nonFraction> million shares of Class A common stock, par value $<ix:nonFraction name="us-gaap:CommonStockParOrStatedValuePerShare" id="Fact_2dd9c014b76a401bb1dfd9cfb596c294" contextRef="c20251231_StatementClassOfStockAxis_CommonClassAMember" unitRef="U003" decimals="3" scale="0" format="ixt:num-dot-decimal">0.001</ix:nonFraction> per share, <span style="font-size: 10pt;">and </span><ix:nonFraction name="us-gaap:CommonStockSharesAuthorized" id="Fact_3d7e5a2e2fa546d3a0af98c0d3638f81" contextRef="c20251231_StatementClassOfStockAxis_CommonClassBMember" unitRef="U002" decimals="-6" scale="6" format="ixt:num-dot-decimal">100</ix:nonFraction><span style="font-size: 10pt;"> million shares of Class B common stock, par value $</span><ix:nonFraction name="us-gaap:CommonStockParOrStatedValuePerShare" id="Fact_1706db89d5404aeabd9097444cbceb63" contextRef="c20251231_StatementClassOfStockAxis_CommonClassBMember" unitRef="U003" decimals="3" scale="0" format="ixt:num-dot-decimal">0.001</ix:nonFraction><span style="font-size: 10pt;"> per share</span>. As of December 31, 2025 and 2024, there were <ix:nonFraction name="us-gaap:PreferredStockSharesOutstanding" id="Fact_f107938a6f3e4a3d86c7927ef0e3d385" contextRef="c20251231" unitRef="U002" decimals="INF" scale="0" format="ixt-sec:numwordsen"><ix:nonFraction name="us-gaap:SharesOutstanding" id="Fact_550cb0e6bd6e4269a89b7c7538184aeb" contextRef="c20251231_StatementClassOfStockAxis_CommonClassBMember" unitRef="U002" decimals="INF" scale="0" format="ixt-sec:numwordsen"><ix:nonFraction name="us-gaap:PreferredStockSharesOutstanding" id="Fact_1bf8ee3d0ff24976a3d801535e650cd9" contextRef="c20241231" unitRef="U002" decimals="INF" scale="0" format="ixt-sec:numwordsen"><ix:nonFraction name="us-gaap:SharesOutstanding" id="Fact_08619c4cfc8b446a9d5b41615c120964" contextRef="c20241231_StatementClassOfStockAxis_CommonClassBMember" unitRef="U002" decimals="INF" scale="0" format="ixt-sec:numwordsen">no</ix:nonFraction></ix:nonFraction></ix:nonFraction></ix:nonFraction> preferred or Class B common shares outstanding. <span style="font-size: 10pt;">Each share of Class A common stock entitles the holder to </span><ix:nonFraction name="nus:CommonStockNumberOfVotesPerShare" id="Fact_99865efa476f4c109680e60d93a92475" contextRef="c20250101to20251231_StatementClassOfStockAxis_CommonClassAMember" unitRef="U007" decimals="INF" scale="0" format="ixt-sec:numwordsen">one</ix:nonFraction><span style="font-size: 10pt;"> vote on matters submitted to a vote of the Company&#8217;s stockholders. Stock dividends of Class A common stock may be paid
        only to holders of Class A common stock. Class A common stock has no conversion rights.</span></div>
</ix:continuation>
