  <ix:continuation id="Text_7891bca57bc341d48970d3bc2cba0c6d9" continuedAt="Text_7891bca57bc341d48970d3bc2cba0c6d10"><ix:continuation id="Text_034686559fb64f7e81ab6b274869ac2f5">
<div style="text-align: justify; font-family: 'Times New Roman'; font-size: 10pt;">The consolidated financial statements include the accounts of the Company and the Subsidiaries. All intercompany accounts and transactions are eliminated in consolidation.</div>
</ix:continuation></ix:continuation>
