gn:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">&#8226;&#8195;&#8202;Cash Severance ($)</span></td><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="2" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">575,000&#160;</span></td><td style="background-color:#bfe4ff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;border-right:1pt solid #000;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000;padding:2px 1pt 2px 10pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">&#8226;&#8195;&#8202;Non-Equity&#160;Incentive Awards ($)</span></td><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="2" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">&#8212;&#160;</span></td><td style="background-color:#bfe4ff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;border-right:1pt solid #000;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000;padding:2px 1pt 2px 10pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">&#8226;&#8195;&#8202;Extra Severance Amount ($)</span></td><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="2" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">325,000&#160;</span></td><td style="background-color:#bfe4ff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;border-right:1pt solid #000;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000;padding:2px 1pt 2px 10pt;text-align:left;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">&#8226;&#8195;&#8202;Equity Incentive Awards ($)</span></td><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="2" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"><span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">460,668&#160;</span></td><td style="background-color:#bfe4ff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;padding:0 1pt"/><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000000;border-right:1pt solid #000;padding:0 1pt"/></tr><tr><td colspan="3" style="background-color:#bfe4ff;border-left:1pt solid #000;padding:2px 1pt 2px 10pt;text-align:left;vertical-align:bo