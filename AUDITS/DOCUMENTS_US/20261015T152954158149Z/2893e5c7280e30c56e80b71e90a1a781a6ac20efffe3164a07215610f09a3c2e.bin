n 0in 3px 0in;border-width: 0pt;white-space: nowrap;" valign="bottom">&#160;</td>	<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;padding-right:0pt;width: 12.26%; padding: 0in 0in 3px 0in;border-width: 0pt;" valign="bottom">	<p class="Tbody_rightalign" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:3pt;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:right;text-indent:0;widows:1;margin-right:0pt;"><ix:nonFraction contextRef="c4" decimals="-3" format="ixt:num-dot-decimal" name="us-gaap:NetIncomeLoss" scale="3" unitRef="usd" id="ixv-2367">18,523</ix:nonFraction></p>	</td>	<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;padding-right:0pt;width: 1.13%; padding: 0in 0in 3px 0in;border-width: 0pt;white-space: nowrap;" valign="bottom">&#160;</td>	<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;padding-right:0pt;width: 1.51%; padding: 0in 0in 3px 0in;border-width: 0pt;white-space: nowrap;" valign="bottom">	<p class="Tbody_rightalign" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:3pt;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:right;text-indent:0;widows:1;margin-right:0pt;text-align:left;">$</p>	</td>	<td class="TB" style="border-bottom-width:0pt;border-left-width:0pt;border-right-width:0pt;border-top-width:0pt;padding-bottom:3pt;padding-left:3pt;padding-right:3pt;padding-top:3pt;vertical-align:bottom;padding-left:0pt;padding-right:0pt;width: 6.98%; padding: 0in 0in 3px 0in;border-width: 0pt;" valign="bottom">	<p class="Tbody_rightalign" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:3pt;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:right;text-indent:0;widows:1;margin-right:0pt;"><ix:nonFraction contextRef="c4" decimals="2" format="ixt:num-dot-decimal" name="ecd:CoSelectedMeasureAmt" scale="0" unitRef="pure" id="ixv-2368">57.08</ix:nonFraction></p>	</td>	</tr>	</table></ix:continuation>
		<p class="Tablefootnotef" style="margin-top: 0in;  border: none; margin-right: 0in; margin-bottom: -5pt; margin-left: 24.0pt; text-align: justify; text-justify: inter-ideograph; text-indent: -24.0pt; padding: 0in; font-size: 9.0pt; font-family: TimesNewRomanPSStd-Regular; color: black;">____________</p><ix:continuation continuedAt="_PvpTableTextBlock-c0_cont_4" id="_PvpTableTextBlock-c0_cont_3"><p class="Tablefootnote_f" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:9pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:24pt;margin-right:0;margin-top:10pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:10pt;">(1)<span style="width: 18px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;</span><ix:nonNumeric contextRef="c0" continuedAt="_NamedExecutiveOfficersFnTextBlock-c0_cont_1" escape="true" name="ecd:NamedExecutiveOfficersFnTextBlock" id="ixv-1978"><ix:footnote continuedAt="ix_0_footnote_cont_1" id="ix_0_footnote" xml:lang="en-US">For each of fiscal year 2022, 2023, 2024 and 2025, the PEO was <ix:nonNumeric contextRef="c3" name="ecd:PeoName" id="ixv-2369"><ix:nonNumeric contextRef="c2" name="ecd:PeoName" id="ixv-2370"><ix:nonNumeric contextRef="c1" name="ecd:PeoName" id="ixv-2371"><ix:nonNumeric contextRef="c0" name="ecd:PeoName" id="ixv-2372">David A.&#160;Lorber</ix:nonNumeric></ix:nonNumeric></ix:nonNumeric></ix:nonNumeric> and the non<span class="nobreak">-PEO</span> NEO was Ellida McMillan. On January&#160;1, 2021, the Company completed the Internalization, prior to which there was a different PEO and non<span class="nobreak">-PEO</span> NEO.&#160;Effective January&#160;1, 2021, Mr.&#160;Lorber became the PEO and Ms. McMillan became the non<span class="nobreak">-PEO</span> NEO and</ix:footnote></ix:nonNumeric></p></ix:continuation>
		</div>

		<p class="RRH" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:center;text-indent:0;widows:1;margin: 10px 0px 10px 0pt; page-break-after: always; border-bottom: 1px solid; margin-top: 10.0pt; margin-right: 0in; margin-bottom: 10.0pt; margin-left: 0in; text-align: center; font-size: 10.0pt; font-family: Times New Roman PS Std, serif; color: black;">21</p>



	<div class="Basic-Text-Frame" style="margin:0;padding:0;border-width:0;">
		<ix:continuation id="ix_0_footnote_cont_1"><ix:continuation continuedAt="_PvpTableTextBlock-c0_cont_5" id="_PvpTableTextBlock-c0_cont_4"><ix:continuation id="_NamedExecutiveOfficersFnTextBlock-c0_cont_1"><p class="Tablefootnote_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:9pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:24pt;margin-right:0;margin-top:0;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:0pt;">&#160;<span style="width: 27px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</span>the prior PEO and non<span class="nobreak">-PEO</span> NEO (concurrently with the Company commencing operations under an internalized management structure) ceased serving in such roles. The prior PEO and non<span class="nobreak">-PEO</span> NEO were not employees of the Company, and the Company did not directly compensate them.</p></ix:continuation></ix:continuation></ix:continuation>
		<ix:continuation continuedAt="_PvpTableTextBlock-c0_cont_6" id="_PvpTableTextBlock-c0_cont_5"><p class="Tablefootnote_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:9pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:24pt;margin-right:0;margin-top:0;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:0pt;">(2)<span style="width: 18px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;</span><ix:footnote id="ix_1_footnote" xml:lang="en-US">No adjustments are applicable pursuant to Item&#160;402(v)(2)(iii)&#160;of Regulation&#160;S<span class="nobreak">-K</span>.</ix:footnote></p></ix:continuation>
		<ix:continuation id="_PvpTableTextBlock-c0_cont_6"><p class="Tablefootnote_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:9pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:24pt;margin-right:0;margin-top:0;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:0pt;">(3)<span style="width: 18px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;</span><ix:footnote id="ix_2_footnote" xml:lang="en-US">The &#8220;peer group&#8221; for Total Shareholder Return (&#8220;TSR&#8221;) is the S&amp;P BDC Index.</ix:footnote></p></ix:continuation>
		<p class="Text_ind" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:24pt;widows:3;margin-top:8pt;">The executive compensation actually paid by the Company to the PEO during the five<span class="nobreak">-year</span> period from October&#160;1, 2020 to September&#160;30, 2025 increased from $774,223.85 to $2,607,492.00, or 236.8%. The executive compensation actually paid by the Company to the non<span class="nobreak">-PEO</span> NEO during the five<span class="nobreak">-year</span> period from October&#160;1, 2020 to September&#160;30, 2025 increased from $472,307.69 to $1,245,039.00, or 163.6%. For the same period, cumulative total shareholder return of the Company was 3.05%, compared with the cumulative total shareholder return of the S&amp;P BDC Index of 0.34%. For the same period, net investment income decreased from $18,522,719 to $5,140,321, or 72.2%, and net asset value per share increased from $57.08 to $80.24, or 40.6%.</p>
		<p class="Text_ind" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:24pt;widows:3;margin-top:8pt;">Restrictions imposed by the 1940 Act restrict the Compensation Committee&#8217;s ability to use nondiscretionary or formulaic Company performance goals or criteria to determine executive incentive compensation. The Compensation Committee instead considers several financial performance metrics, along with other factors including operational goals and individual performance criteria, in determining the appropriate compensation for the NEOs. Subject to the restrictions imposed by the 1940 Act, in the Company&#8217;s assessment, the following list of performance measures represent the most important performance measures used to link compensation actually paid to our NEOs, for the most recently completed fiscal year, to Company performance:</p>
		<p class="BL_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;list-style-position:outside;list-style-type:disc;margin-bottom:0;margin-left:48pt;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:8pt;"><span class="bullet" style="font-size:10pt;">&#8226;<span style="width: 27px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</span></span>Net asset value per share</p>
		<p class="BL_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;list-style-position:outside;list-style-type:disc;margin-bottom:0;margin-left:48pt;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;margin-top:8pt;"><span class="bullet" style="font-size:10pt;">&#8226;<span style="width: 27px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</span></span>Net asset value</p>
		<p class="BL_m" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;list-style-position:outside;list-style-type:disc;margin-bottom:0;margin-left:48pt;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:-24pt;widows:3;list-style-type:none;margin-top:8pt;"><span class="bullet" style="font-size:10pt;">&#8226;<span style="width: 27px;display: inline-block;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;</span></span>Net investment income per share</p>
		</div>

		<p class="LRH" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:0;orphans:1;page-break-after:auto;page-break-before:auto;text-align:center;text-indent:0;widows:1;margin: 10px 0px 10px 0pt; page-break-after: always; border-bottom: 1px solid; margin-top: 10.0pt; margin-right: 0in; margin-bottom: 10.0pt; margin-left: 0in; text-align: center; font-size: 10.0pt; font-family: Times New Roman PS Std, serif; color: black;">22</p>




	<div class="_idGenObjectStyleOverride-1" style="margin:0;padding:0;border-width:0;border-width:0pt;">
		<p class="H1" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:bold;margin-bottom:0;margin-left:0;margin-right:0;margin-top:12pt;orphans:1;page-break-after:avoid;page-break-before:auto;text-align:center;text-indent:0;widows:1;margin-top:12pt;"><span class="Bold" style="font-style:normal;font-weight:bold;">PROPOSAL&#160;II: </span></p>
		<p class="H1" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:bold;margin-bottom:0;margin-left:0;margin-right:0;margin-top:12pt;orphans:1;page-break-after:avoid;page-break-before:auto;text-align:center;text-indent:0;widows:1;margin-top:0pt;margin-top:0pt;"><span class="Bold" style="font-style:normal;font-weight:bold;">RATIFICATION OF APPOINTMENT OF KPMG LLP AS&#160;OUR&#160;INDEPENDENT&#160;REGISTERED&#160;PUBLIC&#160;ACCOUNTING FIRM <br/>FOR THE 2026 FISCAL YEAR</span></p>
		<p class="H2" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:bold;margin-bottom:0;margin-left:0;margin-right:0;margin-top:12pt;orphans:99;page-break-after:avoid;page-break-before:auto;text-align:justify;text-indent:0;widows:1;margin-top:12pt;"><span class="Bold" style="font-style:normal;font-weight:bold;">General Information</span></p>
		<p class="Text_ind" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:24pt;widows:3;margin-top:8pt;">The Audit Committee and the independent directors of the Board have appointed KPMG LLP as the Company&#8217;s independent registered public accounting firm for the fiscal year ending September&#160;30, 2026, and the Audit Committee has asked that this selection be ratified by our stockholders. While the Audit Committee is responsible for the appointment, compensation, retention, termination and oversight of the independent auditor, the Audit Committee is requesting, as a matter of good corporate governance, that the shareholders ratify the appointment of KPMG LLP as the independent registered public accounting firm. If the shareholders fail to ratify the selection, the Audit Committee will reconsider whether to retain KPMG LLP and may retain that firm or another without re<span class="nobreak">-submitting</span> the matter to our shareholders. Even if the appointment is ratified, the Audit Committee may, in its discretion, direct the appointment of a different independent registered public accounting firm at any time during the year.</p>
		<p class="Text_ind" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:24pt;widows:3;margin-top:8pt;">KPMG LLP has advised us that neither the firm nor any present member or associate of it has any material financial interest, direct or indirect, in the Company or its affiliates. It is expected that representatives of KPMG LLP will be present at the Annual Meeting and will have an opportunity to make a statement if they desire to do so and will be available to respond to appropriate questions.</p>
		<p class="H2" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:bold;margin-bottom:0;margin-left:0;margin-right:0;margin-top:12pt;orphans:99;page-break-after:avoid;page-break-before:auto;text-align:justify;text-indent:0;widows:1;margin-top:12pt;"><span class="Bold" style="font-style:normal;font-weight:bold;">Fees Paid to the Independent Registered Public Accounting Firm</span></p>
		<p class="Text_ind" style="margin:0;padding:0;border-width:0;font-family:Times New Roman PS Std, serif;font-size:10pt;font-style:normal;font-variant:normal;font-weight:normal;margin-bottom:0;margin-left:0;margin-right:0;margin-top:8pt;orphans:2;page-break-after:auto;page-break-before:auto;text-align:justify;text-indent:24pt;widows:3;margin-top:8pt;"><span class="Italic" style="font-style:italic;font-weight:normal;">The following table (in thousands) displays fees for professional services for the fiscal&#160;years ended September&#160;30, 2025 (paid to KPMG LLP) and September&#160;30, 2024 (paid to KPMG LLP and Ernst&#160;&amp; Young LLP, the Company&#8217;s prior independent auditor) (dollars in thousands):</span></p>
		<table class="No-Table-Style" style="width: 100.0%; border-collapse: collapse; border: 0px solid #000; border-width: 0pt; margin: 10pt 0 10pt 0;">


