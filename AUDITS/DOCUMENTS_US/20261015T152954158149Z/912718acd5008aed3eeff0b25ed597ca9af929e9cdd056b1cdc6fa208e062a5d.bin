  <tr style="vertical-align: bottom">
    <td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="padding-bottom: 1pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td colspan="2" id="xdx_490_20250401__us-gaap--BusinessAcquisitionAxis__custom--RevNuMember_z2FBucqwvae3" style="border-bottom: Black 1pt solid; text-align: center"><span style="font-family: Times New Roman, Times, Serif">($
    in thousands)</span></td><td style="padding-bottom: 1pt"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr id="xdx_40C_ecustom--BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedContractAsset_iI_pn3n3_maBCRIAzWkO_zqvmjLUUE0qd" style="vertical-align: bottom; background-color: rgb(204,238,255)">
    <td style="width: 80%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">Contract asset</span></td><td style="width: 2%"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="width: 16%; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="CCLD:BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedContractAsset" contextRef="AsOf2025-04-01_custom_RevNuMember" id="Fact001002" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">14</ix:nonFraction></span></td><td style="width: 1%; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
  <tr id="xdx_40D_ecustom--BusinessCombinationRecognizedIdentifiableAssetsAcquiredAndLiabilitiesAssumedCustomerRelationships_iI_pn3n3_maBCRIAzWkO_zwNHZYxfPQhd" style="vertical-align: bottom; background-color: White">
