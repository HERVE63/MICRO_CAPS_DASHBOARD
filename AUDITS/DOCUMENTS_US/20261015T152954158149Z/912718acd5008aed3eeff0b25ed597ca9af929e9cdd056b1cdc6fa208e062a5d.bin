    <td style="border-bottom: Black 1pt solid; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="border-bottom: Black 1pt solid; text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="CCLD:LesseeOperatingLeaseLiabilityPaymentsDueAfterYearFour" contextRef="AsOf2026-06-30" id="Fact001365" format="ixt:numdotdecimal" decimals="-3" scale="3" unitRef="USD">1,188</ix:nonFraction></span></td><td style="padding-bottom: 1pt; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
