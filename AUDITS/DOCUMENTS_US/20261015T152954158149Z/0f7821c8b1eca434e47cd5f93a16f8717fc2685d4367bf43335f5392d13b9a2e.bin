ic></span><span style="color:#000000;white-space:pre-wrap;font-size:8pt;font-family:Arial;font-kerning:none;min-width:fit-content;">.</span></ix:footnote><span style="white-space:pre-wrap;font-size:8pt;font-family:Arial;font-kerning:none;min-width:fit-content;"></span></div></div></ix:continuation></div></ix:nonNumeric></div></div>
