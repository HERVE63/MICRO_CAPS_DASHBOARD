         <td style="padding-top:0.01in;white-space:pre-wrap;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;text-align:left;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:center;"><span><ix:nonNumeric id="F_30260c77-45f3-4c22-9504-af94e8c61d4c" contextRef="C_a18d6412-c18f-4fc5-a205-43ebbea6a401" name="us-gaap:DividendsPayableDateOfRecordDayMonthAndYear" format="ixt:date-monthname-day-year-en"><span style="color:#000000;white-space:pre-wrap;font-kerning:none;min-width:fit-content;">July 20, 2026</span></ix:nonNumeric></span></p></td>
