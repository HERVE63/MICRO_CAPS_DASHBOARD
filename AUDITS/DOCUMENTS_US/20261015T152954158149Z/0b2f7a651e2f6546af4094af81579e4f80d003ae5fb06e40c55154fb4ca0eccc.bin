  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:TransfersAndServicingOfFinancialAssetsTextBlock" id="c3132828" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>Note <em style="font: inherit;">7</em>&#160;- Servicing Rights on Sold Loans</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">Mortgage loans serviced for FHLB, Fannie Mae, and Freddie Mac are <em style="font: inherit;">not</em> included in the accompanying consolidated balance sheets. Selected commercial loan balances&#160;have also been sold&#160;in whole or in part to various participants, including the Main Street Lending Program, with servicing retained by First Fed and are <em style="font: inherit;">not</em> included in the accompanying consolidated balance sheets.&#160;The unpaid principal balances of serviced loans, primarily mortgage loans, were&#160;$<ix:nonFraction id="c141864016" contextRef="i_2025-12-31" unitRef="USD" name="fnwb:ServicingAssetMortgageLoansServicedForThirdParties" scale="6" format="ixt:num-dot-decimal" decimals="-5">301.6</ix:nonFraction> million and&#160;$<ix:nonFraction id="c141864017" contextRef="i_2024-12-31" unitRef="USD" name="fnwb:ServicingAssetMortgageLoansServicedForThirdParties" scale="6" format="ixt:num-dot-decimal" decimals="-5">329.3</ix:nonFraction> million at <em style="font: inherit;"> December 31, 2025 </em>and <em style="font: inherit;">2024</em>, respectively.</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p>
   <ix:exclude>
