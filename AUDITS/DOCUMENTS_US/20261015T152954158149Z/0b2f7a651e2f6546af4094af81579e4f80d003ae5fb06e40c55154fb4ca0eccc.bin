   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><b><a id="toc" title="toc" href="#"></a>FIRST NORTHWEST BANCORP</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><b>2025&#160;ANNUAL REPORT ON FORM 10-K</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><b>TABLE OF CONTENTS</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">&#160;</p>
   <table border="0" cellpadding="0" cellspacing="0" style="width:100%;text-indent:0;font-family:'Times New Roman', Times, serif;font-size:10pt;">
    <tbody>
     <tr style="background-color: rgb(204, 238, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>Forward-Looking Statements</b></p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><a class="tocPGNUM" href="#fwd">5</a></p> </td>
     </tr>

     <tr style="background-color: rgb(255, 255, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>PART I</b></p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p> </td>
     </tr>

     <tr style="background-color: rgb(204, 238, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 0pt 9pt; text-align: left;"><b>Item 1. Business</b></p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><a class="tocPGNUM" href="#item1">6</a></p> </td>
     </tr>

     <tr style="background-color: rgb(255, 255, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 0pt 36pt; text-align: left;">General</p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><a class="tocPGNUM" href="#general">6</a></p> </td>
     </tr>

     <tr style="background-color: rgb(204, 238, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 0pt 36pt; text-align: left;">Market Area</p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><a class="tocPGNUM" href="#market">7</a></p> </td>
     </tr>

     <tr style="background-color: rgb(255, 255, 255);">
      <td style="vertical-align:bottom;width:93%;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt 0pt 0pt 36pt; text-align: left;">Lending Activities</p> </td>
      <td style="vertical-align:bottom;width:7%;"> <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><a class="tocPGNUM" href="#lending">8</a></p> </td>
     </tr>

     <tr style="background-color: rgb(204, 238, 255);">
