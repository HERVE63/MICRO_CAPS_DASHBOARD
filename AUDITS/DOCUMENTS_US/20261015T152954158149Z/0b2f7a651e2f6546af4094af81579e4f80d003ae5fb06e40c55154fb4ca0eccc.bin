   </ix:exclude>
   <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt; text-align: center;"><b></b></p><ix:exclude><p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin: 0pt; text-align: center;"><b>FIRST NORTHWEST BANCORP AND SUBSIDIARY</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">NOTES TO CONSOLIDATED FINANCIAL STATEMENTS</p></ix:exclude><p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">&#160;</p>
  </ix:nonNumeric>
  <div>
   &#160;
  </div>
  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:CondensedFinancialInformationOfParentCompanyOnlyDisclosureTextBlock" id="c3132884" escape="true">
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;"><b>Note <em style="font: inherit;">20</em>&#160;- Parent Company Only Financial Statements</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">Presented below are the condensed balance sheets, statements of operations, and statements of cash flows for First Northwest.</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:left;">&#160;</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;"><b>FIRST NORTHWEST BANCORP</b></p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">Condensed Balance Sheets</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">(dollars in thousands)</p>
   <p style="font-family:'Times New Roman', Times, serif;font-size:10pt;margin:0pt;text-align:center;">&#160;</p>
   <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="srt:ScheduleOfCondensedBalanceSheetTableTextBlock" id="c3132885" escape="true">
