   </ix:continuation>
   <p style="font-family: &quot;Times New Roman&quot;; font-size: 9pt; margin: 0pt; text-align: left;">(<em style="font: inherit;">1</em>) Term loans that are renewed or extended for periods longer than <em style="font: inherit;">90</em> days are presented as a new origination in the year of the most recent renewal or extension.</p>
   <ix:exclude>
    <div class="PGFTR" style="text-align: center; width: 100%">
     <div class="hf-row">
      <div class="hf-cell PGNUM" style="text-align: center; font-size: 10pt; font-family: Times New Roman;">
       <em style="font: inherit;">103</em>
      </div>
     </div>
    </div>
