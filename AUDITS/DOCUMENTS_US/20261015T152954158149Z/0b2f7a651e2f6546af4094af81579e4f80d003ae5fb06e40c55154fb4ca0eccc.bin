247" contextRef="i_2024-12-31" unitRef="USD" name="us-gaap:FinancingReceivableExcludingAccruedInterestNonaccrualNoAllowance" scale="3" format="ixt:num-dot-decimal" decimals="-3">27,545</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 3px; margin-left: 0pt;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">&#160;</td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);">$</td><td style="width: 9%; text-align: right; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"><ix:nonFraction id="c141861248" contextRef="i_2024-12-31" unitRef="USD" name="us-gaap:FinancingReceivableExcludingAccruedInterestNonaccrual" scale="3" format="ixt:num-dot-decimal" decimals="-3">30,515</ix:nonFraction></td><td style="width: 1%; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; padding-bottom: 3px; margin-left: 0pt;">&#160;</td></tr>
