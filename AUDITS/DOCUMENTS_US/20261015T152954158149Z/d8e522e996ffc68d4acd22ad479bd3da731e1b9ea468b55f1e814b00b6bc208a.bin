    <td style="text-align: left; padding-left: 0pt"><span style="font-family: Times New Roman, Times, Serif">Cash paid during the period
    for operating leases</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="INSE:CashPaidDuringPeriodForOperatingLeases" contextRef="From2026-01-01to2026-06-30" id="Fact000748" format="ixt:numdotdecimal" decimals="-5" scale="6" unitRef="USD">1.6</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="INSE:CashPaidDuringPeriodForOperatingLeases" contextRef="From2025-01-012025-06-30" id="Fact000749" format="ixt:numdotdecimal" decimals="-5" scale="6" unitRef="USD">4.3</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
