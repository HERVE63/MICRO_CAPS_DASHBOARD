    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif"><ix:nonFraction name="INSE:RightOfUsePropertyAndEquipmentAcquiredThroughFinanceLease" contextRef="From2025-01-012025-06-30" id="Fact000761" format="ixt:numdotdecimal" decimals="-5" scale="6" unitRef="USD">9.8</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td></tr>
