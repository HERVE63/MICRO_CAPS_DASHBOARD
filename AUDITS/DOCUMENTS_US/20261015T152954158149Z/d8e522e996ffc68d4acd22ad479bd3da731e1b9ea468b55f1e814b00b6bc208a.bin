    <td style="font-style: italic; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="font-style: italic; text-align: right"><span style="font-family: Times New Roman, Times, Serif">1.30</span></td><td style="font-style: italic; text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td><td><span style="font-family: Times New Roman, Times, Serif">&#160;</span></td>
