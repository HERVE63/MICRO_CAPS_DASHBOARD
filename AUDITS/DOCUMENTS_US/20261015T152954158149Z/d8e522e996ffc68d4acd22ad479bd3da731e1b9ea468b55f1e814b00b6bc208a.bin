    <td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">$</span></td><td style="text-align: right"><span style="font-family: Times New Roman, Times, Serif">(<ix:nonFraction name="us-gaap:RightOfUseAssetObtainedInExchangeForFinanceLeaseLiability" contextRef="From2025-01-012025-06-30" id="Fact000755" format="ixt:numdotdecimal" decimals="-5" scale="6" unitRef="USD">1.3</ix:nonFraction></span></td><td style="text-align: left"><span style="font-family: Times New Roman, Times, Serif">)</span></td></tr>
