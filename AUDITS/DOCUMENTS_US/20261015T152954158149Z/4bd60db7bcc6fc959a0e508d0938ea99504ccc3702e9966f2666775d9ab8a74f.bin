  <div class="main-content-container" style="z-index:5;position:relative;"><div><ix:continuation id="F_7acc8698-7163-40b6-b37d-d3517ae233f0_1" continuedAt="F_7acc8698-7163-40b6-b37d-d3517ae233f0_2"><div style="font-size:10pt;font-family:Times New Roman;"><ix:nonNumeric id="F_eacca247-da3f-45f3-8c8a-6b16895da2bd" contextRef="C_4523e5ce-4a22-4c65-b22c-c80416c4f40c" name="us-gaap:ScheduleOfShareBasedCompensationStockOptionsActivityTableTextBlock" escape="true"><p style="font-size:10pt;margin-top:10pt;font-family:Times New Roman;margin-bottom:0;text-align:justify;"><span style="color:#000000;white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">A summary of changes in options issued under the Company&#8217;s stock option plans follows:</span></p><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="white-space:pre-wrap;font-size:10pt;font-family:Times New Roman;font-kerning:none;min-width:fit-content;">&#160;</span></p>
