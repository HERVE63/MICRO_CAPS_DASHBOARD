    <td style="vertical-align: top; padding-right: 0.75pt">
    <p style="font: 9pt Times New Roman, Times, Serif; margin: 0; text-align: center">21,642</p>
    <p style="font: 9pt Times New Roman, Times, Serif; margin: 0; text-align: center">&#160;</p></td>
