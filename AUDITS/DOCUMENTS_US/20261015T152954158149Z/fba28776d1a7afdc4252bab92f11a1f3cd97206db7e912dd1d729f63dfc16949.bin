    <div class="PGHDR" style="width: 100%;">
     <div class="hf-row">
      <div class="hf-cell TOCLink" style="text-align: left; margin: 0pt; width: 99.9%; display: inline-block;">
       <a href="#toc" style="font-weight: initial; font-style: initial; font-variant: initial; font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt;">Table of Contents</a>
      </div>
     </div>
     <div class="hf-row">
      <div class="hf-cell" style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: center; font-weight: bold; margin: 0pt; width: 99.9%; display: inline-block;">
        AEMETIS, INC.
      </div>
     </div>
     <div class="hf-row">
      <div class="hf-cell" style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: center; font-weight: bold; margin: 0pt; width: 99.9%; display: inline-block;">
        NOTES TO THE CONSOLIDATED FINANCIAL STATEMENTS
      </div>
     </div>
     <div class="hf-row">
      <div class="hf-cell" style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: center; margin: 0pt; width: 99.9%; display: inline-block;">
        &#160;
      </div>
     </div>
     <div class="hf-row">
      <div class="hf-cell" style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; text-align: center; font-weight: bold; margin: 0pt; width: 99.9%; display: inline-block;">
        (Tabular data in thousands, except par value and per share data)
      </div>
