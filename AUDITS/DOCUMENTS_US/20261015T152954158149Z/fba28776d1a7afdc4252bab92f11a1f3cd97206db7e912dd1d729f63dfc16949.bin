  <ix:nonNumeric contextRef="d_2025-01-01_2025-12-31" name="us-gaap:BasisOfPresentationAndSignificantAccountingPoliciesTextBlock" id="c3134927" escape="true">
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;margin:0pt;"><b><em style="font: inherit;">1.</em> Nature of Activities and Summary of Significant Accounting Policies</b></p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#160;</p>
   <p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"><b><i>Nature of Activities</i>.</b> These consolidated financial statements include the accounts of Aemetis, Inc., a Delaware corporation, and its subsidiaries (collectively, &#8220;Aemetis&#8221; or the &#8220;Company&#8221;).&#160;</p>
   <p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;">&#160;</p>
   <table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;"><tbody><tr style="vertical-align: top;"><td style="width: 49px;">&#160;</td><td style="width: 47px;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;">&#9679;</p> </td><td style="width: auto; padding-bottom: 5px;"> <p style="font-family: 'Times New Roman', Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify;">Aemetis Americas, Inc., a Nevada corporation, and its subsidiary AE Biofuels, Inc., a Delaware corporation;</p> </td></tr>
<tr><td style="width: 49px;">&#160;</td><td style="width: 47px; vertical-align: top; font-size: 10pt;">&#9679;</td><td style="width: auto; padding-bottom: 5px; vertical-align: bottom; font-size: 10pt; text-align: justify;">Aemetis International, Inc., a Nevada corporation, and its subsidiary International Biofuels Ltd, a Mauritius corporation, and its&#160;subsidiary Universal Biofuels Private Limited, an India company;</td></tr>
<tr style="vertical-align: top;"><td style="width: 49px;">&#160;</td><td style="width: 47px; vertical-align: bottom;"> <p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;">&#9679;</p> </td><td style="width: auto; padding-bottom: 5px; vertical-align: bottom;"> <p style="font-family: &quot;Times New Roman&quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt; text-align: justify; line-height: 1;">Aemetis Technologies, Inc., a Delaware corporation;</p> </td></tr>
