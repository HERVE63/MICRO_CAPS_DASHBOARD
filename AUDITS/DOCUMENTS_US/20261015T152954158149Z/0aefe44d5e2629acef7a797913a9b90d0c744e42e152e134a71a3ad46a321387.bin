pt;position:var(--position);text-decoration:none;white-space:pre">COMPENSATION</span></div><div style="line-height:9pt;position:var(--position);top:15.26pt;width:81.75pt"><span style="color:#ffffff;font-family:'Arial', sans-serif;font-size:9pt;font-style:normal;font-weight:bold;left:4.07pt;position:var(--position);text-decoration:none;white-space:pre">OF EXECUTIVE </span></div><div style="line-height:9pt;position:var(--position);top:26.06pt;width:81.75pt"><span style="color:#ffffff;font-family:'Arial', sans-serif;font-size:9pt;font-style:normal;font-weight:bold;left:4.07pt;position:var(--position);text-decoration:none;white-space:pre">OFFICERS</span></div></div></div></td><td style="font-size:0;text-align:left;vertical-align:top"/><td style="font-size:0;text-align:left;vertical-align:top"><div style="left:295.5pt;position:var(--position);top:31.5pt;width:62.25pt"><div><div style="line-height:9pt;position:var(--position);top:4.46pt;width:62.25pt"><span style="color:#d6d7d8;font-family:'Arial', sans-serif;font-size:9pt;font-style:normal;font-weight:bold;left:4.07pt;position:var(--position);text-decoration:none;white-space:pre">AUDIT</span></div><div style="line-height:9pt;position:var(--position);top:15.26pt;width:62.25pt"><span style="color:#d6d7d8;font-family:'Arial', sans-serif;font-size:9pt;font-style:normal;font-weight:bold;left:4.07pt;position:var(--position);text-decoration:none;white-space:pre">COMMITTEE</span></div><div style="line-height:9pt;position:var(--position);top:26.06pt;width:62.25pt"><span style="color:#d6d7d8;font-family:'Arial', sans-serif;font-size:9pt;font-style:normal;font-weight:bold;left:4.07pt;position:var(--position);text-decoration:none;white-space:pre">MATTERS</span></div></div></div></td><td style="font-size:0;text-align:left;vertical-align:top"/><td style="font-size:0;text-align:left;vertical-align:top"><div style="left:363.75pt;position:var(--position);top:31.5pt;width:65.25pt"><div><div style="line-height:9pt;position:var(--position);