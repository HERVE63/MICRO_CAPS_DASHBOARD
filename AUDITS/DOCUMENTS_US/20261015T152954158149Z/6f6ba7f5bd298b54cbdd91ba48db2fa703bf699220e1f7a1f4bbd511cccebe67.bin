nt-size: 1pt;">&#8194;</div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 43.09pt; padding-top: 0.51pt; padding-bottom: 0.88pt; text-align: center; vertical-align: bottom; background-color: #CCEEFF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 2.8pt; text-align: left;">$<span style="padding-left: 5pt;">84,407</span></div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 37.5pt; padding-top: 0.51pt; padding-bottom: 0.88pt; text-align: center; vertical-align: bottom; background-color: #CCEEFF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 0pt; text-align: left;">$<span style="padding-left: 0.37pt;">119,700</span></div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 52.29pt; padding-top: 0.51pt; padding-bottom: 0.88pt; text-align: center; vertical-align: bottom; background-color: #CCEEFF; white-space: nowrap;"><div class="BRDSX_fpara" style="color: #000000; font-family: 'Times New Roman', Times, serif; font-size: 10pt; margin-top: 0pt; margin-left: 21.15pt; text-align: left;">&#8212;</div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 4.43pt; background-color: #CCEEFF;"><div style="font-size: 1pt;">&#8194;</div></td><td style="width: 49.32pt; padding-top: 0.51pt; padding-bottom: 0.88pt; text-align: center; vertical-align: bottom; background-