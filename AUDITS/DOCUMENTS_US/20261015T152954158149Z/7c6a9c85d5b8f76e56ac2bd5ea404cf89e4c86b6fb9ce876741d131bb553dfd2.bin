;font-weight:400;line-height:100%">Premiums</span></td><td style="padding:2.62pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:100%">$</span></td><td style="padding:2.62pt 0 1.5pt 0;text-align:right;vertical-align:bottom"><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-529" decimals="-3" name="us-gaap:PremiumsEarnedNet" format="ixt:num-dot-decimal" scale="3" id="f-1983">28,369</ix:nonFraction></span><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:100%">&#160;</span></td><td style="padding:2.62pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="padding:0 1pt"/><td colspan="2" style="padding:2.62pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-530" decimals="-3" name="us-gaap:PremiumsEarnedNet" format="ixt:num-dot-decimal" scale="3" id="f-1984">15,334</ix:nonFraction></span><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:100%">&#160;</span></td><td style="padding:2.62pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/><td colspan="3" style="padding:0 1pt"/><td colspan="2" style="padding:2.62pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:100%"><ix:nonFraction unitRef="usd" contextRef="c-531" decimals="-3" name="us-gaap:PremiumsEarnedNet" format="ixt:num-dot-decimal" scale="3" id="f-1985">43,703</ix:nonFraction></span><span style="color:#1207c9;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:100%">&#160;</span></td><td style="padding:2.62pt 1pt