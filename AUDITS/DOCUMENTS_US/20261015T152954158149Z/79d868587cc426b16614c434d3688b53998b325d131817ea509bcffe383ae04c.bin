e-height:120%">Chegg, Inc.</span></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:middle"><div style="text-align:center"><span style="color:#0f0f0f;font-family:'Aspira',sans-serif;font-size:9pt;font-weight:700;line-height:120%">64</span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:middle"><span style="color:#0f0f0f;font-family:'Aspira',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Proxy Statement for the 2026 Annual Meeting of Stockholders</span></td></tr></table></div></div></div><hr style="page-break-after:always"/><div style="min-height:36pt;width:100%"><div style="text-align:right"><span style="color:#0f0f0f;font-family:'Aspira',sans-serif;font-size:8pt;font-weight:700;line-height:120%">PAY VERSUS PERFORMANCE DISCLOSURE</span></div></div><div><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"><tr><td style="width:1.0%"/><td style="width:2.779%"/><td style="width:0.1%"/><td style="width:1.0%"/><td style="width:95.021%"/><td style="width:0.1%"/></tr><tr><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"><div style="margin-bottom:3pt"><span style="color:#0f0f0f;font-family:'Aspira',sans-serif;font-size:8pt;font-weight:400;line-height:120%">(2)</span></div></td><td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"><ix:nonNumeric contextRef="c-1" name="ecd:AdjToPeoCompFnTextBlock" id="f-32" continuedAt="f-32-1" escape="true"><div style="margin-bottom:3pt"><span style="color:#0f0f0f;font-family:'Aspira',sans-serif;font-size:8pt;font-weight:400;line-height:120%">To calculate CAP to the PEOs the following adjustments were made to SCT Total Compensation:</span></div></ix:nonNumeric></td></tr></table></div><ix:continuation id="f-32-1"><div style="margin-bottom:3pt;padding-left:21.6pt"><table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bott