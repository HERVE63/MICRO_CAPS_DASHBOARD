        <tr style="height:10pt;background-color:#ffffff;word-break:break-word;white-space:pre-wrap;text-align:left;">
         <td style="padding-top:0.01in;padding-left:0in;vertical-align:bottom;padding-bottom:0in;padding-right:0.01in;"><p style="font-size:10pt;margin-top:0;font-family:Times New Roman;margin-bottom:0;text-align:left;"><span style="color:#000000;white-space:pre-wrap;font-weight:bold;font-style:italic;font-kerning:none;min-width:fit-content;">(in millions, except per share amounts)</span></p></td>
