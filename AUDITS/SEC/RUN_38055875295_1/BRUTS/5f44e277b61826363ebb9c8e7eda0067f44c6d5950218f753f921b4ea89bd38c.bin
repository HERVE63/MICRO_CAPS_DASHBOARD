sts","description":"This element represents acquisition-related costs incurred to effect a business combination which costs have been expensed during the period. Such costs include finder's fees; advisory, legal, accounting, valuation, and other professional or consulting fees; general administrative costs, including the costs of maintaining an internal acquisitions department; and may include costs of registering and issuing debt and equity securities.","units":{"USD":[{"start":"2022-01-01","end":"2022-12-31","val":4012000,"accn":"0001477932-23-002112","fy":2022,"fp":"FY","form":"10-K","filed":"2023-03-31","frame":"CY2022"}]}},"BusinessCombinationContingentConsiderationLiability":{"label":"Business Combination, Contingent Consideration, Liability","description":"Amount of liability recognized arising from contingent consideration in a business combination.","units":{"USD":[{"end":"2021-12-31","val":0,"accn":"0001477932-23-002112","fy":2022,"fp":"FY","form":"10-K","filed":"2023-03-31","frame":"CY2021Q4I"},{"end":"2022-12-31","val":3547000,"accn":"0001477932-23-002112","fy":2022,"fp":"FY","form":"10-K","filed":"2023-03-31"},{"end":"2022-12-31","val":3547000,"accn":"0001477932-23-003574","fy":2023,"fp":"Q1","form":"10-Q","filed":"2023-05-15","frame":"CY2022Q4I"},{"end":"2023-03-31","val":4699000,"accn":"0001477932-23-003574","fy":2023,"fp":"Q1","form":"10-Q","filed":"2023-05-15","frame":"CY2023Q1I"}]}},"CapitalLeasesFutureMinimumPaymentsDue":{"label":"Capital Leases, Future Minimum Payments Due","description":"Amount of minimum lease payments for capital leases.","units":{"USD":[{"end":"2021-12-31","val":1383000,"accn":"0001477932-23-002112","fy":2022,"fp":"FY","form":"10-K","filed":"2023-03-31","frame":"CY2021Q4I"},{"end":"2023-03-31","val":1411000,"accn":"0001477932-23-003574","fy":2023,"fp":"Q1","form":"10-Q","filed":"2023-05-15","frame":"CY2023Q1I"}]}},"CapitalLeasesFutureMinimumPaymentsDueCurrent":{"label":"Capital Leases, Future Minimum Payments Due, Next Twelve