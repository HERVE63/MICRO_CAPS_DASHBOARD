angible assets (nonphysical assets not used in production) in a systematic and rational manner to the periods expected to benefit from such assets. As a noncash expense, this element is added back to net income when calculating cash provided by or used in operations using the indirect method.","units":{"USD":[{"start":"2024-01-01","end":"2024-09-30","val":138000,"accn":"0001104659-25-111398","fy":2025,"fp":"Q3","form":"10-Q","filed":"2025-11-13"},{"start":"2024-07-01","end":"2024-09-30","val":46000,"accn":"0001104659-25-111398","fy":2025,"fp":"Q3","form":"10-Q","filed":"2025-11-13","frame":"CY2024Q3"},{"start":"2024-01-01","end":"2024-12-31","val":184000,"accn":"0001104659-26-035156","fy":2025,"fp":"FY","form":"10-K","filed":"2026-03-26","frame":"CY2024"},{"start":"2025-01-01","end":"2025-03-31","val":46000,"accn":"0001104659-26-059252","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-12","frame":"CY2025Q1"},{"start":"2025-01-01","end":"2025-06-30","val":92000,"accn":"0001104659-26-094047","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-11"},{"start":"2025-04-01","end":"2025-06-30","val":46000,"accn":"0001104659-26-094047","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-11","frame":"CY2025Q2"},{"start":"2025-01-01","end":"2025-09-30","val":138000,"accn":"0001104659-25-111398","fy":2025,"fp":"Q3","form":"10-Q","filed":"2025-11-13"},{"start":"2025-07-01","end":"2025-09-30","val":46000,"accn":"0001104659-25-111398","fy":2025,"fp":"Q3","form":"10-Q","filed":"2025-11-13","frame":"CY2025Q3"},{"start":"2025-01-01","end":"2025-12-31","val":184000,"accn":"0001104659-26-035156","fy":2025,"fp":"FY","form":"10-K","filed":"2026-03-26","frame":"CY2025"},{"start":"2026-01-01","end":"2026-03-31","val":45999,"accn":"0001104659-26-059252","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-12","frame":"CY2026Q1"},{"start":"2026-01-01","end":"2026-06-30","val":92000,"accn":"0001104659-26-094047","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-11"},{"start":"2026-04-01","end"