from contingent consideration in a business combination, expected to be settled within one year or the normal operating cycle, if longer.","units":{"USD":[{"end":"2023-12-31","val":0,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14","frame":"CY2023Q4I"},{"end":"2024-12-31","val":2486000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14"},{"end":"2024-12-31","val":2486000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2024Q4I"},{"end":"2025-12-31","val":2566000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2025Q4I"}]}},"BusinessCombinationContingentConsiderationLiabilityNoncurrent":{"label":"Business Combination, Contingent Consideration, Liability, Noncurrent","description":"Amount of liability recognized arising from contingent consideration in a business combination, expected to be settled beyond one year or the normal operating cycle, if longer.","units":{"USD":[{"end":"2023-12-31","val":6577000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14","frame":"CY2023Q4I"},{"end":"2024-12-31","val":7736000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14"},{"end":"2024-12-31","val":7736000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2024Q4I"},{"end":"2025-12-31","val":5815000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2025Q4I"}]}},"CapitalExpendituresIncurredButNotYetPaid":{"label":"Capital Expenditures Incurred but Not yet Paid","description":"Future cash outflow to pay for purchases of fixed assets that have occurred.","units":{"USD":[{"start":"2023-01-01","end":"2023-12-31","val":748000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14","frame":"CY2023"},{"start":"2024-01-01","end":"2024-12-31","val":490000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14"},{"start":"2024-01-01","end":"2024-12-31","val":490000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2024"},{"start":"2025-01-01","end":"2025-12-31","val":97000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2025"}]}},"CapitalLeaseObligationsIncurred":{"label":"Lease Obligation Incurred","description":"Amount of increase in lease obligation from new lease.","units":{"USD":[{"start":"2023-01-01","end":"2023-12-31","val":1474000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14","frame":"CY2023"},{"start":"2024-01-01","end":"2024-12-31","val":680000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14"},{"start":"2024-01-01","end":"2024-12-31","val":680000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2024"},{"start":"2025-01-01","end":"2025-12-31","val":3934000,"accn":"0001832928-26-000005","fy":2025,"fp":"FY","form":"40-F","filed":"2026-03-06","frame":"CY2025"}]}},"CashAndCashEquivalentsAtCarryingValue":{"label":"Cash and Cash Equivalents, at Carrying Value","description":"Amount of currency on hand as well as demand deposits with banks or financial institutions. Includes other kinds of accounts that have the general characteristics of demand deposits. Also includes short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates. Excludes cash and cash equivalents within disposal group and discontinued operation.","units":{"USD":[{"end":"2023-12-31","val":103429000,"accn":"0001832928-25-000006","fy":2024,"fp":"FY","form":"40-F","filed":"2025-03-14","frame":"CY2023Q4I"},{"end":"2024-12-31","val":137564000,"accn":