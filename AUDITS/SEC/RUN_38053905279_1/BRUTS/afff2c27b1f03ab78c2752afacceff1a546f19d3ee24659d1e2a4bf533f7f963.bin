nts receivable.","units":{"USD":[{"start":"2024-01-01","end":"2024-12-31","val":1262146,"accn":"0001493152-26-018144","fy":2025,"fp":"FY","form":"10-K","filed":"2026-04-20"},{"start":"2024-01-01","end":"2024-12-31","val":1262146,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2024"}]}},"RepaymentOfNotesReceivableFromRelatedParties":{"label":"Repayment of Notes Receivable from Related Parties","description":"The cash inflow from a loan, supported by a promissory note, granted to related parties where one party can exercise control or significant influence over another party; including affiliates, owners or officers and their immediate families, pension trusts, and so forth.","units":{"USD":[{"start":"2024-01-01","end":"2024-12-31","val":986844,"accn":"0001493152-26-018144","fy":2025,"fp":"FY","form":"10-K","filed":"2026-04-20"},{"start":"2024-01-01","end":"2024-12-31","val":986844,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2024"},{"start":"2025-01-01","end":"2025-03-31","val":15862,"accn":"0001493152-26-024300","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-19"},{"start":"2025-01-01","end":"2025-03-31","val":15862,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2025Q1"},{"start":"2025-01-01","end":"2025-06-30","val":15862,"accn":"0001493152-26-038443","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-14"},{"start":"2025-01-01","end":"2025-12-31","val":15862,"accn":"0001493152-26-018144","fy":2025,"fp":"FY","form":"10-K","filed":"2026-04-20"},{"start":"2025-01-01","end":"2025-12-31","val":15862,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2025"}]}},"RepaymentsOfRelatedPartyDebt":{"label":"Repayments of Related Party Debt","description":"The cash outflow for the payment of a long-term borrowing made from a related party where one party can exercise control or 