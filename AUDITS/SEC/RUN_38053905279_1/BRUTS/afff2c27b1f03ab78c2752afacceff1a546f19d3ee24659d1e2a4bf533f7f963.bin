ct or process or for a significant improvement to an existing product or process whether intended for sale or the entity's use, during the reporting period charged to research and development projects, including the costs of developing computer software up to the point in time of achieving technological feasibility, and costs allocated in accounting for a business combination to in-process projects deemed to have no alternative future use.","units":{"USD":[{"start":"2024-01-01","end":"2024-12-31","val":255414,"accn":"0001493152-26-018144","fy":2025,"fp":"FY","form":"10-K","filed":"2026-04-20"},{"start":"2024-01-01","end":"2024-12-31","val":255414,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2024"},{"start":"2025-01-01","end":"2025-03-31","val":14559,"accn":"0001493152-26-024300","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-19"},{"start":"2025-01-01","end":"2025-03-31","val":14559,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2025Q1"},{"start":"2025-01-01","end":"2025-06-30","val":23833,"accn":"0001493152-26-038443","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-14"},{"start":"2025-04-01","end":"2025-06-30","val":9274,"accn":"0001493152-26-038443","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-14","frame":"CY2025Q2"},{"start":"2025-01-01","end":"2025-12-31","val":58072,"accn":"0001493152-26-018144","fy":2025,"fp":"FY","form":"10-K","filed":"2026-04-20"},{"start":"2025-01-01","end":"2025-12-31","val":58072,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2025"},{"start":"2026-01-01","end":"2026-03-31","val":22999,"accn":"0001493152-26-024300","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-19"},{"start":"2026-01-01","end":"2026-03-31","val":22999,"accn":"0001493152-26-032750","fy":null,"fp":null,"form":"POS AM","filed":"2026-07-10","frame":"CY2026Q1"},{"start":"2026-01-01","end":"2026-06-30","val":25