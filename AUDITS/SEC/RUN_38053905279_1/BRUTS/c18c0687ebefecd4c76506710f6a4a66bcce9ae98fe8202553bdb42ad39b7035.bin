ock, use the element additional paid in capital, common stock. For additional paid-in capital associated with only preferred stock, use the element additional paid in capital, preferred stock.","units":{"USD":[{"end":"2013-12-31","val":8226000,"accn":"0001609065-14-000005","fy":2014,"fp":"Q3","form":"10-Q","filed":"2014-11-12"},{"end":"2013-12-31","val":8226000,"accn":"0001609065-15-000006","fy":2014,"fp":"FY","form":"10-K","filed":"2015-03-18","frame":"CY2013Q4I"},{"end":"2014-09-30","val":8334000,"accn":"0001609065-14-000005","fy":2014,"fp":"Q3","form":"10-Q","filed":"2014-11-12","frame":"CY2014Q3I"},{"end":"2014-12-31","val":28534000,"accn":"0001609065-15-000006","fy":2014,"fp":"FY","form":"10-K","filed":"2015-03-18"},{"end":"2014-12-31","val":28534000,"accn":"0001609065-15-000025","fy":2015,"fp":"Q1","form":"10-Q","filed":"2015-05-14"},{"end":"2014-12-31","val":28534000,"accn":"0001609065-15-000035","fy":2015,"fp":"Q2","form":"10-Q","filed":"2015-08-13"},{"end":"2014-12-31","val":28534000,"accn":"0001609065-15-000043","fy":2015,"fp":"Q3","form":"10-Q","filed":"2015-11-13"},{"end":"2014-12-31","val":28534000,"accn":"0001609065-16-000054","fy":2015,"fp":"FY","form":"10-K","filed":"2016-03-29","frame":"CY2014Q4I"},{"end":"2015-03-31","val":28570000,"accn":"0001609065-15-000025","fy":2015,"fp":"Q1","form":"10-Q","filed":"2015-05-14","frame":"CY2015Q1I"},{"end":"2015-06-30","val":28614000,"accn":"0001609065-15-000035","fy":2015,"fp":"Q2","form":"10-Q","filed":"2015-08-13","frame":"CY2015Q2I"},{"end":"2015-09-30","val":28659000,"accn":"0001609065-15-000043","fy":2015,"fp":"Q3","form":"10-Q","filed":"2015-11-13","frame":"CY2015Q3I"},{"end":"2015-12-31","val":28717000,"accn":"0001609065-16-000054","fy":2015,"fp":"FY","form":"10-K","filed":"2016-03-29"},{"end":"2015-12-31","val":28717000,"accn":"0001609065-16-000072","fy":2016,"fp":"Q1","form":"10-Q","filed":"2016-05-13"},{"end":"2015-12-31","val":28717000,"accn":"0001609065-16-000084","fy":2016,"fp":"Q2","form":"10-Q","