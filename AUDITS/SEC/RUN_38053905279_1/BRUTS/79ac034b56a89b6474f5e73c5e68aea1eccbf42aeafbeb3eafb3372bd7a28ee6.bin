er at a specified price.","units":{"CAD":[{"end":"2023-12-31","val":0,"accn":"0001376474-25-000389","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-25"},{"end":"2023-12-31","val":0,"accn":"0001376474-26-000195","fy":2024,"fp":"FY","form":"20-F/A","filed":"2026-02-20"},{"end":"2023-12-31","val":0,"accn":"0001376474-26-000218","fy":2024,"fp":"FY","form":"20-F/A","filed":"2026-02-27","frame":"CY2023Q4I"},{"end":"2024-12-31","val":751000,"accn":"0001376474-25-000389","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-25"},{"end":"2024-12-31","val":751000,"accn":"0001376474-26-000195","fy":2024,"fp":"FY","form":"20-F/A","filed":"2026-02-20"},{"end":"2024-12-31","val":751000,"accn":"0001376474-26-000218","fy":2024,"fp":"FY","form":"20-F/A","filed":"2026-02-27"},{"end":"2024-12-31","val":751000,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2024-12-31","val":751000,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2024Q4I"},{"end":"2025-12-31","val":361058,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2025-12-31","val":361058,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2025Q4I"}]}},"WeightedAverageNumberOfSharesOutstandingBasic":{"label":"Weighted Average Number of Shares Outstanding, Basic","description":"Number of [basic] shares or units, after adjustment for contingently issuable shares or units and other shares or units not deemed outstanding, determined by relating the portion of time within a reporting period that common shares or units have been outstanding to the total time in that period.","units":{"shares":[{"start":"2023-01-01","end":"2023-12-31","val":16843182,"accn":"0001376474-25-000389","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-25"},{"start":"2023-01-01","end":"2023-12-31","val":16843182,"accn":"0001376474-26-000195","fy":2024,"fp":"FY","form":"20-F