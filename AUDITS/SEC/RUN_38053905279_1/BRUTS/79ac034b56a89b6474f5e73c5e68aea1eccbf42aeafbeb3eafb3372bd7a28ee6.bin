rvice rendered in normal course of business.","units":{"CAD":[{"end":"2025-12-31","val":4773616,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2025-12-31","val":4773616,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2025Q4I"}]}},"AccountsReceivableNet":{"label":"Accounts Receivable, after Allowance for Credit Loss","description":"Amount, after allowance for credit loss, of right to consideration from customer for product sold and service rendered in normal course of business.","units":{"CAD":[{"end":"2024-12-31","val":206434,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2024-12-31","val":206434,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2024Q4I"},{"end":"2025-12-31","val":4166885,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2025-12-31","val":4166885,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2025Q4I"}]}},"AccumulatedDepreciationDepletionAndAmortizationPropertyPlantAndEquipment":{"label":"Accumulated Depreciation, Depletion and Amortization, Property, Plant, and Equipment","description":"Amount of accumulated depreciation, depletion and amortization for physical assets used in the normal conduct of business to produce goods and services.","units":{"CAD":[{"end":"2024-12-31","val":71286,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2024-12-31","val":71286,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2024Q4I"},{"end":"2025-12-31","val":952689,"accn":"0001376474-26-000322","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-04-29"},{"end":"2025-12-31","val":952689,"accn":"0001376474-26-000330","fy":2025,"fp":"FY","form":"20-F/A","filed":"2026-05-04","frame":"CY2025Q