rm":"10-Q","filed":"2026-05-05","frame":"CY2026Q1"}]}},"PaymentsOfDividendsMinorityInterest":{"label":"Payments of Ordinary Dividends, Noncontrolling Interest","description":"Amount of cash outflow in the form of ordinary dividends provided by the non-wholly owned subsidiary to noncontrolling interests.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":20000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":201000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"PaymentsOfFinancingCosts":{"label":"Payments of Financing Costs","description":"The cash outflow for loan and debt issuance costs.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":702403,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":733275,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"PaymentsToAcquireInterestInSubsidiariesAndAffiliates":{"label":"Payments to Acquire Interest in Subsidiaries and Affiliates","description":"The cash outflow associated with the acquisition of or advances to an entity that is related to it but not strictly controlled (for example, an unconsolidated subsidiary, affiliate, and joint venture or equity method investment) or the acquisition of an additional interest in a subsidiary (controlled entity).","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":513,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":121350,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"PaymentsToAcquirePropertyPlantAndEquipment":{"label":"Payments to Acquire Property, Plant, and Equipment","description":"The cash outflow associated with the acquisition of long-lived, physical assets that are used in the normal conduct of business to produce goods and services and not intended for resale; includes cash outflows to pay for construction of self-constructed assets.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":43143,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ProceedsFromInterestReceived":{"label":"Proceeds from Interest Received","description":"Interest received on loans and other debt instruments during the current period.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":165,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":196,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ProceedsFromLongTermLinesOfCredit":{"label":"Proceeds from Long-term Lines of Credit","description":"The cash inflow from a contractual arrangement with the lender, including letter of credit, standby letter of credit and revolving credit arrangements, under which borrowings can be made up to a specific amount at any point in time with maturities due beyond one year or the operating cycle, if longer.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":9299000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":36218275,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ProceedsFromNotesPayable":{"label":"Proceeds from Notes Payable","description":"The cash inflow from a borrowing supported by a written promise to pay an obligation.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":8100000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ProfessionalFees":{"label":"Professional Fees","description":"A fee charged for services from professionals such as doctors, lawyers and accountants. The term is often expanded to include other professions, for example, pharmacists charging to maintain a medicinal profile of a client or customer.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":3565048,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2023-07-01","end":"2023-09-30","val":937735,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023Q3"},{"start":"2024-01-01","end":"2024-09-30","val":2730955,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-07-01","end":"2024-09-30","val":1119518,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2024Q3"}]}},"PropertyPlantAndEquipmentAdditions":{"label":"Property, Plant and Equipment, Additions","description":"Amount of acquisition of long-lived, physical assets used in the normal conduct of business and not intended for resale. Examples include, but are not limited to, land, buildings, machinery and equipment, office equipment, furniture and fixtures, and computer equipment.","units":{"USD":[{"start":"2024-01-01","end":"2024-09-30","val":699903,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"PropertyPlantAndEquipmentDisposals":{"label":"Property, Plant and Equipment, Disposals","description":"Amount of divestiture of long-lived, physical assets used in the normal conduct of business and not intended for resale. Examples include, but are not limited to, land, buildings, machinery and equipment, office equipment, furniture and fixtures, and computer equipment.","units":{"USD":[{"start":"2024-01-01","end":"2024-09-30","val":88950,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-12-31","val":400000,"accn":"0001558370-25-003833","fy":2024,"fp":"FY","form":"10-K","filed":"2025-03-27"},{"start":"2024-01-01","end":"2024-12-31","val":400000,"accn":"0001104659-26-029004","fy":2025,"fp":"FY","form":"10-K","filed":"2026-03-17","frame":"CY2024"},{"start":"2026-01-01","end":"2026-03-31","val":900000,"accn":"0001104659-26-055322","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-05","frame":"CY2026Q1"},{"start":"2026-01-01","end":"2026-06-30","val":1200000,"accn":"0001104659-26-094078","fy":2026,"fp":"Q2","form":"10-Q","filed":"2026-08-11"}]}},"RepaymentsOfRelatedPartyDebt":{"label":"Repayments of Related Party Debt","description":"The cash outflow for the payment of a long-term borrowing made from a related party where one party can exercise control or significant influence over another party; including affiliates, owners or officers and their immediate families, pension trusts, and so forth. Alternate caption: Payments for Advances from Affiliates.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":17027,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-01-01","end":"2024-09-30","val":10000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"RestrictedCashAndCashEquivalentsAtCarryingValue":{"label":"Restricted Cash and Cash Equivalents, Current","description":"Amount of cash and cash equivalents restricted as to withdrawal or usage, classified as current. Cash includes, but is not limited to, currency on hand, demand deposits with banks or financial institutions, and other accounts with general characteristics of demand deposits. Cash equivalents include, but are not limited to, short-term, highly liquid investments that are both readily convertible to known amounts of cash and so near their maturity that they present insignificant risk of changes in value because of changes in interest rates.","units":{"USD":[{"end":"2023-12-31","val":1000000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023Q4I"},{"end":"2024-09-30","val":100