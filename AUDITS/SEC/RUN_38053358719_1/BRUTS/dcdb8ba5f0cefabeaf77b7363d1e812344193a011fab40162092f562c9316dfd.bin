-09-30","val":500368,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2023-07-01","end":"2023-09-30","val":36500,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023Q3"},{"start":"2024-01-01","end":"2024-09-30","val":684578,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"SellingGeneralAndAdministrativeExpense":{"label":"Selling, General and Administrative Expense","description":"The aggregate total costs related to selling a firm's product and services, as well as all other general and administrative expenses. Direct selling expenses (for example, credit, warranty, and advertising) are expenses that can be directly linked to the sale of specific products. Indirect selling expenses are expenses that cannot be directly linked to the sale of specific products, for example telephone expenses, Internet, and postal charges. General and administrative expenses include salaries of non-sales personnel, rent, utilities, communication, etc.","units":{"USD":[{"start":"2023-01-01","end":"2023-09-30","val":21405122,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2023-07-01","end":"2023-09-30","val":5986061,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023Q3"},{"start":"2024-01-01","end":"2024-09-30","val":21470073,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"},{"start":"2024-07-01","end":"2024-09-30","val":6291658,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2024Q3"}]}},"ShareBasedCompensationArrangementByShareBasedPaymentAwardEquityInstrumentsOtherThanOptionsGrantsInPeriod":{"label":"Share-based Compensation Arrangement by Share-based Payment Award, Equity Instruments Other than Options, Grants in Period","description":"The number of grants made during the period on other than stock (or unit) option plans (for example, phantom stock or unit plan, stock or unit appreciation rights plan, performance target plan).","units":{"shares":[{"start":"2023-01-01","end":"2023-12-31","val":0,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023"},{"start":"2026-01-01","end":"2026-03-31","val":0,"accn":"0001104659-26-055322","fy":2026,"fp":"Q1","form":"10-Q","filed":"2026-05-05","frame":"CY2026Q1"}]}},"ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsExpirationsInPeriod":{"label":"Share-based Compensation Arrangement by Share-based Payment Award, Options, Expirations in Period","description":"Number of options or other stock instruments for which the right to exercise has lapsed under the terms of the plan agreements.","units":{"shares":[{"start":"2024-01-01","end":"2024-09-30","val":5000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsForfeituresInPeriod":{"label":"Share-based Compensation Arrangement by Share-based Payment Award, Options, Forfeitures in Period","description":"The number of shares under options that were cancelled during the reporting period as a result of occurrence of a terminating event specified in contractual agreements pertaining to the stock option plan.","units":{"shares":[{"start":"2023-01-01","end":"2023-12-31","val":373167,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06","frame":"CY2023"},{"start":"2024-01-01","end":"2024-09-30","val":55000,"accn":"0001193125-25-021800","fy":null,"fp":null,"form":"8-K/A","filed":"2025-02-06"}]}},"ShareBasedCompensationArrangementByShareBasedPaymentAwardOptionsOutstandingNumber":{"label":"Share-based Compensation Arrangement by Share-based Payment Award, Options, Outstanding, Number","description":"Number of options outstanding, including both vested and non-vest