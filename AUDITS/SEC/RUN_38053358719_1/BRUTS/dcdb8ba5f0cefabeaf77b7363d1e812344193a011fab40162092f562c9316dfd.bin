ef operating decision maker to make decisions about resources to be allocated to the segment and assess its performance, and (c) for which discrete financial information is available. An operating segment may engage in business activities for which it has yet to earn revenues, for example, start-up operations may be operating segments before earning revenues.","units":{"Segment":[{"start":"2018-01-01","end":"2018-06-30","val":1,"accn":"0001564590-18-021702","fy":2018,"fp":"Q2","form":"10-Q","filed":"2018-08-14"},{"start":"2018-01-01","end":"2018-09-30","val":1,"accn":"0001564590-18-027435","fy":2018,"fp":"Q3","form":"10-Q","filed":"2018-11-06"},{"start":"2018-01-01","end":"2018-12-31","val":1,"accn":"0001564590-19-006276","fy":2018,"fp":"FY","form":"10-K","filed":"2019-03-05","frame":"CY2018"},{"start":"2019-01-01","end":"2019-03-31","val":1,"accn":"0001564590-19-016516","fy":2019,"fp":"Q1","form":"10-Q","filed":"2019-05-07","frame":"CY2019Q1"},{"start":"2019-01-01","end":"2019-06-30","val":1,"accn":"0001564590-19-029364","fy":2019,"fp":"Q2","form":"10-Q","filed":"2019-08-06"},{"start":"2019-01-01","end":"2019-09-30","val":1,"accn":"0001564590-19-040392","fy":2019,"fp":"Q3","form":"10-Q","filed":"2019-11-05"},{"start":"2019-01-01","end":"2019-12-31","val":1,"accn":"0001564590-20-008464","fy":2019,"fp":"FY","form":"10-K","filed":"2020-03-03","frame":"CY2019"},{"start":"2020-01-01","end":"2020-03-31","val":1,"accn":"0001564590-20-021268","fy":2020,"fp":"Q1","form":"10-Q","filed":"2020-05-05","frame":"CY2020Q1"},{"start":"2020-01-01","end":"2020-06-30","val":1,"accn":"0001564590-20-036161","fy":2020,"fp":"Q2","form":"10-Q","filed":"2020-08-04"},{"start":"2020-01-01","end":"2020-09-30","val":1,"accn":"0001564590-20-049691","fy":2020,"fp":"Q3","form":"10-Q","filed":"2020-11-02"},{"start":"2020-01-01","end":"2020-12-31","val":1,"accn":"0001564590-21-010320","fy":2020,"fp":"FY","form":"10-K","filed":"2021-03-02","frame":"CY2020"}],"segment":[{"start":"2021-01-01","end":"20