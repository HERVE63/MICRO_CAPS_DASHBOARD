d or applied towards payment after one year or beyond the operating cycle, if longer.","units":{"USD":[{"end":"2023-12-31","val":1293,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28","frame":"CY2023Q4I"}]}},"EarningsPerShareBasic":{"label":"Earnings Per Share, Basic","description":"The amount of net income (loss) for the period per each share of common stock or unit outstanding during the reporting period.","units":{"USD/shares":[{"start":"2022-01-01","end":"2022-12-31","val":100112,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28","frame":"CY2022"},{"start":"2023-01-01","end":"2023-12-31","val":0.105,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2023-01-01","end":"2023-12-31","val":0.105,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2023"},{"start":"2024-01-01","end":"2024-12-31","val":0.056,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2024-01-01","end":"2024-12-31","val":0.056,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2024"},{"start":"2025-01-01","end":"2025-12-31","val":0.147,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2025"}]}},"EarningsPerShareDiluted":{"label":"Earnings Per Share, Diluted","description":"The amount of net income (loss) for the period available to each share of common stock or common unit outstanding during the reporting period and to each share or unit that would have been outstanding assuming the issuance of common shares or units for all dilutive potential common shares or units outstanding during the reporting period.","units":{"USD/shares":[{"start":"2022-01-01","end":"2022-12-31","val":100112,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28","frame":"CY2022"},{"start":"2023-01-01","