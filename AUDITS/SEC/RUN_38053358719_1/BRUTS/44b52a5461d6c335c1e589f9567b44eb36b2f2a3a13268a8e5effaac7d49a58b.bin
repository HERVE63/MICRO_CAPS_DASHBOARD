ons, adjustments, and changes in value not defined as investing or financing activities.","units":{"USD":[{"start":"2022-01-01","end":"2022-12-31","val":4448846,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28","frame":"CY2022"},{"start":"2023-01-01","end":"2023-12-31","val":898367,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2023-01-01","end":"2023-12-31","val":898367,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2023"},{"start":"2024-01-01","end":"2024-12-31","val":2080387,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2024-01-01","end":"2024-12-31","val":2080387,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2024"},{"start":"2025-01-01","end":"2025-12-31","val":-6739075,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2025"}]}},"NetIncomeLoss":{"label":"Net Income (Loss) Attributable to Parent","description":"The portion of profit or loss for the period, net of income taxes, which is attributable to the parent.","units":{"USD":[{"start":"2022-01-01","end":"2022-12-31","val":10011177,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28","frame":"CY2022"},{"start":"2023-01-01","end":"2023-12-31","val":2253709,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2023-01-01","end":"2023-12-31","val":2253709,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2023"},{"start":"2024-01-01","end":"2024-12-31","val":2372842,"accn":"0001213900-25-035802","fy":2024,"fp":"FY","form":"20-F","filed":"2025-04-28"},{"start":"2024-01-01","end":"2024-12-31","val":2372842,"accn":"0001185185-26-001294","fy":2025,"fp":"FY","form":"20-F","filed":"2026-04-07","frame":"CY2024"},{"start":"2025-01